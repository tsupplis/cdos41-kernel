; DFORM - Concurrent DOS 4.1 command-line floppy formatter.
; DFORM B:[DOS] [V] creates and optionally verifies 360K/720K/1.2M/1.44M FAT12 media.
; Native CP/M formats: 320K by default, 160K with [1].
; All transfers use CDOS XIOS under MXdisk.
cgroup	group	code,data
	cseg
	org	100h

i_bdos		equ	0e0h
f_reset		equ	0
f_rawio		equ	6
f_version	equ	12
f_resetdrive	equ	37
opt_single	equ	1
opt_double	equ	2
opt_verify	equ	4
opt_dos         equ     8
stack_size	equ	512

start:
	push	cs
	pop	ds
	pushf
	pop	bx
	cli
	mov	ax,ds
	mov	ss,ax
	mov	sp,offset stack_top
	push	bx
	popf
	cld
	mov	dx,offset msg_banner
	call	puts
	call	parse_args

        mov cl,f_version
        call bdos
        and ah,0fh
        cmp ah,4
        je concurrent_version
        cmp ah,6
        jne wrong_version
concurrent_version:
        mov cl,163
        call bdos
        cmp ax,1441h
        je system_ok
wrong_version:
        jmp wrong_os
system_ok:
        call ccpm_init

; Align within a 32 KiB reservation. A eighteen-sector head fits inside one
; physical 16 KiB slot and cannot straddle a 64 KiB DMA page.
	mov	ax,offset buffer_space
	add	ax,15
	mov	cl,4
	shr	ax,cl
	mov	bx,ds
	add	ax,bx
	add	ax,3ffh
	and	ax,0fc00h
	mov	buffer_segment,ax
	mov	dx,offset msg_double
	cmp	byte ptr sides,1
	jz	show_capacity
	mov	dx,offset msg_single
show_capacity:
        test options,opt_dos
        jz show_capacity_ready
        mov dx,offset msg_dos360
show_capacity_ready:
	call	puts
	mov	dx,offset msg_no_verify
	test	byte ptr options,opt_verify
	jz	show_verify_option
	mov	dx,offset msg_with_verify
show_verify_option:
	call	puts
	mov	dx,offset msg_confirm
	call	puts
	call	read_confirm
	cmp	al,'Y'
	jz	format_disk
	jmp	cancelled

;-----------------------------------------------------------------------------
; CP/M retains DSKMAINT's table; DOS selects nine sectors and F6 fill.
; Keep it installed through format, boot-track write and optional verify.
;-----------------------------------------------------------------------------
format_disk:
        call ccpm_lock
        mov al,sector_count
        mov disk_params+4,al
        mov al,format_fill
        mov disk_params+8,al
        call install_vector
	mov	dx,offset msg_formatting
	call	puts
	mov	byte ptr track,0
format_loop:
        call make_ids
	mov	byte ptr operation,5
	call	disk_io
	inc	byte ptr track
	mov	al,track
	cmp	al,track_count
	jnz	format_loop

        test options,opt_dos
        jz write_cpm_boot
        call write_fat360
        jmp boot_tracks_written
write_cpm_boot:
; Build the exact DSKMAINT track-zero image: E5 fill, boot code at zero,
; side flag at 1FFh and loader at 900h (sector five, offset 100h).
	mov	dx,offset msg_writing
	call	puts
	mov	es,word ptr buffer_segment
	xor	di,di
	mov	cx,1000h
	mov	al,0e5h
	cld
	rep	stosb
	xor	di,di
	mov	si,offset bootsect
	mov	cx,boot_end-bootsect
	rep	movsb
	mov	al,sides
	mov	es:byte ptr .1ffh,al
	mov	si,offset loader
	mov	di,900h
	mov	cx,loader_end-loader
	rep	movsb
	mov	byte ptr track,0
	mov	byte ptr operation,3
	call	disk_io
boot_tracks_written:
	test	byte ptr options,opt_verify
	jz	format_complete

	mov	dx,offset msg_verifying
	call	puts
	mov	byte ptr track,0
	mov	byte ptr operation,4
verify_loop:
	call	disk_io
	inc	byte ptr track
	mov	al,track
	cmp	al,track_count
	jnz	verify_loop
format_complete:
	mov	dx,offset msg_complete
	call	puts
	jmp	cleanup

;-----------------------------------------------------------------------------
; Parse the bounded CP/M base-page tail. Drive comes first; options are one
; or more bracket groups, with an optional closing bracket on each group.
; A group may directly follow the drive or another closed group.
;-----------------------------------------------------------------------------
parse_args:
	xor	cx,cx
	mov	cl,byte ptr .80h
	mov	si,81h
	call	skip_spaces
	jnz	have_drive
	jmp	usage
have_drive:
	lodsb
	dec	cx
	and	al,0dfh
	sub	al,'A'
	cmp	al,2
	jc	letter_ok
	jmp	bad_drive
letter_ok:
	mov	drive,al
	add	al,'A'
	mov	prompt_drive,al
        jcxz near_dform_14385_1_zero
        jmps near_dform_14385_1
near_dform_14385_1_zero:
        jmp bad_syntax
near_dform_14385_1:
	lodsb
	dec	cx
	cmp	al,':'
        jz near_dform_14385_2
        jmp bad_syntax
near_dform_14385_2:
next_group:
	call	skip_spaces
        jnz near_dform_14385_3
        jmp args_done
near_dform_14385_3:
	lodsb
	dec	cx
	cmp	al,'['
        jz near_dform_14385_4
        jmp bad_syntax
near_dform_14385_4:
	xor	bl,bl		; a group must contain at least one option
next_option:
        jcxz near_dform_14385_5_zero
        jmps near_dform_14385_5
near_dform_14385_5_zero:
        jmp group_end
near_dform_14385_5:
	mov	al,[si]
	cmp	al,']'
        jnz near_dform_14385_6
        jmp close_group
near_dform_14385_6:
	cmp	al,' '
        jnz near_dform_14385_7
        jmp group_end
near_dform_14385_7:
	cmp	al,9
        jnz near_dform_14385_8
        jmp group_end
near_dform_14385_8:
	lodsb
	dec	cx
	inc	bl
	cmp	al,'1'
        jnz near_dform_14385_9
        jmp option_one
near_dform_14385_9:
	cmp	al,'2'
        jnz near_dform_14385_10
        jmp option_two
near_dform_14385_10:
	and	al,0dfh
        cmp al,'D'
        jz option_dos
	cmp	al,'V'
        jz near_dform_14385_11
        jmp bad_syntax
near_dform_14385_11:
	or	byte ptr options,opt_verify
	jmp	next_option
option_dos:
        cmp cx,2
        jb bad_syntax
        lodsb
        dec cx
        and al,0dfh
        cmp al,'O'
        jne bad_syntax
        lodsb
        dec cx
        and al,0dfh
        cmp al,'S'
        jne bad_syntax
        or options,opt_dos
; Optional decimal capacity immediately after DOS; bare DOS means 360K.
        xor bp,bp
        xor di,di
capacity_digit:
        jcxz capacity_done
        mov al,[si]
        cmp al,'0'
        jb capacity_done
        cmp al,'9'
        ja capacity_done
        sub al,'0'
        xor ah,ah
        push ax
        mov ax,bp
        mov dx,10
        mul dx
        or dx,dx
        jnz capacity_overflow
        mov bp,ax
        pop ax
        add bp,ax
        jc capacity_invalid
        inc si
        dec cx
        inc di
        jmp capacity_digit
capacity_overflow:
        pop ax
capacity_invalid:
        jmp bad_syntax
capacity_done:
        or di,di
        jnz capacity_explicit
        mov bp,360
capacity_explicit:
        cmp capacity_seen,0
        je capacity_first
        cmp bp,format_capacity
        jne capacity_invalid
capacity_first:
        mov format_capacity,bp
        mov capacity_seen,1
        jmp next_option
option_one:
	or	byte ptr options,opt_single
	jmp	next_option
option_two:
	or	byte ptr options,opt_double
	jmp	next_option
close_group:
	inc	si
	dec	cx
group_end:
	or	bl,bl
	jz	bad_syntax
	jmp	next_group
bad_syntax:
	mov	dx,offset msg_bad_syntax
	call	puts
	jmp	usage
args_done:
	mov	al,options
	and	al,3
	cmp	al,3
	jz	bad_syntax
        mov bx,offset profile_cpm320
        test options,opt_single
        jz select_dos_profile
        mov bx,offset profile_cpm160
select_dos_profile:
        test options,opt_dos
        jz apply_profile
        test options,opt_single
        jz near_dform_14385_12
        jmp bad_syntax
near_dform_14385_12:
        mov bx,offset profile_dos360
        cmp format_capacity,360
        je apply_profile
        mov bx,offset profile_dos720
        cmp format_capacity,720
        je apply_profile
        mov bx,offset profile_dos1200
        cmp format_capacity,1200
        je apply_profile
        mov bx,offset profile_dos1440
        cmp format_capacity,1440
        je apply_profile
        jmp bad_syntax
apply_profile:
; Profile: cylinders, last head number, total heads, sectors/head, fill byte.
        mov al,[bx]
        mov cylinders,al
        mov al,1[bx]
        mov sides,al
        mov al,2[bx]
        mov track_count,al
        mov al,3[bx]
        mov sector_count,al
        mov al,4[bx]
        mov format_fill,al
        test options,opt_dos
        jz args_return
        mov al,5[bx]
        mov format_gap,al
        mov al,6[bx]
        mov fat_cluster_sectors,al
        mov al,7[bx]
        mov fat_media,al
        mov al,8[bx]
        mov fat_sectors,al
        mov ax,9[bx]
        mov fat_root_entries,ax
        mov ax,11[bx]
        mov fat_total_sectors,ax
args_return:
	ret

; Return ZF set at end of tail, clear if SI points at a non-space character.
skip_spaces:
	jcxz	spaces_end
	mov	al,[si]
	cmp	al,' '
	jz	skip_one
	cmp	al,9
	jnz	spaces_return
skip_one:
	inc	si
	dec	cx
	jmp	skip_spaces
spaces_end:
	xor	al,al
spaces_return:
	ret

bad_drive:
	mov	dx,offset msg_bad_drive
	call	puts
usage:
	mov	dx,offset msg_usage
	call	puts
	jmp	cleanup
wrong_os:
	mov	dx,offset msg_wrong_os
	call	puts
	jmp	cleanup
cancelled:
	mov	dx,offset msg_cancelled
	call	puts
	jmp	cleanup

;-----------------------------------------------------------------------------
; Raw console I/O has no automatic Ctrl-C termination. Flush type-ahead,
; then accept Y/N without echoing anything else. Ctrl-C uses normal cleanup.
;-----------------------------------------------------------------------------
read_confirm:
	mov	cl,f_rawio
flush_input:
	mov	dl,0ffh
	call	bdos
	or	al,al
	jnz	flush_input
wait_confirm:
	mov dl,0ffh
        mov dl,0fdh                 ; Sleep for PIN, rather than priority polling.
confirm_input:
	call	bdos
	or	al,al
	jz	wait_confirm
	cmp	al,3
	jz	cancelled
	and	al,0dfh
	cmp	al,'Y'
	jz	echo_confirm
	cmp	al,'N'
	jnz	wait_confirm
echo_confirm:
	push	ax
	mov	dl,al
	call	bdos
	mov	dx,offset msg_newline
	call	puts
	pop	ax
	ret

; DS:DX dollar string. Use raw function 6 even with the vector installed;
; neither type-ahead nor Ctrl-C can bypass cleanup inside a print call.
puts:
	push	ax
	push	cx
	push	dx
	push	si
	mov	si,dx
	mov	cl,f_rawio
puts_next:
	lodsb
	cmp	al,'$'
	jz	puts_return
	mov	dl,al
	call	bdos
	jmp	puts_next
puts_return:
	pop	si
	pop	dx
	pop	cx
	pop	ax
	ret

; AX carries the BDOS result; preserve ES and every disk/buffer cursor.
bdos:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	bp
	push	ds
	push	es
	int	i_bdos
	mov	result_es,es
	mov	result_bx,bx
	pop	es
	pop	ds
	pop	bp
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	cld
	ret

;-----------------------------------------------------------------------------
; DSKMAINT's logical track order reverses cylinders on the second head.
track_chs:
	mov	ch,track
	xor	dh,dh
	cmp ch,cylinders
	jc	chs_return
	neg ch
        add ch,track_count
        dec ch
	mov	dh,1
chs_return:
	ret

make_ids:
	call	track_chs
	mov	dl,ch
	mov	es,word ptr buffer_segment
	xor	di,di
	mov	bx,201h
	xor cx,cx
        mov cl,sector_count
	cld
id_loop:
	mov	ax,dx
	stosw
	mov	ax,bx
	stosw
	inc	bx
	loop	id_loop
	ret

disk_io:
	mov	byte ptr retries,5
io_attempt:
	mov	cl,f_rawio
	mov	dl,0ffh
	call	bdos
	cmp	al,3
	jnz	io_request
	jmp	cancelled
io_request:
	mov	byte ptr disk_touched,1
        call ccpm_io
        jnc io_complete
        mov last_status,ah
io_retry_count:
	dec	byte ptr retries
	jnz	io_attempt

; Report the final XIOS status, then restore the parameter vector and exit.
	mov	al,last_status
	mov	ah,al
	mov	cl,4
	shr	al,cl
	call	hex_digit
	mov	status_hi,al
	mov	al,ah
	and	al,0fh
	call	hex_digit
	mov	status_lo,al
	mov	dx,offset msg_io_error
	call	puts
	jmp	cleanup
io_complete:
        ret
hex_digit:
	add	al,'0'
	cmp	al,'9'
	jbe	hex_return
	add	al,7
hex_return:
	ret

;-----------------------------------------------------------------------------
; Patch the four-byte IVT pointer atomically, preserving interrupt state.
; Never leave our table installed on success, cancellation or disk errors.
;-----------------------------------------------------------------------------
install_vector:
	xor	ax,ax
	mov	es,ax
	mov	ax,es:word ptr .78h
	mov	old_offset,ax
	mov	ax,es:word ptr .7ah
	mov	old_segment,ax
	pushf
	cli
	mov	ax,offset disk_params
	mov	es:word ptr .78h,ax
	mov	ax,ds
	mov	es:word ptr .7ah,ax
	mov	byte ptr vector_active,1
	popf
        ret

cleanup:
	cmp	byte ptr vector_active,0
	jz	cleanup_login
	xor	ax,ax
	mov	es,ax
	pushf
	cli
	mov	ax,old_offset
	mov	es:word ptr .78h,ax
	mov	ax,old_segment
	mov	es:word ptr .7ah,ax
	popf
	mov	byte ptr vector_active,0
cleanup_login:
        call ccpm_finish
quit:
	xor	dx,dx
	mov	cl,f_reset
	int	i_bdos

; ---- data ----
	dseg

options		db	0
drive		db	0
cylinders       db      40
sector_count    db      8
format_fill     db      0e5h
profile_cpm160  db      40,0,40,8,0e5h
profile_cpm320  db      40,1,80,8,0e5h
; DOS profiles append gap, cluster sectors, media, FAT sectors, root/total.
profile_dos360  db 40,1,80,9,0f6h,50h,2,0fdh,2
                dw 112,720
profile_dos720  db 80,1,160,9,0f6h,50h,2,0f9h,3
                dw 112,1440
profile_dos1200 db 80,1,160,15,0f6h,54h,1,0f9h,7
                dw 224,2400
profile_dos1440 db 80,1,160,18,0f6h,6ch,1,0f0h,9
                dw 224,2880
format_capacity dw 360
capacity_seen db 0
format_gap db 50h
transfer_count db 0
transfer_sector db 0
fat_cluster_sectors db 2
fat_media db 0fdh
fat_sectors db 2
fat_root_entries dw 112
fat_total_sectors dw 720
fat_metadata_end dw 0
fat_lba dw 0
sides		db	1
track_count	db	80
track		db	0
operation	db	0
retries		db	0
last_status	db	0
vector_active	db	0
disk_touched	db	0
buffer_segment	dw	0
old_offset	dw	0
old_segment	dw	0
; Same bytes as the parameter table embedded in DSKMAINT.
disk_params	db	0cfh,02h,25h,02h,08h,2ah,0ffh,50h,0e5h,19h,04h

msg_banner	db	13,10,'Concurrent DOS FLOPPY FORMATTER VER 1.1N',13,10,'$'
msg_usage	db	'USAGE: DFORM drive: { [options] ... }',13,10,13,10
	db	'  A: or B:  Target floppy drive (required)',13,10
	db	'  1         Single-sided, 160K',13,10
	db	'  2         Double-sided, 320K (default)',13,10
	db      '  DOS       FAT12 360K; DOS720/DOS1200/DOS1440 select larger media',13,10
	db	'  V         Verify after formatting',13,10
	db	'  Combine options: [1V] or [1] [V; closing ] is optional.',13,10
	db	'  Examples: DFORM A:[1V]   DFORM B: [V',13,10,'$'
msg_dos360      db      'DOS FAT12; copy compatible CCPM.SYS first to boot; $'
msg_single	db	'160K, single-sided; $'
msg_double	db	'320K, double-sided; $'
msg_with_verify	db	'verification enabled.',13,10,'$'
msg_no_verify	db	'verification disabled.',13,10,'$'
msg_confirm	db	'Format drive '
prompt_drive	db	'A'
	db	': (all data will be lost). Continue (Y/N)? $'
msg_newline	db	13,10,'$'
msg_formatting	db	'Formatting...',13,10,'$'
msg_writing	db	'Writing boot track...',13,10,'$'
msg_verifying	db	'Verifying...',13,10,'$'
msg_complete	db	'Format complete.',13,10,'$'
msg_cancelled	db	13,10,'Cancelled.',13,10,'$'
msg_bad_syntax	db	'Invalid parameter.',13,10,'$'
msg_bad_drive	db	'Invalid drive specification.',13,10,'$'
msg_wrong_os	db	'DFORM requires Concurrent DOS 4.1.',13,10,'$'
msg_io_error	db	'Disk operation failed; XIOS status '
status_hi	db	'0'
status_lo	db	'0'
	db	'.',13,10,'$'

; Shared generated images; lengths follow the source images automatically.
bootsect:
	include	bootsect.inc
boot_end:
loader:
	include	loader.inc
loader_end:
fat_boot_sector:
        include fatboot.inc
extended_boot_sector:
        include dosbootx.inc

stack_space	rs	stack_size
stack_top:
; Alignment can consume up to 16383 bytes before a 9216-byte head buffer.
	include	ccpmio.a86
        include fat12.a86
        dseg
buffer_space rs 8000h
	end
