vnm10_msg db	'ENTER A NEW CP/M DIRECTORY LABEL',0
vnm11_msg db	'ENTER A NEW DOS DIRECTORY LABEL',0
vnm12_msg db 	'A CP/M directory label may have up to 8 characters followed',0
vnm13_msg db	'by a period (".") and then up to 3 more characters.',0
vnm14_msg db	'A DOS directory label may have up to 11 characters.  Note',0
