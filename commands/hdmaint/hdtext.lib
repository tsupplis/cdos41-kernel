vfy9A_msg db	'file allocation table is defective',0
vfy10_msg db	'Verification complete      ',0
vfy11_msg db	'Verify disk again',0
vfy12_msg db	'Return to main menu         ',0

vfy3_dos_msg db	'Scanning DOS partition on ',0

eject
