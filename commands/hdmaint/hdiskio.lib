eject
;	HDISKIO.LIB include file for HDMAINT 2.0 as of 17-Jun-84
;	XT ROM BIOS /CCPM interface library routines
;	revised 14-Jun-83 to fix register bug
;	revised 01-Dec-83 to remove delay from FILES_OPEN
;	revised 6-Jun-84 for HDMAINT 2.0 to remove FILES_OPEN routine
;	revised 17-Jun-84 to delete XIOS back door usage, Now for CCPM 3.x ONLY

	DSEG $
dseg_save	equ	 offset $

;	LOCAL CONSTANTS
;SLOW_SEEK	equ	0		;if -1, forces 3 ms step rate
LABEL_SCTR	equ	4		;sector number of cp/m label
PTABLE_SCTR	equ	1		;sector number of partition table
PTABLE_CYL	equ	0
PTABLE_HEAD	equ	0
SYS_START	equ	1		;normal start sector of loader track
SYS_SIZE	equ	16		;normal length of loader track 
DISK_RETRIES	equ	3		;usual number of retries

;	commands for IBM ROS routines
IBM_READF	equ	2		;read
IBM_WRITEF	equ	3		;write
IBM_GPARMSF	equ	8		;return disk parameters
IBM_RESETF	equ	0dh		;reset only hard disk system

IBM_BADTRACK_ERR equ	0Bh		;ROS error code for bad track
;	XT hard disk vector segment
	ESEG	0

	org	13h * 4
hd_o	rw	1
hd_s	rw	1
HD_PTR	equ dword ptr hd_o

	org	476h
hd_control_byte	rb	0		;controller option byte in ROS data seg

;	XT HARD DISK DATA STRUCTURE DEFINITIONS
	DSEG	

;	This defines the CP/M label for a volume
;	org	0
;;HDLB_label STRUCT
;  HDLB_chks	rw	1		;checksum
;  HDLB_id	rb	31		;contains dr copyright
;  HDLB_pstart	rw	1		;partition start cylinder
;  HDLB_plength	rw	1		;partition length in cylinders
;  HDLB_nheads	rb	1		;number of heads
;  HDLB_ibm_spt	rb	1		;ibm sectors per track
;  HDLB_cpm_options rb	1		;lsb = 1 means write verify
;  HDLB_cpm_nsect rb	1		;number of cp/m sectors per ibm sector
;  HDLB_cpm_dpb:				;DPB
;    HDLB_cpm_spt	rw	1	;as per usual abbreviations
;    HDLB_cpm_bsh	rb	1
;    HDLB_cpm_blm	rb	1
;    HDLB_cpm_exm	rb	1
;    HDLB_cpm_dsm	rw	1
;    HDLB_cpm_drm	rw	1
;    HDLB_cpm_al0	rb	1
;    HDLB_cpm_al1	rb	1
;    HDLB_cpm_cks	rw	1
;    HDLB_cpm_off	rw	1
;    HDLB_cpm_rsvd	rw	4	;for future use
;  HDLB_map_ctl:				;remap table begins
;    HDLB_map_spb	rw	1	;# of cp/m sectors per remap block
;    HDLB_map_max	rw	1	;# total length of table in entries
;    HDLB_map_cnt	rw	1	;# of currently active entries
;    HDLB_map_spare_end	rw	1	;last spare cpm relative block number
;    HDLB_map_table	rw	1	;beginning of remap table entries
;    HD_LABEL_SIZE	equ	512
;;HDLB_label ENDS

;	This IOPB is used to communicate with the ROS access routine "hd_rom"
;	Note:some parameters are not EXACTLY as defined by IBM.
;	org	0
;;IBM_iopb STRUCT
;  IBM_fn	rb	1		;ibm ROS function code (0 - 14d)
;  IBM_errcode	rb	1		;what is returned by ROS in AH
;  IBM_lun	rb	1		;unit number (0h or 1h)
;  IBM_head	rb	1		;head number only (0 - maxheads)
;  IBM_cylinder	rw	1		;entire cylinder number (0 - maxcyl)
;  IBM_sector	rb	1		;sector number only (0 - maxsector)
;  IBM_count	rb	1		;number of sectors to xfer (1 - 80h)
;  IBM_xfer_ofs	rw	1		;transfer buffer offset address
;  IBM_xfer_seg	rw	1		;transfer buffer segment address
;  IBM_XFER_PTR equ dword ptr ibm_xfer_ofs
;  HD_IOPB_SIZE	equ	offset $
;;IBM_iopb ENDS


	CSEG $
eject
;	GDK interface routine GET_NUM_HARD
;	entry:	Nothing
;	exit:	AL= number of hard disks in system
GET_NUM_HARD:
	mov	ah,IBM_GPARMSF		;get drive char for unit 0 works
	  mov	dl,80h			;need a legal unit number
	  pushf ! callf HD_ROM_ENTRY
	mov	al,dl
	jnc	get_num_hard_ret	;if call fails, return 0 drives
	  mov	al,0
get_num_hard_ret:
	ret

;	GDK interface routine GET_DISK_PARMS
;	entry:	ES:BX--> disk param structure:
;		max_heads	rb	1	;as in label
;		num_sectors	rb	1	;as in label
;		max_cylinder	rw	1	;as in label
;		DX=Disk number
;	exit:	AL=0 if no errors, else <>0 if doesn't exist
GET_DISK_PARMS:
	cld ! push bx
	  xor ax,ax ! mov di,bx		;pre-zero result in case of error
	  stosw ! stosw
;
	mov	ah,IBM_GPARMSF		;return drive parameters functio
	  or	dl,80h
	  pushf ! callf HD_ROM_ENTRY	;dl is already setup
	  jc	get_disk_parms_ret	;no parms?
;
	pop	di
	cld ! mov al,dh ! stosb		;else update heads
	mov al,cl ! and al,3fh ! stosb	;sectors
	mov ah,cl ! mov al,ch		;and cylinders
	  rol ah,1 ! rol ah,1
	  and ah,3 ! stosw
	xor al,al
get_disk_parms_ret:
	ret


;	GDK interface routine READ_PART_TABLE
;	entry:	ES:BX--> buffer, DX=disk number
;	exit:	AL=0 if no errors, else <>0
READ_PART_TABLE:
	mov	ax,bx
	mov	bx,offset hd_rd_partition_iopb
	jmp	gdk_rom

;	GDK interface routine WRITE_PART_TABLE
;	entry:	ES:BX--> buffer, DX=disk number
;	exit:	AL=0 if no errors, else <>0
WRITE_PART_TABLE:
	mov	ax,bx
	mov	bx,offset hd_wr_partition_iopb
	call	gdk_xlate
	jmp	gdk_write_unmapped

;	GDK interface routine READ_CPM_LABEL
;	entry:	ES:BX--> buffer, CX=Cylinder number, DX=disk number
;	exit:	AL=0 if no errors, else <>0
READ_CPM_LABEL:
	mov	ax,bx
	mov	bx,offset hd_rd_label_iopb	
	mov	IBM_cylinder[bx],cx
	jmp	gdk_rom

;	GDK interface routine WRITE_CPM_LABEL
;	entry:	ES:BX--> buffer, CX=Cylinder number, DX=disk number
;	exit:	AL=0 if no errors, else <>0
WRITE_CPM_LABEL:
	mov	ax,bx
	mov	bx,offset hd_wr_label_iopb
	mov	IBM_cylinder[bx],cx
	call	gdk_xlate
	jmp	gdk_write_unmapped

;	GDK interface routine READ_CPM_BLOCK
;	read a remap block via remap table
;	entry:	AX=block,ES:BX--> buffer, DS:CX-->CPM_LABEL, DX=disk number
;	exit:	AL=0 if no errors, else <>0
READ_CPM_BLOCK:
	mov	si,cx
	push	ax
	mov	ax,bx
	mov	bx,offset hd_rd_block_iopb
	call	gdk_xlate
	pop	ax
	call	hd_xlate_request
	jmp	hd_rom

;	GDK interface routine WRITE_CPM_BLOCK
;	write a remap block via remap table
;	entry:	AX=block,ES:BX--> buffer, DS:CX-->CPM_LABEL, DX=disk number
;	exit:	AL=0 if no errors, else <>0
WRITE_CPM_BLOCK:
	mov	si,cx
	push	ax
	mov	ax,bx
	mov	bx,offset hd_wr_block_iopb
	call	gdk_xlate
	pop	ax
	call	hd_xlate_request
	jmp	gdk_write_unmapped

;	GDK interface routine WRITE_CPM_SYSTEM
;	note that this routine must be aware of difference on CYL 0
;	 which requires track start at sector 2 instead of 1.
;	writes and verifies the system track
;	entry:	ES:BX--> system track image starting with first copy of boot
;		CX=Cylinder number, DX=Disk number
;	exit:	AL=0 if no errors, else <>0
WRITE_CPM_SYSTEM:
	mov	ax,bx
	mov	bx,offset hd_wr_system_iopb
	mov	IBM_cylinder[bx],cx
	mov	IBM_count[bx],16	;write all of it unless cyl 0
	mov	IBM_sector[bx],1	;(because of partition table)
	cmp	cx,0
	jne	write_cpm_system1
	  add	ax,512			;start one sector later on cyl 0
	  inc	IBM_sector[bx]		;(image has two copies of boot)
	  dec	IBM_count[bx]
write_cpm_system1:
	call	gdk_xlate
	jmp	gdk_write_unmapped

;	GDK interface routine READ_CPM_SYSTEM
;	note that this routine must be aware of difference on CYL 0
;	 which requires track start at sector 2 instead of 1.
;	writes and verifies the system track
;	entry:	ES:BX--> system track image starting with first copy of boot
;		CX=Cylinder number, DX=Disk number
;	exit:	AL=0 if no errors, else <>0
READ_CPM_SYSTEM:
	mov	ax,bx
	mov	bx,offset hd_rd_system_iopb
	mov	IBM_cylinder[bx],cx
	mov	IBM_count[bx],16	;write all of it unless cyl 0
	mov	IBM_sector[bx],1	;(because of partition table)
	cmp	cx,0
	jne	read_cpm_system1
	  add	ax,512			;start one sector later on cyl 0
	  inc	IBM_sector[bx]		;(image has two copies of boot)
	  dec	IBM_count[bx]
read_cpm_system1:
	jmp	gdk_rom

;	loads parameters in passing format from GDK into ibm_iopb
;	entry:	Dl=unit, ES:AX--> xfer buffer,DS:BX--> IOPB 
;	exit:	updated iopb
gdk_xlate:
	mov	IBM_lun[bx],dl		;set unit
	mov	IBM_xfer_ofs[bx],ax
	mov	IBM_xfer_seg[bx],es
	ret

;	translates unit and buffer pointer into iopb and executes rom function
;	entry	DL=unit, ES:AX-->xfer buffer, DS:BX--> IOPB
;	exit:	result code in AL
gdk_rom:
	call	gdk_xlate
	jmp	hd_rom

eject
;	translate remap block # passed using CP/M label passed and
;	and update iopb with either unmapped replacement disk addr. as needed
;	entry:	AX=block number, DS:SI--> cp/m label for this drive
;		DS:BX--> IOPB to update with cyl,head,and sector
;	exit:	appropriately updated IOPB
;	CALLS:	NOTHING
hd_xlate_request:
	mov	cx,HDLB_map_cnt[si]		;see if that block is in table
	  jcxz	hd_no_remap			;(skip if table is empty)
	  cld ! lea di,HDLB_map_table[si]	;by scanning table
	  push es ! push ds ! pop es
	  repne	scasw
	  pop es
	  jne	hd_noremap			;nope, leave block number alone
	    inc cx ! sub cx,HDLB_map_cnt[si]	;else calculate replacement
	    mov	ax,HDLB_map_spare_end[si]
	    add	ax,cx
hd_noremap:					;target block now in ax
	mul	HDLB_map_spb[si]		;ibm_block=(block * remap_spb)
	  mov	cl,HDLB_cpm_nsect[si]		;/(cp/m sectors per ibm sector)
	  xor	ch,ch				; L o n g   D i v i d e !!
	  div	cx				;(there should be no remainder)
	mov	cl,HDLB_ibm_spt[si]	;ibm_rel_track=ibm_block/ibm_spt
	  xor dx,dx ! div cx			;CAUTION!! 16 bit result
	  inc	dl				;save remainder as ibm sector
	  mov	IBM_sector[bx],dl		; (except they start with 1)
	add	ax,HDLB_cpm_off[si] 	;ibm_track=ibm_rel_track + cpm_offset
	mov	cl,HDLB_nheads[si]		;ibm_cyl= ibm_track/nheads
	  xor dx,dx ! div cx			;CAUTION!! 16 bit result
	  mov	IBM_cylinder[bx],ax
	  mov	IBM_head[bx],dl			;ibm_head=ibm_track % nheads
	mov	ax,HDLB_map_spb[si]		;set transfer length
	  shr ax,1 ! shr ax,1
	  mov IBM_count[bx],al
	ret

eject
;	writes with verify according to passed IOPB
;	entry:	DS:BX--> IOPB
;	note that our verify buffer must be in our caller's ESEG
gdk_write_unmapped:
	mov	IBM_fn[bx],IBM_WRITEF		;set write function code
	call	hd_rom				;do the write
	  or	al,al
	  jnz	hd_wr_buffer_exit		;and exit here if it fails
;
	push	IBM_xfer_ofs[bx]		;else save buffer pointer
	mov IBM_xfer_ofs[bx],offset hd_vfy_buffer ;point to our own buffer
	mov	IBM_fn[bx],IBM_READF		;change opcode to a read
	call	hd_rom				;and read it back
	  pop	IBM_xfer_ofs[bx]		;restore old buffer pointer
	  or	al,al				;did read-after-write  fail?
	  jnz	hd_wr_buffer_exit		;yes, no point in comparing
;
	push ds ! push es			;else compare buffers
	  les	di,IBM_XFER_PTR[bx]
	  mov	si,offset hd_vfy_buffer		;in our dseg
	  mov	ch,IBM_count[bx]		;get length in words
	  mov ax,es ! mov ds,ax
	  xor	cl,cl
	  cld
	  repe cmpsw
	  pop	es ! pop ds
	mov	al,0				;assume success
	  je	hd_wr_buffer_exit		;if matched, exit
	  mov	al,0ffh
hd_wr_buffer_exit:
	ret

eject
;	provides easy access to HDISK ROM
;	call with ds:bx--> IBM_iopb structure as defined elsewhere
;	returns zero set if succeeds, else non-zero
;	CALLS:	hd_error_handler
hd_rom:
	push es ! push si		;save uda and HDINF_ptr then execute
	mov	cx,DISK_RETRIES		;set retry count
;
hd_rom_retry:				;inner retry loop
	push cx ! push bx		;save retry counter & IOPB
	mov	ah,IBM_fn[bx]
	  mov	al,IBM_count[bx]	;load up registers for ROM call
	  mov	dh,IBM_head[bx]
	  mov	dl,IBM_lun[bx]
	    or dl,80h			;Next ANSI hard disk command standard!!
	  mov	cx,IBM_cylinder[bx]	; SCRewed-Up Microcomputer
	    xchg ch,cl			;  Parameter Interface - SCRUMPI ?
	    ror cl,1 ! ror cl,1		; (SERIOUSLY now, why would anyone do
	    and	cl,0c0h			;  something this way?)
	    or	cl,IBM_sector[bx]
	les	bx,IBM_XFER_PTR[bx]
	pushf ! callf HD_ROM_ENTRY	;fake an SWI call to ROM
	pop bx ! pop cx			;restore IOPB ptr and retry counter
;
	mov	IBM_errcode[bx],ah	;save error return
	mov al,0 ! jnc hd_rom1		;and exit if no error
;
	cmp	IBM_errcode[bx],IBM_BADTRACK_ERR	;skip retries on
	jz	hd_rom_err				; tracks fmt'd bad.
;
	push cx ! push bx !		;reset drive on any error ??
	  mov ah,IBM_RESETF		;registers are still ok
	pushf ! callf HD_ROM_ENTRY
	  pop bx ! pop cx
	loop	hd_rom_retry		;then try automatic retries first
;
hd_rom_err:
	mov	al,0ffh			;else get error code back and exit
hd_rom1:				;result shold be in al here
	pop si ! pop es
hd_rom_done:
	ret				;else return to caller



eject
;	handles cold start setup for XT hard disk driver
;	set up interrupt vector and save os type flag
;	entry:	al=0 if cp/m-86 else nz
;	exit:	al=0 if valid os, else nz
INIT_DISKIO:
	or	al,al				;0 means don't set ccpm flag
	  jz	init_diskio1
	    mov	al,0ffh				;else do ccp/m mode
init_diskio1:
	mov	is_ccpm,al	
;
	push es ! xor ax,ax ! mov es,ax		;point to vector segment
;
	mov	al,hd_control_byte		;turn fast step option off
	  mov	old_control_byte,al
	and	al,11111000b or (not SLOW_SEEK)
	  mov	hd_control_byte,al
;
	test is_ccpm,1 ! jz init_for_cpm		;get rom BIOS entry
;
	  push ds					;from XIOS if CCPM
	  mov cl,156 ! int 224 ! mov es,es:10h[bx]		;ES--> UDA
	  push es ! mov cl,154 ! int 224 ! push es ! pop ds	;DS-->SYSDAT
	  pop es ! mov cx,1 ! mov al,14 ! callf dword ptr .28h	;XIOS getptr fn
	  les cx,[bx] ! mov dx,es	 			;es:cx->ROM ptr
	  pop ds ! jmps save_rom_addr
;
init_for_cpm:
	les cx,HD_PTR				;if cp/m get addr from int vctr
	mov dx,es
save_rom_addr:
	mov hd_rom_ofs,cx			;in either case save it for use
	mov hd_rom_seg,dx
	xor al,al
hd_init_done:
	pop es ! ret

;	called by gdk before program exits
RESTORE_DISKIO:
	push	es
	xor	ax,ax
	mov	es,ax				;point to vector segment
	mov	al,old_control_byte		;restore original step rate
	mov	hd_control_byte,al
	pop	es

	mov	ah,IBM_RESETF
	mov	dl,80h
	pushf ! callf HD_ROM_ENTRY

	ret	

eject
;	XT hard disk driver data segment
	DSEG
	org	dseg_save

;	misc variables
old_control_byte	db	0
is_ccpm			db	0

;	iopbs used to do ROM BIOS IO
;	CAUTION: these are only templates, it is the user's responsibility
;	to make sure they are FULLY filled in with meaningful information

hd_wr_label_iopb	db	IBM_WRITEF,0,0,0	;fn,err,lun,head
			dw	0			;cylinder
			db	LABEL_SCTR,1		;sector,count
			dw	0,0			;xfer offset,seg

hd_rd_label_iopb	db	IBM_READF,0,0,0		;fn,err,lun,head
			dw	0			;cylinder
			db	LABEL_SCTR,1		;sector, count
			dw	0,0			;xfer offset,seg

hd_wr_block_iopb	db	IBM_WRITEF,0,0,0	;fn,err,lun,head
			dw	0			;cylinder
			db	0,4			;sector,count
			dw	0,0			;xfer offset,seg

hd_rd_block_iopb	db	IBM_READF,0,0,0		;fn,err,lun,head
			dw	0			;cylinder
			db	0,4			;sector, count
			dw	0,0			;xfer offset,seg

hd_wr_partition_iopb	db	IBM_WRITEF,0,0,0	;fn,err,lun,head
			dw	0			;cylinder
			db	PTABLE_SCTR,1		;sector,count
			dw	0,0			;xfer offset,seg

hd_rd_partition_iopb	db	IBM_READF,0,0,PTABLE_HEAD ;fn,err,lun,head
			dw	PTABLE_CYL		;cylinder
			db	PTABLE_SCTR,1		;sector,count
			dw	0,0			;xfer offset,seg

hd_wr_system_iopb	db	IBM_WRITEF,0,0,0	;fn,err,lun,head
			dw	0			;cylinder
			db	SYS_START,SYS_SIZE	;sector,count
			dw	0,0			;xfer offset,seg

hd_rd_system_iopb	db	IBM_READF,0,0,0		;fn,err,lun,head
			dw	0			;cylinder
			db	SYS_START,SYS_SIZE	;sector,count
			dw	0,0			;xfer offset,seg

;	pointer to ROS interrupt entry for xt hard disk
hd_rom_ofs	rw	1
hd_rom_seg	rw	1
HD_ROM_ENTRY equ dword ptr hd_rom_ofs

eject
	ESEG $

	org	offset $+1 and 0fffeh		;word align them
;	BUFFER DECLARATIONS FOR XT HARD DISK
;hd_vfy_buffer	rb	17 * 512		;as large as largest write
hd_vfy_buffer	equ	verify_buffer		;use vfy_buffer defined in main
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀