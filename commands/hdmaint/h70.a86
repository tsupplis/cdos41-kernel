
      pagesize 72 ! pagewidth 128 ! title 'Hard Disk Utility Program 2.0'
;******************************************************************************
;******************************************************************************
;**									     **
;**	HDMAINT Multi-Function Hard disk UTILITY			     **
;**									     **
;**	For the IBM PC-XT and look-alikes using an XT compatible	     **
;**	hard disk ROM BIOS under Concurrent CP/M version 3.1		     **
;**									     **
;**	1984-08-31  Latest Revision					     **
;**									     **
;**	Copyright (C) 1983,1984 Digital Research			     **
;**									     **
;******************************************************************************
;******************************************************************************
;
; MODIFICATION HISTORY:
;
;1983-05-31	by G.DeKoning and M.Vano of VANO ASSOCIATES, INC.
;		1.0 pre-release version written.
;
;1983-06-08	by G.DeKoning of VANO ASSOCIATES, INC.
;		Source file cleanup for 1.0 release added comments, and
;		installation of bug fixes and enhancements.  One obscure bug
;		remained re freespace table:
;
;		  Table is not adjusted when a bad system area cyl found.
;		  This has no effect if the start cyl can be moved up 1 or 2
;		  cyl to retry. However, if that makes the proposed partition
;		  too small, a new default start & end are calculated.  There
;		  is nothing to prevent the same starting cylinder from
;		  reappearing.  The user can however avoid using the bad cyls.
;
;1983-12-01	by Dean Ballard Modified for CCP/M version 3.1
;		This version calls itself version 1.1
;		-bugs found after release but not yet corrected:
;		  -Verify abort frame is not properly erased
;		  -fatal error handler prints garbage on status line due to
;		   incorrect emulation of back door xios calls in new XIOS.
;
;1984-4-10	by M.P. Vano of VANO ASSOCIATES, INC
;		Version 2.0: total re-write for SQUID II PCDOS Support:
;		    -Now uses a Codemacro based menu interpreter
;		    -Debug mode supports screen printing
;		    -PC-DOS volume support including loader/boot added
;		    -disk label support added
;		    -simple Shell interface added
;		    -reboot not forced till all done from main menu
;		    -major program cleanup and re-structuring done
;		    -support for disks up to 32 MB (both CCPM and DOS)
;		    -patchable switches for removable disks, and fast test
;		    -English messages moved to an included file
;		    -CCPM 3.x only now (uses bdos 2 con io and new XIOS entry)
;		    -BDOS 3.0 based loader for volumes > 8mb
;		    -Known bugs corrected
;1984-07-20	    -Revised to change Exit keys to ESC by M.P. Vano
;1984-08-06	    -Revised by M.P. Vano to:
;			o fix display bug in get partition size menu
;			o add error message for attempts to use remotely
;			o fix error in files_open preventing use with >8 drives
;			o Program banner revised per latest OS naming
;			o Program version displayed is now considered "3.2"
;			o Added internal ACTUAL PROGRAM version field to header
;1984-08-29	    -Partition rel sect size too high bug fixed by M.P. Vano
;1984-08-31	    -Modified to show DOS type 4 partitions in displays as
;			"DOS 3 only" blinking by M.P. Vano
eject
;******************************************************************************
;
;		Creating HDMAINT.CMD
;1984-06-12
;******************************************************************************
;
;1. Source is usually called HDROOT.A86, it needs the include libraries listed
;   at the of this source module.  They're described in the include statements.
;
;2. The generated loaders are assumed to be collected in the file LOADERS.BIN.
;   This file is the concatenation of the primary boot, CP/M secondary boot,
;   (2 copies), SETUP sector (all zeroes), default CP/M physical label sector
;   (ID STRING ONLY), CP/M tertiary loader, DOS secondary loader (280h),
;   and the DOS tertiary loader.
;
;3. To create HDMAINT, it is necessary to follow these steps:
;
;	3.1	Assemble HDROOT.A86
;
;	3.2	GENCMD HDROOT DATA[mxxx] EXTRA[M0800]
;		(xxx is determined from the value of symbol .dataseg_end / 16)
;		it is typically about 800 paragraphs.
;
;	3.3	use SID to merge HDROOT.CMD with the loaders.
;
;		The loader offsets are as follows:
;
;		DS:DEFAULTXTLBL  +--------------------------------+  0000  hex
;				 | Primary Loader/Partition table |
;				 +--------------------------------+  0200
;		DS:DEFAULTCPM	 | CP/M secondary Loader (copy 1) |
;				 +--------------------------------+  0400
;				 | CP/M secondary Loader (copy 2) |
;				 +--------------------------------+  0600
;				 | Default SETUP sector (all 0)   |
;				 +--------------------------------+  0800
;				 | CP/M label ((C) note only)     |
;				 +--------------------------------+  0A00
;				 |  CP/M tertiary loader          |
;				 +--------------------------------+  2200
;				 | DOS Secondary loader		  |
;				 +--------------------------------+  2400
;				 | 128 bytes of 0 (from GENCMD)   |
;				 +--------------------------------+  2480
;				 | DOS tertiary loader            |
;				 +--------------------------------+  2C00
;
;	Most of these objects are tagged by dummy strings describing them
;	to assist confirming their locations in the DSEG.
;
eject
;	Here is a WINDOW DUMP of one such merge session with notes added.
;
;	Once HDROOT.A86 has been assembled the following steps are needed
;	to convert it into an executable HDMAINT.CMD.  These steps assume
;	That you have already constructed a binary file containing all of
;	the Loader images called LOADERS.BIN.  That file should contain
;	(at proper offsets): PCBOOT1.BIN, CPMBOOT2.BIN, CPMBOOT2.BIN,
;	SETUP.BIN, LABEL.BIN, CPMBOOT3.BIN, PCBOOT2.BIN,PCBOOT3.BIN.
;	If properly constructed, It should be EXACTLY 297fh bytes long.
;	Having this file in hand:
;
;			  +---Note that dseg minimum will vary with assembly
;			  |   If in doubt, look at value of .dsegend with SID.
;			  |   This is done manually to minimize load module
;			  |   size.  It saves about 12k on the disk.
;12C>gencmd hdroot data[m800] extra[m800]
;13:02:04 C:GENCMD.CMD (User 0)
;
;BYTES READ    50E4
;RECORDS WRITTEN 01
;
;
;12C>sid *hdroot
;13:02:47 C:SID.CMD (User 0)
;SID86 1.0
;SYMBOLS
;#rloaders.bin
;  START      END
;344F:0000 344F:297F			;NOTE THAT SEGS AND OFFSETS WILL VARY
;#rhdroot.cmd				;BUT YOU MUST DUPLICATE THOSE YOU SEE
;  START      END			;IN THE COMMANDS THAT FOLLOW.
;36E7:0000 36E7:807F
;#sw1					;If you don't see this here, you have
;36E7:0001 0344 .			;done something wrong---+
;#d80+.patch0+3440,+0f						|
;36E7:4E20 58 54 4C 42 4C 20 44 45 46 41 55 4C 54 20 46 49 XTLBL DEFAULT FI
;#m344f:0,297f,36e7:4e20
;#wHDMAINT.CMD
;#^C
;12C>
;	You now should have HDMAINT ready to test and run.
;
;	HINT:  The first thing you should try is any function that displays
;		a partition table (such as create/display/delete).  If you
;		find that existing CP/M partitions display a blinking
;		message warning you that cp/m is defective, This means that
;		you have not properly merged the loaders.  The message is
;		generated by the system on disk's ID string in the cp/m label
;		failing to match the template label in "LABEL.BIN" which you
;		supposedly merged above.  DO NOT PROCEED any further, instead
;		reboot and examine the HDMAINT image with SID to find out
;		what you did wrong either in concatenating the loaders or in
;		merging them with HDROOT.
eject
;	INCLUDE ALL NEEDED SOURCE MODULES
;	(NOTE that the ordering of some modules is critical for the following
;	reasons:	-Some definitions have forward reference problems.
;		        -It is desirable to minimize object module load size
;			 by grouping uninitialized data at the end of DSEG.
;			-It is desired that some code/data areas be accessible
;			 at fixed addresses for field patches.
;	Aside from these concerns, there is no position dependent code.
DEBUG_MODE	equ	00	;set this true to enable fast formatter mode
				;and screen printer for debugging

;	CONSTANT AND DATA DEFINITION LIBRARIES
 include hddef1.lib		;global definitions part 1
 include hdxtdefs.lib		;XT partition table and cpm label definitions
 include hddef2.lib		;global definitions part 2
 include menubol.def		;Menu interpreter library codemacros

	ESEG			;beginning of running ESEG definitions
 include hdeseg.lib		;eseg buffer definitions used for disk IO

	DSEG			;beginning of running DSEG definitions
 include hddseg1.lib		;global data part 1 base page & public switches
 include hdtext.lib		;language dependent messages
 include hddseg2.lib		;global data part 2 and loader buffers

	CSEG			;Beginning of CODE GENERATION
	org	0

; PROGRAM HIGH LEVEL ROUTINES
 include hdmain.lib		;mainline, init, exit and MAIN MENU code
				;and their support routines
; PROGRAM SECOND LEVEL FUNCTIONS
 include hdpmaint.lib		;create/delete functions
 include hdboot.lib		;bootstrap option functions
 include hdoption.lib		;cpm options and cpm/dos name functions
 include hdverify.lib		;verify partition functions
;
; PROGRAM SUPPORT SUBROUTINES
 include hdutil1.lib		;misc. subroutines
 include hdcpmlib.lib		;cpm related subroutines
 include hddoslib.lib		;dos related subroutines
 include hdptutil.lib		;partition table utility routines
 include hdlogin.lib		;disk information login support library
 include hdiskio.lib		;hard disk access routines
 include menubol.lib		;menu interpreter code and constant data

;  These must be declared last to reduce load module size
 include hdbuff.lib		;uninitialized dseg buffers

	end
