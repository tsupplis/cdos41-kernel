eject
;	HDBOOT.LIB include file for HDMAINT 2.0 as of 20-Jul-84
;	revised 20-Jul-84 to make ESC exit key by M.P. Vano
	cseg $

;==============================================================================
; LEVEL 2 |
;---------
;	DISPLAY/CHANGE BOOTSTRAP OPTIONS
;	normally called by main menu
;
;==============================================================================
BOOT_OPTIONS:
	XMCALL disk0					;always first hard disk
BOOT_OPTIONS_AGAIN:
	XCLRBOX 1,3,77,22
	XCALL SHOW_PM_STATUS				;show info summary
	XBRIGHT ! XPUTS_AT 32,10,bootopt0_msg ! XDIM	;show prompt
;
	XSETW keymask,F_ESC+F2				;exit and change always
	XKBOX_MSG 20,11,2,bootopt1_msg
	XJE WORK_cpmexists,0,BOOT_OPTIONS1		;any cpm on this disk?
	  XKBOX_MSG 20,14,4,bootopt2_msg
	  XADDW keymask,F4
BOOT_OPTIONS1:
	XJE WORK_dosexists,0,BOOT_OPTIONS2		;any DOS on this disk?
	  XKBOX_MSG 20,17,6,bootopt3_msg
	  XADDW keymask,F6
BOOT_OPTIONS2:
	XKBOX_MSG 20,20,0,bootopt4_msg			;exit always ok
;
	XKEYCASE keymask
	  dw	BOOT_OPTIONS_EXIT	;ESC=return to main menu
	  dw	0,BOOTABLE		;F2=set bootable partition
	  dw	0,CPM_LOADER		;F4=write loader to cp/m partition
	  dw	0,DOS_LOADER		;F6=write loader to DOS partition
	  dw	0,0
	  dw	0,0

	XRET				;to caller (main menu usually)

BOOT_OPTIONS_EXIT:
	XPOP ! XJMP MAIN_MENU		;straight to main menu always

eject
;==============================================================================
;	Subroutine writes a cp/m loader to first hard disk cp/m partition
;	(preserving any "SETUP" info in the third sector of the track)
;==============================================================================
CPM_LOADER:
	XCLRBOX 1,8,77,22
;
	XPUTS_AT 10,10,chboot0_msg			;ccpm.sys file copy
	XPUTS_AT 10,11,chboot1_msg			;message
	XPUTS_AT 10,12,chboot2_msg
;
	XPUTS_AT 20,15,chboot6_msg			;writing loader message
	XSTOP
	mov es,esbase ! mov bx,offset cpm_buffer	;read old system first
	mov cx,WORK_pstart ! mov dl,WORK_disk ! sub dh,dh ; (low level read)
	call read_cpm_system ! or al,al ! jz cpm_loader0
	  mov hd_error,HD_ERR_RCPM ! jmp main_menu86	;fatal if can't
cpm_loader0:
	push ds						;copy old setup sector
	push ds ! pop es ! mov di,offset default_cpm+400h
	mov ds,esbase ! mov si,offset cpm_buffer +400h	;to our new cpm track
	cld ! mov cx,512/2 ! rep movsw
	pop ds
;
	call put_cpm_system ! or al,al ! jz cpm_loader1	;write out new system
	  mov hd_error,HD_ERR_WCPM ! jmp main_menu86	;fatal if can't
cpm_loader1:
	cld ! push ds ! pop es
	mov di,offset default_cpm+400h			;restore default cpm
	mov cx,512/2 ! sub ax,ax ! rep stosw		;  setup sector
;
	mov al,HD_SYS_ID ! call loader_set_boot		;only returns if works
	call MENU_BOL
	XPUTS_AT 25,17,chboot8_msg			;print success message
	XCALL LOADER_WFKEY				;all done, wait
	XRET						;then back to caller

eject
;==============================================================================
;	Subroutine writes a  cp/m loader to first hard disk DOS partition
;==============================================================================
DOS_LOADER:
	XCLRBOX 1,8,77,22
	XPUTS_AT 10,10,chboot0_msg			;ccpm.sys file copy
	XPUTS_AT 10,11,chboot1_msg			;message
	XPUTS_AT 10,12,chboot2_msg
;
	XPUTS_AT 20,15,chboot7_msg			;writing loader message
	XSTOP
	call dos_calc_partition				;update bt record entry
	call dos_ok_to_putsys				;get/check dir entry
	or al,al ! jz dos_loader10			;physical error?
	  mov hd_error,HD_ERR_RCPM ! jmp main_menu86	;yes, fatal, exit
dos_loader10:
	cmp bx,0 ! jne dos_loader13			;logical error?
	  jmp dos_loader15				;else go do it
dos_loader13:
	mov loader_errcode,bl
	call MENU_BOL
	XPUTS_AT 8,17,chboot9_msg
	XJNE loader_errcode,1,DOS_LOADER_ERR2		;no space?
	  XPUTS_AT 12,18,chboot10_msg			;show no space message
	  XJMP DOS_LOADER_OOPS				;go wait for operator
DOS_LOADER_ERR2:
	XPUTS_AT 10,18,chboot11_msg			;else file alias msg
	XJMP DOS_LOADER_OOPS				;go wait for operator

;	else it is ok to write system files
dos_loader15:
	call dos_write_sys_only ! or al,al ! jz dos_loader20
	  jmp dos_loader_wr_err
dos_loader20:
	call dos_build_boot				;update boot sector
	call dos_put_boot ! or al,al ! jz dos_loader30	;write it out
	  jmp dos_loader_wr_err
dos_loader30:
	push ds ! pop es ! mov si,offset dribio_fcb	;rename bios file
	cld ! mov di,offset dir_buffer
	mov cx,26 ! rep movsb				;all except start/size
	
;
	mov di,offset dirbuffer+32
	push di ! mov si,offset ibmdos_fcb
	mov cx,11 ! repe cmpsb ! je dos_loader35	;dos ibmdos exist?

	  pop di ! push di ! mov si,offset dridos_fcb	;no, does dridos exist?
	  mov cx,11 ! repe cmpsb ! jne dos_loader38	;no, skip second rename
;
dos_loader35:
	pop di ! push di ! mov si,offset dridos_fcb	;else rename dos file
	mov cx,26 ! rep movsb				;(all but start/size)
;
dos_loader38:
	pop di
	mov cx,0 ! call write_dos_dirsector
	or al,al ! jz dos_loader40
	  jmp dos_loader_wr_err
dos_loader40:
	mov al,1 ! call loader_set_boot			;only returns if works
	call MENU_BOL
;
DOS_LOADER_OK:
	XPUTS_AT 25,17,chboot8_msg			;print success message
;
DOS_LOADER_OOPS:
	XCALL LOADER_WFKEY
	XRET

dos_loader_wr_err:
	mov hd_error,HD_ERR_WCPM ! jmp main_menu86	;fatal if can't write

eject
;	subroutines used by both loader write operations

;==============================================================================
;	common exit subroutine just waits for the exit key
;==============================================================================
LOADER_WFKEY:
	XCALL SHOW_PM_STATUS			;show new partition state
	XKBOX_MSG 20,20,0,bootopt4_msg		;prompt
	XSETW keymask,F_ESC
	XCALL WAIT_KEYMASK_KEY			;go wait for exit key
	XRET					;then return

;------------------------------------------------------------------------------
;	subroutine used to set passed partition bootable and update pt
;------------------------------------------------------------------------------
loader_set_boot:
	mov si,offset WORK_xtlbl ! call pt_set_active
	call put_partition_table ! or al,al ! jz loader_set_boot1
	  mov hd_error,HD_ERR_WPT ! jmp main_menu_86	;fatal if can't write
loader_set_boot1:
	ret


	dseg $
loader_err_code	db	0		;local used to talk to menu routines
	cseg $
eject
;==============================================================================
; LEVEL 2 |
;---------
;		Change bootable partition MENU SEQUENCE
;
;==============================================================================
BOOTABLE:
	XCLRBOX 1,9,77,22			;clear lower part of screen
	XPUTS_AT 10,10,chboot0_msg
	XPUTS_AT 10,11,chboot1_msg
	XPUTS_AT 10,12,chboot2_msg
	XBRIGHT ! XPUTS_AT 32,15,chboot3_msg ! XDIM
;
	XKBOX_MSG 20,17,1,chboot4_msg
	XKBOX_MSG 20,20,0,chboot5_msg
;
BOOTABLE_LOOP:
	XCALL SHOW_PM_STATUS			;show current status 
	XSETW keymask,F_ESC + F1
	XKEYCASE keymask
	  dw	EXIT_BOOT			;ESC is exit key
	  dw	0,0				;F1 (falls through)
	  dw	0,0
	  dw	0,0
	  dw	0,0
	  dw	0,0

	XMCALL set_next_boot			;until F9
	XJMP BOOTABLE_LOOP


EXIT_BOOT:
	XPOP ! XSTOP						;won't return
	call put_partition_table ! or al,al ! jz exit_boot_ok	;write out PT
	  mov hd_error,HD_ERR_WPT ! jmp main_menu86		;OOPS, failed
exit_boot_ok:
	call MENU_BOL ! XRET			;and return to our caller

eject
;------------------------------------------------------------------------------
;	subroutine called by above to rotate bootable partition through table
;------------------------------------------------------------------------------
set_next_boot:
	mov bx,offset WORK_part1 ! mov cx,4	;find bootable partition 
	mov dx,XT_PT_REC_SIZE
;
chng_boot_looking:
	cmp XT_PT_bootfl[bx],80h ! je chng_boot_found
	  add bx,dx ! loop chng_boot_looking
	    mov bx,offset WORK_part1 ! jmps chng_boot_gotoit ;none found,set #1
;
chng_boot_found:
	mov XT_PT_bootfl[bx],0			;else clear current one
	dec cx ! jcxz set_next_boot_ret		;if last, leave none bootable
chng_boot_next:
	  add bx,dx				;else, mark NEXT bootable
	  cmp XT_PT_system[bx],0 ! jne chng_boot_gotoit	;if it exists only
	    loop chng_boot_next			;else try next one
set_next_boot_ret:
	 ret					;leave if it was the last

;
chng_boot_gotoit:				;set current partition bootable
	mov XT_PT_bootfl[bx],80h ! ret		;and return
