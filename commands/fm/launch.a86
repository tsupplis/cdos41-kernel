        title 'FM - local Concurrent DOS 4.1 native launch bridge'
;*****************************************************************************
; DRI C small-model near ABI. Preserve BP/SI/DI/DS/ES on every public entry.
; Local authority: con/command.sup CLI, con/clicb.def (130 bytes),
; con/uda.fmt, batch/tmpmenu.lib priority+attach, batch/ifcmd.lib status.
; DOS kind 1 requires an exclusive launch context: no other open FCBs.
; FMDOSOWN reports transfer after version/FCB/context validation. Accepted
; attempts normalize ownership with DRV_FREE(FFFF), as the DOS loader does.
; A protected direct-child walk prevents cleanup of a live DOS arena. A
; detached child receives the console by exact-PD assignment under the
; thread lock; function 149 consumes that lock. No ancestor handoff gap.
; Native CLI owns its own executable FCB and restores its disk/user/DMA.
; We additionally restore caller state explicitly after console reacquisition.
; Console attach is not waitpid: a child may detach before terminating.
;*****************************************************************************
        public FMLAUNCH,FMEXIT,FMLERROR,FMORDER,FMSYSDISK,FMDOSOWN
        dseg
        db 0 ; keep CLI pointer nonzero even if this is first data module
clibuf  rb 134
status  dw 0ffffh
lerror  dw 0ffffh
result  dw 0ffffh
oldprio dw 0
newprio dw 0
olddrv  dw 0
olduser dw 0
dmaoff  dw 0
dmaseg  dw 0
errmode dw 0
multcnt dw 1
gateway dw 3,0
dosown  dw 0
doscall dw 0
saved   dw 0
kind    dw 0
sysseg  dw 0
udaseg  dw 0
selfpd  dw 0
sysgate dw 0,0
walkmode dw 0
walkret dw 0
seenpd  dw 0
oldcon  dw 0
dospkt  dw 0,0,0,0
        db 0
acb     db 0,1
        dw 0
        rb 8
        cseg
FMEXIT:
        mov ax,status
        ret
FMLERROR:
        mov ax,lerror
        ret
FMDOSOWN:
        mov ax,dosown
        ret
FMLAUNCH:
        push bp
        mov bp,sp
        push si
        push di
        push ds
        push es
        mov status,0ffffh
        mov lerror,0ffffh
        mov result,0ffffh
        mov dosown,0
        mov doscall,0
        mov saved,0
        mov ax,6[bp]
        mov kind,ax
        cmp ax,1
        jbe launch_version
        jmp launch_done
launch_kind:
        cmp kind,1
        jne launch_input
        mov ax,8[bp]
        or ax,ax
        jnz longok1
        jmp launch_invalid
longok1:
        cmp ax,0ffdch
        jbe longok4
        jmp launch_invalid
longok4:
        mov dosown,1
launch_input:
        mov si,4[bp]
        or si,si
        jnz launch_buffer
        jmp launch_invalid
launch_buffer:
        push ds
        pop es
        mov di,offset clibuf
        mov cx,134
        xor ax,ax
        cld
        rep stosb
        mov di,offset clibuf+1
        mov cx,128
launch_copy:
        lodsb
        or al,al
        jz launch_text
        or si,si
        jnz launch_char
        jmp launch_invalid
launch_char:
        stosb
        loop launch_copy
        jmp launch_invalid
launch_text:
        cmp byte ptr clibuf+1,0
        je longok7
        jmp launch_checked
longok7:
        jmp launch_invalid
launch_version:
        mov cx,12
        call oscall
        cmp ax,1441h
        je launch_pd
        jmp launch_done
launch_pd:
        mov cx,156
        call pdcall
        mov ax,es
        or ax,ax
        jnz launch_pdseg
        jmp launch_done
launch_pdseg:
        or bx,bx
        jz launch_badpd
        cmp bx,0ffe0h
        ja launch_badpd
        mov selfpd,bx
        mov sysseg,es
        xor ax,ax
        mov al,es:5[bx]
        mov oldprio,ax
        mov dx,es:10h[bx]
        mov udaseg,dx
        or dx,dx
        jz launch_badpd
        mov bx,es:1eh[bx]
        mov ax,197
        or bx,bx
        jz launch_clamp
        cmp bx,0fffah
        ja launch_badpd
        xor ax,ax
        mov al,es:5[bx]
        dec ax
launch_clamp:
        cmp ax,64
        jge launch_max
        mov ax,64
launch_max:
        cmp ax,197
        jle launch_uda
        mov ax,197
launch_uda:
        mov newprio,ax
        mov es,dx
        xor bx,bx
        mov ax,es:2[bx]
        mov dmaoff,ax
        mov ax,es:4[bx]
        mov dmaseg,ax
        xor ax,ax
        mov al,es:16[bx]
        mov errmode,ax
        mov al,es:17[bx]
        mov multcnt,ax
        jmp launch_save
launch_badpd:
        jmp launch_done
launch_save:
        mov cx,25
        call oscall
        and ax,255
        mov olddrv,ax
        mov cx,32
        mov dx,255
        call oscall
        and ax,255
        mov olduser,ax
        mov cx,153
        call oscall
        and ax,255
        mov oldcon,ax
        mov saved,1
        jmp launch_kind
launch_checked:
        cmp kind,1
        jne launch_priority
        call findtmp
        or ax,ax
        jnz longok2
        jmp launch_invalid
longok2:
        mov es,sysseg
        xor bx,bx
        mov ax,es:[bx]
        cmp ax,3
        je longok5
        jmp launch_invalid
longok5:
        mov sysgate,ax
        mov ax,es:2[bx]
        or ax,ax
        jnz longok3
        jmp launch_invalid
longok3:
        mov sysgate+2,ax
        mov walkmode,0
        call children
        or ax,ax
        jz longok6
        jmp launch_invalid
longok6:
launch_priority:
        mov dx,newprio
        mov cx,145
        call oscall
        cmp kind,1
        je launch_dos
        mov dx,offset clibuf
        mov cx,150
        call oscall
        or bx,bx
        jnz launch_failed
        xor dx,dx
        mov cx,146
        call oscall
        or bx,bx
        jnz launch_failed
        mov dx,0ffffh
        mov cx,108
        call oscall
        mov status,ax
        mov lerror,0
        mov result,0
        jmp launch_finish
launch_dos:
        mov ax,8[bp]
        mov dospkt,ax
        mov dospkt+2,ds
        mov dospkt+4,offset clibuf
        mov dospkt+6,ds
        mov byte ptr dospkt+8,0
        mov doscall,1
        mov dx,offset dospkt
        mov cx,1
        call pccall
        or bx,bx
        jnz launch_failed
        mov result,0
        mov lerror,0
        xor dx,dx
        mov cx,146
        call oscall
        or bx,bx
        jnz launch_failed
        jmp launch_finish
launch_invalid:
        mov lerror,0ffffh
        jmp launch_finish
launch_failed:
        mov lerror,cx
        mov result,0ffffh
launch_finish:
        cmp doscall,0
        je launch_release
        mov walkmode,1
launch_wait:
        call children
        or ax,ax
        jz launch_completed
        cmp ax,2
        jne launch_delay
        xor dx,dx
        mov cx,146
        call oscall
        jmp launch_wait
launch_delay:
        mov dx,1
        mov cx,141
        call oscall
        jmp launch_wait
launch_completed:
        cmp result,0
        jne launch_release
        mov cx,11
        call pccall
        mov status,ax
launch_release:
        cmp dosown,0
        je launch_cleanup
        mov dx,0ffffh
        mov cx,39
        call oscall
launch_cleanup:
        cmp doscall,0
        je launch_restoring
        xor cx,cx
        call pccall
launch_restoring:
        cmp saved,0
        jne launch_restore
        jmp launch_done
launch_restore:
        mov dx,olddrv
        mov cx,14
        call oscall
        mov dx,olduser
        mov cx,32
        call oscall
        mov dx,dmaseg
        mov cx,51
        call oscall
        mov dx,dmaoff
        mov cx,26
        call oscall
        mov dx,errmode
        mov cx,45
        call oscall
        mov dx,multcnt
        mov cx,44
        call oscall
        mov dx,oldprio
        mov cx,145
        call oscall
launch_done:
        mov ax,result
        cld
        pop es
        pop ds
        pop di
        pop si
        pop bp
        ret
; PCTmp far calls return AX/BX status and CX loader error; preserve C state.
pccall:
        push bp
        push si
        push di
        push ds
        push es
        cld
        callf dword ptr gateway
        pop es
        pop ds
        pop di
        pop si
        pop bp
        ret
; Supervisor module entry accepts ES=UDA, DS=caller data. Its dispatcher
; saves this SS:SP before sleeping; no private user-stack emulation needed.
kcall:
        push bp
        push si
        push di
        push ds
        push es
        mov es,udaseg
        callf dword ptr sysgate
        pop es
        pop ds
        pop di
        pop si
        pop bp
        ret
; Return 0=no direct children, 1=present, 2=exact child assigned console,
; FFFF=malformed list. Before launch reject anything but 0. After launch
; never clean up on malformed state: release lock, delay, and inspect again.
; SYSDAT 72h thread root/AAh lock from local sysdat.dat and sup.sym.
children:
        mov walkret,0ffffh
        mov seenpd,0
        mov bx,0aah
        mov cx,0215h
        call kcall
        mov es,sysseg
        mov bx,0ach
        mov ax,es:[bx]
        cmp ax,selfpd
        jne child_unlock
        mov bx,72h
        mov bx,es:[bx]
        mov di,1024
child_next:
        or bx,bx
        jz child_none
        cmp bx,0ffe0h
        ja child_unlock
        cmp bx,selfpd
        jne child_parent
        mov seenpd,1
child_parent:
        mov ax,es:1eh[bx]
        cmp ax,selfpd
        je child_found
        mov bx,es:2[bx]
        dec di
        jnz child_next
        jmps child_unlock
child_none:
        cmp seenpd,0
        je child_unlock
        mov walkret,0
        jmps child_unlock
child_found:
        cmp bx,selfpd
        je child_unlock
        mov walkret,1
        cmp walkmode,0
        je child_unlock
        mov ax,oldcon
        cmp al,es:20h[bx]
        jne child_unlock
        mov acb,al
        mov word ptr acb+2,bx
        mov dx,offset acb
        mov cx,149
        ; 149 re-enters the owned lock, verifies PD while dispatch is
        ; inhibited, and releases it on EVERY success/error exit. Thus no
        ; unlock/recycle window exists between parent check and assignment.
        call oscall
        or bx,bx
        jnz child_return
        mov walkret,2
child_return:
        mov ax,walkret
        ret
child_unlock:
        mov bx,0aah
        mov cx,0216h
        call kcall
        jmp child_return
; BDOS output AX/BX/CX/DX survives. Registers required by the C ABI do not.
oscall:
        push es
        call pdcall
        pop es
        ret
pdcall:
        push bp
        push si
        push di
        push ds
        int 0e0h
        pop ds
        pop di
        pop si
        pop bp
        ret
; Exact CDOS gate and bounded parent walk, as BATCH's PCTmp discovery.
; Returns AX=1 and sets gateway, otherwise AX=0. ES/BX are scratch.
findtmp:
        mov cx,12
        call oscall
        cmp ax,1441h
        jne tmp_bad
        mov cx,156
        call pdcall
        mov ax,es
        or ax,ax
        jz tmp_bad
        mov di,64
tmp_loop:
        or bx,bx
        jz tmp_bad
        cmp bx,0ffe0h
        ja tmp_bad
        cmp es:word ptr 8[bx],4350h
        jne tmp_next
        cmp es:word ptr 10[bx],6d54h
        jne tmp_next
        cmp es:byte ptr 12[bx],70h
        je tmp_found
tmp_next:
        mov bx,es:1eh[bx]
        dec di
        jnz tmp_loop
tmp_bad:
        xor ax,ax
        ret
tmp_found:
        mov ax,es:10h[bx]
        or ax,ax
        jz tmp_bad
        mov es,ax
        mov bx,50h
        mov ax,es:[bx]
        or ax,ax
        jz tmp_bad
        mov gateway+2,ax
        mov ax,1
        ret
FMORDER:
        push bp
        mov bp,sp
        push si
        push di
        push ds
        push es
        mov si,4[bp]
        or si,si
        jz order_bad
        cmp si,0fff3h
        ja order_bad
        call findtmp
        or ax,ax
        jz order_bad
        mov byte ptr [si],1
        mov dx,si
        mov cx,6
        cld
        callf dword ptr gateway
        mov ax,bx
        jmps order_done
order_bad:
        mov ax,0ffffh
order_done:
        cld
        pop es
        pop ds
        pop di
        pop si
        pop bp
        ret
FMSYSDISK:
        push bp
        push si
        push di
        push ds
        push es
        mov cx,12
        call oscall
        cmp ax,1441h
        jne sys_bad
        mov cx,156
        call pdcall
        mov ax,es
        or ax,ax
        jz sys_bad
        xor ax,ax
        mov bx,9dh
        mov al,es:[bx]
        cmp ax,15
        ja sys_bad
        inc ax
        jmps sys_done
sys_bad:
        xor ax,ax
sys_done:
        pop es
        pop ds
        pop di
        pop si
        pop bp
        ret
        end
