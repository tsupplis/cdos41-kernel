;*****************************************************
;*
;*   NORG - Concurrent PC DOS National Setup Utility
;*   IBM PC release 4.11 (utility banner 4.1)
;*
;*****************************************************
;
; Usage: N opens the interactive national installation menus.
; NATIONAL.MSG supplies nine language catalogs and the translation tables.
; Save updates CCPM.SYS through its JW directory. Discard closes the menu.
;
; Frozen disassembly of the release command, including the linked small-model
; Digital Research C startup, terminal I/O, allocator and string library.
; Stack arguments follow the C calling convention. DS addresses program data.
; make check compares the complete 8,704-byte NORG.CMD against base/n.cmd.
; encodings.py verifies and restores 21 equivalent register encodings and
; the release data growth limit. The maintained C implementation is n.c.

; Absolute DATA aliases keep the original small-model addressing. The 128-byte
; command tail occupies the loader base page below the C globals.
keyboard_mode_flags      equ 0106h
device_index             equ 0112h
printer_capabilities     equ 0117h
model_message_ids        equ 011dh
frame_row                equ 019ch
language_order           equ 01a1h
catalog_record           equ 01c5h
records_remaining        equ 01c7h
message_filename         equ 0449h
os_result                equ 048ah
language_index           equ 048ch
messages_ready           equ 048eh
system_fcb               equ 0490h
fcb_random_record        equ 04b1h
cache_pointer            equ 04b8h
cache_dirty              equ 04bah
cached_block             equ 04bch
catalog_pointer          equ 04f2h
selected_printers        equ 04f4h
keyboard_index           equ 04feh
alternate_keyboard       equ 0500h
utility_banner           equ 053ch
runtime_ax               equ 0582h
free_list                equ 058ah
runtime_features         equ 05b6h
runtime_version          equ 05b8h

	cseg

; Initialize the small-model runtime, dispatch the CP/M command tail and exit through BDOS.
start:
	call	init_stack
	call	align_heap
	call	get_drive
	call	install_divide_handler
	call	init_runtime_buffers
	call	identify_os
	mov	si,80h
	lodsb
	xor	ah,ah
	push	ax
	push	si
	call	call_main

exit_to_bdos:
	mov	cl,0h
	push	es
	int	0e0h
	pop	es
	jmp	national_main

fatal_inline:
	pop	dx
	push	cs
	pop	ds
	mov	cl,9h
	push	es
	int	0e0h
	pop	es
	jmps	exit_to_bdos
	ret
	db	'CP/M V1.11 8/27/84 SMALL Model CLEAR library. Copyright '
	db	'1983,1984 Digital Research.$'

; C interface to INT E0h. Preserve ES and capture the full AX and CX results.
bdos:
	push	bp
	mov	bp,sp
	push	di
	push	si
	mov	dx,word ptr 6h[bp]
	mov	cl,byte ptr 4h[bp]
	push	es
	int	0e0h
	pop	es
	mov	word ptr .runtime_ax,ax
	mov	word ptr .5a6h,cx
	sub	ah,ah
	pop	si
	pop	di
	pop	bp
	ret

get_drive:
	mov	cl,0ch
	push	es
	int	0e0h
	pop	es
	cmp	ah,11h
	jnz	check_launch_drive
	inc	byte ptr .50h

check_launch_drive:
	mov	al,byte ptr .50h
	test	al,al
	jz	query_current_drive
	dec	al
	cmp	al,0fh
	jna	remember_drive

query_current_drive:
	mov	cl,19h
	push	es
	int	0e0h
	pop	es

remember_drive:
	mov	byte ptr .5ach,al
	add	al,41h
	mov	byte ptr .5aeh,al
	ret

install_divide_handler:
	push	ds
	sub	bx,bx
	mov	ds,bx
	mov	word ptr [bx],0dbh
	mov	word ptr 2h[bx],cs
	pop	ds
	ret

divide_error:
	call	fatal_inline
	db	'Zero divide error$'

align_heap:
	push	ds
	pop	es
	mov	ax,word ptr .102h
	add	ax,0fh
	and	ax,0fff0h
	mov	word ptr .104h,ax
	ret
	mov	ax,sp
	sub	ax,100h
	sub	ax,word ptr .104h
	sub	bx,bx
	ret

grow_heap:
	mov	bx,sp
	mov	bx,ss:word ptr 2h[bx]
	inc	bx
	and	bl,0feh
	mov	ax,word ptr .104h
	add	bx,ax
	jc	heap_full
	jmps	check_stack_margin

heap_full:
	mov	ax,0ffffh
	ret
	mov	bx,sp
	mov	bx,ss:word ptr 2h[bx]
	sub	ax,ax

check_stack_margin:
	mov	cx,sp
	sub	cx,100h
	cmp	bx,cx
	jnc	heap_full
	cmp	bx,word ptr .104h
	jc	heap_full
	mov	word ptr .104h,bx
	ret

init_runtime_buffers:
	sub	sp,4h
	mov	dx,sp
	mov	cl,69h
	push	es
	int	0e0h
	pop	es
	add	sp,4h
	inc	ax
	jz	query_runtime_version
	sub	ax,ax
	or	ax,1000h

query_runtime_version:
	push	ax
	mov	cl,0ch
	push	es
	int	0e0h
	pop	es
	pop	ax
	cmp	bx,22h
	jc	save_runtime_flags
	test	bh,2h
	jz	use_legacy_buffers
	or	ax,800h
	xor	bh,2h

use_legacy_buffers:
	mov	cx,22h
	or	ax,400h
	test	bh,bh
	jz	save_runtime_flags
	xor	ax,400h
	inc	cl
	or	ax,0e000h
	cmp	bh,1h
	jz	save_runtime_flags
	inc	cl
	xor	ax,8000h
	cmp	bh,14h
	jz	save_runtime_flags
	sub	cx,cx

save_runtime_flags:
	mov	byte ptr .5b2h,cl
	mov	word ptr .5b0h,ax
	ret

init_stack:
	pop	ax
	pop	cx
	pop	dx
	sub	bx,bx
	push	ds
	pushf
	pop	si
	cli
	pop	ss
	mov	sp,word ptr 6h[bx]
	push	si
	popf
	inc	sp
	and	sp,0fffeh
	push	dx
	push	cx
	push	bx
	mov	bp,sp
	lea	dx,word ptr (0-8h)[bp]
	push	dx
	push	bx
	push	bx
	push	bx
	push	ax
	mov	ss:word ptr .9h,ds
	ret
	pop	bx
	pop	dx
	inc	dx
	and	dl,0feh
	mov	ax,dx
	add	ax,word ptr .104h
	cmp	ax,sp
	jna	grow_stack
	call	fatal_inline
	db	0dh
	db	0ah
	db	'Stack overflow.'
	db	0dh
	db	0ah
	db	24h

grow_stack:
	sub	sp,dx
	mov	ax,sp
	push	dx
	push	bx
	ret
	db	0h

national_main:
	call	check_platform
	call	choose_ui_language
	call	configure_system
	call	restore_console
	ret

; Select the correct system-file signature offset for the reported Concurrent release.
check_platform:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,0ch
	push	ax
	call	bdos_result
	inc	sp
	inc	sp
	mov	ax,word ptr .os_result
	mov	cl,8h
	sar	ax,cl
	cmp	ax,14h
	jnz	reject_platform
	jmps	select_system_layout

unsupported_release:
	jmps	reject_platform

use_31_layout:
	mov	word ptr signature_offset,0c3bh
	jmps	platform_accepted

use_41_layout:
	mov	word ptr signature_offset,0c3ch
	jmps	platform_accepted

select_system_layout:
	mov	ax,word ptr .os_result
	xor	ah,ah
	cmp	ax,31h
	jz	use_31_layout
	cmp	ax,30h
	jz	unsupported_release
	jmps	use_41_layout

platform_accepted:
	jmps	start_terminal

reject_platform:
	mov	ax,1f6h
	push	ax
	mov	ax,9h
	push	ax
	call	file_bdos_result
	add	sp,4h
	sub	ax,ax
	push	ax
	push	ax
	call	bdos_result
	add	sp,4h

start_terminal:
	sub	ax,ax
	push	ax
	mov	al,6eh
	push	ax
	call	bdos_result
	add	sp,4h
	mov	ax,0ffffh
	push	ax
	mov	ax,6dh
	push	ax
	call	bdos_result
	add	sp,4h
	or	ax,0eh
	push	ax
	mov	ax,6dh
	push	ax
	call	bdos_result
	add	sp,4h
	mov	ax,36h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	call	clear_screen
	call	initialize_video
	call	refresh_console
	pop	di
	pop	si
	pop	bp
	ret

copy_bytes:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	si,word ptr 4h[bp]
	mov	di,word ptr 6h[bp]

copy_next_byte:
	mov	ax,di
	inc	di
	push	ax
	mov	ax,si
	inc	si
	xchg	ax,bx
	mov	al,byte ptr [bx]
	pop	bx
	mov	byte ptr [bx],al
	dec	word ptr 8h[bp]
	cmp	word ptr 8h[bp],0h
	jnz	copy_next_byte
	pop	di
	pop	si
	pop	bp
	ret

fill_bytes:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	si,word ptr 4h[bp]

fill_next_byte:
	mov	ax,si
	inc	si
	push	ax
	mov	ax,word ptr 6h[bp]
	pop	bx
	mov	byte ptr [bx],al
	dec	word ptr 8h[bp]
	cmp	word ptr 8h[bp],0h
	jnz	fill_next_byte
	pop	di
	pop	si
	pop	bp
	ret

; Send supported control characters through BDOS; paint other bytes in the virtual screen.
output_character:
	push	bp
	mov	bp,sp
	cmp	word ptr 4h[bp],20h
	jnl	fill_one_cell
	cmp	word ptr 4h[bp],0dh
	jz	write_control
	cmp	word ptr 4h[bp],0ah
	jz	write_control
	cmp	word ptr 4h[bp],8h
	jnz	fill_one_cell

write_control:
	push	word ptr 4h[bp]
	mov	ax,6h
	push	ax
	call	bdos
	add	sp,4h
	jmps	char_done

fill_one_cell:
	mov	ax,1h
	push	ax
	push	word ptr 4h[bp]
	call	fill_video_cells
	add	sp,4h

char_done:
	pop	bp
	ret

display_string:
	push	bp
	mov	bp,sp
	push	word ptr 4h[bp]
	call	write_video_string
	inc	sp
	inc	sp
	pop	bp
	ret
	mov	ax,20h
	push	ax
	call	output_character
	inc	sp
	inc	sp
	ret

send_escape:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	si,word ptr 4h[bp]
	mov	ax,1bh
	push	ax
	mov	al,6h
	push	ax
	call	bdos
	add	sp,4h
	push	si
	mov	ax,6h
	push	ax
	call	bdos
	add	sp,4h
	pop	di
	pop	si
	pop	bp
	ret

set_cursor:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	si,word ptr 4h[bp]
	mov	di,word ptr 6h[bp]
	mov	ax,59h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	lea	ax,word ptr 20h[si]
	push	ax
	mov	ax,6h
	push	ax
	call	bdos
	add	sp,4h
	lea	ax,word ptr 20h[di]
	push	ax
	mov	ax,6h
	push	ax
	call	bdos
	add	sp,4h
	pop	di
	pop	si
	pop	bp
	ret

repeat_char:
	push	bp
	mov	bp,sp
	push	word ptr 4h[bp]
	push	word ptr 6h[bp]
	call	fill_video_cells
	add	sp,4h
	pop	bp
	ret

clear_screen:
	mov	ax,45h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret
	mov	ax,72h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret

normal_video:
	mov	ax,75h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret

highlight_on:
	mov	ax,70h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret

highlight_off:
	mov	ax,71h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret
	mov	ax,76h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret
	mov	ax,77h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret

cursor_on:
	mov	ax,65h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret

cursor_off:
	mov	ax,66h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	ret

print_centered:
	push	bp
	mov	bp,sp
	mov	ax,28h
	push	ax
	push	word ptr 6h[bp]
	call	string_length
	inc	sp
	inc	sp
	sar	ax,1
	xchg	ax,bx
	pop	ax
	sub	ax,bx
	push	ax
	push	word ptr 4h[bp]
	call	set_cursor
	add	sp,4h
	push	word ptr 6h[bp]
	call	display_string
	inc	sp
	inc	sp
	pop	bp
	ret

clear_line:
	push	bp
	mov	bp,sp
	mov	ax,1h
	push	ax
	push	word ptr 4h[bp]
	call	set_cursor
	add	sp,4h
	mov	ax,20h
	push	ax
	mov	al,4eh
	push	ax
	call	repeat_char
	add	sp,4h
	pop	bp
	ret

show_heading:
	push	bp
	mov	bp,sp
	mov	ax,4h
	push	ax
	call	clear_line
	inc	sp
	inc	sp
	call	highlight_on
	push	word ptr 4h[bp]
	mov	ax,4h
	push	ax
	call	print_centered
	add	sp,4h
	call	highlight_off
	call	normal_video
	pop	bp
	ret

; Read direct input with BDOS 6 (FDh). Redraw the banner for the reserved key.
read_menu_key:
	push	bp
	mov	bp,sp
	sub	sp,6h
	call	query_console
	jmps	retry_key

read_direct_key:
	mov	ax,0fdh
	push	ax
	mov	al,6h
	push	ax
	call	bdos
	add	sp,4h
	mov	word ptr (0-6h)[bp],ax
	cmp	ax,6ah
	jnz	return_key
	call	paint_banner
	jmps	retry_key

return_key:
	mov	ax,word ptr (0-6h)[bp]
	jmps	key_done

retry_key:
	jmps	read_direct_key

key_done:
	mov	sp,bp
	pop	bp
	ret

paint_banner:
	push	bp
	mov	bp,sp
	push	si
	push	di
	sub	sp,4h
	mov	ax,212h
	push	ax
	mov	ax,1h
	push	ax
	call	print_centered
	add	sp,4h
	mov	ax,5h
	push	ax
	mov	al,1h
	push	ax
	call	set_cursor
	add	sp,4h
	mov	ax,153h
	mov	word ptr (0-6h)[bp],ax
	jmps	read_banner_char

paint_banner_char:
	mov	ax,word ptr (0-8h)[bp]
	neg	ax
	push	ax
	call	output_character
	inc	sp
	inc	sp

read_banner_char:
	mov	ax,word ptr (0-6h)[bp]
	inc	word ptr (0-6h)[bp]
	xchg	ax,bx
	mov	al,byte ptr [bx]
	xor	ah,ah
	mov	word ptr (0-8h)[bp],ax
	or	ax,ax
	jnz	paint_banner_char
	lea	sp,word ptr (0-4h)[bp]
	pop	di
	pop	si
	pop	bp
	ret

restore_console:
	call	clear_screen
	mov	ax,37h
	push	ax
	call	send_escape
	inc	sp
	inc	sp
	call	cursor_on
	call	normal_video
	sub	ax,ax
	push	ax
	push	ax
	call	set_cursor
	add	sp,4h
	sub	ax,ax
	push	ax
	push	ax
	call	bdos_result
	add	sp,4h
	ret

show_menu_title:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,word ptr .19ah
	or	ax,ax
	jz	first_clear_row
	call	draw_menu
	mov	word ptr .19ah,0h
	jmps	draw_heading

first_clear_row:
	mov	word ptr .frame_row,3h
	jmps	test_clear_row

clear_next_row:
	mov	ax,word ptr .frame_row
	push	ax
	call	clear_line
	inc	sp
	inc	sp
	inc	word ptr .frame_row

test_clear_row:
	cmp	word ptr .frame_row,17h
	jl	clear_next_row

draw_heading:
	mov	ax,utility_banner
	push	ax
	mov	ax,1h
	push	ax
	call	print_centered
	add	sp,4h
	push	word ptr 4h[bp]
	call	show_heading
	inc	sp
	inc	sp
	pop	di
	pop	si
	pop	bp
	ret

draw_menu:
	sub	ax,ax
	push	ax
	push	ax
	call	set_cursor
	add	sp,4h
	call	normal_video
	call	cursor_off
	mov	byte ptr .19eh,0h
	jmps	test_frame_row

paint_frame_row:
	sub	ax,ax
	push	ax
	mov	al,byte ptr .19eh
	xor	ah,ah
	push	ax
	call	set_cursor
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0b3h
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,4eh
	push	ax
	mov	al,20h
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0b3h
	push	ax
	call	fill_video_cells
	add	sp,4h
	inc	byte ptr .19eh

test_frame_row:
	cmp	byte ptr .19eh,17h
	jc	paint_frame_row
	sub	ax,ax
	push	ax
	mov	al,17h
	push	ax
	call	set_cursor
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0c0h
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,4eh
	push	ax
	mov	al,0c4h
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0d9h
	push	ax
	call	fill_video_cells
	add	sp,4h
	sub	ax,ax
	push	ax
	push	ax
	call	set_cursor
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0dah
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,4eh
	push	ax
	mov	al,0c4h
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0bfh
	push	ax
	call	fill_video_cells
	add	sp,4h
	sub	ax,ax
	push	ax
	mov	al,2h
	push	ax
	call	set_cursor
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0c6h
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,4eh
	push	ax
	mov	al,0cdh
	push	ax
	call	fill_video_cells
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	al,0b5h
	push	ax
	call	fill_video_cells
	add	sp,4h
	ret

; Allocate 20 KiB for NATIONAL.MSG and a 4 KiB read/write cache for CCPM.SYS.
configure_system:
	mov	ax,5000h
	push	ax
	call	allocate
	inc	sp
	inc	sp
	mov	word ptr .catalog_pointer,ax
	mov	ax,1000h
	push	ax
	call	allocate
	inc	sp
	inc	sp
	mov	word ptr .cache_pointer,ax
	call	load_messages
	call	load_national_tables
	call	installation_menu
	call	save_national_settings
	ret

; Map the displayed language order to the catalog index used on disk.
choose_ui_language:
	push	bp
	mov	bp,sp
	push	si
	push	di
	dec	sp
	dec	sp
	mov	ax,214h
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,22ah
	push	ax
	mov	ax,231h
	push	ax
	mov	ax,239h
	push	ax
	mov	ax,242h
	push	ax
	mov	ax,250h
	push	ax
	mov	ax,256h
	push	ax
	mov	ax,25eh
	push	ax
	mov	ax,26ah
	push	ax
	mov	ax,272h
	push	ax
	mov	ax,27bh
	push	ax
	sub	ax,ax
	push	ax
	mov	al,0ah
	push	ax
	call	draw_options
	add	sp,18h
	mov	word ptr (0-6h)[bp],ax
	cmp	word ptr (0-6h)[bp],9h
	jnz	choose_language
	call	restore_console

choose_language:
	mov	ax,language_order
	push	ax
	mov	ax,word ptr (0-6h)[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	ax,word ptr [bx]
	mov	word ptr .language_index,ax
	lea	sp,word ptr (0-4h)[bp]
	pop	di
	pop	si
	pop	bp
	ret

; Each language has 100 little-endian offsets following the 128-byte header.
message_address:
	push	bp
	mov	bp,sp
	sub	sp,6h
	mov	ax,64h
	mul	word ptr .language_index
	add	word ptr 4h[bp],ax
	mov	ax,word ptr 4h[bp]
	shl	ax,1
	add	ax,word ptr .catalog_pointer
	add	ax,80h
	mov	word ptr (0-6h)[bp],ax
	mov	bx,word ptr (0-6h)[bp]
	mov	ax,word ptr [bx]
	add	ax,word ptr .catalog_pointer
	add	ax,80h
	mov	sp,bp
	pop	bp
	ret

; The binary translation payloads start at catalog entry 50.
translation_address:
	push	bp
	mov	bp,sp
	mov	ax,word ptr 4h[bp]
	add	ax,32h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	pop	bp
	ret

fatal_message:
	push	bp
	mov	bp,sp
	push	si
	push	di
	push	word ptr 4h[bp]
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,1b3h
	push	ax
	mov	ax,word ptr .language_index
	shl	ax,1
	pop	bx
	add	bx,ax
	push	word ptr [bx]
	sub	ax,ax
	push	ax
	inc	ax
	push	ax
	call	draw_options
	add	sp,6h
	call	restore_console
	pop	di
	pop	si
	pop	bp
	ret

; Read up to 160 CP/M records using multi-sector BDOS operations.
load_messages:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,message_filename
	push	ax
	call	open_fcb
	inc	sp
	inc	sp
	or	ax,ax
	jz	allocate_message_dma
	mov	ax,1c9h
	push	ax
	mov	ax,word ptr .language_index
	shl	ax,1
	pop	bx
	add	bx,ax
	push	word ptr [bx]
	call	fatal_message
	inc	sp
	inc	sp

allocate_message_dma:
	mov	word ptr .records_remaining,0a0h
	mov	word ptr .catalog_record,0h
	jmps	test_records_left

read_message_chunk:
	mov	ax,word ptr .catalog_record
	mov	cl,7h
	shl	ax,cl
	add	ax,word ptr .catalog_pointer
	push	ax
	mov	ax,1ah
	push	ax
	call	file_bdos_result
	add	sp,4h
	cmp	word ptr .records_remaining,80h
	jng	set_last_chunk
	mov	ax,80h
	push	ax
	mov	al,2ch
	push	ax
	call	bdos_result
	add	sp,4h
	sub	word ptr .records_remaining,80h
	add	word ptr .catalog_record,80h
	jmps	read_message_records

set_last_chunk:
	mov	ax,word ptr .records_remaining
	push	ax
	mov	ax,2ch
	push	ax
	call	bdos_result
	add	sp,4h
	mov	word ptr .records_remaining,0h

read_message_records:
	mov	ax,system_fcb
	push	ax
	mov	ax,14h
	push	ax
	call	file_bdos_result
	add	sp,4h

test_records_left:
	mov	ax,word ptr .records_remaining
	or	ax,ax
	jnz	read_message_chunk
	mov	ax,system_fcb
	push	ax
	mov	ax,10h
	push	ax
	call	file_bdos_result
	add	sp,4h
	mov	word ptr .messages_ready,1h
	pop	di
	pop	si
	pop	bp
	ret

; Expand the packed filename into the FCB. Try current, launch and system drives.
open_fcb:
	push	bp
	mov	bp,sp
	sub	sp,6h
	mov	ax,25h
	push	ax
	sub	ax,ax
	push	ax
	mov	ax,system_fcb
	push	ax
	call	fill_bytes
	add	sp,6h
	mov	ax,0bh
	push	ax
	mov	ax,491h
	push	ax
	push	word ptr 4h[bp]
	call	copy_bytes
	add	sp,6h
	mov	ax,system_fcb
	push	ax
	mov	ax,0fh
	push	ax
	call	file_bdos_result
	add	sp,4h
	cmp	ax,0ffh
	jz	try_launch_drive
	sub	ax,ax
	jmps	open_done

try_launch_drive:
	mov	word ptr (0-6h)[bp],50h
	mov	bx,word ptr (0-6h)[bp]
	mov	al,byte ptr [bx]
	mov	byte ptr .system_fcb,al
	mov	ax,system_fcb
	push	ax
	mov	ax,0fh
	push	ax
	call	file_bdos_result
	add	sp,4h
	cmp	ax,0ffh
	jz	try_system_drive
	sub	ax,ax
	jmps	open_done

try_system_drive:
	mov	byte ptr .system_fcb,10h
	mov	ax,system_fcb
	push	ax
	mov	ax,0fh
	push	ax
	call	file_bdos_result
	add	sp,4h
	cmp	ax,0ffh
	jz	open_failed
	sub	ax,ax
	jmps	open_done

open_failed:
	mov	ax,1h

open_done:
	mov	sp,bp
	pop	bp
	ret

; Split a transfer at 4 KiB buffer boundaries, preserving the surrounding file bytes.
; Split transfers at 4 KiB boundaries and flush the dirty block before replacing it.
transfer_bytes:
	push	bp
	mov	bp,sp
	sub	sp,8h

next_chunk:
	mov	ax,1000h
	push	ax
	mov	ax,word ptr 6h[bp]
	and	ax,0fffh
	xchg	ax,bx
	pop	ax
	sub	ax,bx
	mov	word ptr (0-8h)[bp],ax
	cmp	word ptr 0ah[bp],ax
	jnl	chunk_ready
	mov	ax,word ptr 0ah[bp]
	mov	word ptr (0-8h)[bp],ax

chunk_ready:
	push	word ptr 6h[bp]
	call	select_file_block
	inc	sp
	inc	sp
	mov	ax,word ptr 6h[bp]
	and	ax,0fffh
	add	ax,word ptr .cache_pointer
	mov	word ptr (0-6h)[bp],ax
	cmp	word ptr 4h[bp],77h
	jnz	copy_from_cache
	push	word ptr (0-8h)[bp]
	push	word ptr (0-6h)[bp]
	push	word ptr 8h[bp]
	call	copy_bytes
	add	sp,6h
	mov	word ptr .cache_dirty,1h
	jmps	advance_transfer

copy_from_cache:
	push	word ptr (0-8h)[bp]
	push	word ptr 8h[bp]
	push	word ptr (0-6h)[bp]
	call	copy_bytes
	add	sp,6h

advance_transfer:
	mov	ax,word ptr (0-8h)[bp]
	add	word ptr 6h[bp],ax
	mov	ax,word ptr (0-8h)[bp]
	sub	word ptr 0ah[bp],ax
	mov	ax,word ptr (0-8h)[bp]
	add	word ptr 8h[bp],ax
	cmp	word ptr 0ah[bp],0h
	jg	next_chunk
	mov	sp,bp
	pop	bp
	ret

read_bytes:
	push	bp
	mov	bp,sp
	push	word ptr 8h[bp]
	push	word ptr 6h[bp]
	push	word ptr 4h[bp]
	mov	ax,72h
	push	ax
	call	transfer_bytes
	add	sp,8h
	pop	bp
	ret

write_bytes:
	push	bp
	mov	bp,sp
	push	word ptr 8h[bp]
	push	word ptr 6h[bp]
	push	word ptr 4h[bp]
	mov	ax,77h
	push	ax
	call	transfer_bytes
	add	sp,8h
	pop	bp
	ret

select_file_block:
	push	bp
	mov	bp,sp
	sub	sp,6h
	mov	ax,word ptr 4h[bp]
	mov	cl,0ch
	shr	ax,cl
	mov	word ptr (0-6h)[bp],ax
	mov	ax,word ptr .cached_block
	cmp	word ptr (0-6h)[bp],ax
	jz	cache_ready
	call	flush_dirty_block
	push	word ptr (0-6h)[bp]
	call	read_file_block
	inc	sp
	inc	sp

cache_ready:
	mov	sp,bp
	pop	bp
	ret

read_file_block:
	push	bp
	mov	bp,sp
	push	word ptr 4h[bp]
	call	set_block_dma
	inc	sp
	inc	sp
	mov	ax,word ptr 4h[bp]
	mov	word ptr .cached_block,ax
	mov	ax,system_fcb
	push	ax
	mov	ax,21h
	push	ax
	call	file_bdos_result
	add	sp,4h
	pop	bp
	ret

flush_dirty_block:
	mov	ax,word ptr .cache_dirty
	or	ax,ax
	jz	buffer_clean
	mov	word ptr .cache_dirty,0h
	mov	ax,word ptr .cached_block
	push	ax
	call	set_block_dma
	inc	sp
	inc	sp
	mov	ax,system_fcb
	push	ax
	mov	ax,22h
	push	ax
	call	file_bdos_result
	add	sp,4h

buffer_clean:
	ret

set_block_dma:
	push	bp
	mov	bp,sp
	sub	sp,6h
	mov	ax,word ptr .cache_pointer
	push	ax
	mov	ax,1ah
	push	ax
	call	file_bdos_result
	add	sp,4h
	mov	ax,20h
	push	ax
	mov	al,2ch
	push	ax
	call	bdos_result
	add	sp,4h
	mov	ax,word ptr 4h[bp]
	mov	cl,0ch
	shl	ax,cl
	mov	cl,7h
	shr	ax,cl
	mov	word ptr (0-6h)[bp],ax
	mov	byte ptr .4b3h,0h
	mov	ax,2h
	push	ax
	mov	ax,fcb_random_record
	push	ax
	lea	ax,word ptr (0-6h)[bp]
	push	ax
	call	copy_bytes
	add	sp,6h
	mov	sp,bp
	pop	bp
	ret

; Read the group size at file byte 1. The data group begins after the 128-byte header and the code paragraphs.
load_national_tables:
	mov	ax,offset kernel_filename
	push	ax
	call	open_fcb
	inc	sp
	inc	sp
	or	ax,ax
	jz	read_group_size
	mov	ax,1dh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	fatal_message
	inc	sp
	inc	sp

read_group_size:
	mov	ax,2h
	push	ax
	mov	ax,offset code_paragraphs
	push	ax
	mov	ax,1h
	push	ax
	call	read_bytes
	add	sp,6h
	mov	ax,word ptr code_paragraphs
	mov	cl,4h
	shl	ax,cl
	add	ax,80h
	mov	word ptr data_file_base,ax
	mov	ax,2h
	push	ax
	mov	ax,offset table_work
	push	ax
	mov	ax,word ptr data_file_base
	add	ax,word ptr signature_offset
	push	ax
	call	read_bytes
	add	sp,6h
; Verify JW before interpreting the following relative directory pointer.
	cmp	word ptr table_work,574ah
	jz	read_directory_pointer
	mov	ax,1eh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	fatal_message
	inc	sp
	inc	sp

; The word after JW points to a directory of 24 words, relative to the data group.
read_directory_pointer:
	mov	ax,2h
	push	ax
	mov	ax,offset table_work
	push	ax
	mov	ax,word ptr data_file_base
	add	ax,word ptr signature_offset
	inc	ax
	inc	ax
	push	ax
	call	read_bytes
	add	sp,6h
	mov	ax,30h
	push	ax
	mov	ax,offset slot_offsets
	push	ax
	mov	ax,word ptr data_file_base
	add	ax,word ptr table_work
	push	ax
	call	read_bytes
	add	sp,6h
	mov	word ptr table_work,0h
	jmps	test_slot_count

; Translate each nonzero relative pointer into a file position. Zero denotes an unavailable table.
relocate_slot:
; Convert nonzero displacements to file offsets. A missing slot becomes FFFFh.
	mov	ax,offset slot_offsets
	push	ax
	mov	ax,word ptr table_work
	shl	ax,1
	pop	bx
	add	bx,ax
	cmp	word ptr [bx],0h
	jz	mark_missing
	mov	ax,offset slot_offsets
	push	ax
	mov	ax,word ptr table_work
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	ax,word ptr data_file_base
	add	word ptr [bx],ax
	jmps	advance_slot

mark_missing:
	mov	ax,offset slot_offsets
	push	ax
	mov	ax,word ptr table_work
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	word ptr [bx],0ffffh

advance_slot:
	inc	word ptr table_work

test_slot_count:
	cmp	word ptr table_work,18h
	jl	relocate_slot
	mov	ax,37h
	push	ax
	mov	ax,offset device_records
	push	ax
	mov	ax,word ptr .4d2h
	push	ax
	call	read_bytes
	add	sp,6h
	mov	word ptr .device_index,0h
	jmps	test_device_count

; Read five 11-byte device descriptions from slot 10.
load_device:
	mov	ax,selected_printers
	push	ax
	mov	ax,word ptr .device_index
	shl	ax,1
	pop	bx
	add	ax,bx
	push	ax
	mov	ax,offset device_records
	push	ax
	mov	ax,0bh
	mul	word ptr .device_index
	pop	bx
	add	bx,ax
	mov	al,byte ptr 1h[bx]
	xor	ah,ah
	pop	bx
	mov	word ptr [bx],ax
	mov	ax,offset device_records
	push	ax
	mov	ax,0bh
	mul	word ptr .device_index
	pop	bx
	add	bx,ax
	mov	byte ptr 8h[bx],0ffh
	inc	word ptr .device_index

test_device_count:
	cmp	word ptr .device_index,5h
	jl	load_device
	mov	word ptr .keyboard_index,0h
	mov	ax,1h
	push	ax
	mov	ax,keyboard_index
	push	ax
	mov	ax,word ptr .4c2h
	push	ax
	call	read_bytes
	add	sp,6h
	mov	word ptr .alternate_keyboard,0h
	mov	ax,1h
	push	ax
	mov	ax,alternate_keyboard
	push	ax
	mov	ax,word ptr .4e2h
	push	ax
	call	read_bytes
	add	sp,6h
	ret

; Dispatch keyboard, printer and summary menus. Saving is confirmed separately.
installation_menu:
	push	bp
	mov	bp,sp
	sub	sp,6h
	mov	word ptr (0-6h)[bp],0h
	jmp	repeat_main

main_heading:
	mov	ax,1h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	jmps	show_main_choices

edit_keyboard:
	call	keyboard_menu
	mov	word ptr (0-6h)[bp],1h
	jmps	repeat_main

edit_printers:
	call	printer_menu
	mov	word ptr (0-6h)[bp],2h
	jmps	repeat_main

list_settings:
	call	display_settings
	mov	word ptr (0-6h)[bp],3h
	jmps	repeat_main

leave_main:
	jmps	main_done
	jmps	repeat_main

show_main_choices:
	mov	ax,5h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,4h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,3h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,2h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	push	word ptr (0-6h)[bp]
	mov	ax,4h
	push	ax
	call	draw_options
	add	sp,0ch
	cmp	ax,2h
	jz	list_settings
	cmp	ax,1h
	jz	edit_printers
	cmp	ax,0h
	jz	edit_keyboard
	jmps	leave_main

repeat_main:
	jmps	main_heading

main_done:
	mov	sp,bp
	pop	bp
	ret

; Retain the keyboard selection on Back; otherwise store the new menu index.
keyboard_menu:
	push	bp
	mov	bp,sp
	sub	sp,4ch
	mov	ax,6h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,1ah
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-4ch)[bp]
	push	ax
	call	copy_string
	add	sp,4h
	mov	ax,word ptr .keyboard_index
	add	ax,7h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-4ch)[bp]
	push	ax
	call	append_string
	add	sp,4h
	lea	ax,word ptr (0-4ch)[bp]
	push	ax
	mov	ax,6h
	push	ax
	call	print_centered
	add	sp,4h
	mov	ax,12h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0bh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0ah
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,9h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,8h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,7h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .keyboard_index
	push	ax
	mov	ax,6h
	push	ax
	call	draw_options
	add	sp,10h
	mov	word ptr (0-6h)[bp],ax
	cmp	word ptr (0-6h)[bp],5h
	jz	keyboard_done
	mov	ax,word ptr (0-6h)[bp]
	mov	word ptr .keyboard_index,ax

keyboard_done:
	mov	sp,bp
	pop	bp
	ret

; Select one of three parallel and two serial devices before choosing its model.
printer_menu:
	push	bp
	mov	bp,sp
	sub	sp,6h
	mov	word ptr (0-6h)[bp],0h
	jmps	repeat_devices

list_devices:
	mov	ax,0ch
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,12h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,11h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,10h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0fh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0eh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0dh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	push	word ptr (0-6h)[bp]
	mov	ax,6h
	push	ax
	call	draw_options
	add	sp,10h
	mov	word ptr (0-6h)[bp],ax
	cmp	word ptr (0-6h)[bp],5h
	jz	leave_devices
	mov	ax,word ptr (0-6h)[bp]
	inc	word ptr (0-6h)[bp]
	push	ax
	call	select_printer_option
	inc	sp
	inc	sp
	jmps	repeat_devices

leave_devices:
	jmps	devices_done

repeat_devices:
	jmps	list_devices

devices_done:
	mov	sp,bp
	pop	bp
	ret

; Translate the model index through the catalog lookup table for this printer.
select_printer_option:
	push	bp
	mov	bp,sp
	sub	sp,42h
	mov	ax,13h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-42h)[bp]
	push	ax
	call	copy_string
	add	sp,4h
	mov	ax,word ptr 4h[bp]
	add	ax,0dh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-42h)[bp]
	push	ax
	call	append_string
	add	sp,4h
	lea	ax,word ptr (0-42h)[bp]
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,selected_printers
	push	ax
	mov	ax,word ptr 4h[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	ax,word ptr [bx]
	mov	word ptr (0-6h)[bp],ax
	mov	ax,1ah
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-42h)[bp]
	push	ax
	call	copy_string
	add	sp,4h
	mov	ax,model_message_ids
	push	ax
	mov	ax,word ptr (0-6h)[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	push	word ptr [bx]
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-42h)[bp]
	push	ax
	call	append_string
	add	sp,4h
	lea	ax,word ptr (0-42h)[bp]
	push	ax
	mov	ax,6h
	push	ax
	call	print_centered
	add	sp,4h
	mov	ax,12h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .127h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .125h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .123h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .121h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .11fh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,word ptr .model_message_ids
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	push	word ptr (0-6h)[bp]
	mov	ax,7h
	push	ax
	call	draw_options
	add	sp,12h
	mov	word ptr (0-6h)[bp],ax
	cmp	word ptr (0-6h)[bp],6h
	jz	model_done
	mov	ax,selected_printers
	push	ax
	mov	ax,word ptr 4h[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	ax,word ptr (0-6h)[bp]
	mov	word ptr [bx],ax

model_done:
	mov	sp,bp
	pop	bp
	ret

display_settings:
	push	bp
	mov	bp,sp
	sub	sp,4ch
	mov	ax,4h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,18h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-4ch)[bp]
	push	ax
	call	copy_string
	add	sp,4h
	mov	ax,word ptr .keyboard_index
	add	ax,7h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	lea	ax,word ptr (0-4ch)[bp]
	push	ax
	call	append_string
	add	sp,4h
	lea	ax,word ptr (0-4ch)[bp]
	push	ax
	mov	ax,7h
	push	ax
	call	print_centered
	add	sp,4h
	mov	ax,19h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0ah
	push	ax
	call	print_centered
	add	sp,4h
	mov	word ptr (0-6h)[bp],0h
	jmps	test_printer_number

show_one_printer:
	mov	ax,23h
	push	ax
	mov	ax,word ptr (0-6h)[bp]
	add	ax,0dh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	string_length
	inc	sp
	inc	sp
	xchg	ax,bx
	pop	ax
	sub	ax,bx
	push	ax
	mov	ax,word ptr (0-6h)[bp]
	add	ax,0ch
	push	ax
	call	set_cursor
	add	sp,4h
	mov	ax,word ptr (0-6h)[bp]
	add	ax,0dh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	display_string
	inc	sp
	inc	sp
	mov	ax,461h
	push	ax
	call	display_string
	inc	sp
	inc	sp
	mov	ax,model_message_ids
	push	ax
	mov	ax,selected_printers
	push	ax
	mov	ax,word ptr (0-6h)[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	ax,word ptr [bx]
	shl	ax,1
	pop	bx
	add	bx,ax
	push	word ptr [bx]
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	display_string
	inc	sp
	inc	sp
	inc	word ptr (0-6h)[bp]

test_printer_number:
	cmp	word ptr (0-6h)[bp],5h
	jl	show_one_printer
	mov	ax,12h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	sub	ax,ax
	push	ax
	inc	ax
	push	ax
	call	draw_options
	add	sp,6h
	mov	sp,bp
	pop	bp
	ret

wrap_selection:
	push	bp
	mov	bp,sp
	mov	ax,word ptr 4h[bp]
	cmp	word ptr 6h[bp],ax
	jnl	check_upper_bound
	mov	ax,word ptr 8h[bp]
	jmps	wrapped_selection

check_upper_bound:
	mov	ax,word ptr 8h[bp]
	cmp	word ptr 6h[bp],ax
	jng	keep_selection
	mov	ax,word ptr 4h[bp]
	jmps	wrapped_selection

keep_selection:
	mov	ax,word ptr 6h[bp]

wrapped_selection:
	pop	bp
	ret

; Measure option widths, paint the active row, and wrap navigation at either end.
draw_options:
	push	bp
	mov	bp,sp
	sub	sp,12h
	cmp	word ptr 4h[bp],1h
	jng	prepare_options
	mov	ax,word ptr .messages_ready
	or	ax,ax
	jz	prepare_options
	mov	ax,24h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,8h
	push	ax
	call	print_centered
	add	sp,4h
	mov	ax,25h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,9h
	push	ax
	call	print_centered
	add	sp,4h

prepare_options:
	lea	ax,word ptr 8h[bp]
	mov	word ptr (0-6h)[bp],ax
	cmp	word ptr 4h[bp],1h
	jng	single_option_row
	mov	word ptr (0-12h)[bp],0bh
	jmps	start_width_scan

single_option_row:
	mov	word ptr (0-12h)[bp],14h

start_width_scan:
	mov	word ptr (0-0eh)[bp],0h
	mov	word ptr (0-8h)[bp],0h
	jmps	test_width

measure_option:
	mov	ax,word ptr (0-8h)[bp]
	shl	ax,1
	add	ax,word ptr (0-6h)[bp]
	xchg	ax,bx
	push	word ptr [bx]
	call	string_length
	inc	sp
	inc	sp
	mov	word ptr (0-0ch)[bp],ax
	mov	ax,word ptr (0-0eh)[bp]
	cmp	word ptr (0-0ch)[bp],ax
	jng	next_width
	mov	ax,word ptr (0-0ch)[bp]
	mov	word ptr (0-0eh)[bp],ax

next_width:
	inc	word ptr (0-8h)[bp]

test_width:
	mov	ax,word ptr 4h[bp]
	cmp	word ptr (0-8h)[bp],ax
	jl	measure_option
	mov	word ptr (0-8h)[bp],0h
	jmps	test_option_row

start_option_row:
	push	word ptr (0-0eh)[bp]
	mov	ax,word ptr 6h[bp]
	cmp	word ptr (0-8h)[bp],ax
	mov	ax,0h
	jnz	paint_option_row
	inc	ax

paint_option_row:
	push	ax
	mov	ax,word ptr (0-8h)[bp]
	shl	ax,1
	add	ax,word ptr (0-6h)[bp]
	xchg	ax,bx
	push	word ptr [bx]
	mov	ax,word ptr (0-8h)[bp]
	add	ax,word ptr (0-12h)[bp]
	push	ax
	call	show_field
	add	sp,8h
	inc	word ptr (0-8h)[bp]

test_option_row:
	mov	ax,word ptr 4h[bp]
	cmp	word ptr (0-8h)[bp],ax
	jl	start_option_row
	mov	ax,word ptr 6h[bp]
	mov	word ptr (0-0ah)[bp],ax
	jmp	repaint_selection

update_highlight:
	mov	ax,word ptr 6h[bp]
	cmp	word ptr (0-0ah)[bp],ax
	jz	check_single_option
	push	word ptr (0-0eh)[bp]
	sub	ax,ax
	push	ax
	mov	ax,word ptr (0-0ah)[bp]
	shl	ax,1
	add	ax,word ptr (0-6h)[bp]
	xchg	ax,bx
	push	word ptr [bx]
	mov	ax,word ptr (0-0ah)[bp]
	add	ax,word ptr (0-12h)[bp]
	push	ax
	call	show_field
	add	sp,8h
	push	word ptr (0-0eh)[bp]
	mov	ax,1h
	push	ax
	mov	ax,word ptr 6h[bp]
	shl	ax,1
	add	ax,word ptr (0-6h)[bp]
	xchg	ax,bx
	push	word ptr [bx]
	mov	ax,word ptr 6h[bp]
	add	ax,word ptr (0-12h)[bp]
	push	ax
	call	show_field
	add	sp,8h
	mov	ax,word ptr 6h[bp]
	mov	word ptr (0-0ah)[bp],ax

check_single_option:
	cmp	word ptr 4h[bp],1h
	jnz	await_menu_key
	call	read_menu_key
	sub	ax,ax
	jmp	menu_done

await_menu_key:
	jmps	dispatch_menu_key

select_previous:
	mov	ax,word ptr 4h[bp]
	dec	ax
	push	ax
	mov	ax,word ptr 6h[bp]
	dec	ax
	push	ax
	sub	ax,ax
	push	ax
	call	wrap_selection
	add	sp,6h
	mov	word ptr 6h[bp],ax
	jmp	repaint_selection

cancel_menu:
	mov	ax,word ptr 4h[bp]
	dec	ax
	mov	word ptr 6h[bp],ax

accept_menu:
	mov	ax,word ptr 6h[bp]
	jmp	menu_done

redraw_banner:
	call	paint_banner
	jmp	repaint_selection

select_next:
	mov	ax,word ptr 4h[bp]
	dec	ax
	push	ax
	mov	ax,word ptr 6h[bp]
	inc	ax
	push	ax
	sub	ax,ax
	push	ax
	call	wrap_selection
	add	sp,6h
	mov	word ptr 6h[bp],ax
	jmp	repaint_selection
	jmp	repaint_selection

dispatch_menu_key:
	call	read_menu_key
	cmp	ax,6ah
	jz	redraw_banner
	cmp	ax,0dh
	jz	accept_menu
	cmp	ax,1bh
	jz	cancel_menu
	cmp	ax,38h
	jz	select_previous
	cmp	ax,34h
	jz	select_previous
	cmp	ax,0c8h
	jz	select_previous
	cmp	ax,0cbh
	jz	select_previous
	jmps	select_next

repaint_selection:
	jmp	update_highlight

menu_done:
	mov	sp,bp
	pop	bp
	ret

show_field:
	push	bp
	mov	bp,sp
	sub	sp,0ah
	add	word ptr 0ah[bp],0ah
	mov	ax,word ptr 0ah[bp]
	sar	ax,1
	mov	word ptr (0-0ah)[bp],ax
	push	word ptr 6h[bp]
	call	string_length
	inc	sp
	inc	sp
	mov	word ptr (0-6h)[bp],ax
	sar	ax,1
	mov	word ptr (0-8h)[bp],ax
	mov	ax,28h
	sub	ax,word ptr (0-0ah)[bp]
	push	ax
	push	word ptr 4h[bp]
	call	set_cursor
	add	sp,4h
	cmp	word ptr 8h[bp],0h
	jz	draw_plain_field
	call	highlight_on

draw_plain_field:
	mov	ax,467h
	push	ax
	call	display_string
	inc	sp
	inc	sp
	mov	ax,20h
	push	ax
	mov	ax,word ptr (0-0ah)[bp]
	sub	ax,3h
	sub	ax,word ptr (0-8h)[bp]
	push	ax
	call	repeat_char
	add	sp,4h
	push	word ptr 6h[bp]
	call	display_string
	inc	sp
	inc	sp
	mov	ax,20h
	push	ax
	mov	ax,word ptr (0-0ah)[bp]
	sub	ax,word ptr (0-6h)[bp]
	add	ax,word ptr (0-8h)[bp]
	push	ax
	call	repeat_char
	add	sp,4h
	cmp	word ptr 8h[bp],0h
	jz	field_done
	call	highlight_off

field_done:
	mov	sp,bp
	pop	bp
	ret

; Report a missing kernel table if the selected directory entry is FFFFh.
require_slot:
	push	bp
	mov	bp,sp
	cmp	word ptr 4h[bp],0ffffh
	jnz	slot_present
	mov	ax,offset missing_table_msg
	push	ax
	call	fatal_message
	inc	sp
	inc	sp
	jmps	slot_checked

slot_present:
	mov	ax,word ptr 4h[bp]

slot_checked:
	pop	bp
	ret

; Include the NUL terminator when writing a selected string.
write_string_slot:
	push	bp
	mov	bp,sp
	push	word ptr 6h[bp]
	call	string_length
	inc	sp
	inc	sp
	inc	ax
	push	ax
	push	word ptr 6h[bp]
	mov	ax,offset slot_offsets
	push	ax
	mov	ax,word ptr 4h[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	push	word ptr [bx]
	call	require_slot
	inc	sp
	inc	sp
	push	ax
	call	write_bytes
	add	sp,6h
	pop	bp
	ret

write_block_slot:
	push	bp
	mov	bp,sp
	push	word ptr 8h[bp]
	push	word ptr 6h[bp]
	mov	ax,offset slot_offsets
	push	ax
	mov	ax,word ptr 4h[bp]
	shl	ax,1
	pop	bx
	add	bx,ax
	push	word ptr [bx]
	call	require_slot
	inc	sp
	inc	sp
	push	ax
	call	write_bytes
	add	sp,6h
	pop	bp
	ret

; Confirm installation, then write the language, console mappings and five printer records.
save_national_settings:
	push	bp
	mov	bp,sp
	mov	ax,1fh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	mov	ax,20h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,21h
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	sub	ax,ax
	push	ax
	mov	al,2h
	push	ax
	call	draw_options
	add	sp,8h
	cmp	ax,1h
	jnz	confirm_install
	jmp	install_done

confirm_install:
	mov	ax,1bh
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	call	show_menu_title
	inc	sp
	inc	sp
	sub	ax,ax
	push	ax
	call	message_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0eh
	push	ax
	call	write_string_slot
	add	sp,4h
	mov	ax,1h
	push	ax
	mov	ax,language_index
	push	ax
	sub	ax,ax
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,1h
	push	ax
	mov	ax,keyboard_mode_flags
	push	ax
	mov	ax,word ptr .keyboard_index
	shl	ax,1
	pop	bx
	add	ax,bx
	push	ax
	mov	ax,1h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,1h
	push	ax
	mov	ax,keyboard_index
	push	ax
	mov	ax,2h
	push	ax
	call	write_block_slot
	add	sp,6h
	cmp	word ptr .alternate_keyboard,0h
	jnz	save_alt_keyboard
	mov	ax,36h
	push	ax
	sub	ax,ax
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,3h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,36h
	push	ax
	mov	al,1h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,4h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,36h
	push	ax
	mov	al,2h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,5h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,6h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,9h
	push	ax
	call	write_string_slot
	add	sp,4h
	jmps	save_case_tables

save_alt_keyboard:
	mov	ax,36h
	push	ax
	mov	al,0dh
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,3h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,36h
	push	ax
	mov	al,0eh
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,4h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,36h
	push	ax
	mov	al,0fh
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,5h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,10h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,9h
	push	ax
	call	write_string_slot
	add	sp,4h

save_case_tables:
	mov	ax,3h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,6h
	push	ax
	call	write_string_slot
	add	sp,4h
	mov	ax,4h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,7h
	push	ax
	call	write_string_slot
	add	sp,4h
	mov	ax,5h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,8h
	push	ax
	call	write_string_slot
	add	sp,4h
	mov	word ptr .device_index,0h
	jmp	test_printer_record

; Keep the physical device and handler; reset the model flags and cached character set.
prepare_printer_record:
	mov	ax,offset device_records
	push	ax
	mov	ax,0bh
	mul	word ptr .device_index
	pop	bx
	add	ax,bx
	push	ax
	mov	ax,selected_printers
	push	ax
	mov	ax,word ptr .device_index
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	ax,word ptr [bx]
	pop	bx
	mov	byte ptr 1h[bx],al
	mov	ax,offset device_records
	push	ax
	mov	ax,0bh
	mul	word ptr .device_index
	pop	bx
	add	ax,bx
	push	ax
	mov	ax,printer_capabilities
	push	ax
	mov	ax,selected_printers
	push	ax
	mov	ax,word ptr .device_index
	shl	ax,1
	pop	bx
	add	bx,ax
	mov	bx,word ptr [bx]
	pop	ax
	add	bx,ax
	mov	al,byte ptr [bx]
	xor	ah,ah
	pop	bx
	mov	word ptr 2h[bx],ax
	inc	word ptr .device_index

test_printer_record:
	cmp	word ptr .device_index,5h
	jl	prepare_printer_record
	mov	ax,37h
	push	ax
	mov	ax,offset device_records
	push	ax
	mov	ax,0ah
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,30h
	push	ax
	mov	al,7h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0bh
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,30h
	push	ax
	mov	al,8h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0ch
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,5h
	push	ax
	mov	al,9h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0dh
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,5h
	push	ax
	mov	al,0ah
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,0fh
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,8h
	push	ax
	mov	al,0bh
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,10h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,8h
	push	ax
	mov	al,0ch
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,11h
	push	ax
	call	write_block_slot
	add	sp,6h
	mov	ax,1h
	push	ax
	mov	ax,alternate_keyboard
	push	ax
	mov	ax,12h
	push	ax
	call	write_block_slot
	add	sp,6h
	cmp	word ptr .alternate_keyboard,0h
	jnz	save_alt_overrides
	mov	ax,11h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,13h
	push	ax
	call	write_string_slot
	add	sp,4h
	mov	ax,12h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,14h
	push	ax
	call	write_string_slot
	add	sp,4h
	jmps	flush_install

save_alt_overrides:
	mov	ax,13h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,13h
	push	ax
	call	write_string_slot
	add	sp,4h
	mov	ax,14h
	push	ax
	call	translation_address
	inc	sp
	inc	sp
	push	ax
	mov	ax,14h
	push	ax
	call	write_string_slot
	add	sp,4h

; Commit the final dirty block and close the system FCB.
flush_install:
	call	flush_dirty_block
	mov	ax,system_fcb
	push	ax
	mov	ax,10h
	push	ax
	call	file_bdos_result
	add	sp,4h

install_done:
	pop	bp
	ret

bdos_result:
	push	bp
	mov	bp,sp
	sub	sp,6h
	push	word ptr 6h[bp]
	push	word ptr 4h[bp]
	call	bdos
	add	sp,4h
	mov	word ptr (0-6h)[bp],ax
	mov	ax,word ptr .runtime_ax
	mov	word ptr .os_result,ax
	mov	sp,bp
	pop	bp
	ret

file_bdos_result:
	push	bp
	mov	bp,sp
	sub	sp,6h
	push	word ptr 6h[bp]
	push	word ptr 4h[bp]
	call	bdos
	add	sp,4h
	mov	word ptr (0-6h)[bp],ax
	mov	ax,word ptr .runtime_ax
	mov	word ptr .os_result,ax
	mov	sp,bp
	pop	bp
	ret

call_main:
	call	national_main
	ret

initialize_video:
	push	bp
	mov	bp,sp
	push	si
	push	di
	push	es
	mov	cl,9ah
	int	0e0h
	mov	word ptr .1e6h,es
	mov	ax,10h
	mov	dx,0ffh
	call	xios_call
	mov	word ptr .1e4h,ax
	cmp	ax,0ffffh
	jz	no_direct_video
	cmp	ax,0c00h
	jnc	use_direct_video

no_direct_video:
	mov	word ptr .1e2h,0h
	jmps	video_init_done

use_direct_video:
	mov	word ptr .1e2h,1h
	mov	cl,99h
	int	0e0h
	mov	byte ptr .1ech,al
	call	get_console_pointer
	mov	al,byte ptr .1ech
	cmp	al,byte ptr .1e8h
	jnc	no_direct_video
	call	get_window_data
	mov	ax,es:word ptr 16h[bx]
	mov	word ptr .1eah,ax
	cmp	ax,es:word ptr 18h[bx]
	jnz	load_video_pointers
	mov	word ptr .1e2h,3h

load_video_pointers:
	call	refresh_window_data
	call	get_window_data
	mov	es,es:word ptr 16h[bx]
	cmp	es:byte ptr .0h,20h
	jz	video_init_done
	mov	word ptr .1e2h,0h

video_init_done:
	pop	es
	pop	di
	pop	si
	pop	bp
	ret
	mov	ax,word ptr .1e2h
	ret

refresh_console:
	push	bp
	push	si
	push	di
	push	es
	cmp	word ptr .1e2h,3h
	jz	refresh_done
	call	refresh_window_data

refresh_done:
	pop	es
	pop	di
	pop	si
	pop	bp
	ret

write_video_string:
	push	bp
	mov	bp,sp
	push	si
	push	di
	push	es
	call	video_cell_address
	mov	si,word ptr 4h[bp]

next_video_char:
	lodsb
	test	al,al
	jz	advance_video_cursor
	stosw
	jmps	next_video_char

advance_video_cursor:
	dec	si
	sub	si,word ptr 4h[bp]
	mov	ax,si
	add	dl,al
	call	update_cursor
	pop	es
	pop	di
	pop	si
	pop	bp
	ret

fill_video_cells:
	push	bp
	mov	bp,sp
	push	si
	push	di
	push	es
	call	video_cell_address
	mov	al,byte ptr 4h[bp]
	mov	cx,word ptr 6h[bp]
	add	dl,cl
	cld
	rep	stosw
	call	update_cursor
	pop	es
	pop	di
	pop	si
	pop	bp
	ret

query_console:
	push	bp
	push	si
	push	di
	push	es
	mov	dl,byte ptr .1ech
	mov	ax,10h
	call	xios_call
	mov	es,word ptr .1e6h
	mov	dl,byte ptr .1ech
	mov	cx,es:word ptr 2h[bx]
	mov	bx,es:word ptr 4h[bx]
	mov	ax,14h
	call	xios_call
	pop	es
	pop	di
	pop	si
	pop	bp
	ret

get_console_pointer:
	les	bx,dword ptr .1e4h
	mov	al,es:byte ptr 1h[bx]
	mov	byte ptr .1e8h,al
	cbw
	mov	si,ax
	mov	al,es:byte ptr 1h[bx+si]
	mov	byte ptr .1e9h,al
	ret

get_window_data:
	mov	dl,byte ptr .1ech
	mov	ax,10h
	call	xios_call
	mov	es,word ptr .1e6h
	ret

refresh_window_data:
	call	get_console_pointer
	mov	dl,al
	sub	cx,cx
	mov	ax,7h
	jmp	xios_call

; Map the current console cursor to its character/attribute word in video memory.
video_cell_address:
	call	get_window_data
	mov	dx,es:word ptr [bx]
	mov	al,50h
	mul	dh
	add	al,dl
	adc	ah,0h
	mov	di,ax
	shl	di,1
	mov	ah,es:byte ptr 1ch[bx]
	mov	es,es:word ptr 16h[bx]
	ret

xios_call:
	push	ds
	mov	ds,word ptr .1e6h
	mov	si,word ptr .68h
	mov	es,word ptr 10h[si]
	callf	dword ptr .28h
	pop	ds
	ret

update_cursor:
	xchg	dl,dh
	add	dx,2020h
	mov	word ptr .1f2h,dx
	mov	dx,1f0h
	mov	cx,9h
	int	0e0h
	ret
	db	0h

; Round requests to six-byte allocation units and obtain a checked free-list block.
allocate:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,word ptr 4h[bp]
	add	ax,6h
	dec	ax
	mov	bx,6h
	sub	dx,dx
	div	bx
	inc	ax
	mov	si,ax
	push	si
	call	find_free_block
	inc	sp
	inc	sp
	mov	di,ax
	or	ax,ax
	jnz	allocate_from_block
	sub	ax,ax
	jmps	allocate_done

allocate_from_block:
	push	si
	push	di
	call	split_block
	add	sp,4h

allocate_done:
	pop	di
	pop	si
	pop	bp
	ret

find_free_block:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,word ptr .free_list
	mov	di,ax
	mov	ax,word ptr [di]
	mov	si,ax

examine_free_block:
	mov	ax,word ptr 2h[si]
	push	ax
	mov	bx,word ptr 4h[si]
	pop	ax
	xor	ax,bx
	not	ax
	or	ax,ax
	jz	check_capacity
	mov	ax,1h
	push	ax
	call	heap_error_hook
	inc	sp
	inc	sp
	sub	ax,ax
	jmps	find_block_done

check_capacity:
	mov	ax,word ptr 2h[si]
	cmp	ax,word ptr 4h[bp]
	jc	test_arena_end
	mov	ax,di
	jmps	find_block_done

test_arena_end:
	cmp	si,word ptr .free_list
	jnz	next_free_block
	push	word ptr 4h[bp]
	call	extend_arena
	inc	sp
	inc	sp
	mov	si,ax
	or	ax,ax
	jnz	next_free_block
	mov	ax,2h
	push	ax
	call	heap_error_hook
	inc	sp
	inc	sp
	sub	ax,ax
	jmps	find_block_done

next_free_block:
	mov	di,si
	mov	ax,word ptr [si]
	mov	si,ax
	jmps	examine_free_block

find_block_done:
	pop	di
	pop	si
	pop	bp
	ret

split_block:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	bx,word ptr 4h[bp]
	mov	ax,word ptr [bx]
	mov	si,ax
	mov	ax,word ptr 2h[si]
	push	ax
	mov	ax,word ptr 6h[bp]
	add	ax,4h
	pop	bx
	cmp	bx,ax
	ja	split_tail
	push	word ptr 4h[bp]
	mov	ax,word ptr [si]
	pop	bx
	mov	word ptr [bx],ax
	jmps	remember_allocated

split_tail:
	mov	ax,6h
	mul	word ptr 6h[bp]
	xchg	ax,bx
	mov	ax,si
	add	ax,bx
	mov	di,ax
	push	di
	mov	ax,word ptr 2h[si]
	sub	ax,word ptr 6h[bp]
	pop	bx
	mov	word ptr 2h[bx],ax
	push	di
	mov	ax,word ptr 2h[di]
	not	ax
	pop	bx
	mov	word ptr 4h[bx],ax
	push	di
	mov	ax,word ptr [si]
	pop	bx
	mov	word ptr [bx],ax
	mov	bx,word ptr 4h[bp]
	mov	word ptr [bx],di
	mov	bx,si
	mov	ax,word ptr 6h[bp]
	mov	word ptr 2h[bx],ax
	push	si
	mov	ax,word ptr 2h[si]
	not	ax
	pop	bx
	mov	word ptr 4h[bx],ax

remember_allocated:
	mov	ax,word ptr 4h[bp]
	mov	word ptr .free_list,ax
	lea	ax,word ptr 6h[si]
	pop	di
	pop	si
	pop	bp
	ret

extend_arena:
	push	bp
	mov	bp,sp
	push	si
	push	di
	dec	sp
	dec	sp
	mov	ax,word ptr 4h[bp]
	add	ax,3fh
	mov	cl,6h
	shr	ax,cl
	mov	cl,6h
	shl	ax,cl
	mov	word ptr (0-6h)[bp],ax
	mov	ax,6h
	mul	word ptr (0-6h)[bp]
	push	ax
	call	grow_heap
	inc	sp
	inc	sp
	mov	si,ax
	cmp	si,0ffffh
	jnz	initialize_extent
	sub	ax,ax
	jmps	extend_done

initialize_extent:
	mov	ax,si
	inc	ax
	cwd
	push	dx
	push	ax
	sub	ax,ax
	push	ax
	inc	ax
	push	ax
	call	long_complement
	call	long_and
	pop	ax
	pop	dx
	mov	si,ax
	mov	di,si
	mov	bx,di
	mov	ax,word ptr (0-6h)[bp]
	mov	word ptr 2h[bx],ax
	push	di
	mov	ax,word ptr 2h[di]
	not	ax
	pop	bx
	mov	word ptr 4h[bx],ax
	lea	ax,word ptr 6h[di]
	push	ax
	call	free_block
	inc	sp
	inc	sp
	mov	ax,word ptr .free_list

extend_done:
	lea	sp,word ptr (0-4h)[bp]
	pop	di
	pop	si
	pop	bp
	ret

; Validate the size complement and coalesce neighboring free blocks in address order.
free_block:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,word ptr 4h[bp]
	sub	ax,6h
	mov	si,ax
	mov	ax,word ptr 2h[si]
	push	ax
	mov	bx,word ptr 4h[si]
	pop	ax
	xor	ax,bx
	not	ax
	or	ax,ax
	jz	start_free_search
	mov	ax,3h
	push	ax
	call	heap_error_hook
	inc	sp
	inc	sp
	mov	ax,0ffffh
	jmp	free_done

start_free_search:
	mov	ax,word ptr .free_list
	mov	di,ax
	jmps	repeat_free_search

scan_neighbors:
	cmp	si,di
	jc	test_list_wrap
	mov	ax,word ptr [di]
	cmp	si,ax
	jc	check_overlap

test_list_wrap:
	mov	ax,word ptr [di]
	cmp	di,ax
	jc	next_interval
	mov	ax,word ptr [di]
	cmp	si,ax
	jna	found_interval
	cmp	si,di
	jc	next_interval

found_interval:
	jmps	check_overlap

next_interval:
	mov	ax,word ptr [di]
	mov	di,ax

repeat_free_search:
	jmps	scan_neighbors

check_overlap:
	cmp	si,di
	jc	merge_upper
	mov	ax,word ptr 2h[si]
	mov	dx,6h
	mul	dx
	xchg	ax,bx
	mov	ax,si
	add	ax,bx
	push	ax
	mov	ax,word ptr 2h[di]
	mov	dx,6h
	mul	dx
	xchg	ax,bx
	mov	ax,di
	add	ax,bx
	pop	bx
	cmp	bx,ax
	ja	merge_upper
	mov	word ptr .free_list,di
	sub	ax,ax
	jmps	free_done

merge_upper:
	mov	ax,word ptr 2h[si]
	mov	dx,6h
	mul	dx
	xchg	ax,bx
	mov	ax,si
	add	ax,bx
	push	ax
	mov	ax,word ptr [di]
	pop	bx
	cmp	bx,ax
	jnz	link_upper
	push	si
	mov	bx,word ptr [di]
	mov	ax,word ptr 2h[bx]
	pop	bx
	add	word ptr 2h[bx],ax
	push	si
	mov	ax,word ptr 2h[si]
	not	ax
	pop	bx
	mov	word ptr 4h[bx],ax
	push	si
	mov	bx,word ptr [di]
	mov	ax,word ptr [bx]
	pop	bx
	mov	word ptr [bx],ax
	jmps	merge_lower

link_upper:
	push	si
	mov	ax,word ptr [di]
	pop	bx
	mov	word ptr [bx],ax

merge_lower:
	mov	ax,word ptr 2h[di]
	mov	dx,6h
	mul	dx
	xchg	ax,bx
	mov	ax,di
	add	ax,bx
	cmp	ax,si
	jnz	link_lower
	push	di
	mov	ax,word ptr 2h[si]
	pop	bx
	add	word ptr 2h[bx],ax
	push	di
	mov	ax,word ptr 2h[di]
	not	ax
	pop	bx
	mov	word ptr 4h[bx],ax
	push	di
	mov	ax,word ptr [si]
	pop	bx
	mov	word ptr [bx],ax
	jmps	finish_free

link_lower:
	mov	word ptr [di],si

finish_free:
	mov	word ptr .free_list,di
	sub	ax,ax

free_done:
	pop	di
	pop	si
	pop	bp
	ret

; Copy forward or backward according to overlap, then finish the resized allocation.
resize_block:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	si,word ptr 4h[bp]
	sub	sp,4h
	push	si
	call	free_block
	inc	sp
	inc	sp
	mov	ax,word ptr 6h[bp]
	add	ax,6h
	dec	ax
	mov	bx,6h
	sub	dx,dx
	div	bx
	inc	ax
	mov	word ptr (0-6h)[bp],ax
	push	ax
	call	find_free_block
	inc	sp
	inc	sp
	mov	word ptr (0-8h)[bp],ax
	or	ax,ax
	jnz	move_resized_data
	sub	ax,ax
	jmps	resize_done

move_resized_data:
	mov	bx,word ptr (0-8h)[bp]
	mov	ax,word ptr [bx]
	add	ax,6h
	mov	di,ax
	cmp	si,di
	jz	finish_resize
	cmp	di,si
	jnc	prepare_backward
	jmps	test_forward

copy_forward:
	mov	ax,di
	inc	di
	push	ax
	mov	ax,si
	inc	si
	xchg	ax,bx
	mov	al,byte ptr [bx]
	pop	bx
	mov	byte ptr [bx],al
	dec	word ptr 6h[bp]

test_forward:
	cmp	word ptr 6h[bp],0h
	jnz	copy_forward
	jmps	finish_resize

prepare_backward:
	mov	ax,word ptr 6h[bp]
	add	di,ax
	mov	ax,word ptr 6h[bp]
	add	si,ax
	jmps	test_backward

copy_backward:
	dec	di
	mov	ax,di
	push	ax
	dec	si
	mov	al,byte ptr [si]
	pop	bx
	mov	byte ptr [bx],al
	dec	word ptr 6h[bp]

test_backward:
	cmp	word ptr 6h[bp],0h
	jnz	copy_backward

finish_resize:
	push	word ptr (0-6h)[bp]
	push	word ptr (0-8h)[bp]
	call	split_block
	add	sp,4h

resize_done:
	lea	sp,word ptr (0-4h)[bp]
	pop	di
	pop	si
	pop	bp
	ret

long_complement:
	push	bp
	mov	bp,sp
	not	word ptr 4h[bp]
	not	word ptr 6h[bp]
	pop	bp
	ret
	push	bp
	mov	bp,sp
	sub	ax,ax
	test	word ptr 4h[bp],0ffffh
	jnz	store_long_boolean
	test	word ptr 6h[bp],0ffffh
	jnz	store_long_boolean
	inc	ax

store_long_boolean:
	mov	word ptr 4h[bp],ax
	mov	word ptr 6h[bp],0h
	pop	bp
	ret

long_and:
	push	bp
	mov	bp,sp
	mov	ax,word ptr 4h[bp]
	mov	bx,word ptr 6h[bp]
	and	word ptr 8h[bp],ax
	and	word ptr 0ah[bp],bx
	pop	bp
	ret	04h
	push	bp
	mov	bp,sp
	mov	ax,word ptr 4h[bp]
	mov	bx,word ptr 6h[bp]
	or	word ptr 8h[bp],ax
	or	word ptr 0ah[bp],bx
	pop	bp
	ret	04h
	push	bp
	mov	bp,sp
	mov	ax,word ptr 4h[bp]
	mov	bx,word ptr 6h[bp]
	xor	word ptr 8h[bp],ax
	xor	word ptr 0ah[bp],bx
	pop	bp
	ret	04h
	push	bp
	mov	bp,sp
	mov	cx,word ptr 4h[bp]
	jcxz	left_done
	mov	bx,word ptr 0ah[bp]
	mov	ax,word ptr 8h[bp]

shift_long_left:
	shl	ax,1
	rcl	bx,1
	loop	shift_long_left
	mov	word ptr 0ah[bp],bx
	mov	word ptr 8h[bp],ax

left_done:
	pop	bp
	ret	04h
	push	bp
	mov	bp,sp
	mov	cx,word ptr 4h[bp]
	jcxz	right_done
	mov	bx,word ptr 0ah[bp]
	mov	ax,word ptr 8h[bp]

shift_long_right:
	shr	bx,1
	rcr	ax,1
	loop	shift_long_right
	mov	word ptr 0ah[bp],bx
	mov	word ptr 8h[bp],ax

right_done:
	pop	bp
	ret	04h
	db	0h
	ret

heap_error_hook:
	ret

; Classify the BDOS release for the runtime feature mask.
identify_os:
	sub	ax,ax
	push	ax
	mov	al,0ch
	push	ax
	call	bdos
	add	sp,4h
	mov	ax,word ptr .runtime_ax
	mov	word ptr .runtime_version,ax
	jmps	classify_version

legacy_os_flags:
	or	word ptr .runtime_features,25h
	jmp	os_done

query_os_release:
	sub	ax,ax
	push	ax
	mov	al,0a3h
	push	ax
	call	bdos
	add	sp,4h
	jmps	dispatch_release

plain_release:
	or	word ptr .runtime_features,0h

flag_multiuser:
	or	word ptr .runtime_features,40h
	jmps	check_optional_calls

concurrent_release:
	or	word ptr .runtime_features,0h

flag_concurrent:
	or	word ptr .runtime_features,0c5h
	jmps	check_optional_calls

dispatch_release:
	mov	ax,word ptr .runtime_ax
	cmp	ax,1420h
	jz	flag_concurrent
	cmp	ax,1431h
	jz	concurrent_release
	cmp	ax,22h
	jz	flag_multiuser
	cmp	ax,1031h
	jz	plain_release
	jmps	concurrent_release

check_optional_calls:
	call	probe_bdos_mode
	jmps	os_done

native_concurrent_flags:
	or	word ptr .runtime_features,0c5h
	jmps	os_done

os_flags_ready:
	jmps	os_done
	jmps	os_done

classify_version:
	mov	ax,word ptr .runtime_version
	cmp	ax,3022h
	jz	os_flags_ready
	cmp	ax,2022h
	jz	os_flags_ready
	cmp	ax,22h
	jz	os_flags_ready
	cmp	ax,1031h
	jz	native_concurrent_flags
	cmp	ax,1431h
	jz	query_os_release
	cmp	ax,1130h
	jz	legacy_os_flags
	cmp	ax,1430h
	jnz	query_extended_version
	jmp	legacy_os_flags

query_extended_version:
	jmps	query_os_release

os_done:
	ret

probe_bdos_mode:
	sub	ax,ax
	push	ax
	mov	al,44h
	push	ax
	call	bdos
	add	sp,4h
	cmp	word ptr .runtime_ax,0ffffh
	jz	mode_unavailable
	cmp	word ptr .runtime_ax,0h
	jz	mode_unavailable
	or	word ptr .runtime_features,2h
	sub	ax,ax
	jmps	mode_done

mode_unavailable:
	mov	ax,0ffffh

mode_done:
	ret

append_string:
	mov	dx,0ffffh
	jmp	string_copy_common

copy_string:
	mov	dx,1h

string_copy_common:
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,ds
	mov	es,ax
	mov	di,word ptr 6h[bp]
	sub	al,al
	mov	cx,0ffffh
	repne	scasb
	xchg	cx,dx
	mov	di,word ptr 4h[bp]
	repne	scasb
	dec	di
	mov	si,word ptr 6h[bp]
	not	dx
	mov	cx,dx
	shr	cx,1
	rep	movsw
	jnc	return_dest
	movsb

return_dest:
	mov	ax,word ptr 4h[bp]

string_done:
	pop	di
	pop	si
	pop	bp
	ret
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,ds
	mov	es,ax
	mov	di,word ptr 6h[bp]
	sub	ax,ax
	mov	cx,0ffffh
	repne	scasb
	not	cx
	mov	si,word ptr 4h[bp]
	mov	di,word ptr 6h[bp]
	repe	cmpsb
	jz	string_done

compare_mismatch:
	jg	compare_greater
	dec	ax
	jmps	string_done

compare_greater:
	inc	ax
	jmps	string_done
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	ax,ds
	mov	es,ax
	mov	di,word ptr 6h[bp]
	sub	ax,ax
	mov	cx,0ffffh
	repne	scasb
	not	cx
	mov	si,word ptr 4h[bp]
	mov	di,word ptr 6h[bp]

compare_next:
	repe	cmpsb
	jz	string_done
	mov	bh,byte ptr (0-1h)[si]
	mov	bl,es:byte ptr (0-1h)[di]
	sub	bh,61h
	cmp	bh,19h
	ja	fold_first
	add	bh,0e0h

fold_first:
	add	bh,61h
	sub	bl,61h
	cmp	bl,19h
	ja	fold_second
	add	bl,0e0h

fold_second:
	add	bl,61h
	cmp	bh,bl
	jz	compare_next
	jmps	compare_mismatch

string_length:
	mov	bx,sp
	push	di
	mov	ax,ds
	mov	es,ax
	mov	di,ss:word ptr 2h[bx]
	sub	al,al
	mov	cx,0ffffh
	repne	scasb
	not	cx
	mov	ax,cx
	dec	ax
	pop	di
	ret

