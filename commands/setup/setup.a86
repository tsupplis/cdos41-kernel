limit_instructions	db	'     Enter a three digit decimal number to set a new Maximum Value in '
	db	0h
	db	'Kilobytes (Kb).   The new Maximum Value must be between 64 and 999 Kb.'
	db	0h
	db	'To enter a value less than 100 Kb, be sure to start with a zero.'
	db	0h,0h
	db	'ENTER MAXIMUM VALUE'
	db	0h

decimal_input_prompt	db	' __'
	db	8h,8h,8h,1bh,65h
	db	0h

msg_value_is_too_small	db	' Value is Too Small '
	db	0h

msg_value_is_too_large	db	' Value is Too Large '
	db	0h

scroll_instructions	db	'    This option lets you select how the video memory on a color monitor'
	db	0h
	db	'is to be accessed.  Your choice will affect the appearance and speed of'
	db	0h
	db	'the color monitor.  Try each of the modes available, and choose the one'
	db	0h
	db	'which best suits the hardware of your system and your personal taste.'
	db	0h
	db	0h

scroll_caption	db	'The current Color Monitor Scroll Mode is:  '
	db	0h

scroll_captions	dw	offset scroll_fast,offset scroll_smooth,offset scroll_wide

scroll_fast	db	'Fast/Flicker'
	db	0h

scroll_smooth	db	'Slow/Smooth '
	db	0h

scroll_wide	db	'Wide Open   '
	db	0h

scroll_buttons	db	1	; number of buttons
	db	16,20,'F3 Change the Scroll Mode',0

scroll_keys	db	3,3,1,97	; count followed by accepted key codes

update_instructions	db	'       You may now exit SETUP, saving your changes to the Update Disk,'
	db	0h
	db	'or you may select a different Update Disk.  A CCPM.SYS file must be on'
	db	0h
	db	'the Update Disk for the changes to be saved.   The changes will be put'
	db	0h
	db	'into effect at the next Power-On or System Reset using the Update Disk.'
	db	0h
	db	0h

update_buttons	db	2	; number of buttons
	db	14,20,'F3 Select the Update Disk',0
	db	17,20,'F5 Update System and Exit',0

drive_caption	db	'The current Update Disk is:  '
	db	0h

update_keys	db	4,3,5,1,97	; count followed by accepted key codes

drive_instructions	db	'       Enter the designation letter for the Disk upon which you would'
	db	0h
	db	'like your changes saved.  You may use any letter from A to P, as long'
	db	0h
	db	'as it corresponds to an actual Disk Drive.'
	db	0h
	db	0h

drive_input_prompt	db	1bh,65h
	db	0h

record_buffer	db	0h

system_code_paragraphs	rb	639

system_fcb	db	0h
	db	'CCPM    '

system_fcb_type	db	'SYS'

system_fcb_extent	rb	21

system_random_record	rb	3

config_record_offset	db	0h
	db	0h

updating_system	db	'Updating CCPM.SYS on drive '
	db	0h

missing_system_file	db	' Can',27h,'t find CCPM.SYS '
	db	0h

system_read_error	db	' Can',27h,'t read CCPM.SYS '
	db	0h

system_write_error	db	' Can',27h,'t write to CCPM.SYS '
	db	0h

wrong_system_version	db	' Wrong version of CCPM.SYS '
	rb	3
help_index_block	dw	0h

; Eight 128-byte HELP index records, 64 sixteen-byte entries.
help_index_cache	rb	400h	; zero-filled workspace
help_saved_index	dw	0h
help_version	dw	0h
help_index_step	dw	0h
help_index_pointer	dw	0h
help_global_index	dw	0h
help_index_position	dw	0h
help_listing_position	dw	0h
help_listing_cursor	dw	0h
help_listing_delta	dw	0h
help_listing_stride	dw	0h
help_displayed_topics	dw	0h
help_search_cursor	dw	0h
help_list_mode	db	0h
help_no_page_mode	db	0h
help_create_mode	db	0h
help_extract_mode	db	0h
help_page_mode	db	0h
help_file_status	db	0h
help_end_of_data	db	0h

; Retained HELP utility secondary FCB workspace.
help_secondary_fcb	rb	24h	; zero-filled workspace
help_token_count	dw	0h
help_search_level	db	0h

; Space-padded subtopic name.
help_subtopic_name	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h

; Eleven 15-byte topic slots (12-character name and three work bytes).
help_topic_tokens	rb	0a5h	; zero-filled workspace

; Temporary topic name.
help_name_buffer	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
help_parent_level	db	0h
help_level	dw	0h
help_page_length	db	0h

; Console clear-screen string and associated buffer space.
help_clear_screen	db	1bh,45h,24h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h
help_compare_result	db	0h
help_compare_index	db	0h
help_records_per_block	dw	0h
help_step_count	db	0h
help_record_number	db	0h
help_record_index	db	0h
help_page_stop	db	0h
help_parse_index	db	0h
help_parse_level	db	0h
help_input_index	db	0h
help_token_character_index	dw	0h
help_parse_done	db	0h
help_option_seen	db	0h
help_listing_level	db	0h
help_listing_character	dw	0h
help_listing_top_level	db	0h
help_listing_heading_shown	db	0h

; Topic name assembled for display; terminator follows.
help_listing_text	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h
help_listing_terminator	db	0h
help_last_token	db	0h
help_search_done	db	0h
help_search_failed	db	0h
help_search_restart	db	0h
help_search_matched	db	0h
help_search_passed_name	db	0h
help_parent_token_saved	db	0h
help_compare_byte	db	0h
help_token_display_index	db	0h
help_token_indent	db	0h
help_text_index	db	0h
help_delimiter_count	db	0h
help_text_character	dw	0h

; Up to three consecutive delimiter bytes.
help_delimiter_buffer	db	0h,0h,0h
help_prompt_tokens	db	0h
help_open_status	dw	0h

; Retained workspace/alignment between records.
help_reserved_byte_4	db	0h
help_printer_number	db	0h

; Retained printer-status diagnostic.
help_printer_busy	db	0h,0dh,0ah
	db	'Printer Busy'
	db	0dh,0ah,24h
help_pending_key	dw	0h
help_extended_key	db	0h
help_retype_width	db	0h

; Retained workspace/alignment between records.
help_edit_padding	db	0h
help_prompt_column	db	0h
help_editor_sp	dw	0h
help_editor_buffer	dw	0h
help_editor_es	dw	0h


	rb	9	; paragraph alignment
help_line_count	equ	help_level+1h
help_topic_finished	equ	help_text_character+1h


	sseg
	rb	2fh
	db	0
	end
