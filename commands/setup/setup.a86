;*****************************************************
;*
;*   SETUP - Concurrent DOS IBM PC/XT system customization
;*
;*****************************************************
;
; Select hardware settings with function keys. F1 opens HELP.HLP.
; F10 opens the update menu. Escape quits without writing CCPM.SYS.
; The command tail can also select one of the eight slash entries in tail_dispatch.
; Reconstructed from the 4.11 release. The displayed utility version is 4.1.

xios_gate equ 28h	; far XIOS entry in SYSDAT, addressed through DS

help_main_stack equ 24h

	cseg

entry:
	jmps	initialize
	db	'Copyright (C) 1984, Digital Research'

; Read the running XIOS configuration before interpreting the optional command tail.
initialize:
	call	check_version
	call	check_console
	call	flush_keyboard
	call	get_system_context
	call	get_xios_parameters
	call	draw_frame
	call	load_configuration
	call	dispatch_command_tail

main_menu_loop:
	call	clear_menu
	call	draw_main_menu
	mov	di,offset main_keys
	call	read_menu_choice
	call	cs:word ptr main_choices[bx]
	jmps	main_menu_loop

main_choices:
	dw	parameters_menu,mdisk_menu,head_step_menu,verify_menu,serial_menu,memory_limit_menu,scroll_menu,main_help,update_menu,exit_setup

return_to_menu:
	ret

main_help:
	lea	si,msg_setup
	jmp	open_help_topic

; Check the BDOS family and the BDOS 163 release word before calling private XIOS services.
check_version:
	mov	cx,0ch
	int	0e0h
	and	ah,0fh
	cmp	ah,4h
	jz	check_system_release
	cmp	ah,6h
	jnz	wrong_version

check_system_release:
	mov	cx,0a3h
	int	0e0h
	cmp	ax,1441h
	jnz	wrong_version
	ret

wrong_version:
	mov	dx,offset version_error
	jmps	print_startup_error

check_console:
	mov	cl,99h
	int	0e0h
	cmp	al,4h
	jnc	serial_console_error
	cbw
	mov	word ptr console_number,ax
	ret

serial_console_error:
	lea	dx,terminal_error

print_startup_error:
	mov	cx,9h
	int	0e0h

terminate:
	xor	cx,cx
	xor	dx,dx
	int	0e0h
	jmps	terminate

; Toggle which live settings will be captured when the user updates the system file.
parameters_menu:
	mov	si,offset parameters_title
	mov	ax,offset parameters_instructions
	call	show_page
	mov	si,offset parameters_buttons
	call	draw_options

parameters_loop:
	call	show_save_flags
	mov	dh,0ah
	call	select_prompt
	mov	di,offset parameters_keys
	call	read_menu_choice
	jmp	cs:word ptr parameters_choices[bx]

parameters_choices:
	dw	toggle_keys,toggle_ports,parameters_help,return_to_menu

parameters_help:
	lea	si,msg_setup_params
	call	open_help_topic
	jmp	parameters_menu

toggle_keys:
	xor	byte ptr save_keys,0ffh
	jmp	parameters_loop

toggle_ports:
	xor	byte ptr save_ports,0ffh
	jmp	parameters_loop

show_save_flags:
	mov	dx,0c0ch
	mov	cx,2h
	mov	bx,offset save_keys
	call	reverse_video

next_save_flag:
	mov	si,offset msg_saved
	test	byte ptr [bx],0ffh
	jnz	print_save_flag
	mov	si,offset blank_save_state

print_save_flag:
	call	print_positioned
	inc	bx
	add	dh,3h
	loop	next_save_flag
	jmp	normal_video

; Select a starting segment for the RAM disk. Its size is the contiguous memory above that segment.
mdisk_menu:
	mov	si,offset msg_mdisk
	mov	ax,offset mdisk_instructions
	call	show_page
	mov	si,offset mdisk_buttons
	call	draw_options
	mov	dh,0ch
	call	select_prompt

mdisk_loop:
	call	show_mdisk
	mov	di,offset mdisk_keys
	call	read_menu_choice
	jmp	cs:word ptr mdisk_choices[bx]

mdisk_choices:
	dw	increase_mdisk,decrease_mdisk,enter_mdisk_address,mdisk_help,return_to_menu

mdisk_help:
	lea	si,msg_setup_mdisk
	call	open_help_topic
	jmp	mdisk_menu

; Lower the segment by 0400h paragraphs (16 KiB), stopping at the bottom of the selected bank.
increase_mdisk:
	mov	ax,word ptr mdisk_segment
	test	ax,ax
	jnz	choose_mdisk_bank
	mov	ax,word ptr lower_memory_end

choose_mdisk_bank:
	cmp	ax,0c000h
	jnc	grow_upper_bank
	cmp	ax,4000h
	jz	mdisk_limit_reached
	sub	ax,400h
	cmp	ax,4000h
	jnc	store_mdisk_segment
	mov	ax,4000h
	jmps	store_mdisk_segment

grow_upper_bank:
	cmp	ax,0c000h
	jz	mdisk_limit_reached
	sub	ax,400h
	cmp	ax,0c000h
	jnc	store_mdisk_segment
	mov	ax,0c000h
	jmps	store_mdisk_segment

; Raise the segment in 16 KiB steps. Reaching the end of the bank disables MDisk.
decrease_mdisk:
	mov	ax,word ptr mdisk_segment
	test	ax,ax
	jz	mdisk_limit_reached
	cmp	ax,0c000h
	ja	shrink_upper_bank
	add	ax,400h
	cmp	ax,word ptr lower_memory_end
	jc	store_mdisk_segment
	sub	ax,ax
	jmps	store_mdisk_segment

shrink_upper_bank:
	add	ax,400h
	cmp	ax,0e000h
	jc	store_mdisk_segment
	sub	ax,ax

store_mdisk_segment:
	mov	word ptr mdisk_segment,ax
	jmp	mdisk_loop

mdisk_limit_reached:
	mov	al,7h
	call	write_char
	jmp	mdisk_loop

enter_mdisk_address:
	mov	dh,0ch
	call	clear_menu_row
	mov	si,offset segment_instructions
	mov	dx,0d05h
	call	print_lines
	mov	si,offset hex_input_prompt
	mov	dx,1326h
	call	print_positioned
	call	read_hex_digit
	mov	cl,4h
	shl	al,cl
	mov	dh,al
	call	read_hex_digit
	or	dh,al
	mov	al,66h
	call	terminal_escape
	mov	al,dh
	cmp	al,0h
	jz	accept_segment
	cmp	al,40h
	jc	reject_segment
	cmp	al,90h
	jna	accept_segment
	cmp	al,0c0h
	jc	reject_segment
	cmp	al,0e0h
	jna	accept_segment

reject_segment:
	call	invalid_address
	jmp	mdisk_menu

; DB00h also reinstalls both serial menu handlers in the writable CODE table.
accept_segment:
	mov	dl,0h
	mov	word ptr mdisk_segment,dx
	cmp	dh,0dbh
	jnz	redisplay_mdisk
	mov	bx,offset serial_choices
	db	2eh	; CS override emitted separately to retain the short addressing form.
	mov	word ptr [bx],offset toggle_serial_zero
	db	2eh	; CS override emitted separately to retain the short addressing form.
	mov	word ptr 2[bx],offset toggle_serial_one

redisplay_mdisk:
	jmp	mdisk_menu

show_mdisk:
	mov	si,offset msg_current_mdisk_size
	mov	dx,0a05h
	call	print_positioned
	call	reverse_video
	call	mdisk_size_kb
	call	print_decimal
	mov	si,offset msg_kb
	call	print_string
	call	normal_video
	mov	si,offset msg_current_starting_addre
	mov	dx,0a27h
	call	print_positioned
	call	reverse_video
	mov	dx,word ptr mdisk_segment
	call	print_hex_byte
	xchg	dh,dl
	call	print_hex_byte
	mov	si,offset segment_suffix
	call	print_string
	call	normal_video
	ret

print_hex_byte:
	mov	al,dh
	mov	cl,4h
	shr	al,cl
	call	print_hex_digit
	mov	al,dh
	and	al,0fh

print_hex_digit:
	mov	bx,offset hex_digits
	xlat	hex_digits
	jmp	write_char

; Subtract the starting segment from the end of the selected bank and divide by 64 paragraphs per KiB.
mdisk_size_kb:
	mov	ax,word ptr mdisk_segment
	cmp	ax,0h
	jz	no_mdisk
	mov	dx,word ptr lower_memory_end
	cmp	ax,dx
	jc	paragraphs_to_kb
	cmp	ax,word ptr upper_memory_start
	jc	no_mdisk
	mov	dx,word ptr upper_memory_end
	cmp	ax,dx
	jc	paragraphs_to_kb

no_mdisk:
	sub	ax,ax
	ret

paragraphs_to_kb:
	xchg	ax,dx
	sub	ax,dx
	mov	cl,6h
	shr	ax,cl
	ret

print_decimal:
	mov	dh,0h
	div	byte ptr decimal_hundreds
	call	print_decimal_digit
	mov	al,ah
	cbw
	div	byte ptr decimal_tens
	call	print_decimal_digit
	mov	dh,0ffh
	mov	al,ah

print_decimal_digit:
	push	ax
	or	dh,al
	jz	digit_done
	or	al,30h
	call	write_char

digit_done:
	pop	ax
	ret

read_hex_digit:
	call	read_char
	cmp	al,60h
	jc	lookup_hex_digit
	sub	al,20h

lookup_hex_digit:
	mov	di,offset hex_digits
	mov	cx,10h
	cld
	repne	scasb
	jz	echo_hex_digit
	mov	al,7h
	call	write_char
	jmps	read_hex_digit

echo_hex_digit:
	call	write_char
	mov	al,20h
	call	write_char
	mov	al,8h
	call	write_char
	mov	al,0fh
	sub	al,cl
	ret

invalid_address:
	mov	al,70h
	call	terminal_escape
	mov	si,offset msg_invalid_starting_addre
	mov	dh,13h
	call	print_centered
	mov	al,71h
	call	terminal_escape
	mov	cx,3h

address_error_bell:
	mov	al,7h
	call	write_char
	loop	address_error_bell
	mov	si,offset continue_prompt
	mov	dh,15h
	call	reverse_centered
	jmp	read_char

; Select whether the floppy driver verifies each completed write.
verify_menu:
	mov	si,offset verify_title
	mov	ax,offset verify_instructions
	call	show_page
	mov	si,offset verify_buttons
	call	draw_options
	mov	dh,0dh
	call	select_prompt

verify_loop:
	call	show_verify
	mov	di,offset verify_keys
	call	read_menu_choice
	jmp	cs:word ptr verify_choices[bx]

verify_choices:
	dw	enable_verify,disable_verify,verify_help,return_to_menu

verify_help:
	lea	si,msg_setup_verify
	call	open_help_topic
	jmp	verify_menu

enable_verify:
	mov	byte ptr verify_flag,0ffh
	jmps	verify_loop

disable_verify:
	mov	byte ptr verify_flag,0h
	jmps	verify_loop

show_verify:
	mov	si,offset verify_caption
	mov	dx,0b11h
	call	print_positioned
	call	reverse_video
	mov	si,offset msg_enabled
	test	byte ptr verify_flag,0ffh
	jnz	print_verify_state
	mov	si,offset msg_disabled

print_verify_state:
	call	print_string
	jmp	normal_video

; Change the high nibble of the floppy step-rate parameter. Display the converted time in milliseconds.
head_step_menu:
	mov	si,offset step_title
	mov	ax,offset step_instructions
	call	show_page
	mov	si,offset step_buttons
	call	draw_options
	mov	dh,0dh
	call	select_prompt

step_loop:
	call	show_step
	mov	di,offset step_keys
	call	read_menu_choice
	jmp	cs:word ptr step_choices[bx]

step_choices:
	dw	reduce_step,increase_step,head_step_help,return_to_menu

head_step_help:
	lea	si,msg_setup_hdstep
	call	open_help_topic
	jmp	head_step_menu

reduce_step:
	mov	al,byte ptr head_step
	add	al,10h
	jmps	store_step

increase_step:
	mov	al,byte ptr head_step
	sub	al,10h

store_step:
	jc	step_limit_reached
	mov	byte ptr head_step,al
	jmps	step_loop

step_limit_reached:
	mov	al,7h
	call	write_char
	jmps	step_loop

show_step:
	mov	si,offset step_time_caption
	mov	dx,0b10h
	call	print_positioned
	call	reverse_video
	mov	al,byte ptr head_step
	mov	cl,4h
	shr	al,cl
	or	al,0f0h
	neg	al
	shl	al,1
	aam
	test	ah,ah
	jz	print_step_units
	push	ax
	mov	al,ah
	or	al,30h
	call	write_char
	pop	ax

print_step_units:
	or	al,30h
	call	write_char
	mov	si,offset msg_msec
	call	print_string
	jmp	normal_video

; Assign either physical serial port to a terminal or to auxiliary/printer use.
serial_menu:
	mov	si,offset msg_select_serial_console
	mov	ax,offset serial_instructions
	call	show_page
	mov	si,offset serial_buttons
	call	draw_options
	mov	dh,0dh
	call	select_prompt

serial_loop:
	call	show_serial_ports
	mov	di,offset serial_keys
	call	read_menu_choice
	jmp	cs:word ptr serial_choices[bx]

serial_choices:
	dw	toggle_serial_zero,toggle_serial_one,serial_help,return_to_menu

serial_help:
	lea	si,msg_setup_serial
	call	open_help_topic
	jmp	serial_menu

toggle_serial_zero:
	xor	byte ptr port_zero_console,0ffh
	jmps	serial_loop

toggle_serial_one:
	xor	byte ptr port_one_console,0ffh
	jmps	serial_loop

show_serial_ports:
	mov	si,offset port_zero_caption
	mov	dx,0a0fh
	mov	bx,0h
	call	show_port_role
	mov	si,offset port_one_caption
	mov	dx,0b0fh
	mov	bx,1h

show_port_role:
	call	print_positioned
	call	reverse_video
	mov	si,offset msg_an_aux
	test	byte ptr port_zero_console[bx],0ffh
	jz	print_port_role
	mov	si,offset msg_multiuser_terminal

print_port_role:
	call	print_string
	jmp	normal_video

; Store the per-process ceiling in paragraphs. The menu accepts 064 through 999 KiB.
memory_limit_menu:
	mov	si,offset memory_title
	mov	ax,offset memory_instructions
	call	show_page
	call	show_memory_limit
	mov	si,offset memory_buttons
	call	draw_options
	mov	dh,0fh
	call	select_prompt
	mov	di,offset memory_keys
	call	read_menu_choice
	jmp	cs:word ptr memory_choices[bx]

memory_choices:
	dw	enter_memory_limit,memory_limit_help,return_to_menu

memory_limit_help:
	lea	si,msg_setup_maxmem
	call	open_help_topic
	jmp	memory_limit_menu

enter_memory_limit:
	mov	dh,0fh
	call	clear_menu_row
	mov	si,offset limit_instructions
	mov	dx,0f05h
	call	print_lines
	mov	si,offset decimal_input_prompt
	mov	dx,1326h
	call	print_positioned
	call	read_three_digits
	mov	al,66h
	call	terminal_escape
	xchg	ax,dx
	mov	si,offset msg_value_is_too_small
	cmp	ax,40h
	jc	reject_memory_limit
	mov	si,offset msg_value_is_too_large
	cmp	ax,3e7h
	ja	reject_memory_limit
	mov	cl,6h
	shl	ax,cl
	mov	word ptr max_memory_paragraphs,ax
	jmp	memory_limit_menu

reject_memory_limit:
	mov	al,70h
	call	terminal_escape
	mov	dh,13h
	call	print_centered
	mov	al,71h
	call	terminal_escape
	mov	cx,3h

memory_error_bell:
	mov	al,7h
	call	write_char
	loop	memory_error_bell
	mov	si,offset continue_prompt
	mov	dh,15h
	call	reverse_centered
	call	read_char
	jmp	memory_limit_menu

show_memory_limit:
	mov	si,offset max_memory_caption
	mov	dx,0c0fh
	call	print_positioned
	call	reverse_video
	mov	ax,word ptr max_memory_paragraphs
	mov	cl,6h
	shr	ax,cl
	call	print_decimal
	mov	si,offset text_kb_142b
	call	print_string
	jmp	normal_video

read_three_digits:
	mov	dx,0h
	mov	cx,3h

next_decimal_digit:
	call	read_char
	cmp	al,30h
	jc	reject_decimal_digit
	cmp	al,39h
	ja	reject_decimal_digit
	push	ax
	call	write_char
	mov	al,20h
	call	write_char
	mov	al,8h
	call	write_char
	mov	ax,0ah
	mul	dx
	xchg	ax,dx
	pop	ax
	sub	al,30h
	cbw
	add	dx,ax
	loop	next_decimal_digit
	ret

reject_decimal_digit:
	mov	al,7h
	call	write_char
	jmps	next_decimal_digit

; Select fast/flicker, slow/smooth or wide-open access to color video memory.
scroll_menu:
	mov	si,offset scroll_title
	mov	ax,offset scroll_instructions
	call	show_page
	call	show_scroll_mode
	mov	si,offset scroll_buttons
	call	draw_options
	mov	dh,0fh
	call	select_prompt

scroll_loop:
	mov	di,offset scroll_keys
	call	read_menu_choice
	jmp	cs:word ptr scroll_choices[bx]

scroll_choices:
	dw	cycle_scroll_mode,scroll_help,return_to_menu

scroll_help:
	lea	si,msg_setup_scroll
	call	open_help_topic
	jmp	scroll_menu

cycle_scroll_mode:
	mov	al,byte ptr scroll_mode
	inc	al
	cmp	al,2h
	jna	store_scroll_mode
	mov	al,0h

store_scroll_mode:
	mov	byte ptr scroll_mode,al
	call	show_scroll_mode
	jmp	scroll_loop

show_scroll_mode:
	mov	si,offset scroll_caption
	mov	dx,0c0fh
	call	print_positioned
	call	reverse_video
	mov	al,byte ptr scroll_mode
	cbw
	shl	ax,1
	xchg	ax,bx
	mov	si,word ptr scroll_captions[bx]
	call	print_string
	jmp	normal_video

open_help_topic:
	mov	dx,si
	call	help_entry
	call	draw_frame
	ret

; Choose a destination drive or write the saved settings. F1 and Escape return to the menu system.
update_menu:
	mov	si,offset msg_update_and_exit
	mov	ax,offset update_instructions
	call	show_page
	mov	si,offset update_buttons
	call	draw_options
	mov	dh,0dh
	call	select_prompt
	call	show_update_drive
	mov	di,offset update_keys
	call	read_menu_choice
	jmp	cs:word ptr update_choices[bx]

update_choices:
	dw	select_update_disk,update_system_file,update_help,return_to_menu

update_help:
	lea	si,msg_setup_update
	call	open_help_topic
	jmp	update_menu

select_update_disk:
	mov	dh,0ch
	call	clear_menu_row
	mov	si,offset drive_instructions
	mov	dx,0e05h
	call	print_lines
	mov	si,offset drive_input_prompt
	mov	dx,1226h
	call	print_positioned
	call	read_drive_letter
	mov	byte ptr system_fcb,al
	mov	al,66h
	call	terminal_escape
	jmp	update_menu

; Open CCPM.SYS on the update drive. Check the embedded signature before replacing its configuration.
update_system_file:
	call	snapshot_options
	mov	dh,0ch
	call	clear_menu_row
	lea	si,updating_system
	mov	dh,0fh
	call	print_centered
	mov	al,byte ptr system_fcb
	add	al,40h
	call	write_char
	mov	al,3ah
	call	write_char
	mov	dx,3ch
	mov	cl,8dh
	int	0e0h
	call	set_error_mode_and_dma
	call	open_system_file
	lea	si,missing_system_file
	test	ax,ax
	jnz	show_update_error
	call	clear_file_protection
	sub	ax,ax
	mov	dl,1h
	call	read_random_record
	lea	si,system_read_error
	test	ax,ax
	jnz	close_after_error
	call	locate_config_record
	mov	dl,5h
	call	read_random_record
	lea	si,system_read_error
	test	ax,ax
	jnz	close_after_error
	call	check_setup_signature
	lea	si,wrong_system_version
	jnz	close_after_error
	call	copy_config_block
	call	write_random_record
	lea	si,system_write_error
	test	ax,ax
	jnz	close_after_error
	call	close_system_file
	call	restore_file_attributes
	jmp	exit_setup

close_after_error:
	call	close_system_file

show_update_error:
	mov	al,70h
	call	terminal_escape
	mov	dh,13h
	call	print_centered
	mov	al,71h
	call	terminal_escape
	mov	cx,3h

update_error_bell:
	mov	al,7h
	call	write_char
	loop	update_error_bell
	lea	si,continue_prompt
	mov	dh,15h
	call	reverse_centered
	call	read_char
	jmp	update_menu

set_error_mode_and_dma:
	mov	dl,0ffh
	mov	cl,2dh
	int	0e0h
	lea	dx,record_buffer
	mov	cl,1ah
	int	0e0h
	ret

open_system_file:
	push	ds
	pop	es
	lea	di,system_fcb_extent
	mov	cx,18h
	mov	al,0h
	cld
	rep	stosb
	lea	dx,system_fcb
	mov	cl,0fh
	int	0e0h
	ret

; Remember the original read-only bit so the successful update can reinstate it.
clear_file_protection:
	test	byte ptr system_fcb_type,80h
	jz	protection_cleared
	mov	byte ptr restore_read_only,0ffh
	call	close_system_file
	and	byte ptr system_fcb_type,7fh
	lea	dx,system_fcb
	mov	cl,1eh
	int	0e0h
	call	open_system_file

protection_cleared:
	ret

; DL is the number of consecutive 128-byte records. AX is the first record number.
read_random_record:
	mov	word ptr system_random_record,ax
	mov	cl,2ch
	int	0e0h
	lea	dx,system_fcb
	mov	cl,21h
	int	0e0h
	ret

write_random_record:
	lea	dx,system_fcb
	mov	cl,22h
	int	0e0h
	ret

close_system_file:
	lea	dx,system_fcb
	mov	cl,10h
	int	0e0h
	ret

restore_file_attributes:
	mov	dl,1h
	mov	cl,2ch
	int	0e0h
	test	byte ptr restore_read_only,0ffh
	jz	attributes_restored
	or	byte ptr system_fcb_type,80h
	lea	dx,system_fcb
	mov	cl,1eh
	int	0e0h

attributes_restored:
	ret

; Convert the paragraph address to a 128-byte record and a byte offset within it.
locate_config_record:
	mov	ax,word ptr system_code_paragraphs
	add	ax,0dfh
	push	ax
	and	ax,7h
	mov	cl,4h
	shl	ax,cl
	mov	word ptr config_record_offset,ax
	pop	ax
	mov	cl,3h
	shr	ax,cl
	ret

check_setup_signature:
	push	ds
	pop	es
	lea	di,record_buffer
	add	di,word ptr config_record_offset
	lea	si,setup_signature
	mov	cx,10h
	cld
	repe	cmpsb
	ret

copy_config_block:
	lea	si,config_block
	mov	cx,100h
	cld
	rep	movsw
	ret

show_update_drive:
	mov	si,offset drive_caption
	mov	dx,0b19h
	call	print_positioned
	call	reverse_video
	mov	al,byte ptr system_fcb
	add	al,40h
	call	write_char
	mov	al,3ah
	call	write_char
	jmp	normal_video

read_drive_letter:
	call	read_char
	cmp	al,41h
	jc	reject_drive_letter
	cmp	al,50h
	jna	accept_drive_letter
	cmp	al,61h
	jc	reject_drive_letter
	cmp	al,70h
	jna	accept_drive_letter

reject_drive_letter:
	mov	al,7h
	call	write_char
	jmps	read_drive_letter

accept_drive_letter:
	and	al,0dfh
	push	ax
	call	write_char
	pop	ax
	sub	al,40h
	ret

snapshot_options:
	cmp	byte ptr save_ports,0h
	jz	check_save_keys
	call	snapshot_serial_ports

check_save_keys:
	cmp	byte ptr save_keys,0h
	jz	snapshot_done
	call	snapshot_function_keys

snapshot_done:
	ret

; Capture each UART configuration and, if available, the four live XIOS port-state bytes.
snapshot_serial_ports:
	mov	byte ptr saved_serial_flag,0ffh
	mov	dx,3f8h
	call	read_uart
	mov	byte ptr com1_settings,al
	mov	dx,2f8h
	call	read_uart
	mov	byte ptr com2_settings,al
	cmp	byte ptr config_present,0ffh
	jnz	serial_snapshot_done
	push	ds
	mov	al,0eh
	mov	cx,3h
	mov	es,word ptr user_data_segment
	mov	ds,word ptr sysdat_segment
	callf	dword ptr .xios_gate	; DS addresses SYSDAT here
	pop	es
	push	es
	mov	bx,ax
	lea	di,port_state
	mov	cx,4h

copy_port_state:
	mov	si,word ptr [bx]
	movsb
	inc	bx
	inc	bx
	loop	copy_port_state
	pop	ds

serial_snapshot_done:
	ret

; Probe the interrupt identification register, then read the divisor latch and restore line control.
read_uart:
	inc	dx
	inc	dx
	in	al,dx
	test	al,0f8h
	mov	al,43h
	jnz	uart_done
	inc	dx
	in	al,dx
	mov	bl,al
	or	al,80h
	out	dx,al
	dec	dx
	dec	dx
	in	al,dx
	mov	ah,al
	dec	dx
	in	al,dx
	push	ds
	pop	es
	mov	di,offset uart_divisors
	mov	cx,8h
	repne	scasw
	add	dx,3h
	mov	al,bl
	out	dx,al
	and	al,1fh
	mov	bl,cl
	mov	cl,5h
	shl	bl,cl
	or	al,bl

uart_done:
	ret

; Select this console's key table in SYSDAT and save 180 words in the configuration block.
snapshot_function_keys:
	mov	byte ptr saved_key_flag,0ffh
	push	ds
	push	ds
	pop	es
	mov	bx,word ptr console_number
	add	bx,bx
	mov	si,word ptr key_tables[bx]
	mov	di,offset function_key_data
	mov	cx,0b4h
	mov	ds,word ptr sysdat_segment
	rep	movsw
	pop	ds
	ret

exit_setup:
	mov	si,offset screen_exit
	call	print_string
	mov	cl,0h
	mov	dl,0h
	int	0e0h

get_system_context:
	mov	cl,9ah
	int	0e0h
	mov	word ptr sysdat_segment,es
	mov	cl,9ch
	int	0e0h
	mov	ax,es:word ptr 10h[bx]
	mov	word ptr user_data_segment,ax
	mov	al,es:byte ptr 12h[bx]
	inc	al
	mov	byte ptr system_fcb,al
	ret

get_xios_parameters:
	push	ds
	mov	al,0eh
	mov	cx,1h
	mov	es,word ptr user_data_segment
	mov	ds,word ptr sysdat_segment
	callf	dword ptr .xios_gate	; DS addresses SYSDAT here
	pop	es
	push	es
	mov	di,offset xios_parameters
	mov	si,ax
	mov	cx,12h
	cld
	rep	movsb
	pop	ds
	mov	ax,word ptr lower_memory_end
	mov	word ptr mdisk_segment,ax
	ret

; Compare the 16-byte signature in SYSDAT and the DDB2h marker before importing the 512-byte block.
load_configuration:
	push	es
	push	ds
	push	ds
	pop	es
	mov	di,offset setup_signature
	mov	ds,word ptr sysdat_segment
	mov	si,0d70h
	mov	cx,10h
	cld
	repe	cmpsb
	jnz	config_loaded
	mov	es:byte ptr .642h,0ffh
	mov	si,0d80h
	cmp	word ptr [si],0ddb2h
	jnz	config_loaded
	lea	di,config_block
	mov	cx,100h
	rep	movsw

config_loaded:
	pop	ds
	pop	es
	ret

; Compare the supplied tail length against the eight slash keywords, then jump to its handler.
dispatch_command_tail:
	cmp	byte ptr command_tail,0h
	jz	tail_done
	push	ds
	pop	es
	mov	si,offset tail_dispatch
	mov	cx,8h

next_tail_switch:
	call	compare_tail
	jz	run_tail_switch
	add	si,2h
	loop	next_tail_switch

tail_done:
	ret

run_tail_switch:
	jmp	word ptr [si]

; Compare exactly the supplied length. A prefix can therefore select the first matching entry.
compare_tail:
	lodsw
	push	si
	push	cx
	xchg	ax,si
	mov	di,offset command_tail_text
	mov	cl,byte ptr command_tail
	mov	ch,0h
	repe	cmpsb
	pop	cx
	pop	si
	ret

request_key_save:
	mov	byte ptr save_keys,0ffh
	ret

request_port_save:
	mov	byte ptr save_ports,0ffh
	ret

draw_main_menu:
	mov	si,offset main_heading
	mov	dh,3h
	call	print_centered
	mov	si,offset main_buttons
	call	draw_buttons
	mov	si,offset main_prompt
	mov	dh,5h
	jmp	reverse_centered

; Draw the horizontal and vertical edges, place six corner/junction glyphs, then center the title.
draw_frame:
	mov	si,offset screen_init
	call	print_string
	mov	cx,4eh
	mov	dx,1h
	mov	bl,0c4h
	call	horizontal_rule
	mov	dx,201h
	mov	bl,0cdh
	call	horizontal_rule
	mov	dx,1701h
	mov	bl,0c4h
	call	horizontal_rule
	mov	cx,16h
	mov	dx,100h
	mov	bl,0b3h
	call	vertical_rule
	mov	dx,14fh
	mov	bl,0b3h
	call	vertical_rule
	mov	si,offset frame_corners
	mov	cx,6h

draw_frame_corner:
	mov	al,59h
	call	terminal_escape
	lodsb
	add	al,20h
	call	write_char
	lodsb
	add	al,20h
	call	write_char
	lodsb
	call	write_char
	loop	draw_frame_corner
	mov	si,offset program_title
	mov	dh,1h
	jmp	print_centered

horizontal_rule:
	push	cx
	call	position_cursor

next_horizontal_cell:
	mov	al,bl
	call	write_char
	loop	next_horizontal_cell
	pop	cx
	ret

vertical_rule:
	push	cx
	push	dx

next_vertical_cell:
	call	position_cursor
	mov	al,bl
	call	write_char
	inc	dh
	loop	next_vertical_cell
	pop	dx
	pop	cx
	ret

draw_options:
	call	draw_buttons
	mov	si,offset return_buttons
	call	draw_buttons
	mov	si,offset main_heading
	jmp	print_string

; Each button record contains row, column, three key legend bytes and a NUL-terminated caption.
draw_buttons:
	lodsb
	cbw
	xchg	ax,cx

draw_next_button:
	lodsw
	xchg	al,ah
	mov	dx,ax
	push	si
	mov	si,offset keycap_prefix
	call	print_positioned
	pop	si
	lodsb
	call	write_char
	lodsb
	call	write_char
	lodsb
	call	write_char
	push	si
	mov	si,offset keycap_suffix
	call	print_string
	pop	si
	call	print_string
	loop	draw_next_button
	ret

show_page:
	push	ax
	call	clear_menu
	mov	dh,4h
	call	print_centered
	pop	si
	mov	dx,605h

print_lines:
	call	print_positioned
	inc	dh
	test	byte ptr [si],0ffh
	jnz	print_lines
	ret

select_prompt:
	mov	si,offset select_function

reverse_centered:
	call	reverse_video
	call	print_centered
	jmp	normal_video

print_centered:
	push	ds
	pop	es
	mov	di,si
	mov	al,0h
	mov	cx,50h
	repne	scasb
	shr	cx,1
	mov	dl,cl

print_positioned:
	call	position_cursor

print_string:
	lodsb

print_next_char:
	call	write_char
	lodsb
	test	al,al
	jnz	print_next_char
	ret

position_cursor:
	mov	al,59h
	call	terminal_escape
	mov	al,dh
	add	al,20h
	call	write_char
	mov	al,dl
	add	al,20h
	jmp	write_char

; Return twice the selected key index in BX for the near dispatch table.
read_menu_choice:
	mov	cl,byte ptr [di]
	mov	ch,0h
	inc	di

retry_menu_key:
	push	cx
	push	di
	push	ds
	pop	es
	mov	bx,cx
	call	read_char
	sub	al,0bah
	repne	scasb
	mov	dx,cx
	pop	di
	pop	cx
	jz	menu_key_found
	mov	al,7h
	call	write_char
	jmps	retry_menu_key

menu_key_found:
	sub	bx,dx
	dec	bx
	add	bx,bx
	mov	ah,0h
	ret

flush_keyboard:
	call	poll_char
	test	al,al
	jnz	flush_keyboard
	ret

clear_menu:
	mov	dh,3h

clear_menu_row:
	mov	dl,1h
	call	position_cursor
	mov	al,4bh
	call	terminal_escape
	mov	dl,4fh
	call	position_cursor
	mov	al,0b3h
	call	write_char
	inc	dh
	cmp	dh,16h
	jna	clear_menu_row
	ret

reverse_video:
	mov	al,72h
	jmps	terminal_escape

normal_video:
	mov	al,75h

terminal_escape:
	push	ax
	mov	al,1bh
	call	write_char
	pop	ax

write_char:
	mov	ah,6h
	jmps	console_io

read_char:
	mov	ax,6fdh
	jmps	console_io

poll_char:
	mov	ax,6ffh

; Preserve the menu registers across direct console I/O. Return the result in AL.
console_io:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	es
	mov	dl,al
	mov	cl,ah
	int	0e0h
	cld
	pop	es
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	ret
	rb	11	; align embedded HELP to a paragraph
; Embedded HELP V2.0 entry: skip its copyright and save the caller context.
; -----------------------------------------------------------------------------
	include E:HELPCODE.LIB

; -----------------------------------------------------------------------------

	dseg
	org	0

; Loader base-page bytes preceding the supplied stack segment.
	include E:HELPDATA.LIB


