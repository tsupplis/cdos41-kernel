LDRLEN		EQU	OFFSET $ - OFFSET LDR
;
;
;	this is the boot loader for the PC-DOS data disk
;
;	use DDT to put the image of the loader into the DSKMAINT.CMD file,
;	  instructions are in the file LS.SUB as part of LINK procedure
;
;	the boot loader is DOSBOOT.LDR, the source file is DOSBOOT.A86
;
pc_loader	db	'PUT THE PC LOADER HERE'
		rs	512 - length pc_loader
;
dskmaint_format	db	'DSKMAINT FORMAT',0	;HELP prompt
