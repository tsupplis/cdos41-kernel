; Length-prefixed display string.
tail_usage	dw	2d1h
tail_usage_text	db	0dh,0ah
	db	'Absence of  command tail arguments invokes screen mode'
	db	0dh,0ah
	db	'If a command tail is present all arguments must be separated by '
	db	'spaces.'
	db	0dh,0ah
	db	'Valid device identifiers are:'
	db	9h,9h
	db	'P3 P4'
	db	0dh,0ah
	db	'Valid speed identifiers are:'
	db	9h,9h
	db	'110 150 300 600 1200 2400 4800 9600'
	db	0dh,0ah
	db	'Valid word length identifiers are:'
	db	9h
	db	'5 6 7 8'
	db	0dh,0ah
	db	'Valid parity identifiers are:'
	db	9h,9h
	db	'NONE ODD EVEN'
	db	0dh,0ah
	db	'Valid stop bit identifiers are:'
	db	9h,9h,31h,20h,32h,0dh,0ah
	db	'Valid protocol identifiers are I(input)'
	db	0dh,0ah
	db	'  or O(output)followed by:             DNN NRN DRN NNX DNX NRX DRX'
	db	0dh,0ah
	db	'The following example sets Printer 3 / Serial Port 0 to:'
	db	0dh,0ah
	db	'  1200 baud 7 bit ODD parity 2 stop bits '
	db	0dh,0ah
	db	'  input protocol is  NO DTR/DSR + RTS/CTS + XON/XOFF'
	db	0dh,0ah
	db	'  output protocol is DTR/DSR + NO RTS/CTS + XON/XOFF'
	db	0dh,0ah
	db	'SETPORT P3 1200 7 ODD 2 INRX ODNX'
	db	0dh,0ah,0dh,0ah,0dh,0ah

