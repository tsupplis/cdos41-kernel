;*****************************************************************************
; SETPORT - Concurrent DOS 4.1 serial configuration (26 Aug 84).
;
; Reconstructed from ../../base/setport.cmd. setporg.a86 is the frozen source.
; Build: make. Verify: make check (39 documented equivalent ASM86 encodings).
; Usage: SETPORT                         interactive function-key menus
;        SETPORT HELP                    command-line usage
;        SETPORT P3 1200 7 ODD 2 INRX ODNX
; P3/P4 select printer 3/4, serial port 0/1. Baud: 110 150 300 600 1200
; 2400 4800 9600; word length: 5..8; parity: NONE ODD EVEN; stop bits: 1/2.
; Protocol: I(input)/O(output), D/N for DTR/DSR, R/N for RTS/CTS, X/N for
; XON/XOFF. Tokens are space separated. Unspecified settings retain defaults.
; Interactive mode requires a local console; command tails allow terminals.
; F1 provides context help through HELP.HLP; Escape returns/applies settings.
;
; CODE=1CC0h, DATA=2780h, STACK=0130h. Every loaded instruction is mnemonic
; assembly. DB/DW contain only strings, tables, workspace and padding.
; ASM86 chooses 39 equivalent same-length encodings inside embedded HELP.
; check.py validates each exception and every other byte, including headers.
; header.py compacts the empty EXTRA descriptor and restores loader metadata
; and the unloaded final record. It never patches instruction or data bytes.
;*****************************************************************************

	cseg
	org	0

; -----------------------------------------------------------------------------
; Skip the copyright and enter SETPORT. All branch offsets are preserved.
; -----------------------------------------------------------------------------
entry:
	jmp	initialize
copyright	db	'Copyright (C) 1983, Digital Research, Inc.Serial No. 1031-0000       '

; -----------------------------------------------------------------------------
; Install the private stack, retain DS for string output, validate DOS 4.1,
; locate the XIOS and probe both serial ports. A nonempty tail selects parsing.
; -----------------------------------------------------------------------------
initialize:
	cli
	mov	ss,word ptr base_stack_segment
	mov	sp,124h
	sti
	mov	ax,ds
	mov	es,ax
	mov	word ptr output_segment,ax
	call	check_version
	call	locate_system
	call	detect_ports
	or	al,al
	jz	no_ports_installed
	cmp	byte ptr command_tail,0h
	jz	interactive_main
	jmp	parse_command_tail

; -----------------------------------------------------------------------------
; Build the main menu after rejecting a serial terminal for interactive use.
; -----------------------------------------------------------------------------
interactive_main:
	call	check_console
	call	initialize_screen
	call	draw_frame
	mov	bx,0h
	mov	dx,offset main_help_topic
	call	select_help_footer
	mov	bx,0h
	call	select_menu_footer
	call	build_main_choices
	mov	si,offset main_menu
	call	draw_menu_and_read
	jmps	dispatch_main_choice
main_menu_again:
	mov	bx,0h
	call	select_menu_footer
	mov	si,offset main_menu
	call	read_menu_choice
dispatch_main_choice:
	xor	bh,bh
	shl	bl,1
	call	word ptr main_dispatch[bx]
	jmps	main_menu_again

; -----------------------------------------------------------------------------
; Main-menu exit callback: restore the display and terminate.
; -----------------------------------------------------------------------------
menu_exit:
	jmps	clear_and_exit
clear_and_exit:
	call	clear_screen

; -----------------------------------------------------------------------------
; BDOS 0 terminates this process with DX zero.
; -----------------------------------------------------------------------------
terminate:
	xor	cx,cx
	xor	dx,dx
	jmp	bdos
	push	si
	call	clear_screen
	pop	si
print_error_and_exit:
	call	print_length_string
	jmps	terminate
no_ports_installed:
	mov	si,offset no_ports_error
	jmps	print_error_and_exit

; -----------------------------------------------------------------------------
; Add a protocol entry for each installed UART, followed by Escape.
; Update both the display pointers and the indirect function-key dispatch table.
; -----------------------------------------------------------------------------
build_main_choices:
	mov	bx,offset main_protocol_dispatch
	mov	dx,offset main_port_0_record
	mov	al,0bfh
	mov	di,offset main_protocol_text
	mov	si,offset main_protocol_keys
	cmp	byte ptr port_0_present,0h
	jz	add_port_one_choice
	mov	word ptr [bx],4e6h
	mov	word ptr [di],dx
	inc	word ptr main_text_count
	inc	byte ptr main_key_count
	mov	byte ptr [si],al
	add	di,2h
	inc	si
	add	bx,2h
add_port_one_choice:
	cmp	byte ptr port_1_present,0h
	jz	add_escape_choice
	add	al,2h
	mov	dx,offset main_port_1_record
	mov	word ptr [bx],4d4h
	mov	word ptr [di],dx
	inc	word ptr main_text_count
	inc	byte ptr main_key_count
	mov	byte ptr [si],al
	add	bx,2h
	inc	si
add_escape_choice:
	mov	word ptr [bx],0a8h
	inc	byte ptr main_key_count
	mov	byte ptr [si],1bh
	ret

; -----------------------------------------------------------------------------
; BDOS 12 must identify a concurrent system; BDOS 163 must return 1441h.
; Print the version error and exit when either test fails.
; -----------------------------------------------------------------------------
check_version:
	mov	cx,0ch
	int	0e0h
	and	ah,0fh
	cmp	ah,4h
	jz	check_cdos_release
	cmp	ah,6h
	jnz	version_rejected
check_cdos_release:
	mov	cx,0a3h
	int	0e0h
	cmp	ax,1441h
	jnz	version_rejected
	ret
version_rejected:
	mov	dx,offset version_error
	mov	cx,9h
	int	0e0h
	xor	cx,cx
	xor	dx,dx
	int	0e0h

; -----------------------------------------------------------------------------
; BDOS 153 returns the console number. Consoles above 3 are serial terminals
; and cannot run the interactive menu; command-line use remains available.
; -----------------------------------------------------------------------------
check_console:
	mov	cl,99h
	int	0e0h
	cmp	al,3h
	jg	serial_menu_rejected
	ret
serial_menu_rejected:
	mov	dx,offset terminal_error
	mov	cl,9h
	int	0e0h
	mov	dx,offset terminal_usage
	mov	cl,9h
	int	0e0h
	xor	cx,cx
	xor	dx,dx
	int	0e0h

; -----------------------------------------------------------------------------
; Read the current UART settings, display the configuration menu, and cycle
; fields on function keys. Escape programs both present ports and returns.
; -----------------------------------------------------------------------------
configure_ports:
	call	read_port_settings
	mov	bx,0h
	mov	dx,offset config_help_topic
	call	select_help_footer
	mov	bx,1h
	call	select_menu_footer
	mov	si,offset config_menu
	mov	bx,word ptr 6h[si]
	mov	bx,word ptr 2h[bx]
	push	bx
	call	read_menu_choice
configuration_key_loop:
	cmp	al,1bh
	jz	apply_menu_settings
	call	advance_setting
	pop	si
	push	si
	call	read_allowed_key
	jmps	configuration_key_loop
apply_menu_settings:
	pop	bx
	call	program_ports
	ret

; -----------------------------------------------------------------------------
; Advance a selected serial setting, wrap at its maximum index, and redraw
; the fixed-width value. BX identifies the field within the menu.
; -----------------------------------------------------------------------------
advance_setting:
	xor	bh,bh
	push	bx
	shl	bx,1
	mov	cx,word ptr setting_token_pointers[bx]
	mov	si,word ptr selected_settings
	mov	al,byte ptr [bx+si]
	inc	al
	cmp	al,byte ptr 1h[bx+si]
	jng	store_advanced_setting
	xor	al,al
store_advanced_setting:
	mov	byte ptr [bx+si],al
	xor	ah,ah
	xor	dx,dx
	mov	bl,9h
	mul	bl
	add	ax,cx
	pop	bx
	push	ax
	mov	ax,0bh
	mul	bl
	mov	si,word ptr selected_display
	add	si,ax
	lodsw
	call	position_cursor
	pop	si
	call	print_length_string
	ret

; -----------------------------------------------------------------------------
; Read each installed UART and unpack its baud/format into menu selections.
; -----------------------------------------------------------------------------
read_port_settings:
	cmp	byte ptr port_0_present,0ffh
	jnz	read_port_one_settings
	mov	dx,3f0h
	call	read_uart
	mov	byte ptr port_0_packed,al
	mov	di,offset port_0_baud_key_description
	mov	bx,offset port_0_settings
	call	unpack_serial
read_port_one_settings:
	cmp	byte ptr port_1_present,0ffh
	jnz	port_settings_loaded
	mov	dx,2f0h
	call	read_uart
	mov	byte ptr port_1_packed,al
	mov	di,offset port_1_baud_key_description
	mov	bx,offset port_1_settings
	call	unpack_serial
port_settings_loaded:
	ret

; -----------------------------------------------------------------------------
; Pack the selected baud and format, then program each installed UART.
; -----------------------------------------------------------------------------
program_ports:
	cmp	byte ptr port_0_present,0ffh
	jnz	program_port_one
	mov	si,offset port_0_settings
	call	pack_serial
	mov	dx,3f0h
	call	program_uart
program_port_one:
	cmp	byte ptr port_1_present,0ffh
	jnz	ports_programmed
	mov	si,offset port_1_settings
	call	pack_serial
	mov	dx,2f0h
	call	program_uart
ports_programmed:
	ret

; -----------------------------------------------------------------------------
; Pack baud index in bits 7..5, parity in 4..3, stop in 2 and word length
; in 1..0. SI addresses the selected port's index/maximum pairs.
; -----------------------------------------------------------------------------
pack_serial:
	xor	ax,ax
	mov	al,byte ptr 2h[si]
	xchg	ah,al
	mov	al,byte ptr 6h[si]
	mov	cl,2h
	shl	al,cl
	or	ah,al
	mov	al,byte ptr 4h[si]
	mov	cl,3h
	shl	al,cl
	or	ah,al
	mov	al,byte ptr [si]
	mov	cl,5h
	shl	al,cl
	or	al,ah
	ret

; -----------------------------------------------------------------------------
; Construct the configuration menu for the ports actually installed.
; Copy display pointers and install only valid function-key choices.
; -----------------------------------------------------------------------------
build_port_menu:
	push	es
	mov	ax,ds
	mov	es,ax
	mov	di,offset config_field_pointers
	cmp	byte ptr port_0_present,0ffh
	jz	add_port_zero_fields
	mov	bx,offset config_key_slots
	jmps	add_port_one_fields
add_port_zero_fields:
	mov	word ptr config_port_0_label,726h
	mov	word ptr config_port_0_serial_label,748h
	mov	ax,4h
	add	word ptr config_field_count,ax
	mov	si,offset port_0_field_pointers
	mov	cx,ax
	mov	ax,cx
	rep	movsw
	mov	cx,5h
	mov	byte ptr config_key_count,cl
	mov	bx,di
	mov	si,offset port_0_key_template
	mov	di,offset config_key_slots
	rep	movsb
	xchg	bx,di
add_port_one_fields:
	cmp	byte ptr port_1_present,0ffh
	jnz	port_menu_complete
	mov	word ptr config_port_1_label,737h
	mov	word ptr config_port_1_serial_label,75dh
	mov	ax,4h
	add	word ptr config_field_count,ax
	mov	cx,ax
	mov	si,offset port_1_field_pointers
	rep	movsw
	xchg	bx,di
	mov	cx,5h
	add	byte ptr config_key_count,cl
	mov	si,offset port_1_key_template
	rep	movsb
	cmp	byte ptr port_0_present,0ffh
	jz	port_menu_complete
	mov	word ptr selected_display,849h
	mov	word ptr selected_settings,0a2ah
port_menu_complete:
	pop	es
	ret

; -----------------------------------------------------------------------------
; Probe each UART interrupt-identification register at 3FAh / 2FAh.
; An installed UART has reserved bits 7..3 clear; mark it FFh and count ports.
; -----------------------------------------------------------------------------
detect_ports:
	mov	dx,3f0h
	mov	dl,0fah
	in	al,dx
	test	al,0f8h
	jnz	probe_port_one
	mov	byte ptr port_0_present,0ffh
	inc	byte ptr ports_found
probe_port_one:
	mov	dx,2f0h
	mov	dl,0fah
	in	al,dx
	test	al,0f8h
	jnz	return_port_count
	mov	byte ptr port_1_present,0ffh
	inc	byte ptr ports_found
return_port_count:
	mov	al,byte ptr ports_found
	ret

; -----------------------------------------------------------------------------
; Read the line-control register and divisor latch with interrupts masked.
; Match the divisor against the baud table and return the packed setting in AL.
; -----------------------------------------------------------------------------
read_uart:
	mov	dl,0fbh
	in	al,dx
	mov	bl,al
	and	al,1fh
	xchg	ax,bx
	mov	al,80h
	pushf
	cli
	out	dx,al
	mov	dl,0f9h
	in	al,dx
	xchg	al,ah
	mov	dl,0f8h
	in	al,dx
	mov	dl,0fbh
	xchg	ax,cx
	mov	al,bl
	out	dx,al
	popf
	xchg	ax,cx
	push	es
	mov	dx,ds
	mov	es,dx
	mov	di,offset baud_divisors
	mov	cx,8h
	push	cx
	repne	scasw
	pop	dx
	dec	dl
	sub	dl,cl
	xchg	dl,cl
	pop	es
	xchg	al,cl
	mov	cl,5h
	shl	al,cl
	and	al,0e0h
	or	al,bl
	ret

; -----------------------------------------------------------------------------
; Decode AL into baud, word-length, parity and stop selections.
; Populate the selection pairs at BX and the display strings at DI.
; -----------------------------------------------------------------------------
unpack_serial:
	push	es
	mov	dx,ds
	mov	es,dx
	xor	ah,ah
	push	ax
	mov	cl,5h
	shr	al,cl
	call	store_selection
	mov	si,offset token_110
	call	copy_setting_text
	pop	ax
	push	ax
	and	al,3h
	call	store_selection
	mov	si,offset token_5
	call	copy_setting_text
	pop	ax
	push	ax
	and	al,18h
	mov	cl,3h
	shr	al,cl
	call	store_selection
	mov	si,offset token_none
	call	copy_setting_text
	pop	ax
	and	al,4h
	mov	cl,2h
	shr	al,cl
	call	store_selection
	mov	si,offset token_1
	call	copy_setting_text
	pop	es
	ret

; -----------------------------------------------------------------------------
; Store one setting index and skip its adjacent maximum byte.
; -----------------------------------------------------------------------------
store_selection:
	mov	byte ptr [bx],al
	inc	bx
	inc	bx
	ret

; -----------------------------------------------------------------------------
; Index the nine-byte token records, skip the length word and copy the text.
; -----------------------------------------------------------------------------
copy_setting_text:
	mov	dx,9h
	mul	dl
	add	si,ax
	lodsw
	mov	cx,ax
	inc	di
	inc	di
	rep	movsb
	ret

; -----------------------------------------------------------------------------
; Set DLAB, write both baud-divisor bytes, then install the line-control bits.
; DX selects the UART; AL contains the packed baud/format setting.
; -----------------------------------------------------------------------------
program_uart:
	xor	ah,ah
	push	ax
	mov	dl,0fbh
	mov	al,80h
	out	dx,al
	pop	ax
	push	ax
	and	al,0e0h
	mov	cl,4h
	shr	al,cl
	xchg	ax,bx
	mov	ax,word ptr baud_divisors[bx]
	mov	dl,0f8h
	out	dx,al
	xchg	ah,al
	mov	dl,0f9h
	out	dx,al
	mov	dl,0fbh
	pop	ax
	and	al,1fh
	out	dx,al
	ret

; -----------------------------------------------------------------------------
; Read initial hardware settings, then scan space-separated tail tokens.
; Each nine-byte token record supplies a handler and argument. Unknown tokens
; print the tail, an error marker and usage; recognized settings retain defaults
; for fields not specified. P3/P4 select serial port 0/1.
; -----------------------------------------------------------------------------
parse_command_tail:
	call	read_port_settings
	mov	ax,ds
	mov	es,ax
	mov	al,byte ptr command_tail
	mov	byte ptr tail_remaining,al
	mov	si,81h
skip_tail_spaces:
	cmp	byte ptr tail_remaining,0h
	jz	apply_tail_settings
	mov	al,byte ptr [si]
	cmp	al,20h
	ja	begin_token_search
	inc	si
	dec	byte ptr tail_remaining
	jmps	skip_tail_spaces
begin_token_search:
	mov	word ptr token_scan,8bdh
	mov	word ptr token_start,si
next_token_candidate:
	mov	si,word ptr token_scan
	add	word ptr token_scan,9h
	lodsw
	or	ax,ax
	jnz	prepare_token_compare
	jmp	invalid_tail
prepare_token_compare:
	mov	cx,ax
skip_token_padding:
	lodsb
	dec	cx
	cmp	al,20h
	jz	skip_token_padding
	dec	si
	inc	cx
	mov	di,si
	mov	si,word ptr token_start
	mov	al,byte ptr tail_remaining
	mov	byte ptr token_remaining,al
compare_token_characters:
	cmp	byte ptr token_remaining,0h
	jz	next_token_candidate
	cmpsb
	jnz	next_token_candidate
	dec	byte ptr token_remaining
	dec	cx
	jnz	compare_token_characters
	cmp	byte ptr token_remaining,0h
	jz	token_matched
	cmp	byte ptr [si],20h
	jnz	next_token_candidate
token_matched:
	mov	al,byte ptr token_remaining
	mov	byte ptr tail_remaining,al
	call	apply_token
	jmps	skip_tail_spaces
apply_tail_settings:
	mov	al,byte ptr port_0_packed
	mov	dx,3f0h
	cmp	byte ptr selected_port,0h
	jz	write_selected_uart
	mov	al,byte ptr port_1_packed
	mov	dx,2f0h
write_selected_uart:
	call	program_uart
	jmp	terminate

; -----------------------------------------------------------------------------
; Dispatch a matched token through its handler word. BX points to the packed
; setting of the selected port; DL is the selected port number.
; -----------------------------------------------------------------------------
apply_token:
	push	si
	mov	si,di
	mov	bx,offset port_0_packed
	cmp	byte ptr selected_port,0h
	jz	dispatch_token_handler
	mov	bx,offset port_1_packed
dispatch_token_handler:
	mov	dl,byte ptr selected_port
	lodsw
	mov	cx,ax
	lodsb
	call	cx		; Token table supplies handler CX and argument AL.
	pop	si
	ret

; -----------------------------------------------------------------------------
; P3/P4 token handler: reject an absent UART and select port 0 or 1.
; -----------------------------------------------------------------------------
select_port:
	mov	si,offset port_0_present
	xor	ah,ah
	add	si,ax
	cmp	byte ptr [si],0h
	jnz	remember_selected_port
	jmp	no_ports_installed
remember_selected_port:
	mov	byte ptr selected_port,al
	ret

; -----------------------------------------------------------------------------
; Replace only the baud bits in the selected port's packed setting.
; -----------------------------------------------------------------------------
set_baud:
	and	byte ptr [bx],1fh
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Replace only the word-length bits in the selected port's packed setting.
; -----------------------------------------------------------------------------
set_word_length:
	and	byte ptr [bx],0fch
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Replace only the parity bits in the selected port's packed setting.
; -----------------------------------------------------------------------------
set_parity:
	and	byte ptr [bx],0e7h
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Replace only the stop-bit selection in the packed setting.
; -----------------------------------------------------------------------------
set_stop_bits:
	and	byte ptr [bx],0fbh
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Display the original command tail and point to the unrecognized token.
; Print command-line usage, apply the selected settings and terminate.
; -----------------------------------------------------------------------------
invalid_tail:
	mov	si,80h
	xor	ax,ax
	mov	al,byte ptr [si]
	push	ax
	dec	si
	mov	word ptr [si],ax
	call	print_length_string
	mov	si,offset tail_newline
	call	print_length_string
	pop	cx
	sub	cl,byte ptr tail_remaining
	jcxz	print_tail_error_details
	call	print_spaces
print_tail_error_details:
	mov	si,offset tail_error_marker
	call	print_length_string
	mov	si,offset invalid_token_message
	call	print_length_string

; -----------------------------------------------------------------------------
; HELP token handler: display the built-in command syntax and return to DOS.
; -----------------------------------------------------------------------------
command_help:
	mov	si,offset tail_usage
	call	print_length_string
	call	program_ports
	jmp	terminate

; -----------------------------------------------------------------------------
; Print CX spaces using the length-prefixed work buffer.
; -----------------------------------------------------------------------------
print_spaces:
	mov	word ptr space_buffer,cx
	mov	si,offset space_buffer
	jmp	print_length_string

; -----------------------------------------------------------------------------
; Select serial port 1 / printer 4 for the protocol screen.
; -----------------------------------------------------------------------------
protocol_port_1:
	mov	byte ptr protocol_printer_digit,34h
	mov	byte ptr protocol_serial_digit,31h
	mov	word ptr protocol_port,1h
	jmps	protocol_menu

; -----------------------------------------------------------------------------
; Select serial port 0 / printer 3 for the protocol screen.
; -----------------------------------------------------------------------------
protocol_port_0:
	mov	byte ptr protocol_printer_digit,33h
	mov	byte ptr protocol_serial_digit,30h
	mov	word ptr protocol_port,0h

; -----------------------------------------------------------------------------
; Read XIOS protocol flags, display the six input/output choices, then
; accept function-key toggles until Escape writes the flags back.
; -----------------------------------------------------------------------------
protocol_menu:
	mov	bx,1h
	call	select_menu_footer
	mov	dx,offset protocol_help_topic
	mov	bx,0h
	call	select_help_footer
	call	read_protocols
	call	format_protocol_flags
	mov	si,offset protocol_menu_data
	mov	bx,word ptr 6h[si]
	mov	bx,word ptr 2h[bx]
	push	bx
	call	read_menu_choice
protocol_key_loop:
	cmp	al,1bh
	jz	apply_protocol_settings
	call	toggle_protocol
	pop	si
	push	si
	call	read_allowed_key
	jmps	protocol_key_loop
apply_protocol_settings:
	pop	bx
	call	write_protocols
	ret

; -----------------------------------------------------------------------------
; Toggle DTR/DSR, RTS/CTS or XON/XOFF for the selected direction and port.
; The six function keys alternate input/output within each protocol pair.
; -----------------------------------------------------------------------------
toggle_protocol:
	xor	bh,bh
	mov	al,bl
	and	al,1h
	mov	si,offset input_protocols
	jz	select_protocol_byte
	mov	si,offset output_protocols
select_protocol_byte:
	add	si,word ptr protocol_port
	mov	al,byte ptr [si]
	mov	cl,3h
	cmp	bl,4h
	jnl	flip_protocol_bit
	dec	cl
	cmp	bl,2h
	jnl	flip_protocol_bit
	dec	cl
flip_protocol_bit:
	clc
	rcr	al,cl
	cmc
	rcl	al,cl
	mov	byte ptr [si],al
	push	bx
	call	format_protocol_flags
	pop	bx
	call	redraw_protocol_field
	ret

; -----------------------------------------------------------------------------
; Redraw one protocol value from its eleven-byte display record.
; -----------------------------------------------------------------------------
redraw_protocol_field:
	xor	dx,dx
	mov	ax,0bh
	xor	bh,bh
	mul	bx
	mov	si,offset protocol_input_dtr_key_position
	add	si,ax
	lodsw
	push	si
	call	position_cursor
	pop	si
	mov	si,word ptr [si]
	call	print_length_string
	ret

; -----------------------------------------------------------------------------
; Convert the current input and output masks into six ON/OFF pointers.
; -----------------------------------------------------------------------------
format_protocol_flags:
	mov	si,offset input_protocols
	add	si,word ptr protocol_port
	mov	al,byte ptr [si]
	mov	di,offset protocol_input_dtr_key_description_pointer
	call	protocol_on_off
	mov	si,offset output_protocols
	add	si,word ptr protocol_port
	mov	al,byte ptr [si]
	mov	di,offset protocol_output_dtr_key_description_pointer
	call	protocol_on_off
	ret

; -----------------------------------------------------------------------------
; For three mask bits, install ON or OFF pointers, skipping alternate fields.
; -----------------------------------------------------------------------------
protocol_on_off:
	mov	cx,3h
next_protocol_bit:
	rcr	al,1
	mov	bx,offset protocol_on
	jc	store_on_off_pointer
	mov	bx,offset protocol_off
store_on_off_pointer:
	mov	word ptr [di],bx
	add	di,16h
	loop	next_protocol_bit
	ret

; -----------------------------------------------------------------------------
; Call XIOS function 14, subfunction 3 to obtain the four protocol pointers;
; copy input0/input1/output0/output1 masks from the system data segment.
; -----------------------------------------------------------------------------
read_protocols:
	mov	cx,3h
	mov	al,0eh
	call	call_xios
	push	es
	push	ds
	mov	ax,ds
	mov	es,ax
	mov	ds,word ptr system_segment
	mov	cx,4h
	mov	di,offset input_protocols
read_protocol_byte:
	mov	si,word ptr [bx]
	movsb
	inc	bx
	inc	bx
	loop	read_protocol_byte
	pop	ds
	pop	es
	ret

; -----------------------------------------------------------------------------
; Obtain the XIOS protocol pointers and copy all four selected masks back.
; -----------------------------------------------------------------------------
write_protocols:
	mov	cx,3h
	mov	ax,0eh
	call	call_xios
	push	es
	mov	es,word ptr system_segment
	mov	cx,4h
	mov	si,offset input_protocols
write_protocol_byte:
	mov	di,es:word ptr [bx]
	movsb
	inc	bx
	inc	bx
	loop	write_protocol_byte
	pop	es
	ret

; -----------------------------------------------------------------------------
; Call the far XIOS entry at system offset 28h with system DS and XIOS ES.
; Preserve the application's segment registers.
; -----------------------------------------------------------------------------
call_xios:
	push	ds
	push	es
	mov	ds,word ptr system_segment
	mov	es,word ptr xios_segment
	callf	dword ptr .28h
	pop	es
	pop	ds
	ret

; -----------------------------------------------------------------------------
; Output protocol token handler: select the output pair of mask bytes.
; -----------------------------------------------------------------------------
set_output_protocol:
	mov	bx,2h
	jmps	set_protocol_mask

; -----------------------------------------------------------------------------
; Input protocol token handler: select the input pair of mask bytes.
; -----------------------------------------------------------------------------
set_input_protocol:
	mov	bx,0h

; -----------------------------------------------------------------------------
; Read all masks, replace only the selected direction/port, and write back.
; -----------------------------------------------------------------------------
set_protocol_mask:
	mov	ah,dl
	push	ax
	push	bx
	call	read_protocols
	pop	bx
	pop	ax
	mov	si,offset input_protocols
	add	si,bx
	xor	bx,bx
	mov	bl,ah
	add	si,bx
	mov	byte ptr [si],al
	call	write_protocols
	ret

; -----------------------------------------------------------------------------
; Draw the full-screen border, title and separator line using menu primitives.
; -----------------------------------------------------------------------------
draw_frame:
	mov	al,0c4h
	mov	cx,4eh
	mov	di,offset border_horizontal_text
	rep	stosb
	mov	si,offset top_border
	mov	bx,0h
	call	render_records
	mov	ax,102h
	call	draw_vertical_border
	mov	ax,5002h
	call	draw_vertical_border
	mov	ax,118h
	call	position_cursor
	mov	si,offset bottom_border
	mov	bx,0h
	call	render_records
	mov	si,offset title_record
	call	draw_text_record
	mov	al,0cdh
	mov	di,offset separator_fill
	mov	cx,4eh
	rep	stosb
	mov	si,offset separator_record
	call	draw_text_record
	ret

; -----------------------------------------------------------------------------
; Position and draw 22 vertical border characters, advancing one row each time.
; -----------------------------------------------------------------------------
draw_vertical_border:
	mov	word ptr screen_position,ax
	call	position_cursor
	mov	cx,16h
vertical_border_row:
	push	cx
	mov	dl,0b3h
	mov	cl,2h
	call	bdos
	call	next_screen_row
	pop	cx
	loop	vertical_border_row
	ret

; -----------------------------------------------------------------------------
; Clear the menu body before drawing its records and accepting a choice.
; -----------------------------------------------------------------------------
read_menu_choice:
	push	si
	call	clear_menu_body
	pop	si

; -----------------------------------------------------------------------------
; Render the four menu sections; return selected key index in BL and key in AL.
; -----------------------------------------------------------------------------
draw_menu_and_read:
	mov	bx,6h
	call	render_sections
	xor	bx,bx
	mov	bl,byte ptr key_index
	mov	al,byte ptr key_value
	ret

; -----------------------------------------------------------------------------
; Walk the menu's section pointers and dispatch each nonzero section.
; -----------------------------------------------------------------------------
render_sections:
	mov	word ptr last_section,bx
	xor	bx,bx
next_menu_section:
	lodsw
	or	ax,ax
	jz	advance_menu_section
	push	si
	push	bx
	mov	si,ax
	call	render_records
	pop	bx
	pop	si
advance_menu_section:
	cmp	bx,word ptr last_section
	jz	menu_sections_complete
	inc	bx
	inc	bx
	jmps	next_menu_section
menu_sections_complete:
	ret

; -----------------------------------------------------------------------------
; Walk a counted list of record pointers, dispatching by section index BX.
; -----------------------------------------------------------------------------
render_records:
	lodsw
	mov	cx,ax
next_display_record:
	push	cx
	push	bx
	lodsw
	push	si
	mov	si,ax
	call	word ptr render_dispatch[bx]
	pop	si
	pop	bx
	pop	cx
	loop	next_display_record
	ret

; -----------------------------------------------------------------------------
; Draw a function-key box and its associated explanatory text.
; -----------------------------------------------------------------------------
draw_key_record:
	lodsw
	mov	word ptr screen_position,ax
	push	si
	call	position_cursor
	pop	si
	call	draw_key_box
	lodsw
	mov	cx,ax
	jcxz	key_record_complete
	lodsw
	mov	word ptr screen_position,ax
	push	si
	push	cx
	call	position_cursor
	pop	cx
	pop	si
next_key_description:
	push	cx
	lodsw
	mov	si,ax
	push	si
	call	print_length_string
	call	next_screen_row
	pop	si
	pop	cx
	loop	next_key_description
key_record_complete:
	ret

; -----------------------------------------------------------------------------
; Copy a key legend into the shared three-line box template and print it.
; -----------------------------------------------------------------------------
draw_key_box:
	mov	di,offset key_box_legend
	mov	cx,3h
	push	es
	mov	ax,ds
	mov	es,ax
	rep	movsb
	pop	es
	push	si
	mov	si,offset key_box_top
	call	print_length_string
	call	next_screen_row
	mov	si,offset key_box_middle
	call	print_length_string
	call	next_screen_row
	mov	si,offset key_box_bottom
	call	print_length_string
	pop	si
	ret

; -----------------------------------------------------------------------------
; A text record contains cursor position, display attributes and a string
; pointer. Set attributes, print the length-prefixed text, then restore them.
; -----------------------------------------------------------------------------
draw_text_record:
	lodsw
	push	si
	call	position_cursor
	pop	si
	lodsw
	push	si
	mov	byte ptr saved_attribute,ah
	call	set_display_attribute
	pop	si
	mov	si,word ptr [si]
	call	print_length_string
	mov	al,byte ptr saved_attribute
	call	set_display_attribute
	ret

; -----------------------------------------------------------------------------
; Read a key and match it against the counted allowed-key list. F1 invokes
; context help when enabled. Reject other keys with a bell.
; -----------------------------------------------------------------------------
read_allowed_key:
	xor	ax,ax
	lodsb
	mov	word ptr allowed_key_count,ax
	xchg	si,di
wait_allowed_key:
	push	di
	push	di
	call	read_key
	cmp	al,0bbh
	jnz	match_allowed_key
	call	context_help
	jz	match_allowed_key
	pop	di
	pop	di
	jmp	wait_allowed_key
match_allowed_key:
	mov	byte ptr key_value,al
	mov	cx,word ptr allowed_key_count
	pop	di
	jcxz	return_key_choice
	repne	scasb
	jnz	reject_key_choice
return_key_choice:
	pop	di
	mov	ax,word ptr allowed_key_count
	sub	ax,cx
	dec	al
	mov	byte ptr key_index,al
	mov	bl,al
	mov	al,byte ptr key_value
	ret
reject_key_choice:
	call	bell
	pop	di
	jmps	wait_allowed_key

; -----------------------------------------------------------------------------
; Set the context-help topic and redraw the footer only when its type changes.
; -----------------------------------------------------------------------------
select_help_footer:
	mov	word ptr current_help_topic,dx
	cmp	bx,word ptr help_footer_type
	jz	footer_unchanged
	mov	word ptr help_footer_type,bx
	mov	si,offset help_footer_tables
render_footer_table:
	xor	dx,dx
	mov	ax,4h
	mul	bx
	add	si,ax
	lodsw
	mov	bx,word ptr [si]
	mov	si,ax
	call	render_records
footer_unchanged:
	ret

; -----------------------------------------------------------------------------
; Redraw the menu's footer only when the requested footer type changes.
; -----------------------------------------------------------------------------
select_menu_footer:
	cmp	bx,word ptr menu_footer_type
	jz	footer_unchanged
	mov	word ptr menu_footer_type,bx
	mov	si,offset menu_footer_tables
	jmp	render_footer_table

; -----------------------------------------------------------------------------
; Clear the 17 interior menu rows without disturbing the frame.
; -----------------------------------------------------------------------------
clear_menu_body:
	mov	ax,404h
	mov	cx,11h
	push	cx
	mov	word ptr screen_position,ax
	call	position_cursor
	pop	cx
clear_menu_row:
	push	cx
	mov	si,offset blank_menu_row
	call	print_length_string
	call	next_screen_row
	pop	cx
	loop	clear_menu_row
	ret

; -----------------------------------------------------------------------------
; Increment the saved row and reposition the cursor.
; -----------------------------------------------------------------------------
next_screen_row:
	inc	byte ptr screen_position
	mov	ax,word ptr screen_position
	call	position_cursor
	ret

; -----------------------------------------------------------------------------
; BDOS entry. Callers supply the function in CL and its argument in DX.
; -----------------------------------------------------------------------------
bdos:
	int	0e0h
	ret

; -----------------------------------------------------------------------------
; Print the word-length-prefixed string at DS:SI using BDOS 111's
; offset/segment/length parameter block.
; -----------------------------------------------------------------------------
print_length_string:
	lodsw
	mov	word ptr output_length,ax
	mov	word ptr output_offset,si
	mov	cl,6fh
	mov	dx,offset output_offset
	jmp	bdos

; -----------------------------------------------------------------------------
; Print the dollar-terminated string at DS:SI with BDOS 9.
; -----------------------------------------------------------------------------
print_dollar_string:
	mov	cl,9h
	mov	dx,si
	jmp	bdos

; -----------------------------------------------------------------------------
; Prepare the offset/segment/length block for BDOS 112.
; -----------------------------------------------------------------------------
read_length_buffer:
	lodsw
	mov	word ptr input_length,ax
	mov	word ptr input_offset,si
	mov	cl,70h
	mov	dx,offset input_offset
	jmp	bdos

; -----------------------------------------------------------------------------
; Print the length-prefixed bell character.
; -----------------------------------------------------------------------------
bell:
	mov	si,offset bell_string
	jmp	print_length_string

; -----------------------------------------------------------------------------
; BDOS 6, DL=FDh: wait for an un-echoed console character.
; -----------------------------------------------------------------------------
read_key:
	mov	dl,0fdh
	mov	cl,6h
	jmp	bdos

; -----------------------------------------------------------------------------
; Convert AX to decimal, filling the buffer backward for at most CX digits.
; -----------------------------------------------------------------------------
format_decimal:
	dec	di
	add	di,cx
	mov	bx,0ah
decimal_digit_loop:
	sub	dx,dx
	div	bx
	add	dl,30h
	mov	byte ptr [di],dl
	dec	di
	test	ax,ax
	jz	decimal_complete
	loop	decimal_digit_loop
decimal_complete:
	ret

; -----------------------------------------------------------------------------
; Poll console status, then test for Ctrl-C or Escape when input is pending.
; -----------------------------------------------------------------------------
check_abort_key:
	mov	cl,0bh
	call	bdos
	or	al,al
	jz	no_abort_pending
	call	read_key
	cmp	al,3h
	jz	return_abort_test
	cmp	al,1bh
return_abort_test:
	ret
no_abort_pending:
	inc	al
	ret

; -----------------------------------------------------------------------------
; Invoke the current help topic only when the help footer is enabled.
; Release and reacquire the screen mutex around HELP.
; -----------------------------------------------------------------------------
context_help:
	cmp	word ptr help_footer_type,0h
	jz	display_context_help
	push	ax
	xor	ax,ax
	pop	ax
	ret
display_context_help:
	call	release_screen_once
	mov	dx,word ptr current_help_topic
	call	invoke_help
	call	reacquire_screen
	xor	al,al
	inc	al
	ret

; -----------------------------------------------------------------------------
; Convert packed column/row coordinates to the console escape sequence.
; -----------------------------------------------------------------------------
position_cursor:
	mov	si,offset cursor_coordinates
	add	ax,1f1fh
	mov	word ptr [si],ax
	mov	si,offset cursor_sequence
	jmp	print_length_string
	mov	si,offset cursor_enable_sequence
	jmp	print_length_string
	mov	si,offset cursor_disable_sequence
	jmp	print_length_string

; -----------------------------------------------------------------------------
; Select the console attribute escape byte from the attribute table.
; -----------------------------------------------------------------------------
set_display_attribute:
	mov	si,offset attribute_codes
	xor	ah,ah
	add	si,ax
	mov	al,byte ptr [si]
	mov	byte ptr attribute_byte,al
	mov	si,offset attribute_sequence
	jmp	print_length_string

; -----------------------------------------------------------------------------
; Send the screen-reset escape string.
; -----------------------------------------------------------------------------
clear_screen:
	mov	si,offset clear_sequence
	jmp	print_length_string

; -----------------------------------------------------------------------------
; Set console mode through BDOS 109, initialize the terminal and port menu.
; -----------------------------------------------------------------------------
initialize_screen:
	mov	cl,6dh
	mov	dx,8eh
	call	bdos
	mov	si,offset initialize_sequence
	call	print_length_string
	call	build_port_menu
	ret

; -----------------------------------------------------------------------------
; Call BDOS 145 with the original delay argument.
; -----------------------------------------------------------------------------
delay_tick:
	mov	dl,96h
	mov	cl,91h
	jmp	bdos

; -----------------------------------------------------------------------------
; Set bit 1 of the current process descriptor flags.
; -----------------------------------------------------------------------------
set_process_flag:
	mov	bx,word ptr process_descriptor
	push	ds
	mov	ds,word ptr system_segment
	or	word ptr 6h[bx],2h
	pop	ds
	ret

; -----------------------------------------------------------------------------
; Clear bit 1 of the current process descriptor flags.
; -----------------------------------------------------------------------------
clear_process_flag:
	mov	bx,word ptr process_descriptor
	push	ds
	mov	ds,word ptr system_segment
	and	word ptr 6h[bx],0fffdh
	pop	ds
	ret

; -----------------------------------------------------------------------------
; With interrupts masked, set console flag 8 only when its flags word is zero.
; -----------------------------------------------------------------------------
try_console_flag:
	mov	bx,word ptr console_descriptor
	push	ds
	mov	ds,word ptr system_segment
	cli
	cmp	word ptr 0eh[bx],0h
	jz	claim_console_flag
	xor	ax,ax
	jmps	restore_console_interrupts
claim_console_flag:
	or	word ptr 0eh[bx],8h
restore_console_interrupts:
	sti
	pop	ds
	ret

; -----------------------------------------------------------------------------
; Clear flag 8 in the current console descriptor.
; -----------------------------------------------------------------------------
clear_console_flag:
	mov	bx,word ptr console_descriptor
	push	ds
	mov	ds,word ptr system_segment
	and	word ptr 0eh[bx],0fff7h
	pop	ds
	ret

; -----------------------------------------------------------------------------
; Check the system word at 88h, then open and acquire the screen queue.
; -----------------------------------------------------------------------------
open_screen_mutex:
	push	ds
	mov	ds,word ptr system_segment
	mov	ax,word ptr .88h
	or	ax,ax
	pop	ds
	jnz	screen_mutex_unavailable
	mov	cl,87h
	mov	dx,offset screen_queue
	call	bdos
acquire_screen_mutex:
	mov	cl,89h
	mov	dx,offset screen_queue
	call	bdos
	xor	al,al
	inc	al
	mov	byte ptr screen_released,0h
	ret
screen_mutex_unavailable:
	xor	ax,ax
	ret

; -----------------------------------------------------------------------------
; BDOS 139 releases the screen mutual-exclusion queue.
; -----------------------------------------------------------------------------
release_screen_mutex:
	mov	cl,8bh
	mov	dx,offset screen_queue
	call	bdos
	ret

; -----------------------------------------------------------------------------
; Release the mutex once and mark it released while HELP runs.
; -----------------------------------------------------------------------------
release_screen_once:
	cmp	byte ptr screen_released,0h
	jnz	screen_already_released
	call	release_screen_mutex
	mov	byte ptr screen_released,1h
screen_already_released:
	ret

; -----------------------------------------------------------------------------
; Reacquire the screen queue if it was released for HELP.
; -----------------------------------------------------------------------------
reacquire_screen:
	cmp	byte ptr screen_released,1h
	jz	acquire_screen_mutex
	ret

; -----------------------------------------------------------------------------
; Use BDOS 154/156 to locate system data, process descriptor and XIOS.
; BDOS 153 selects the console's 44-byte descriptor.
; -----------------------------------------------------------------------------
locate_system:
	push	es
	mov	cl,9ah
	call	bdos
	mov	word ptr system_segment,es
	mov	cl,9ch
	call	bdos
	mov	word ptr process_descriptor,bx
	mov	ax,es:word ptr 10h[bx]
	mov	word ptr xios_segment,ax
	mov	cl,99h
	call	bdos
	xor	ah,ah
	mov	byte ptr console_number,al
	mov	bx,2ch
	mul	bx
	add	ax,es:word ptr .54h
	mov	word ptr console_descriptor,ax
	pop	es
	ret

; -----------------------------------------------------------------------------
; Indirect entry: the first call initializes HELP's console state; later
; calls go directly to the screen-save and HELP wrapper.
; -----------------------------------------------------------------------------
invoke_help:
	jmp	word ptr help_dispatch

; -----------------------------------------------------------------------------
; Locate HELP console/window buffers and its screen mutex once.
; Replace the dispatch pointer with the normal screen-save wrapper.
; -----------------------------------------------------------------------------
initialize_help_wrapper:
	push	dx
	push	es
	mov	cl,9ah
	call	help_wrapper_bdos
	mov	word ptr wrapper_system_segment,es
	mov	cl,9ch
	call	help_wrapper_bdos
	mov	word ptr help_process_descriptor,bx
	mov	ax,es:word ptr 10h[bx]
	mov	word ptr help_xios_segment,ax
	mov	cl,99h
	call	help_wrapper_bdos
	mov	byte ptr help_console_number,al
	xor	ah,ah
	mov	bx,2ch
	mul	bx
	add	ax,es:word ptr .54h
	mov	word ptr help_console_descriptor,ax
	mov	dl,byte ptr help_console_number
	mov	al,10h
	call	help_wrapper_xios
	xchg	ax,bx
	mov	word ptr help_window_descriptor,bx
	mov	ax,es:word ptr 16h[bx]
	mov	word ptr help_video_segment,ax
	mov	bx,es:word ptr 28h[bx]
	pop	es
	mov	ax,50h
	mul	bx
	mov	word ptr help_screen_words,ax
	mov	al,byte ptr help_console_number
	add	al,30h
	mov	byte ptr help_queue_console_digit,al
	call	open_help_mutex
	pop	dx
	mov	word ptr help_dispatch,9d5h
	jmp	word ptr help_dispatch

; -----------------------------------------------------------------------------
; Save the current console image, blank it, run the embedded HELP engine,
; then restore the saved screen. DX points to a zero-terminated help topic.
; -----------------------------------------------------------------------------
help_screen_wrapper:
	push	dx
	mov	byte ptr help_restore_flag,0h
	call	acquire_help_mutex
	call	prepare_help_console
	call	copy_help_screen
	call	blank_help_screen
	call	restore_help_cursor
	call	release_help_mutex
	pop	dx
	call	help_entry
	call	restore_help_screen
	ret

; -----------------------------------------------------------------------------
; Restore the console image and cursor while holding its mutex.
; -----------------------------------------------------------------------------
restore_help_screen:
	mov	byte ptr help_restore_flag,0ffh
	call	acquire_help_mutex
	call	copy_help_screen
	call	restore_help_cursor
	call	release_help_mutex
	ret

; -----------------------------------------------------------------------------
; Open the console screen queue using BDOS 135.
; -----------------------------------------------------------------------------
open_help_mutex:
	mov	cl,87h
help_queue_operation:
	call	set_queue_flag
	mov	dx,offset help_screen_queue
	call	help_wrapper_bdos
	call	clear_queue_flag
	ret

; -----------------------------------------------------------------------------
; Acquire the console screen queue using BDOS 137.
; -----------------------------------------------------------------------------
acquire_help_mutex:
	mov	cl,89h
	jmps	help_queue_operation

; -----------------------------------------------------------------------------
; Release the console screen queue using BDOS 139.
; -----------------------------------------------------------------------------
release_help_mutex:
	mov	cl,8bh
	jmps	help_queue_operation

; -----------------------------------------------------------------------------
; Read the saved window cursor and apply it with XIOS function 20.
; -----------------------------------------------------------------------------
restore_help_cursor:
	mov	si,word ptr help_window_descriptor
	push	es
	mov	es,word ptr wrapper_system_segment
	mov	cx,es:word ptr 2h[si]
	mov	bx,es:word ptr 4h[si]
	pop	es
	mov	al,14h
	mov	dl,byte ptr help_console_number
	call	help_wrapper_xios
	ret

; -----------------------------------------------------------------------------
; Temporarily clear the console flag while calling XIOS function 7.
; Restore the original descriptor flags afterward.
; -----------------------------------------------------------------------------
prepare_help_console:
	push	es
	mov	es,word ptr wrapper_system_segment
	mov	bx,word ptr help_console_descriptor
	mov	ax,es:word ptr 0eh[bx]
	push	ax
	push	bx
	and	es:word ptr 0eh[bx],0fff7h
	mov	dl,byte ptr help_console_number
	mov	al,7h
	call	help_wrapper_xios
	pop	bx
	pop	ax
	mov	es:word ptr 0eh[bx],ax
	pop	es
	ret

; -----------------------------------------------------------------------------
; Copy screen words between the console buffer and local storage.
; The restore flag reverses source and destination; preserve DS and ES.
; -----------------------------------------------------------------------------
copy_help_screen:
	mov	cx,word ptr help_screen_words
	mov	ax,word ptr help_video_segment
	mov	di,offset help_screen_buffer
	xor	si,si
	mov	bx,ds
	mov	dx,es
	mov	ds,ax
	mov	es,bx
	cmp	es:byte ptr .11f3h,0h
	jz	copy_screen_words
	mov	ds,bx
	mov	es,ax
	xchg	di,si
copy_screen_words:
	cld
	rep	movsw
	mov	ds,bx
	mov	es,dx
	ret

; -----------------------------------------------------------------------------
; Fill the console buffer with spaces in attribute 07h.
; -----------------------------------------------------------------------------
blank_help_screen:
	mov	cx,word ptr help_screen_words
	mov	ax,offset config_word_pointer
	mov	dx,es
	mov	es,word ptr help_video_segment
	xor	di,di
	cld
	rep	stosw
	mov	es,dx
	ret

; -----------------------------------------------------------------------------
; Set process-descriptor flag bit 0 around a screen queue operation.
; -----------------------------------------------------------------------------
set_queue_flag:
	push	es
	push	bx
	mov	es,word ptr wrapper_system_segment
	mov	bx,word ptr help_process_descriptor
	or	es:word ptr 6h[bx],1h
	pop	bx
	pop	es
	ret

; -----------------------------------------------------------------------------
; Clear process-descriptor flag bit 0 after a screen queue operation.
; -----------------------------------------------------------------------------
clear_queue_flag:
	push	es
	push	bx
	mov	es,word ptr wrapper_system_segment
	mov	bx,word ptr help_process_descriptor
	and	es:word ptr 6h[bx],0fffeh
	pop	bx
	pop	es
	ret

; -----------------------------------------------------------------------------
; BDOS entry used by the screen-save wrapper.
; -----------------------------------------------------------------------------
help_wrapper_bdos:
	int	0e0h
	ret

; -----------------------------------------------------------------------------
; Call the far XIOS entry with the wrapper's saved system segments.
; -----------------------------------------------------------------------------
help_wrapper_xios:
	push	ds
	push	es
	mov	es,word ptr help_xios_segment
	mov	ds,word ptr wrapper_system_segment
	callf	dword ptr .28h
	pop	es
	pop	ds
	ret

; -----------------------------------------------------------------------------
; Retained fallback: display the topic and placeholder HELP message, then wait.
; -----------------------------------------------------------------------------
help_stub:
	mov	cl,9h
	int	0e0h
	mov	dx,offset help_stub_message
	mov	cl,9h
	int	0e0h
	mov	cx,1h
	int	0e0h
	ret
utility_alignment	db	0h,0h,0h,0h,0h,0h

; -----------------------------------------------------------------------------
; Embedded HELP V2.0 entry: skip its copyright and save the caller context.
; -----------------------------------------------------------------------------
help_entry:
	jmps	help_save_context
	nop
help_copyright	db	'COPYRIGHT(C)1983,84,DIGITAL RESEARCH(05/02/84)1031-0000-009373'

; -----------------------------------------------------------------------------
; Save caller flags/registers, obtain the system drive, and copy the topic.
; The zero immediates loading ES and DS are loader-relocated DATA segments
; at CODE 0B53h and 0B60h; their on-disk words must remain zero.
; -----------------------------------------------------------------------------
help_save_context:
	pushf
	push	ds
	push	es
	push	ax
	push	bx
	push	cx
	push	dx
	push	es
	push	dx
	mov	cl,9ah
	int	0e0h
	mov	word ptr help_system_segment,es
	mov	bx,4bh
	mov	al,es:byte ptr [bx]
	inc	al
	mov	byte ptr help_system_disk,al
	pop	dx
	pop	es
	cld
	mov	si,dx
	mov	ax,0h
	mov	es,ax
	mov	di,offset help_input_text
	mov	cx,7fh
	rep	movsb
	mov	ax,0h
	mov	ds,ax
	mov	bx,offset help_input_buffer
measure_help_topic:
	inc	bx
	cmp	byte ptr [bx],0h
	jnz	measure_help_topic
	sub	bx,offset help_input_text
	mov	byte ptr help_input_buffer,bl
	mov	word ptr help_caller_ss,ss
	mov	word ptr help_caller_sp,sp
	call	help_private_stack
	call	help_main

; -----------------------------------------------------------------------------
; Restore the caller's stack, registers and flags; return to SETPORT.
; -----------------------------------------------------------------------------
help_return:
	pushf
	pop	bx
	cli
	mov	ss,word ptr help_caller_ss
	mov	sp,word ptr help_caller_sp
	push	bx
	popf
	pop	dx
	pop	cx
	pop	bx
	pop	ax
	pop	es
	pop	ds
	popf
	ret

; -----------------------------------------------------------------------------
; PL/M stack interface: function and argument are words on the stack.
; Intercept BDOS 10 for HELP's local line editor; save AX/BX/CX/DX results.
; -----------------------------------------------------------------------------
help_bdos:
	push	bp
	mov	bp,sp
	add	bp,4h
	mov	dx,word ptr 0h[bp]
	add	bp,2h
	mov	cx,word ptr 0h[bp]
	cmp	cl,0ah
	jnz	help_bdos_interrupt
	call	help_line_editor
	jmps	save_help_bdos_results
	nop
help_bdos_interrupt:
	int	0e0h
save_help_bdos_results:
	mov	word ptr help_saved_ax,ax
	mov	word ptr help_saved_bx,bx
	mov	word ptr help_saved_cx,cx
	mov	word ptr help_saved_dx,dx
	pop	bp
	ret	word ptr 4h

; -----------------------------------------------------------------------------
; Switch to the HELP stack within DATA with interrupts safely masked.
; -----------------------------------------------------------------------------
help_private_stack:
	pop	dx
	pushf
	pop	bx
	cli
	mov	cx,ds
	mov	ss,cx
	mov	sp,180h
	push	bx
	popf
	push	dx
	ret

; -----------------------------------------------------------------------------
; Retained PL/M startup entry; normal HELP entry calls help_main directly.
; -----------------------------------------------------------------------------
help_plm_start:
	mov	bp,sp
	sti

; -----------------------------------------------------------------------------
; Initialize HELP, open HELP.HLP on the default or system drive, parse the
; requested topic and navigate topics/subtopics. Close the file and return
; to SETPORT, including on a user abort or missing help file.
; -----------------------------------------------------------------------------
help_main:
	mov	sp,124h
	mov	bp,sp
	mov	byte ptr help_end_of_data,0h
	mov	byte ptr help_line_count,0h
	call	help_private_stack
	call	help_get_version
	mov	word ptr help_version,ax
	mov	byte ptr help_page_length,16h
	mov	byte ptr help_page_mode,0ffh
	call	help_parse
	mov	byte ptr help_token_count,al
	mov	al,0dh
	push	ax
	mov	ax,offset help_filename
	push	ax
	mov	ax,offset help_fcb
	push	ax
	call	help_move
	mov	ax,offset help_fcb
	push	ax
	call	help_open_file
	mov	byte ptr help_open_status,al
	cmp	byte ptr help_open_status,0ffh
	jnz	test_help_open_result
	call	help_system_drive
	mov	byte ptr help_fcb,al
	mov	al,0h
	push	ax
	call	help_set_user
	mov	ax,offset help_fcb
	push	ax
	call	help_open_file
	mov	byte ptr help_open_status,al
test_help_open_result:
	cmp	byte ptr help_open_status,0ffh
	jnz	initialize_help_index
	jmp	report_missing_help_file
initialize_help_index:
	call	help_reset_index
	mov	al,byte ptr help_list_mode
	not	al
	rcr	al,1
	jnc	test_initial_help_topic
	mov	ax,offset help_clear_screen
	push	ax
	call	help_print_string
test_initial_help_topic:
	cmp	byte ptr help_token_count,0h
	jnz	test_help_token_count
	mov	byte ptr help_level,0h
	mov	ax,offset help_intro
	push	ax
	call	help_print_string
	mov	byte ptr help_line_count,2h
display_available_topics:
	call	help_display_index
prompt_for_help_topic:
	call	help_prompt
	mov	byte ptr help_token_count,al
test_help_token_count:
	mov	al,0h
	cmp	byte ptr help_token_count,al
	jnz	test_help_question_mark
	jmp	close_help_and_return
test_help_question_mark:
	mov	byte ptr help_level,al
	mov	cx,offset help_topic_tokens
	push	cx
	mov	cx,offset help_question_token
	push	cx
	call	help_compare
	cmp	al,0h
	jnz	search_exact_help_topic
	jmp	choose_help_next_action
search_exact_help_topic:
	mov	byte ptr help_search_level,0h
	call	help_search
	cmp	al,0ffh
	jz	search_parent_help_topic
	call	help_print_topic
	mov	ax,offset help_topic_tokens
	push	ax
	mov	ax,offset help_command_token
	jmps	compare_help_keyword
search_parent_help_topic:
	mov	byte ptr help_search_level,1h
	mov	byte ptr help_level,0h
	call	help_search
	cmp	al,0ffh
	jz	report_missing_help_topic
	call	help_print_topic
	mov	ax,offset help_topic_tokens
	push	ax
	mov	ax,offset help_intro_token
compare_help_keyword:
	push	ax
	call	help_compare
	cmp	al,0h
	jz	help_topic_displayed
	jmp	choose_help_next_action
help_topic_displayed:
	jmp	reset_help_level
report_missing_help_topic:
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	reset_help_level
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	reset_help_level
	mov	ax,offset help_topic_heading
	push	ax
	call	help_print_string
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	push	word ptr help_token_count
	call	help_display_tokens
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	mov	ax,offset help_not_found
	push	ax
	call	help_print_string
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
reset_help_level:
	mov	byte ptr help_level,0h
choose_help_next_action:
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	return_to_help_prompt
	jmp	display_available_topics
return_to_help_prompt:
	jmp	prompt_for_help_topic
close_help_and_return:
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	byte ptr help_file_status,al
	jmps	finish_help_session
report_missing_help_file:
	mov	al,0h
	push	ax
	mov	ax,offset help_file_missing
	push	ax
	call	help_error
finish_help_session:
	call	help_return
	sti
	hlt

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 1; retained although not called by this HELP path.
; -----------------------------------------------------------------------------
help_read_console:
	push	bp
	mov	bp,sp
	mov	al,1h
	push	ax
	mov	ax,0h
	push	ax
	call	help_bdos
	pop	bp
	ret

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 2, console character output.
; -----------------------------------------------------------------------------
help_write_console:
	push	bp
	mov	bp,sp
	mov	al,2h
	push	ax
	mov	al,byte ptr 4h[bp]
	mov	ah,0h
	push	ax
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 9, dollar-terminated string output.
; -----------------------------------------------------------------------------
help_print_string:
	push	bp
	mov	bp,sp
	mov	al,9h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 10; intercepted by the local HELP line editor.
; -----------------------------------------------------------------------------
help_read_line:
	push	bp
	mov	bp,sp
	mov	al,0ah
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 6, direct console I/O.
; -----------------------------------------------------------------------------
help_direct_console:
	push	bp
	mov	bp,sp
	mov	al,6h
	push	ax
	mov	al,byte ptr 4h[bp]
	mov	ah,0h
	push	ax
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 12, system version.
; -----------------------------------------------------------------------------
help_get_version:
	push	bp
	mov	bp,sp
	mov	al,0ch
	push	ax
	mov	ax,0h
	push	ax
	call	help_bdos
	pop	bp
	ret

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 19; retained file interface entry.
; -----------------------------------------------------------------------------
help_delete_file:
	push	bp
	mov	bp,sp
	mov	al,13h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Clear extent/current-record fields and open an FCB using BDOS 15.
; -----------------------------------------------------------------------------
help_open_file:
	push	bp
	mov	bp,sp
	mov	bx,word ptr 4h[bp]
	mov	byte ptr 0ch[bx],0h
	mov	byte ptr 20h[bx],0h
	mov	al,0fh
	push	ax
	push	bx
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 16, close FCB.
; -----------------------------------------------------------------------------
help_close_file:
	push	bp
	mov	bp,sp
	mov	al,10h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 20, sequential record read.
; -----------------------------------------------------------------------------
help_read_record:
	push	bp
	mov	bp,sp
	mov	al,14h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 21; retained file interface entry.
; -----------------------------------------------------------------------------
help_write_record:
	push	bp
	mov	bp,sp
	mov	al,15h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Clear FCB extent/current-record fields, then call BDOS 22.
; -----------------------------------------------------------------------------
help_make_file:
	push	bp
	mov	bp,sp
	mov	bx,word ptr 4h[bp]
	mov	byte ptr 0ch[bx],0h
	mov	byte ptr 20h[bx],0h
	mov	al,16h
	push	ax
	push	bx
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 33, random record read.
; -----------------------------------------------------------------------------
help_read_random:
	push	bp
	mov	bp,sp
	mov	al,21h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 26, select DMA address.
; -----------------------------------------------------------------------------
help_set_dma:
	push	bp
	mov	bp,sp
	mov	al,1ah
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 36; retained file interface entry.
; -----------------------------------------------------------------------------
help_set_random_record:
	push	bp
	mov	bp,sp
	mov	al,24h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 32, select/query user number.
; -----------------------------------------------------------------------------
help_set_user:
	push	bp
	mov	bp,sp
	mov	al,20h
	push	ax
	mov	al,byte ptr 4h[bp]
	mov	ah,0h
	push	ax
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Return the system drive only for the recognized concurrent OS family.
; -----------------------------------------------------------------------------
help_system_drive:
	push	bp
	mov	bp,sp
	call	help_get_version
	mov	al,ah	; 0EA4h: original 88E0, ASM86 8AC4 (same instruction/length)
	and	al,0fdh
	cmp	al,14h
	jz	return_help_system_drive
	mov	al,0h
	pop	bp
	ret
return_help_system_drive:
	mov	al,byte ptr help_system_disk
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Print ERROR, the supplied dollar-terminated message and CR/LF.
; Return to SETPORT when the caller requests termination.
; -----------------------------------------------------------------------------
help_error:
	push	bp
	mov	bp,sp
	mov	ax,offset help_error_prefix
	push	ax
	call	help_print_string
	push	word ptr 4h[bp]
	call	help_print_string
	mov	ax,offset help_newline
	push	ax
	call	help_print_string
	mov	al,byte ptr 6h[bp]
	rcr	al,1
	jnc	help_error_return
	call	help_return
help_error_return:
	pop	bp
	ret	word ptr 4h

; -----------------------------------------------------------------------------
; Copy a byte count between two addresses; PL/M callee removes arguments.
; -----------------------------------------------------------------------------
help_move:
	push	bp
	mov	bp,sp
	mov	cl,byte ptr 8h[bp]
	mov	ch,0h
	mov	si,word ptr 6h[bp]
	mov	di,word ptr 4h[bp]
	push	ds
	pop	es
	cld
	repne	movsb
	pop	bp
	ret	word ptr 6h

; -----------------------------------------------------------------------------
; Compare two space-padded, twelve-character topic names.
; Return 0 for equal, 1 for less and 2 for greater.
; -----------------------------------------------------------------------------
help_compare:
	push	bp
	mov	bp,sp
	mov	byte ptr help_compare_result,0h
	mov	byte ptr help_compare_index,0h
compare_topic_character:
	mov	al,byte ptr help_compare_index
	cmp	al,0ch
	mov	al,0ffh
	jc	load_topic_character
	inc	ax
load_topic_character:
	mov	cl,byte ptr help_compare_index
	mov	ch,0h
	mov	si,cx	; 0F0Eh: original 89CE, ASM86 8BF1 (same instruction/length)
	mov	bx,word ptr 6h[bp]
	mov	dl,byte ptr [bx+si]
	push	ax
	cmp	dl,20h
	mov	al,0ffh
	jnz	test_topic_compare_limit
	inc	ax
test_topic_compare_limit:
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	return_topic_comparison
	mov	bx,word ptr 4h[bp]
	cmp	dl,byte ptr [bx+si]
	jz	advance_topic_character
	cmp	dl,byte ptr [bx+si]
	jnc	topic_compares_greater
	mov	byte ptr help_compare_result,1h
	jmps	finish_topic_difference
topic_compares_greater:
	mov	byte ptr help_compare_result,2h
finish_topic_difference:
	mov	byte ptr help_compare_index,0bh
advance_topic_character:
	inc	byte ptr help_compare_index
	jmps	compare_topic_character
return_topic_comparison:
	mov	al,byte ptr help_compare_result
	pop	bp
	ret	word ptr 4h

; -----------------------------------------------------------------------------
; Move through 16-byte index entries in a 1 KiB cache. Crossing a 64-entry
; boundary reloads eight records; 8000h resets the index to its start.
; -----------------------------------------------------------------------------
help_step_index:
	pop	cx
	pop	word ptr help_index_step
	pop	word ptr help_index_pointer
	push	cx
	push	bp
	mov	bp,sp
	mov	byte ptr help_records_per_block,8h
	cmp	word ptr help_index_step,8000h
	jnz	test_index_direction
	mov	ax,0h
	mov	word ptr help_index_block,ax
	mov	byte ptr help_record_number,al
	mov	bx,word ptr help_index_pointer
	mov	word ptr [bx],ax
	call	help_load_index_block
	pop	bp
	ret
test_index_direction:
	cmp	word ptr help_index_step,8000h
	jna	test_forward_index_step
	neg	word ptr help_index_step
	mov	byte ptr help_step_count,1h
previous_index_entry:
	mov	al,byte ptr help_step_count
	mov	ah,0h
	cmp	ax,word ptr help_index_step
	ja	index_step_complete
	mov	bx,word ptr help_index_pointer
	mov	ax,word ptr [bx]
	dec	ax
	mov	word ptr [bx],ax
	cmp	ax,8000h
	jna	count_backward_step
	mov	ax,word ptr help_index_block
	mov	cl,byte ptr help_records_per_block
	mov	ch,0h
	mul	cx
	sub	ax,cx
	mov	byte ptr help_record_number,al
	call	help_load_index_block
	mov	bx,word ptr help_index_pointer
	add	word ptr [bx],40h
	dec	word ptr help_index_block
count_backward_step:
	inc	byte ptr help_step_count
	jnz	previous_index_entry
	pop	bp
	ret
test_forward_index_step:
	cmp	word ptr help_index_step,0h
	jna	index_step_complete
	mov	byte ptr help_step_count,1h
next_index_entry:
	mov	al,byte ptr help_step_count
	mov	ah,0h
	cmp	ax,word ptr help_index_step
	ja	index_step_complete
	mov	bx,word ptr help_index_pointer
	mov	ax,word ptr [bx]
	inc	ax
	mov	word ptr [bx],ax
	cmp	ax,3fh	; 0FECh: original 83F83F, ASM86 3D3F00 (same instruction/length)
	jna	count_forward_step
	mov	ax,word ptr help_index_block
	mov	cl,byte ptr help_records_per_block
	mov	ch,0h
	mul	cx
	add	ax,cx
	mov	byte ptr help_record_number,al
	call	help_load_index_block
	mov	bx,word ptr help_index_pointer
	sub	word ptr [bx],40h
	inc	word ptr help_index_block
count_forward_step:
	inc	byte ptr help_step_count
	jnz	next_index_entry
index_step_complete:
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Read eight random 128-byte records into the index cache, restoring the
; normal DMA afterward. A read error closes HELP.HLP and returns to SETPORT.
; -----------------------------------------------------------------------------
help_load_index_block:
	push	bp
	mov	bp,sp
	mov	byte ptr help_record_index,0h
load_index_record:
	mov	al,byte ptr help_records_per_block
	dec	al
	cmp	byte ptr help_record_index,al
	ja	restore_help_dma
	mov	al,byte ptr help_record_index
	mov	cl,80h
	mul	cl
	mov	cx,10h
	xor	dx,dx	; 1034h: original 31D2, ASM86 33D2 (same instruction/length)
	div	cx
	mul	cx
	mov	bx,ax	; 103Ah: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	call	help_set_dma
	mov	al,byte ptr help_record_number
	mov	byte ptr help_random_record,al
	mov	al,0h
	mov	byte ptr help_random_record_middle,al
	mov	byte ptr help_random_record_high,al
	mov	cx,offset help_fcb
	push	cx
	call	help_read_random
	cmp	al,0h
	jz	advance_index_record
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	ah,0h
	mov	word ptr help_index_step,ax
	mov	al,0ffh
	push	ax
	mov	ax,offset help_read_error
	push	ax
	call	help_error
advance_index_record:
	inc	byte ptr help_record_number
	inc	byte ptr help_record_index
	jnz	load_index_record
restore_help_dma:
	mov	ax,offset help_input_buffer
	push	ax
	call	help_set_dma
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Advance a sequential buffer index, reading another record after byte 127.
; Set the end-of-data flag on a failed read.
; -----------------------------------------------------------------------------
help_next_byte:
	push	bp
	mov	bp,sp
	mov	al,byte ptr 4h[bp]
	inc	al
	mov	byte ptr 4h[bp],al
	cmp	al,7fh
	jna	return_help_byte_index
	mov	ax,offset help_fcb
	push	ax
	call	help_read_record
	cmp	al,0h
	jz	reset_help_byte_index
	mov	byte ptr help_end_of_data,0ffh
reset_help_byte_index:
	mov	byte ptr 4h[bp],0h
return_help_byte_index:
	mov	al,byte ptr 4h[bp]
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Count output lines and prompt at the configured page length unless paging
; is disabled. RETURN continues, Ctrl-C returns to SETPORT, other keys stop
; the current display. Return the stop flag in AL.
; -----------------------------------------------------------------------------
help_page_check:
	push	bp
	mov	bp,sp
	mov	byte ptr help_page_stop,0h
	mov	al,byte ptr help_no_page_mode
	not	al
	and	al,byte ptr help_page_mode
	rcr	al,1
	jnc	paging_disabled
	mov	bx,word ptr 4h[bp]
	mov	al,byte ptr [bx]
	inc	al
	mov	byte ptr [bx],al
	cmp	al,byte ptr help_page_length
	jna	output_page_linefeed
	mov	ax,offset help_continue_prompt
	push	ax
	call	help_print_string
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],0h
wait_page_response:
	mov	bx,word ptr 4h[bp]
	cmp	byte ptr [bx],0h
	jnz	erase_page_prompt
	mov	al,0fdh
	push	ax
	call	help_direct_console
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],al
	jmps	wait_page_response
erase_page_prompt:
	mov	ax,offset help_erase_prompt
	push	ax
	call	help_print_string
	mov	bx,word ptr 4h[bp]
	cmp	byte ptr [bx],3h
	jnz	test_page_return_key
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],al
	call	help_return
	jmps	return_page_stop_flag
test_page_return_key:
	mov	bx,word ptr 4h[bp]
	cmp	byte ptr [bx],0dh
	jz	reset_page_line_count
	mov	byte ptr help_page_stop,0ffh
reset_page_line_count:
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],0h
	jmps	return_page_stop_flag
paging_disabled:
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],0h
output_page_linefeed:
	mov	al,0ah
	push	ax
	call	help_write_console
return_page_stop_flag:
	mov	al,byte ptr help_page_stop
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Reset the cached directory traversal to its initial index block.
; -----------------------------------------------------------------------------
help_reset_index:
	push	bp
	mov	bp,sp
	mov	word ptr help_global_index,8000h
	mov	ax,offset help_index_position
	push	ax
	mov	ax,8000h
	push	ax
	call	help_step_index
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Normalize commas/tabs to spaces; parse topic and subtopic tokens plus HELP
; options. A leading period extends the current topic path.
; -----------------------------------------------------------------------------
help_parse:
	push	bp
	mov	bp,sp
	mov	byte ptr help_parse_index,0h
	cmp	byte ptr help_input_buffer,0h
	jnz	begin_separator_normalization
	jmp	initialize_help_options
begin_separator_normalization:
	mov	byte ptr help_parse_index,1h
normalize_next_separator:
	mov	al,byte ptr help_parse_index
	cmp	al,byte ptr help_input_buffer
	ja	begin_leading_space_scan
	mov	ah,0h
	mov	bx,ax	; 1176h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_input_buffer[bx],9h
	jz	replace_separator_with_space
	mov	bl,byte ptr help_parse_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],2ch
	jnz	advance_separator_scan
replace_separator_with_space:
	mov	byte ptr help_input_buffer[bx],20h
advance_separator_scan:
	inc	byte ptr help_parse_index
	jnz	normalize_next_separator
begin_leading_space_scan:
	mov	byte ptr help_parse_index,1h
test_leading_space_limit:
	mov	al,byte ptr help_parse_index
	cmp	al,byte ptr help_input_buffer
	mov	al,0ffh
	jc	test_leading_space_character
	inc	ax
test_leading_space_character:
	mov	bl,byte ptr help_parse_index
	mov	bh,0h
	push	ax
	cmp	byte ptr help_input_buffer[bx],20h
	mov	al,0ffh
	jz	combine_leading_space_tests
	inc	ax
combine_leading_space_tests:
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	test_relative_topic_prefix
	inc	byte ptr help_parse_index
	jmps	test_leading_space_limit
test_relative_topic_prefix:
	mov	bl,byte ptr help_parse_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],2eh
	jnz	reset_topic_path_level
	mov	al,byte ptr help_level
	mov	byte ptr help_parse_level,al
	mov	byte ptr help_input_buffer[bx],20h
	jmps	prepare_topic_slots
reset_topic_path_level:
	mov	byte ptr help_parse_level,0h
prepare_topic_slots:
	mov	al,byte ptr help_parse_level
	mov	byte ptr help_parse_index,al
clear_next_topic_slot:
	cmp	byte ptr help_parse_index,0ah
	ja	begin_help_token_scan
	mov	al,0fh
	push	ax
	mov	cx,offset help_blank_topic
	push	cx
	mov	cx,ax	; 11F9h: original 89C1, ASM86 8BC8 (same instruction/length)
	mov	al,byte ptr help_parse_index
	mul	cl
	mov	bx,ax	; 1200h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_move
	inc	byte ptr help_parse_index
	jnz	clear_next_topic_slot
begin_help_token_scan:
	mov	al,byte ptr help_parse_level
	mov	byte ptr help_parse_index,al
	mov	byte ptr help_input_index,1h
	mov	byte ptr help_parse_done,0h
	mov	byte ptr help_option_seen,0h
test_help_input_end:
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],0h
	mov	al,0ffh
	jnz	test_help_parse_stop
	inc	ax
test_help_parse_stop:
	mov	cl,byte ptr help_parse_done
	not	cl
	and	al,cl
	rcr	al,1
	jc	test_help_token_space
	jmp	initialize_help_options
test_help_token_space:
	cmp	byte ptr help_input_buffer[bx],20h
	jnz	begin_help_token
	jmp	advance_help_input_index
begin_help_token:
	mov	byte ptr help_token_character_index,0h
read_help_token_character:
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	mov	al,byte ptr help_input_buffer[bx]
	push	ax
	cmp	al,20h
	mov	al,0ffh
	jnz	test_open_option_bracket
	inc	ax
test_open_option_bracket:
	pop	cx
	push	ax
	cmp	cl,5bh
	mov	al,0ffh
	jnz	test_close_option_bracket
	inc	ax
test_close_option_bracket:
	pop	dx
	and	al,dl
	push	ax
	cmp	cl,0h
	mov	al,0ffh
	jnz	test_help_token_width
	inc	ax
test_help_token_width:
	pop	dx
	and	al,dl
	push	ax
	cmp	byte ptr help_token_character_index,0ch
	mov	al,0ffh
	jc	test_help_token_capacity
	inc	ax
test_help_token_capacity:
	push	ax
	cmp	byte ptr help_parse_index,0bh
	mov	al,0ffh
	jc	combine_help_token_tests
	inc	ax
combine_help_token_tests:
	pop	dx
	and	al,dl
	pop	dx
	and	al,dl
	rcr	al,1
	jnc	advance_help_token_slot
	cmp	cl,60h
	jna	compute_help_token_address
	cmp	cl,7bh
	jnc	compute_help_token_address
	sub	cl,20h
	mov	al,byte ptr help_parse_index
	mov	dl,0fh
	mul	dl
	jmps	store_help_token_character
compute_help_token_address:
	mov	al,byte ptr help_parse_index
	mov	cl,0fh
	mul	cl
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	mov	cl,byte ptr help_input_buffer[bx]
store_help_token_character:
	mov	dl,byte ptr help_token_character_index
	mov	bx,ax	; 12C9h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	dh,0h
	mov	si,dx	; 12CDh: original 89D6, ASM86 8BF2 (same instruction/length)
	mov	byte ptr help_topic_tokens[bx+si],cl
	inc	byte ptr help_input_index
	inc	byte ptr help_token_character_index
	jmp	read_help_token_character
advance_help_token_slot:
	mov	al,byte ptr help_parse_index
	inc	al
	mov	byte ptr help_parse_index,al
	cmp	al,0ah
	ja	stop_help_token_scan
	mov	al,byte ptr help_option_seen
	rcr	al,1
	jnc	test_help_option_bracket
stop_help_token_scan:
	mov	byte ptr help_parse_done,0ffh
	jmps	repeat_help_input_scan
test_help_option_bracket:
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],5bh
	jnz	repeat_help_input_scan
	mov	al,byte ptr help_parse_index
	dec	al
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 130Eh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],20h
	jnz	store_help_option_token
	mov	al,byte ptr help_parse_index
	dec	al
	mov	byte ptr help_parse_index,al
store_help_option_token:
	mov	al,byte ptr help_parse_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1326h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	byte ptr help_topic_tokens[bx],5bh
	inc	byte ptr help_input_index
	inc	byte ptr help_parse_index
	mov	byte ptr help_option_seen,0ffh
	jmps	repeat_help_input_scan
advance_help_input_index:
	inc	byte ptr help_input_index
repeat_help_input_scan:
	jmp	test_help_input_end
initialize_help_options:
	mov	al,0h
	mov	byte ptr help_list_mode,al
	mov	byte ptr help_no_page_mode,al
	mov	byte ptr help_create_mode,al
	mov	byte ptr help_extract_mode,al
	cmp	byte ptr help_parse_index,al
	ja	begin_help_option_scan
	jmp	return_help_token_count
begin_help_option_scan:
	mov	byte ptr help_token_character_index,al
next_help_option_slot:
	mov	al,byte ptr help_token_character_index
	cmp	al,0ah
	jc	test_help_option_marker
	jmp	return_help_token_count
test_help_option_marker:
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 136Bh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],5bh
	jnz	advance_help_option_slot
	cmp	byte ptr 2665h[bx],43h
	jnz	test_help_list_option
	mov	byte ptr help_create_mode,0ffh
	jmps	remove_help_option_tokens
test_help_list_option:
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1389h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr 2665h[bx],45h
	jnz	test_help_no_page_option
	mov	byte ptr help_extract_mode,0ffh
remove_help_option_tokens:
	sub	byte ptr help_parse_index,2h
	jmps	finish_help_option_scan
test_help_no_page_option:
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 13A5h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr 2665h[bx],4eh
	jz	enable_help_no_page
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 13B5h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr 2665h[bx],4ch
	jnz	test_help_create_option
	mov	byte ptr help_list_mode,0ffh
enable_help_no_page:
	mov	byte ptr help_no_page_mode,0ffh
	jmps	remove_help_option_tokens
test_help_create_option:
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 13D1h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr 2665h[bx],20h
	jnz	remove_help_option_tokens
	dec	byte ptr help_parse_index
finish_help_option_scan:
	mov	byte ptr help_token_character_index,0ah
advance_help_option_slot:
	inc	byte ptr help_token_character_index
	jmp	next_help_option_slot
return_help_token_count:
	mov	al,byte ptr help_parse_index
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Walk the help index and display the available topics or subtopics,
; respecting nesting level, pagination and the user's stop request.
; -----------------------------------------------------------------------------
help_display_index:
	push	bp
	mov	bp,sp
	mov	ax,0h
	mov	word ptr help_listing_position,ax
	mov	byte ptr help_listing_heading_shown,al
	mov	byte ptr help_listing_top_level,al
	mov	word ptr help_listing_stride,1h
	mov	al,byte ptr help_level
	inc	al
	mov	byte ptr help_listing_level,al
	cmp	al,0ah
	jnc	mark_top_level_listing
	cmp	byte ptr help_level,0h
	jnz	use_saved_index_position
	mov	word ptr help_listing_position,0h
	jmps	reset_displayed_topic_count
use_saved_index_position:
	mov	ax,word ptr help_saved_index
	mov	word ptr help_listing_position,ax
reset_displayed_topic_count:
	mov	word ptr help_displayed_topics,0h
	jmps	calculate_index_display_step
mark_top_level_listing:
	mov	byte ptr help_listing_top_level,0ffh
calculate_index_display_step:
	mov	ax,word ptr help_listing_position
	sub	ax,word ptr help_listing_cursor
	mov	word ptr help_listing_delta,ax
	mov	cx,offset help_listing_cursor
	push	cx
	push	ax
	call	help_step_index
	mov	word ptr help_listing_position,0h
test_top_level_listing:
	mov	al,byte ptr help_listing_top_level
	not	al
	rcr	al,1
	jc	load_index_entry_level
	jmp	finish_topic_listing
load_index_entry_level:
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 145Eh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_index_cache[bx],24h
	jnz	load_index_entry_name
	mov	byte ptr help_listing_top_level,0ffh
load_index_entry_name:
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1474h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	al,byte ptr 2213h[bx]
	cmp	al,byte ptr help_listing_level
	jz	test_subtopic_heading_printed
	jmp	load_next_index_level
test_subtopic_heading_printed:
	mov	al,byte ptr help_listing_heading_shown
	not	al
	rcr	al,1
	jc	print_topics_heading
	jmp	test_topic_column_boundary
print_topics_heading:
	mov	byte ptr help_listing_heading_shown,0ffh
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	cmp	byte ptr help_listing_level,1h
	jnz	test_index_scan_direction
	mov	al,byte ptr help_listing_top_level
	not	al
	rcr	al,1
	jnc	begin_index_display_page
	mov	ax,offset help_topics_heading
	push	ax
	call	help_print_string
	mov	ax,offset help_listing_cursor
	push	ax
	mov	ax,8000h
	push	ax
	call	help_step_index
	jmps	begin_index_display_page
test_index_scan_direction:
	cmp	byte ptr help_listing_level,2h
	jna	test_subtopic_heading_needed
	mov	ax,word ptr help_listing_cursor
	mov	word ptr help_listing_stride,ax
scan_previous_index_entry:
	mov	ax,offset help_listing_cursor
	push	ax
	mov	ax,0ffffh
	push	ax
	call	help_step_index
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	push	ax
	mov	ax,word ptr help_listing_cursor
	dec	ax
	mul	cx
	pop	bx
	mov	cl,byte ptr 2213h[bx]
	mov	bx,ax	; 14EEh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	cl,byte ptr 2213h[bx]
	jz	scan_previous_index_entry
	mov	ax,offset help_listing_cursor
	push	ax
	mov	ax,0ffffh
	push	ax
	call	help_step_index
	mov	ax,word ptr help_listing_cursor
	sub	word ptr help_listing_stride,ax
test_subtopic_heading_needed:
	cmp	byte ptr help_listing_level,2h
	ja	print_subtopics_heading
	mov	al,byte ptr help_listing_top_level
	not	al
	rcr	al,1
	jnc	begin_index_display_page
print_subtopics_heading:
	mov	ax,offset help_subtopics_heading
	push	ax
	call	help_print_string
begin_index_display_page:
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	mov	ax,offset help_heading_newline
	push	ax
	call	help_print_string
test_topic_column_boundary:
	mov	ax,word ptr help_displayed_topics
	mov	cx,6h
	xor	dx,dx	; 1536h: original 31D2, ASM86 33D2 (same instruction/length)
	div	cx
	cmp	dx,0h
	jnz	prepare_topic_output_buffer
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	mov	al,0dh
	push	ax
	call	help_write_console
prepare_topic_output_buffer:
	mov	byte ptr help_listing_character,0h
clear_topic_output_byte:
	cmp	byte ptr help_listing_character,0dh
	ja	terminate_topic_output_buffer
	mov	bl,byte ptr help_listing_character
	mov	bh,0h
	mov	byte ptr help_listing_text[bx],20h
	inc	byte ptr help_listing_character
	jnz	clear_topic_output_byte
terminate_topic_output_buffer:
	mov	byte ptr help_listing_terminator,24h
	mov	al,0ch
	push	ax
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 157Ch: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	mov	ax,offset help_listing_text
	push	ax
	call	help_move
	mov	ax,offset help_listing_text
	push	ax
	call	help_print_string
	inc	word ptr help_displayed_topics
	jmps	advance_display_index
load_next_index_level:
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 159Fh: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	al,byte ptr 2213h[bx]
	cmp	al,byte ptr help_listing_level
	jnc	advance_display_index
	mov	byte ptr help_listing_top_level,0ffh
advance_display_index:
	mov	ax,offset help_listing_cursor
	push	ax
	push	word ptr help_listing_stride
	call	help_step_index
	mov	word ptr help_listing_stride,1h
	jmp	test_top_level_listing
finish_topic_listing:
	mov	al,byte ptr help_listing_heading_shown
	rcr	al,1
	jnc	restore_index_display_dma
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	mov	ax,304h
	push	ax
	call	help_print_string
restore_index_display_dma:
	mov	ax,offset help_input_buffer
	push	ax
	call	help_set_dma
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Search the index for the requested topic path; return FFh when not found
; and retain its text position for display.
; -----------------------------------------------------------------------------
help_search:
	push	bp
	mov	bp,sp
	mov	al,0h
	mov	byte ptr help_search_matched,al
	mov	byte ptr help_search_done,al
	mov	byte ptr help_search_failed,al
	mov	byte ptr help_search_passed_name,al
	mov	ah,0h
	mov	word ptr help_search_cursor,ax
	call	help_reset_index
	mov	byte ptr help_search_restart,0ffh
	cmp	byte ptr help_search_level,1h
	jnz	test_parent_search_restart
	mov	byte ptr help_last_token,0ah
find_last_topic_token:
	mov	al,byte ptr help_last_token
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1616h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],20h
	jnz	prepare_parent_topic_search
	dec	byte ptr help_last_token
	jmps	find_last_topic_token
prepare_parent_topic_search:
	mov	al,byte ptr help_last_token
	sub	al,2h
	mov	byte ptr help_parent_level,al
	mov	al,byte ptr help_last_token
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1634h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	mov	al,byte ptr help_parent_level
	mul	cl
	mov	bx,ax	; 1640h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_compare
	mov	byte ptr help_search_restart,al
	mov	al,byte ptr help_parent_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1654h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	al,byte ptr 2665h[bx]
	mov	byte ptr help_parent_token_saved,al
test_parent_search_restart:
	cmp	byte ptr help_search_restart,0h
	jz	select_parent_topic_level
	cmp	byte ptr help_search_level,0h
	jz	select_parent_topic_level
	jmp	topic_search_failed
select_parent_topic_level:
	cmp	byte ptr help_search_level,1h
	jnz	test_search_completion
	mov	al,byte ptr help_parent_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 167Ch: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	byte ptr 2665h[bx],20h
test_search_completion:
	mov	al,byte ptr help_search_done
	not	al
	mov	cl,byte ptr help_search_failed
	not	cl
	and	al,cl
	rcr	al,1
	jc	load_search_index_entry
	jmp	load_matched_topic_position
load_search_index_entry:
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 169Fh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_index_cache[bx],24h
	jnz	test_search_child_level
	jmp	mark_search_not_found
test_search_child_level:
	mov	al,byte ptr help_level
	inc	al
	cmp	byte ptr 2213h[bx],al
	jz	compute_search_token_offset
	jmp	test_search_order_result
compute_search_token_offset:
	mov	al,byte ptr help_level
	mov	dl,0fh
	mul	dl
	mov	si,ax	; 16C0h: original 89C6, ASM86 8BF0 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[si]
	push	ax
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	call	help_compare
	mov	byte ptr help_search_restart,al
	cmp	byte ptr help_search_restart,0h
	jz	compare_search_topic
	jmp	advance_search_index
compare_search_topic:
	mov	al,0ch
	push	ax
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 16E7h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	mov	al,byte ptr help_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 16F5h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_move
	mov	al,byte ptr help_level
	inc	al
	mov	byte ptr help_level,al
	mov	al,byte ptr help_search_passed_name
	not	al
	rcr	al,1
	jnc	test_search_depth_limit
	mov	al,byte ptr help_level
	mov	byte ptr help_compare_byte,al
	mov	byte ptr help_search_passed_name,0ffh
test_search_depth_limit:
	mov	al,byte ptr help_level
	cmp	al,8h
	ja	mark_search_match
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1726h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],20h
	jz	mark_search_match
	cmp	byte ptr help_topic_tokens[bx],5bh
	jnz	skip_search_subtree
mark_search_match:
	mov	byte ptr help_search_matched,0ffh
	mov	byte ptr help_search_done,0ffh
	jmps	repeat_topic_search
skip_search_subtree:
	mov	ax,offset help_search_cursor
	push	ax
	mov	ax,1h
	push	ax
	call	help_step_index
	mov	byte ptr help_search_matched,0h
	jmps	repeat_topic_search
test_search_order_result:
	mov	al,byte ptr help_search_passed_name
	rcr	al,1
	jnc	advance_search_index
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1763h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	cl,byte ptr help_compare_byte
	cmp	cl,byte ptr 2213h[bx]
	jc	advance_search_index
mark_search_not_found:
	mov	byte ptr help_search_failed,0ffh
	jmps	repeat_topic_search
advance_search_index:
	mov	ax,offset help_search_cursor
	push	ax
	mov	ax,1h
	push	ax
	call	help_step_index
repeat_topic_search:
	jmp	test_search_completion
load_matched_topic_position:
	mov	al,byte ptr help_search_matched
	rcr	al,1
	jnc	restore_parent_topic_token
	mov	ax,word ptr help_search_cursor
	inc	ax
	mov	word ptr help_saved_index,ax
	mov	al,1h
	push	ax
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 179Dh: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr 2210h[bx]
	push	ax
	mov	ax,offset help_random_record
	push	ax
	call	help_move
	mov	al,1h
	push	ax
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 17B6h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr 2210h[bx]
	inc	ax
	push	ax
	mov	ax,offset help_random_record_middle
	push	ax
	call	help_move
	mov	byte ptr help_random_record_high,0h
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 17D2h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	cl,byte ptr 2212h[bx]
	mov	byte ptr help_file_status,cl
	mov	al,byte ptr 2213h[bx]
	mov	byte ptr help_level,al
restore_parent_topic_token:
	cmp	byte ptr help_search_level,1h
	jnz	return_topic_search_result
	mov	al,byte ptr help_parent_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 17F1h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	cl,byte ptr help_parent_token_saved
	mov	byte ptr 2665h[bx],cl
	jmps	return_topic_search_result
topic_search_failed:
	mov	byte ptr help_search_failed,0ffh
return_topic_search_result:
	mov	al,byte ptr help_search_failed
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Print the requested topic path, separating its tokens for diagnostics.
; -----------------------------------------------------------------------------
help_display_tokens:
	push	bp
	mov	bp,sp
	mov	byte ptr help_token_display_index,0h
test_display_token_limit:
	mov	al,byte ptr help_token_display_index
	cmp	al,byte ptr 4h[bp]
	mov	al,0ffh
	jc	test_token_display_abort
	inc	ax
test_token_display_abort:
	mov	cl,byte ptr help_end_of_data
	not	cl
	and	al,cl
	rcr	al,1
	jnc	token_display_complete
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	test_display_token_limit
	mov	byte ptr help_token_indent,0h
indent_topic_token:
	mov	al,byte ptr help_token_indent
	cmp	al,byte ptr help_token_display_index
	ja	print_topic_token
	mov	ax,offset help_indent_string
	push	ax
	call	help_print_string
	inc	byte ptr help_token_indent
	jnz	indent_topic_token
print_topic_token:
	mov	al,byte ptr help_token_display_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 185Bh: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_print_string
	inc	byte ptr help_token_display_index
	jmps	test_display_token_limit
token_display_complete:
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Read and display the selected HELP.HLP topic text, tracking lines and
; record boundaries until the topic ends or the user stops the display.
; -----------------------------------------------------------------------------
help_print_topic:
	push	bp
	mov	bp,sp
	mov	al,0dh
	push	ax
	call	help_write_console
	push	word ptr help_level
	call	help_display_tokens
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	read_first_topic_record
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
read_first_topic_record:
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	topic_read_failed
	mov	ax,offset help_fcb
	push	ax
	call	help_read_random
	cmp	al,0h
	jz	initialize_topic_text_scan
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	byte ptr help_file_status,al
	mov	al,0ffh
	push	ax
	mov	ax,offset help_topic_read_error
	push	ax
	call	help_error
topic_read_failed:
	mov	byte ptr help_end_of_data,0h
	pop	bp
	ret
initialize_topic_text_scan:
	mov	byte ptr help_topic_finished,0h
test_topic_text_end:
	mov	cl,byte ptr help_topic_finished
	not	cl
	mov	al,byte ptr help_end_of_data
	not	al
	and	al,cl
	push	ax
	mov	cx,offset help_fcb
	push	cx
	call	help_read_record
	cmp	al,0h
	mov	al,0ffh
	jz	test_topic_record_limit
	inc	ax
test_topic_record_limit:
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	topic_read_failed
	mov	al,byte ptr help_file_status
	dec	al
	mov	byte ptr help_text_index,al
advance_topic_text_byte:
	mov	al,byte ptr help_text_index
	inc	al
	mov	byte ptr help_text_index,al
	cmp	al,7fh
	mov	al,0ffh
	jna	test_topic_delimiter_state
	inc	ax
test_topic_delimiter_state:
	mov	cl,byte ptr help_topic_finished
	not	cl
	and	al,cl
	rcr	al,1
	jc	load_topic_text_character
	jmp	begin_next_topic_record
load_topic_text_character:
	mov	bl,byte ptr help_text_index
	mov	bh,0h
	mov	al,byte ptr help_input_buffer[bx]
	mov	byte ptr help_text_character,al
	cmp	al,1ah
	jnz	begin_topic_delimiter_scan
	mov	byte ptr help_end_of_data,0ffh
begin_topic_delimiter_scan:
	mov	byte ptr help_delimiter_count,0h
test_delimiter_scan_end:
	mov	al,byte ptr help_topic_finished
	not	al
	mov	cl,byte ptr help_end_of_data
	not	cl
	and	al,cl
	push	ax
	cmp	byte ptr help_delimiter_count,3h
	mov	al,0ffh
	jc	test_delimiter_character
	inc	ax
test_delimiter_character:
	mov	bl,byte ptr help_text_index
	mov	bh,0h
	push	ax
	cmp	byte ptr help_input_buffer[bx],2fh
	mov	al,0ffh
	jz	combine_delimiter_tests
	inc	ax
combine_delimiter_tests:
	pop	cx
	and	al,cl
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	test_complete_topic_delimiter
	inc	byte ptr help_delimiter_count
	push	bx
	call	help_next_byte
	mov	byte ptr help_text_index,al
	mov	bl,byte ptr help_delimiter_count
	dec	bl
	mov	bh,0h
	push	bx
	mov	bl,byte ptr help_text_index
	mov	bh,0h
	mov	al,byte ptr help_input_buffer[bx]
	pop	bx
	mov	byte ptr help_delimiter_buffer[bx],al
	jmps	test_delimiter_scan_end
test_complete_topic_delimiter:
	cmp	byte ptr help_delimiter_count,3h
	jnz	terminate_delimiter_buffer
	mov	byte ptr help_topic_finished,0ffh
	jmps	test_topic_output_enabled
terminate_delimiter_buffer:
	mov	bl,byte ptr help_delimiter_count
	mov	bh,0h
	mov	byte ptr help_delimiter_buffer[bx],24h
test_topic_output_enabled:
	mov	al,byte ptr help_end_of_data
	not	al
	mov	cl,byte ptr help_topic_finished
	not	cl
	and	al,cl
	rcr	al,1
	jnc	continue_topic_text_scan
	cmp	byte ptr help_text_character,0ah
	jnz	output_pending_topic_character
	mov	al,byte ptr help_no_page_mode
	not	al
	rcr	al,1
	jnc	output_pending_topic_character
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	jmps	output_partial_delimiter
output_pending_topic_character:
	push	word ptr help_text_character
	call	help_write_console
output_partial_delimiter:
	cmp	byte ptr help_delimiter_count,0h
	jna	reset_delimiter_count
	mov	ax,offset help_delimiter_buffer
	push	ax
	call	help_print_string
reset_delimiter_count:
	mov	byte ptr help_delimiter_count,0h
continue_topic_text_scan:
	jmp	advance_topic_text_byte
begin_next_topic_record:
	mov	byte ptr help_file_status,0h
	jmp	test_topic_text_end

; -----------------------------------------------------------------------------
; Print the topic prompt, read a line, then pass it to the topic parser.
; -----------------------------------------------------------------------------
help_prompt:
	push	bp
	mov	bp,sp
	mov	al,1h
	push	ax
	mov	ax,offset help_input_limit
	push	ax
	mov	ax,offset help_input_buffer
	dec	ax
	push	ax
	call	help_move
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_prompt_tokens,al
	mov	ax,offset help_topic_prompt
	push	ax
	call	help_print_string
	mov	ax,offset help_input_buffer
	dec	ax
	push	ax
	call	help_read_line
	mov	bl,byte ptr help_input_buffer
	mov	bh,0h
	mov	byte ptr help_input_text[bx],0h
	mov	byte ptr help_line_count,0ffh
	call	help_parse
	mov	byte ptr help_prompt_tokens,al
	cmp	byte ptr help_prompt_tokens,0h
	jz	return_prompt_token_count
	mov	al,byte ptr help_list_mode
	not	al
	rcr	al,1
	jnc	return_prompt_token_count
	mov	ax,offset help_clear_screen
	push	ax
	call	help_print_string
return_prompt_token_count:
	mov	al,byte ptr help_prompt_tokens
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Local BDOS-10-style editor: CR/LF accept, Escape/Ctrl-C cancel, backspace
; and DEL erase, Ctrl-E starts a new line, Ctrl-X/Ctrl-U clear, Ctrl-R retypes.
; Preserve the caller's ES and handle control-character/tab display widths.
; -----------------------------------------------------------------------------
help_line_editor:
	mov	word ptr help_editor_es,es
	mov	word ptr help_editor_buffer,dx
	mov	word ptr help_editor_sp,sp
initialize_line_edit:
	push	dx
	push	es
	mov	cl,9ah
	call	help_editor_bdos
	mov	ax,es
	mov	si,es:word ptr .68h
	mov	bl,es:byte ptr 20h[si]
	mov	byte ptr help_printer_number,bl
	pop	es
	pop	dx
	mov	al,byte ptr help_output_column
	mov	byte ptr help_prompt_column,al
	mov	bx,dx
	mov	cl,es:byte ptr [bx]
	inc	bx
	push	bx
	mov	ch,0h
preserve_line_edit_state:
	push	cx
	push	bx
read_line_edit_key:
	call	help_get_key
	pop	bx
	pop	cx
	cmp	al,0dh
	jnz	test_linefeed_or_backspace
accept_line_jump:
	jmp	accept_input_line
test_linefeed_or_backspace:
	cmp	al,0ah
	jz	accept_line_jump
	cmp	al,8h
	jnz	test_escape_key
	or	ch,ch
	jz	preserve_line_edit_state
	dec	ch
	mov	al,byte ptr help_output_column
	mov	byte ptr help_retype_width,al
	jmp	retype_input_line
test_escape_key:
	cmp	al,1bh
	jnz	test_delete_key
	jmp	cancel_input_line
test_delete_key:
	cmp	al,7fh
	jnz	test_new_line_key
	or	ch,ch
	jz	preserve_line_edit_state
	mov	al,es:byte ptr [bx]
	dec	ch
	dec	bx
	jmp	echo_input_character
test_new_line_key:
	cmp	al,5h
	jnz	test_clear_to_prompt_key
	push	cx
	push	bx
	call	help_crlf
	mov	byte ptr help_prompt_column,0h
continue_line_edit:
	jmps	read_line_edit_key
test_clear_to_prompt_key:
	cmp	al,18h
	jnz	test_kill_line_key
	pop	bx
erase_back_to_prompt:
	mov	al,byte ptr help_prompt_column
	cmp	al,byte ptr help_output_column
	jnc	restart_line_edit
	dec	byte ptr help_output_column
	call	help_erase_cell
	jmps	erase_back_to_prompt
test_kill_line_key:
	cmp	al,15h
	jnz	test_retype_line_key
	call	help_retype_prefix
	pop	bx
restart_line_edit:
	mov	sp,word ptr help_editor_sp
	mov	dx,word ptr help_editor_buffer
	jmp	initialize_line_edit
test_retype_line_key:
	cmp	al,12h
	jnz	test_abort_line_key
retype_input_line:
	push	cx
	call	help_retype_prefix
	pop	cx
	pop	bx
	push	bx
	push	cx
retype_next_character:
	or	ch,ch
	jz	finish_line_retype
	inc	bx
	mov	cl,es:byte ptr [bx]
	dec	ch
	push	cx
	push	bx
	call	help_echo_char
	pop	bx
	pop	cx
	jmp	retype_next_character
finish_line_retype:
	push	bx
	mov	al,byte ptr help_retype_width
	or	al,al
	jz	resume_after_retype
	sub	al,byte ptr help_output_column
	mov	byte ptr help_retype_width,al
erase_deleted_character_cells:
	call	help_erase_cell
	dec	byte ptr help_retype_width
	jnz	erase_deleted_character_cells
resume_after_retype:
	jmp	continue_line_edit
test_abort_line_key:
	cmp	al,3h
	jnz	test_input_buffer_capacity
	mov	ax,ds
	mov	es,ax
	jmp	cancel_input_line
test_input_buffer_capacity:
	cmp	ch,cl
	jnc	read_next_line_character
	inc	bx
	mov	es:byte ptr [bx],al
	inc	ch
echo_input_character:
	push	cx
	push	bx
	mov	cl,al
	call	help_echo_char
	pop	bx
	pop	cx
read_next_line_character:
	jmp	preserve_line_edit_state
accept_input_line:
	inc	bx
	mov	es:byte ptr [bx],0dh
	pop	bx
	mov	es:byte ptr [bx],ch
	mov	es,word ptr help_editor_es
	mov	cl,0dh
	jmp	help_output_char
cancel_input_line:
	mov	es,word ptr help_editor_es
	mov	bx,word ptr help_editor_buffer
	mov	byte ptr 1h[bx],0h
	mov	sp,word ptr help_editor_sp
	ret

; -----------------------------------------------------------------------------
; Check the saved key first, otherwise poll direct console status.
; -----------------------------------------------------------------------------
help_key_pending:
	mov	ax,word ptr help_pending_key
	or	ax,ax
	jnz	return_key_status
	push	cx
	mov	dl,0feh
	mov	cl,6h
	call	help_editor_bdos
	pop	cx
	or	al,al
return_key_status:
	ret

; -----------------------------------------------------------------------------
; Write CL through BDOS 6, preserving CX.
; -----------------------------------------------------------------------------
help_raw_output:
	push	cx
	mov	dl,cl
	mov	cl,6h
	call	help_editor_bdos
	pop	cx
	ret

; -----------------------------------------------------------------------------
; Consume a saved key or wait for input, preserving extended-key state.
; -----------------------------------------------------------------------------
help_get_key:
	mov	ax,word ptr help_pending_key
	or	ax,ax
	jz	read_fresh_help_key
	cmp	byte ptr help_extended_key,0ffh
	jz	return_saved_scan_code
	or	al,al
	jnz	clear_saved_key
	mov	byte ptr help_extended_key,0ffh
	ret
return_saved_scan_code:
	mov	al,ah
clear_saved_key:
	mov	byte ptr help_extended_key,0h
	mov	word ptr help_pending_key,0h
	ret
read_fresh_help_key:
	call	help_wait_key
	or	al,al
	jnz	return_help_key
	mov	byte ptr help_extended_key,0ffh
	mov	word ptr help_pending_key,ax
return_help_key:
	ret

; -----------------------------------------------------------------------------
; Recognize CR, LF, TAB and BS; otherwise compare AL with space.
; -----------------------------------------------------------------------------
help_classify_char:
	cmp	al,0dh
	jz	return_character_class
	cmp	al,0ah
	jz	return_character_class
	cmp	al,9h
	jz	return_character_class
	cmp	al,8h
	jz	return_character_class
	cmp	al,20h
return_character_class:
	ret

; -----------------------------------------------------------------------------
; Poll for Ctrl-C abort and Ctrl-S pause; Ctrl-Q resumes output.
; Save other pending input for the line editor.
; -----------------------------------------------------------------------------
help_flow_control:
	call	help_key_pending
	jz	flow_control_complete
	call	help_get_key
	cmp	al,3h
	jnz	test_output_pause
	mov	word ptr help_pending_key,0h
	jmp	cancel_input_line
test_output_pause:
	cmp	al,13h
	jnz	save_pending_input_key
wait_output_resume:
	call	help_get_key
	cmp	al,3h
	jnz	test_output_resume_key
	mov	word ptr help_pending_key,0h
	jmp	cancel_input_line
test_output_resume_key:
	cmp	al,11h
	jnz	wait_output_resume
	xor	ax,ax
	mov	word ptr help_pending_key,0h
flow_control_complete:
	ret
save_pending_input_key:
	mov	word ptr help_pending_key,ax
	mov	al,0ffh
	ret

; -----------------------------------------------------------------------------
; Output CL unless retyping silently, then update the tracked column.
; -----------------------------------------------------------------------------
help_output_char:
	test	byte ptr help_retype_width,0ffh
	jnz	update_output_column
	call	help_flow_control
	call	help_raw_output
update_output_column:
	mov	al,cl
	cmp	al,7fh
	jz	output_character_complete
	inc	byte ptr help_output_column
	cmp	al,20h
	jnc	output_character_complete
	dec	byte ptr help_output_column
	jz	output_character_complete
	cmp	al,8h
	jnz	test_output_linefeed
	dec	byte ptr help_output_column
output_character_complete:
	ret
test_output_linefeed:
	cmp	al,0ah
	jnz	output_column_complete
	mov	byte ptr help_output_column,0h
output_column_complete:
	ret

; -----------------------------------------------------------------------------
; Echo controls as caret notation and expand tabs to eight-column stops.
; -----------------------------------------------------------------------------
help_echo_char:
	mov	al,cl
	call	help_classify_char
	jnc	test_tab_expansion
	push	ax
	mov	cl,5eh
	call	help_output_char
	pop	cx
	or	cl,40h
; Shared entry: CL contains a display character. Expand TAB, otherwise output it.
test_tab_expansion:
	cmp	cl,9h
	jnz	help_output_char
output_tab_space:
	mov	cl,20h
	call	help_output_char
	mov	al,byte ptr help_output_column
	and	al,7h
	jnz	output_tab_space
expanded_character_complete:
	ret

; -----------------------------------------------------------------------------
; Erase one display cell with backspace and space.
; -----------------------------------------------------------------------------
help_erase_cell:
	call	help_backspace
	mov	cl,20h
	call	help_raw_output

; -----------------------------------------------------------------------------
; Emit backspace through direct console output.
; -----------------------------------------------------------------------------
help_backspace:
	mov	cl,8h
	jmp	help_raw_output

; -----------------------------------------------------------------------------
; Print the retype marker and CR/LF, then indent to the original prompt column.
; -----------------------------------------------------------------------------
help_retype_prefix:
	mov	cl,23h
	call	help_output_char
	call	help_crlf
restore_prompt_indentation:
	mov	al,byte ptr help_output_column
	cmp	al,byte ptr help_prompt_column
	jnc	expanded_character_complete
	mov	cl,20h
	call	help_output_char
	jmps	restore_prompt_indentation

; -----------------------------------------------------------------------------
; Print CR/LF through the tracked console-output routine.
; -----------------------------------------------------------------------------
help_crlf:
	mov	cl,0dh
	call	help_output_char
	mov	cl,0ah
	jmp	help_output_char

; -----------------------------------------------------------------------------
; Wait for a key through BDOS 6, DL=FDh, preserving CX.
; -----------------------------------------------------------------------------
help_wait_key:
	push	cx
	mov	cl,6h
	mov	dl,0fdh
	call	help_editor_bdos
	pop	cx
	ret

; -----------------------------------------------------------------------------
; Print a dollar-terminated string from the stack segment, expanding tabs.
; -----------------------------------------------------------------------------
help_print_stack_string:
	mov	si,cx
	lodsb
	cmp	al,24h
	jz	expanded_character_complete
	inc	cx
	push	cx
	mov	cl,al
	push	ds
	push	ss
	pop	ds
	call	test_tab_expansion
	pop	ds
	pop	cx
	jmps	help_print_stack_string

; -----------------------------------------------------------------------------
; BDOS entry used by the local line editor.
; -----------------------------------------------------------------------------
help_editor_bdos:
	int	0e0h
	ret
code_padding	db	0h,0h,0h

; -----------------------------------------------------------------------------
; DATA record formats (all offsets are relative to DS):
;   display string: length word, then exactly that many text bytes;
;   positioned text: row, column, active/restored attributes, string pointer;
;   key record: row, column, three legend characters, line-count word,
;               description row/column, description-string pointer;
;   menu: four pointers to plain, positioned, key-box and accepted-key lists;
;   token: length word, four padded characters, handler word, argument byte.
; Pointer lists and dispatch tables below use the corresponding symbolic names.
; -----------------------------------------------------------------------------
	dseg
	org	0

; Loader base-page bytes preceding the supplied stack segment.
base_page	rb	15h	; zero-filled workspace

; STACK segment supplied by the CMD loader.
base_stack_segment	dw	0h

; Remaining loader base-page fields, initially zero.
base_page_reserved	rb	69h	; zero-filled workspace

; Length of the command tail at 81h.
command_tail	db	0h

; CP/M command tail, supplied by the command processor.
command_tail_text	rb	7fh	; zero-filled workspace

; HELP switches SS to DATA and uses SP=180h for its private stack.
help_stack_space	rb	80h	; zero-filled workspace
help_stack_guard	db	0h
help_system_disk	db	0h

; Standard FCB through the current sequential-record byte.
help_fcb	rb	21h	; zero-filled workspace
help_random_record	db	0h
help_random_record_middle	db	0h
help_random_record_high	db	0h

; Input length byte; also the normal DMA buffer.
help_input_buffer	db	0h
help_input_text	rb	7fh	; zero-filled workspace
help_system_segment	dw	0h
help_output_column	db	21h
help_saved_ax	dw	0h
help_saved_bx	dw	0h
help_saved_cx	dw	0h
help_saved_dx	dw	0h
help_caller_sp	dw	0h
help_caller_ss	dw	0h
help_context_padding	db	0h
help_error_prefix	db	0dh,0ah
	db	'ERROR:  $'
help_newline	db	0dh,0ah,24h
help_read_error	db	'Reading file HELP.HLP.$'
help_continue_prompt	db	0dh,0ah
	db	'Press RETURN to continue $'
help_erase_prompt	db	0dh
	db	'                             '
	db	0dh,24h
help_blank_topic	db	'             '
	db	0dh,24h
help_topics_heading	db	0dh
	db	'Topics available:$'
help_subtopics_heading	db	0dh
	db	'For more information, type a period and one of the following '
	db	'subtopics:$'

; Retained workspace/alignment between records.
help_heading_newline	db	0dh,24h,0dh
help_short_newline	db	0ah,24h
help_indent_string	db	20h,20h,24h
help_topic_read_error	db	'Reading file HELP.HLP.$'

; Maximum input size used by the local line editor.
help_input_limit	db	80h
help_topic_prompt	db	0dh
	db	'HELP (Enter topic, ESC to exit)> $'

; FCB prefix: drive, eight-character HELP name (attribute bit retained), HLP, extent.
help_filename	db	0h
	db	'HELP '
	db	0a0h
	db	'  HLP'
	db	0h
help_intro	db	0dh,0ah
	db	'HELP UTILITY V2.0'
	db	0dh,0ah,0ah
	db	'At "HELP (Enter topic, ESC to exit)> " enter topic {,subtopic}...'
	db	0dh,0ah,0ah
	db	'EXAMPLE:  HELP (Enter topic, ESC to exit)> DIR EXAMPLES'
	db	0dh,0ah,24h

; Space-padded topic comparison token.
help_question_token	db	'?           '

; Space-padded topic comparison token.
help_command_token	db	'HELP        '

; Space-padded topic comparison token.
help_intro_token	db	'HELP        '
help_topic_heading	db	'Topic:$'
help_not_found	db	'Not found$'
help_file_missing	db	'No HELP.HLP file on the default drive.$'
terminal_error	db	0ah,0dh
	db	'This program cannot be run from a menu from the Serial Terminal.$'

