;*****************************************************************************
; SETPORT - Concurrent DOS 4.1 serial configuration (26 Aug 84).
;
; Reconstructed from ../../base/setport.cmd. setporg.a86 is the frozen source.
; Build: make. Verify: make check (39 documented equivalent ASM86 encodings).
; Usage: SETPORT                         interactive function-key menus
;        SETPORT HELP                    command-line usage
;        SETPORT P3 1200 7 ODD 2 INRX ODNX
; P3/P4 select printer 3/4, serial port 0/1. Baud: 110 150 300 600 1200
; 2400 4800 9600; word length: 5..8; parity: NONE ODD EVEN; stop bits: 1/2.
; Protocol: I(input)/O(output), D/N for DTR/DSR, R/N for RTS/CTS, X/N for
; XON/XOFF. Tokens are space separated. Unspecified settings retain defaults.
; Interactive mode requires a local console; command tails allow terminals.
; F1 provides context help through HELP.HLP; Escape returns/applies settings.
;
; CODE=1CC0h, DATA=2780h, STACK=0130h. Every loaded instruction is mnemonic
; assembly. DB/DW contain only strings, tables, workspace and padding.
; ASM86 chooses 39 equivalent same-length encodings inside embedded HELP.
; check.py validates each exception and every other byte, including headers.
; header.py compacts the empty EXTRA descriptor and restores loader metadata
; and the unloaded final record. It never patches instruction or data bytes.
;*****************************************************************************

	cseg
	org	0

; -----------------------------------------------------------------------------
; Skip the copyright and enter SETPORT. All branch offsets are preserved.
; -----------------------------------------------------------------------------
entry:
	jmp	initialize
copyright	db	'Copyright (C) 1983, Digital Research, Inc.Serial No. 1031-0000       '

; -----------------------------------------------------------------------------
; Install the private stack, retain DS for string output, validate DOS 4.1,
; locate the XIOS and probe both serial ports. A nonempty tail selects parsing.
; -----------------------------------------------------------------------------
initialize:
	cli
	mov	ss,word ptr base_stack_segment
	mov	sp,124h
	sti
	mov	ax,ds
	mov	es,ax
	mov	word ptr output_segment,ax
	call	check_version
	call	locate_system
	call	detect_ports
	or	al,al
	jz	loc_00be
	cmp	byte ptr command_tail,0h
	jz	interactive_main
	jmp	parse_command_tail

; -----------------------------------------------------------------------------
; Build the main menu after rejecting a serial terminal for interactive use.
; -----------------------------------------------------------------------------
interactive_main:
	call	check_console
	call	initialize_screen
	call	draw_frame
	mov	bx,0h
	mov	dx,offset main_help_topic
	call	select_help_footer
	mov	bx,0h
	call	select_menu_footer
	call	build_main_choices
	mov	si,offset main_menu
	call	draw_menu_and_read
	jmps	loc_009e
loc_0092:
	mov	bx,0h
	call	select_menu_footer
	mov	si,offset main_menu
	call	read_menu_choice
loc_009e:
	xor	bh,bh
	shl	bl,1
	call	word ptr main_dispatch[bx]
	jmps	loc_0092

; -----------------------------------------------------------------------------
; Main-menu exit callback: restore the display and terminate.
; -----------------------------------------------------------------------------
menu_exit:
	jmps	loc_00aa
loc_00aa:
	call	clear_screen

; -----------------------------------------------------------------------------
; BDOS 0 terminates this process with DX zero.
; -----------------------------------------------------------------------------
terminate:
	xor	cx,cx
	xor	dx,dx
	jmp	bdos
	push	si
	call	clear_screen
	pop	si
loc_00b9:
	call	print_length_string
	jmps	terminate
loc_00be:
	mov	si,offset no_ports_error
	jmps	loc_00b9

; -----------------------------------------------------------------------------
; Add a protocol entry for each installed UART, followed by Escape.
; Update both the display pointers and the indirect function-key dispatch table.
; -----------------------------------------------------------------------------
build_main_choices:
	mov	bx,557h
	mov	dx,offset main_port_0_record
	mov	al,0bfh
	mov	di,4eeh
	mov	si,offset main_protocol_keys
	cmp	byte ptr port_0_present,0h
	jz	loc_00ef
	mov	word ptr [bx],4e6h
	mov	word ptr [di],dx
	inc	word ptr main_text_count
	inc	byte ptr main_key_count
	mov	byte ptr [si],al
	add	di,2h
	inc	si
	add	bx,2h
loc_00ef:
	cmp	byte ptr port_1_present,0h
	jz	loc_010f
	add	al,2h
	mov	dx,offset main_port_1_record
	mov	word ptr [bx],4d4h
	mov	word ptr [di],dx
	inc	word ptr main_text_count
	inc	byte ptr main_key_count
	mov	byte ptr [si],al
	add	bx,2h
	inc	si
loc_010f:
	mov	word ptr [bx],0a8h
	inc	byte ptr main_key_count
	mov	byte ptr [si],1bh
	ret

; -----------------------------------------------------------------------------
; BDOS 12 must identify a concurrent system; BDOS 163 must return 1441h.
; Print the version error and exit when either test fails.
; -----------------------------------------------------------------------------
check_version:
	mov	cx,0ch
	int	0e0h
	and	ah,0fh
	cmp	ah,4h
	jz	loc_012d
	cmp	ah,6h
	jnz	loc_0138
loc_012d:
	mov	cx,0a3h
	int	0e0h
	cmp	ax,1441h
	jnz	loc_0138
	ret
loc_0138:
	mov	dx,offset version_error
	mov	cx,9h
	int	0e0h
	xor	cx,cx
	xor	dx,dx
	int	0e0h

; -----------------------------------------------------------------------------
; BDOS 153 returns the console number. Consoles above 3 are serial terminals
; and cannot run the interactive menu; command-line use remains available.
; -----------------------------------------------------------------------------
check_console:
	mov	cl,99h
	int	0e0h
	cmp	al,3h
	jg	loc_014f
	ret
loc_014f:
	mov	dx,offset terminal_error
	mov	cl,9h
	int	0e0h
	mov	dx,offset terminal_usage
	mov	cl,9h
	int	0e0h
	xor	cx,cx
	xor	dx,dx
	int	0e0h

; -----------------------------------------------------------------------------
; Read the current UART settings, display the configuration menu, and cycle
; fields on function keys. Escape programs both present ports and returns.
; -----------------------------------------------------------------------------
configure_ports:
	call	read_port_settings
	mov	bx,0h
	mov	dx,offset config_help_topic
	call	select_help_footer
	mov	bx,1h
	call	select_menu_footer
	mov	si,offset config_menu
	mov	bx,word ptr 6h[si]
	mov	bx,word ptr 2h[bx]
	push	bx
	call	read_menu_choice
loc_0182:
	cmp	al,1bh
	jz	loc_0190
	call	advance_setting
	pop	si
	push	si
	call	read_allowed_key
	jmps	loc_0182
loc_0190:
	pop	bx
	call	program_ports
	ret

; -----------------------------------------------------------------------------
; Advance a selected serial setting, wrap at its maximum index, and redraw
; the fixed-width value. BX identifies the field within the menu.
; -----------------------------------------------------------------------------
advance_setting:
	xor	bh,bh
	push	bx
	shl	bx,1
	mov	cx,word ptr setting_token_pointers[bx]
	mov	si,word ptr selected_settings
	mov	al,byte ptr [bx+si]
	inc	al
	cmp	al,byte ptr 1h[bx+si]
	jng	loc_01ad
	xor	al,al
loc_01ad:
	mov	byte ptr [bx+si],al
	xor	ah,ah
	xor	dx,dx
	mov	bl,9h
	mul	bl
	add	ax,cx
	pop	bx
	push	ax
	mov	ax,0bh
	mul	bl
	mov	si,word ptr selected_display
	add	si,ax
	lodsw
	call	position_cursor
	pop	si
	call	print_length_string
	ret

; -----------------------------------------------------------------------------
; Read each installed UART and unpack its baud/format into menu selections.
; -----------------------------------------------------------------------------
read_port_settings:
	cmp	byte ptr port_0_present,0ffh
	jnz	loc_01e8
	mov	dx,3f0h
	call	read_uart
	mov	byte ptr port_0_packed,al
	mov	di,offset port_0_display
	mov	bx,offset port_0_settings
	call	unpack_serial
loc_01e8:
	cmp	byte ptr port_1_present,0ffh
	jnz	loc_0201
	mov	dx,2f0h
	call	read_uart
	mov	byte ptr port_1_packed,al
	mov	di,offset port_1_display
	mov	bx,offset port_1_settings
	call	unpack_serial
loc_0201:
	ret

; -----------------------------------------------------------------------------
; Pack the selected baud and format, then program each installed UART.
; -----------------------------------------------------------------------------
program_ports:
	cmp	byte ptr port_0_present,0ffh
	jnz	loc_0215
	mov	si,offset port_0_settings
	call	pack_serial
	mov	dx,3f0h
	call	program_uart
loc_0215:
	cmp	byte ptr port_1_present,0ffh
	jnz	loc_0228
	mov	si,offset port_1_settings
	call	pack_serial
	mov	dx,2f0h
	call	program_uart
loc_0228:
	ret

; -----------------------------------------------------------------------------
; Pack baud index in bits 7..5, parity in 4..3, stop in 2 and word length
; in 1..0. SI addresses the selected port's index/maximum pairs.
; -----------------------------------------------------------------------------
pack_serial:
	xor	ax,ax
	mov	al,byte ptr 2h[si]
	xchg	ah,al
	mov	al,byte ptr 6h[si]
	mov	cl,2h
	shl	al,cl
	or	ah,al
	mov	al,byte ptr 4h[si]
	mov	cl,3h
	shl	al,cl
	or	ah,al
	mov	al,byte ptr [si]
	mov	cl,5h
	shl	al,cl
	or	al,ah
	ret

; -----------------------------------------------------------------------------
; Construct the configuration menu for the ports actually installed.
; Copy display pointers and install only valid function-key choices.
; -----------------------------------------------------------------------------
build_port_menu:
	push	es
	mov	ax,ds
	mov	es,ax
	mov	di,offset config_field_pointers
	cmp	byte ptr port_0_present,0ffh
	jz	loc_025f
	mov	bx,offset config_keys
	jmps	loc_028e
loc_025f:
	mov	word ptr .716h,726h
	mov	word ptr .718h,748h
	mov	ax,4h
	add	word ptr config_field_count,ax
	mov	si,offset port_0_field_pointers
	mov	cx,ax
	mov	ax,cx
	rep	movsw
	mov	cx,5h
	mov	byte ptr config_key_count,cl
	mov	bx,di
	mov	si,offset item_08b3
	mov	di,offset config_keys
	rep	movsb
	xchg	bx,di
loc_028e:
	cmp	byte ptr port_1_present,0ffh
	jnz	loc_02d0
	mov	word ptr .71ah,737h
	mov	word ptr .71ch,75dh
	mov	ax,4h
	add	word ptr config_field_count,ax
	mov	cx,ax
	mov	si,offset item_0803
	rep	movsw
	xchg	bx,di
	mov	cx,5h
	add	byte ptr config_key_count,cl
	mov	si,offset item_08b8
	rep	movsb
	cmp	byte ptr port_0_present,0ffh
	jz	loc_02d0
	mov	word ptr selected_display,849h
	mov	word ptr selected_settings,0a2ah
loc_02d0:
	pop	es
	ret

; -----------------------------------------------------------------------------
; Probe each UART interrupt-identification register at 3FAh / 2FAh.
; An installed UART has reserved bits 7..3 clear; mark it FFh and count ports.
; -----------------------------------------------------------------------------
detect_ports:
	mov	dx,3f0h
	mov	dl,0fah
	in	al,dx
	test	al,0f8h
	jnz	loc_02e5
	mov	byte ptr port_0_present,0ffh
	inc	byte ptr ports_found
loc_02e5:
	mov	dx,2f0h
	mov	dl,0fah
	in	al,dx
	test	al,0f8h
	jnz	loc_02f8
	mov	byte ptr port_1_present,0ffh
	inc	byte ptr ports_found
loc_02f8:
	mov	al,byte ptr ports_found
	ret

; -----------------------------------------------------------------------------
; Read the line-control register and divisor latch with interrupts masked.
; Match the divisor against the baud table and return the packed setting in AL.
; -----------------------------------------------------------------------------
read_uart:
	mov	dl,0fbh
	in	al,dx
	mov	bl,al
	and	al,1fh
	xchg	ax,bx
	mov	al,80h
	pushf
	cli
	out	dx,al
	mov	dl,0f9h
	in	al,dx
	xchg	al,ah
	mov	dl,0f8h
	in	al,dx
	mov	dl,0fbh
	xchg	ax,cx
	mov	al,bl
	out	dx,al
	popf
	xchg	ax,cx
	push	es
	mov	dx,ds
	mov	es,dx
	mov	di,offset baud_divisors
	mov	cx,8h
	push	cx
	repne	scasw
	pop	dx
	dec	dl
	sub	dl,cl
	xchg	dl,cl
	pop	es
	xchg	al,cl
	mov	cl,5h
	shl	al,cl
	and	al,0e0h
	or	al,bl
	ret

; -----------------------------------------------------------------------------
; Decode AL into baud, word-length, parity and stop selections.
; Populate the selection pairs at BX and the display strings at DI.
; -----------------------------------------------------------------------------
unpack_serial:
	push	es
	mov	dx,ds
	mov	es,dx
	xor	ah,ah
	push	ax
	mov	cl,5h
	shr	al,cl
	call	store_selection
	mov	si,offset baud_tokens
	call	copy_setting_text
	pop	ax
	push	ax
	and	al,3h
	call	store_selection
	mov	si,offset word_length_tokens
	call	copy_setting_text
	pop	ax
	push	ax
	and	al,18h
	mov	cl,3h
	shr	al,cl
	call	store_selection
	mov	si,offset parity_tokens
	call	copy_setting_text
	pop	ax
	and	al,4h
	mov	cl,2h
	shr	al,cl
	call	store_selection
	mov	si,offset stop_tokens
	call	copy_setting_text
	pop	es
	ret

; -----------------------------------------------------------------------------
; Store one setting index and skip its adjacent maximum byte.
; -----------------------------------------------------------------------------
store_selection:
	mov	byte ptr [bx],al
	inc	bx
	inc	bx
	ret

; -----------------------------------------------------------------------------
; Index the nine-byte token records, skip the length word and copy the text.
; -----------------------------------------------------------------------------
copy_setting_text:
	mov	dx,9h
	mul	dl
	add	si,ax
	lodsw
	mov	cx,ax
	inc	di
	inc	di
	rep	movsb
	ret

; -----------------------------------------------------------------------------
; Set DLAB, write both baud-divisor bytes, then install the line-control bits.
; DX selects the UART; AL contains the packed baud/format setting.
; -----------------------------------------------------------------------------
program_uart:
	xor	ah,ah
	push	ax
	mov	dl,0fbh
	mov	al,80h
	out	dx,al
	pop	ax
	push	ax
	and	al,0e0h
	mov	cl,4h
	shr	al,cl
	xchg	ax,bx
	mov	ax,word ptr baud_divisors[bx]
	mov	dl,0f8h
	out	dx,al
	xchg	ah,al
	mov	dl,0f9h
	out	dx,al
	mov	dl,0fbh
	pop	ax
	and	al,1fh
	out	dx,al
	ret

; -----------------------------------------------------------------------------
; Read initial hardware settings, then scan space-separated tail tokens.
; Each nine-byte token record supplies a handler and argument. Unknown tokens
; print the tail, an error marker and usage; recognized settings retain defaults
; for fields not specified. P3/P4 select serial port 0/1.
; -----------------------------------------------------------------------------
parse_command_tail:
	call	read_port_settings
	mov	ax,ds
	mov	es,ax
	mov	al,byte ptr command_tail
	mov	byte ptr tail_remaining,al
	mov	si,81h
loc_03c7:
	cmp	byte ptr tail_remaining,0h
	jz	loc_0434
	mov	al,byte ptr [si]
	cmp	al,20h
	ja	loc_03db
	inc	si
	dec	byte ptr tail_remaining
	jmps	loc_03c7
loc_03db:
	mov	word ptr token_scan,8bdh
	mov	word ptr token_start,si
loc_03e5:
	mov	si,word ptr token_scan
	add	word ptr token_scan,9h
	lodsw
	or	ax,ax
	jnz	loc_03f6
	jmp	invalid_tail
loc_03f6:
	mov	cx,ax
loc_03f8:
	lodsb
	dec	cx
	cmp	al,20h
	jz	loc_03f8
	dec	si
	inc	cx
	mov	di,si
	mov	si,word ptr token_start
	mov	al,byte ptr tail_remaining
	mov	byte ptr token_remaining,al
loc_040c:
	cmp	byte ptr token_remaining,0h
	jz	loc_03e5
	cmpsb
	jnz	loc_03e5
	dec	byte ptr token_remaining
	dec	cx
	jnz	loc_040c
	cmp	byte ptr token_remaining,0h
	jz	loc_0429
	cmp	byte ptr [si],20h
	jnz	loc_03e5
loc_0429:
	mov	al,byte ptr token_remaining
	mov	byte ptr tail_remaining,al
	call	apply_token
	jmps	loc_03c7
loc_0434:
	mov	al,byte ptr port_0_packed
	mov	dx,3f0h
	cmp	byte ptr selected_port,0h
	jz	loc_0447
	mov	al,byte ptr port_1_packed
	mov	dx,2f0h
loc_0447:
	call	program_uart
	jmp	terminate

; -----------------------------------------------------------------------------
; Dispatch a matched token through its handler word. BX points to the packed
; setting of the selected port; DL is the selected port number.
; -----------------------------------------------------------------------------
apply_token:
	push	si
	mov	si,di
	mov	bx,offset port_0_packed
	cmp	byte ptr selected_port,0h
	jz	loc_045d
	mov	bx,offset port_1_packed
loc_045d:
	mov	dl,byte ptr selected_port
	lodsw
	mov	cx,ax
	lodsb
	call	cx
	pop	si
	ret

; -----------------------------------------------------------------------------
; P3/P4 token handler: reject an absent UART and select port 0 or 1.
; -----------------------------------------------------------------------------
select_port:
	mov	si,offset port_0_present
	xor	ah,ah
	add	si,ax
	cmp	byte ptr [si],0h
	jnz	loc_0478
	jmp	loc_00be
loc_0478:
	mov	byte ptr selected_port,al
	ret

; -----------------------------------------------------------------------------
; Replace only the baud bits in the selected port's packed setting.
; -----------------------------------------------------------------------------
set_baud:
	and	byte ptr [bx],1fh
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Replace only the word-length bits in the selected port's packed setting.
; -----------------------------------------------------------------------------
set_word_length:
	and	byte ptr [bx],0fch
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Replace only the parity bits in the selected port's packed setting.
; -----------------------------------------------------------------------------
set_parity:
	and	byte ptr [bx],0e7h
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Replace only the stop-bit selection in the packed setting.
; -----------------------------------------------------------------------------
set_stop_bits:
	and	byte ptr [bx],0fbh
	or	byte ptr [bx],al
	ret

; -----------------------------------------------------------------------------
; Display the original command tail and point to the unrecognized token.
; Print command-line usage, apply the selected settings and terminate.
; -----------------------------------------------------------------------------
invalid_tail:
	mov	si,80h
	xor	ax,ax
	mov	al,byte ptr [si]
	push	ax
	dec	si
	mov	word ptr [si],ax
	call	print_length_string
	mov	si,offset tail_newline
	call	print_length_string
	pop	cx
	sub	cl,byte ptr tail_remaining
	jcxz	loc_04b2
	call	print_spaces
loc_04b2:
	mov	si,offset tail_error_marker
	call	print_length_string
	mov	si,offset invalid_token_message
	call	print_length_string

; -----------------------------------------------------------------------------
; HELP token handler: display the built-in command syntax and return to DOS.
; -----------------------------------------------------------------------------
command_help:
	mov	si,offset tail_usage
	call	print_length_string
	call	program_ports
	jmp	terminate

; -----------------------------------------------------------------------------
; Print CX spaces using the length-prefixed work buffer.
; -----------------------------------------------------------------------------
print_spaces:
	mov	word ptr space_buffer,cx
	mov	si,offset space_buffer
	jmp	print_length_string

; -----------------------------------------------------------------------------
; Select serial port 1 / printer 4 for the protocol screen.
; -----------------------------------------------------------------------------
protocol_port_1:
	mov	byte ptr protocol_printer_digit,34h
	mov	byte ptr protocol_serial_digit,31h
	mov	word ptr protocol_port,1h
	jmps	protocol_menu

; -----------------------------------------------------------------------------
; Select serial port 0 / printer 3 for the protocol screen.
; -----------------------------------------------------------------------------
protocol_port_0:
	mov	byte ptr protocol_printer_digit,33h
	mov	byte ptr protocol_serial_digit,30h
	mov	word ptr protocol_port,0h

; -----------------------------------------------------------------------------
; Read XIOS protocol flags, display the six input/output choices, then
; accept function-key toggles until Escape writes the flags back.
; -----------------------------------------------------------------------------
protocol_menu:
	mov	bx,1h
	call	select_menu_footer
	mov	dx,offset protocol_help_topic
	mov	bx,0h
	call	select_help_footer
	call	read_protocols
	call	format_protocol_flags
	mov	si,offset protocol_menu_data
	mov	bx,word ptr 6h[si]
	mov	bx,word ptr 2h[bx]
	push	bx
	call	read_menu_choice
loc_0518:
	cmp	al,1bh
	jz	loc_0526
	call	toggle_protocol
	pop	si
	push	si
	call	read_allowed_key
	jmps	loc_0518
loc_0526:
	pop	bx
	call	write_protocols
	ret

; -----------------------------------------------------------------------------
; Toggle DTR/DSR, RTS/CTS or XON/XOFF for the selected direction and port.
; The six function keys alternate input/output within each protocol pair.
; -----------------------------------------------------------------------------
toggle_protocol:
	xor	bh,bh
	mov	al,bl
	and	al,1h
	mov	si,offset input_protocols
	jz	loc_0539
	mov	si,offset output_protocols
loc_0539:
	add	si,word ptr protocol_port
	mov	al,byte ptr [si]
	mov	cl,3h
	cmp	bl,4h
	jnl	loc_054f
	dec	cl
	cmp	bl,2h
	jnl	loc_054f
	dec	cl
loc_054f:
	clc
	rcr	al,cl
	cmc
	rcl	al,cl
	mov	byte ptr [si],al
	push	bx
	call	format_protocol_flags
	pop	bx
	call	redraw_protocol_field
	ret

; -----------------------------------------------------------------------------
; Redraw one protocol value from its eleven-byte display record.
; -----------------------------------------------------------------------------
redraw_protocol_field:
	xor	dx,dx
	mov	ax,0bh
	xor	bh,bh
	mul	bx
	mov	si,offset protocol_display
	add	si,ax
	lodsw
	push	si
	call	position_cursor
	pop	si
	mov	si,word ptr [si]
	call	print_length_string
	ret

; -----------------------------------------------------------------------------
; Convert the current input and output masks into six ON/OFF pointers.
; -----------------------------------------------------------------------------
format_protocol_flags:
	mov	si,offset input_protocols
	add	si,word ptr protocol_port
	mov	al,byte ptr [si]
	mov	di,offset protocol_input_value
	call	protocol_on_off
	mov	si,offset output_protocols
	add	si,word ptr protocol_port
	mov	al,byte ptr [si]
	mov	di,offset protocol_output_value
	call	protocol_on_off
	ret

; -----------------------------------------------------------------------------
; For three mask bits, install ON or OFF pointers, skipping alternate fields.
; -----------------------------------------------------------------------------
protocol_on_off:
	mov	cx,3h
loc_059c:
	rcr	al,1
	mov	bx,offset protocol_on
	jc	loc_05a6
	mov	bx,offset protocol_off
loc_05a6:
	mov	word ptr [di],bx
	add	di,16h
	loop	loc_059c
	ret

; -----------------------------------------------------------------------------
; Call XIOS function 14, subfunction 3 to obtain the four protocol pointers;
; copy input0/input1/output0/output1 masks from the system data segment.
; -----------------------------------------------------------------------------
read_protocols:
	mov	cx,3h
	mov	al,0eh
	call	call_xios
	push	es
	push	ds
	mov	ax,ds
	mov	es,ax
	mov	ds,word ptr system_segment
	mov	cx,4h
	mov	di,offset input_protocols
loc_05c6:
	mov	si,word ptr [bx]
	movsb
	inc	bx
	inc	bx
	loop	loc_05c6
	pop	ds
	pop	es
	ret

; -----------------------------------------------------------------------------
; Obtain the XIOS protocol pointers and copy all four selected masks back.
; -----------------------------------------------------------------------------
write_protocols:
	mov	cx,3h
	mov	ax,0eh
	call	call_xios
	push	es
	mov	es,word ptr system_segment
	mov	cx,4h
	mov	si,offset input_protocols
loc_05e4:
	mov	di,es:word ptr [bx]
	movsb
	inc	bx
	inc	bx
	loop	loc_05e4
	pop	es
	ret

; -----------------------------------------------------------------------------
; Call the far XIOS entry at system offset 28h with system DS and XIOS ES.
; Preserve the application's segment registers.
; -----------------------------------------------------------------------------
