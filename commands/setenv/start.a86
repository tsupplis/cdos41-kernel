        title 'SETENV - native entry and PCTMP environment bridge'
;*******************************************************************************
; Native CMD startup and DR C small-model bridge. SS=DS permits near pointers
; to local arrays. There is no DOS runtime, PSP or INT 21h dependency.
;
; Locate the owning PCTmp through the native process-parent chain. Its entry
; at code offset 3 accepts ms_func selector 0Ah: AX/BX=environment segment,
; DX=capacity. Unknown selectors return FFFFh. The query itself does not edit
; memory; ENVWRITE commits the C editor's validated result to that shared block.
;*******************************************************************************
        public BDOS,ENVREAD,ENVWRITE,TAILREAD
        extrn MAIN:near
        dseg
        org 100h
DGROUP group DATA
env_segment dw 0
env_capacity dw 0
ms_entry rd 0
        dw 3,0
owner_name db 'PCTmp'
stack_area rs 1024
stack_top rs 0
        cseg
start:
        mov ax,ds
        mov es,ax
        cli
        mov ss,ax
        mov sp,offset stack_top
        sti
        cld
        call MAIN
        xor cx,cx
        xor dx,dx
        int 0e0h

TAILREAD:
        push bp
        mov bp,sp
        push si
        push di
        push es
        push ds ! pop es
        xor cx,cx
        mov bx,80h
        mov cl,es:[bx]
        cmp cx,127
        jbe tail_ok
        mov cx,127
 tail_ok:
        mov ax,cx
        mov di,4[bp]
        inc bx
        jcxz tail_done
 tail_copy:
        mov dl,es:[bx]
        mov [di],dl
        inc bx
        inc di
        loop tail_copy
 tail_done:
        mov byte ptr [di],0
        pop es
        pop di
        pop si
        pop bp
        ret

; Return capacity, or zero without reading/writing an unsupported environment.
; Keep the parent's process descriptor layout confined to discovery; the
; environment location and size come from PCTMP, never a hardcoded offset.
ENVREAD:
        push bp
        mov bp,sp
        push si
        push di
        push es
        mov env_capacity,0
        mov cl,156
        int 0e0h
        mov dx,64
find_owner:
        or bx,bx
        jz unsupported
        push dx
        mov di,bx
        add di,8
        mov si,offset owner_name
        mov cx,5
        repe cmpsb
        pop dx
        je owner_found
        mov bx,es:1eh[bx]
        dec dx
        jnz find_owner
        jmps unsupported
owner_found:
        mov ax,es:10h[bx]
        mov es,ax
        mov ax,es:word ptr .50h
        mov word ptr ms_entry+2,ax
        mov cl,0ah
        callf ms_entry
        cmp ax,0ffffh
        je unsupported
        or ax,ax
        jz unsupported
        cmp dx,2
        jb unsupported
        cmp dx,1024
        ja unsupported
        mov env_segment,ax
        mov env_capacity,dx
        mov es,ax
        mov cx,dx
        xor bx,bx
        mov di,4[bp]
read_bytes:
        mov al,es:[bx]
        mov [di],al
        inc bx
        inc di
        loop read_bytes
        mov ax,env_capacity
        jmps read_done
unsupported:
        xor ax,ax
read_done:
        pop es
        pop di
        pop si
        pop bp
        ret

; The portable editor checks the double NUL, names and capacity, then builds
; a complete replacement in a separate buffer. Only a successful edit reaches
; this bounded commit; preserve the environment header and surrounding memory.
ENVWRITE:
        push bp
        mov bp,sp
        push si
        push di
        push es
        mov cx,env_capacity
        jcxz write_done
        mov es,env_segment
        xor di,di
        mov si,4[bp]
        cld
        rep movsb
write_done:
        pop es
        pop di
        pop si
        pop bp
        ret

; Full native BDOS bridge, preserving the C frame/index registers and ES.
BDOS:
        push bp
        mov bp,sp
        push si
        push di
        push es
        mov cx,4[bp]
        mov dx,6[bp]
        int 0e0h
        pop es
        pop di
        pop si
        pop bp
        ret
        end start
