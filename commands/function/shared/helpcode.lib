; Shared reconstructed HELP 2.0 code for SETUP and SETPORT, not OEM source.
; The caller supplies help_main_stack and the HELP data/workspace.
help_entry:
	jmps	help_save_context
	nop
help_copyright	db	'COPYRIGHT(C)1983,84,DIGITAL RESEARCH(05/02/84)1031-0000-009373'

; -----------------------------------------------------------------------------
; Save caller flags/registers, obtain the system drive, and copy the topic.
; The zero immediates loading ES and DS are loader-relocated DATA segments
; at the per-command relocation offsets; their on-disk words remain zero.
; -----------------------------------------------------------------------------
help_save_context:
	pushf
	push	ds
	push	es
	push	ax
	push	bx
	push	cx
	push	dx
	push	es
	push	dx
	mov	cl,9ah
	int	0e0h
	mov	word ptr help_system_segment,es
	mov	bx,4bh
	mov	al,es:byte ptr [bx]
	inc	al
	mov	byte ptr help_system_disk,al
	pop	dx
	pop	es
	cld
	mov	si,dx
	mov	ax,0h
	mov	es,ax
	mov	di,offset help_input_text
	mov	cx,7fh
	rep	movsb
	mov	ax,0h
	mov	ds,ax
	mov	bx,offset help_input_buffer
measure_help_topic:
	inc	bx
	cmp	byte ptr [bx],0h
	jnz	measure_help_topic
	sub	bx,offset help_input_text
	mov	byte ptr help_input_buffer,bl
	mov	word ptr help_caller_ss,ss
	mov	word ptr help_caller_sp,sp
	call	help_private_stack
	call	help_main

; -----------------------------------------------------------------------------
; Restore the caller's stack, registers and flags; return to the caller.
; -----------------------------------------------------------------------------
help_return:
	pushf
	pop	bx
	cli
	mov	ss,word ptr help_caller_ss
	mov	sp,word ptr help_caller_sp
	push	bx
	popf
	pop	dx
	pop	cx
	pop	bx
	pop	ax
	pop	es
	pop	ds
	popf
	ret

; -----------------------------------------------------------------------------
; PL/M stack interface: function and argument are words on the stack.
; Intercept BDOS 10 for HELP's local line editor; save AX/BX/CX/DX results.
; -----------------------------------------------------------------------------
help_bdos:
	push	bp
	mov	bp,sp
	add	bp,4h
	mov	dx,word ptr 0h[bp]
	add	bp,2h
	mov	cx,word ptr 0h[bp]
	cmp	cl,0ah
	jnz	help_bdos_interrupt
	call	help_line_editor
	jmps	save_help_bdos_results
	nop
help_bdos_interrupt:
	int	0e0h
save_help_bdos_results:
	mov	word ptr help_saved_ax,ax
	mov	word ptr help_saved_bx,bx
	mov	word ptr help_saved_cx,cx
	mov	word ptr help_saved_dx,dx
	pop	bp
	ret	word ptr 4h

; -----------------------------------------------------------------------------
; Switch to the HELP stack within DATA with interrupts safely masked.
; -----------------------------------------------------------------------------
help_private_stack:
	pop	dx
	pushf
	pop	bx
	cli
	mov	cx,ds
	mov	ss,cx
	mov	sp,180h
	push	bx
	popf
	push	dx
	ret

; -----------------------------------------------------------------------------
; Retained PL/M startup entry; normal HELP entry calls help_main directly.
; -----------------------------------------------------------------------------
help_plm_start:
	mov	bp,sp
	sti

; -----------------------------------------------------------------------------
; Initialize HELP, open HELP.HLP on the default or system drive, parse the
; requested topic and navigate topics/subtopics. Close the file and return
; to the caller, including on a user abort or missing help file.
; -----------------------------------------------------------------------------
help_main:
	mov	sp,help_main_stack
	mov	bp,sp
	mov	byte ptr help_end_of_data,0h
	mov	byte ptr help_line_count,0h
	call	help_private_stack
	call	help_get_version
	mov	word ptr help_version,ax
	mov	byte ptr help_page_length,16h
	mov	byte ptr help_page_mode,0ffh
	call	help_parse
	mov	byte ptr help_token_count,al
	mov	al,0dh
	push	ax
	mov	ax,offset help_filename
	push	ax
	mov	ax,offset help_fcb
	push	ax
	call	help_move
	mov	ax,offset help_fcb
	push	ax
	call	help_open_file
	mov	byte ptr help_open_status,al
	cmp	byte ptr help_open_status,0ffh
	jnz	test_help_open_result
	call	help_system_drive
	mov	byte ptr help_fcb,al
	mov	al,0h
	push	ax
	call	help_set_user
	mov	ax,offset help_fcb
	push	ax
	call	help_open_file
	mov	byte ptr help_open_status,al
test_help_open_result:
	cmp	byte ptr help_open_status,0ffh
	jnz	initialize_help_index
	jmp	report_missing_help_file
initialize_help_index:
	call	help_reset_index
	mov	al,byte ptr help_list_mode
	not	al
	rcr	al,1
	jnc	test_initial_help_topic
	mov	ax,offset help_clear_screen
	push	ax
	call	help_print_string
test_initial_help_topic:
	cmp	byte ptr help_token_count,0h
	jnz	test_help_token_count
	mov	byte ptr help_level,0h
	mov	ax,offset help_intro
	push	ax
	call	help_print_string
	mov	byte ptr help_line_count,2h
display_available_topics:
	call	help_display_index
prompt_for_help_topic:
	call	help_prompt
	mov	byte ptr help_token_count,al
test_help_token_count:
	mov	al,0h
	cmp	byte ptr help_token_count,al
	jnz	test_help_question_mark
	jmp	close_help_and_return
test_help_question_mark:
	mov	byte ptr help_level,al
	mov	cx,offset help_topic_tokens
	push	cx
	mov	cx,offset help_question_token
	push	cx
	call	help_compare
	cmp	al,0h
	jnz	search_exact_help_topic
	jmp	choose_help_next_action
search_exact_help_topic:
	mov	byte ptr help_search_level,0h
	call	help_search
	cmp	al,0ffh
	jz	search_parent_help_topic
	call	help_print_topic
	mov	ax,offset help_topic_tokens
	push	ax
	mov	ax,offset help_command_token
	jmps	compare_help_keyword
search_parent_help_topic:
	mov	byte ptr help_search_level,1h
	mov	byte ptr help_level,0h
	call	help_search
	cmp	al,0ffh
	jz	report_missing_help_topic
	call	help_print_topic
	mov	ax,offset help_topic_tokens
	push	ax
	mov	ax,offset help_intro_token
compare_help_keyword:
	push	ax
	call	help_compare
	cmp	al,0h
	jz	help_topic_displayed
	jmp	choose_help_next_action
help_topic_displayed:
	jmp	reset_help_level
report_missing_help_topic:
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	reset_help_level
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	reset_help_level
	mov	ax,offset help_topic_heading
	push	ax
	call	help_print_string
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	push	word ptr help_token_count
	call	help_display_tokens
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
	mov	ax,offset help_not_found
	push	ax
	call	help_print_string
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,0dh
	push	ax
	call	help_write_console
reset_help_level:
	mov	byte ptr help_level,0h
choose_help_next_action:
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	return_to_help_prompt
	jmp	display_available_topics
return_to_help_prompt:
	jmp	prompt_for_help_topic
close_help_and_return:
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	byte ptr help_file_status,al
	jmps	finish_help_session
report_missing_help_file:
	mov	al,0h
	push	ax
	mov	ax,offset help_file_missing
	push	ax
	call	help_error
finish_help_session:
	call	help_return
	sti
	hlt

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 1; retained although not called by this HELP path.
; -----------------------------------------------------------------------------
help_read_console:
	push	bp
	mov	bp,sp
	mov	al,1h
	push	ax
	mov	ax,0h
	push	ax
	call	help_bdos
	pop	bp
	ret

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 2, console character output.
; -----------------------------------------------------------------------------
help_write_console:
	push	bp
	mov	bp,sp
	mov	al,2h
	push	ax
	mov	al,byte ptr 4h[bp]
	mov	ah,0h
	push	ax
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 9, dollar-terminated string output.
; -----------------------------------------------------------------------------
help_print_string:
	push	bp
	mov	bp,sp
	mov	al,9h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 10; intercepted by the local HELP line editor.
; -----------------------------------------------------------------------------
help_read_line:
	push	bp
	mov	bp,sp
	mov	al,0ah
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 6, direct console I/O.
; -----------------------------------------------------------------------------
help_direct_console:
	push	bp
	mov	bp,sp
	mov	al,6h
	push	ax
	mov	al,byte ptr 4h[bp]
	mov	ah,0h
	push	ax
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 12, system version.
; -----------------------------------------------------------------------------
help_get_version:
	push	bp
	mov	bp,sp
	mov	al,0ch
	push	ax
	mov	ax,0h
	push	ax
	call	help_bdos
	pop	bp
	ret

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 19; retained file interface entry.
; -----------------------------------------------------------------------------
help_delete_file:
	push	bp
	mov	bp,sp
	mov	al,13h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Clear extent/current-record fields and open an FCB using BDOS 15.
; -----------------------------------------------------------------------------
help_open_file:
	push	bp
	mov	bp,sp
	mov	bx,word ptr 4h[bp]
	mov	byte ptr 0ch[bx],0h
	mov	byte ptr 20h[bx],0h
	mov	al,0fh
	push	ax
	push	bx
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 16, close FCB.
; -----------------------------------------------------------------------------
help_close_file:
	push	bp
	mov	bp,sp
	mov	al,10h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 20, sequential record read.
; -----------------------------------------------------------------------------
help_read_record:
	push	bp
	mov	bp,sp
	mov	al,14h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 21; retained file interface entry.
; -----------------------------------------------------------------------------
help_write_record:
	push	bp
	mov	bp,sp
	mov	al,15h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Clear FCB extent/current-record fields, then call BDOS 22.
; -----------------------------------------------------------------------------
help_make_file:
	push	bp
	mov	bp,sp
	mov	bx,word ptr 4h[bp]
	mov	byte ptr 0ch[bx],0h
	mov	byte ptr 20h[bx],0h
	mov	al,16h
	push	ax
	push	bx
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 33, random record read.
; -----------------------------------------------------------------------------
help_read_random:
	push	bp
	mov	bp,sp
	mov	al,21h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 26, select DMA address.
; -----------------------------------------------------------------------------
help_set_dma:
	push	bp
	mov	bp,sp
	mov	al,1ah
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 36; retained file interface entry.
; -----------------------------------------------------------------------------
help_set_random_record:
	push	bp
	mov	bp,sp
	mov	al,24h
	push	ax
	push	word ptr 4h[bp]
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; PL/M wrapper for BDOS 32, select/query user number.
; -----------------------------------------------------------------------------
help_set_user:
	push	bp
	mov	bp,sp
	mov	al,20h
	push	ax
	mov	al,byte ptr 4h[bp]
	mov	ah,0h
	push	ax
	call	help_bdos
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Return the system drive only for the recognized concurrent OS family.
; -----------------------------------------------------------------------------
help_system_drive:
	push	bp
	mov	bp,sp
	call	help_get_version
	mov	al,ah	; 0E54h: original 88E0, ASM86 8AC4 (same instruction/length)
	and	al,0fdh
	cmp	al,14h
	jz	return_help_system_drive
	mov	al,0h
	pop	bp
	ret
return_help_system_drive:
	mov	al,byte ptr help_system_disk
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Print ERROR, the supplied dollar-terminated message and CR/LF.
; Return to the caller when the caller requests termination.
; -----------------------------------------------------------------------------
help_error:
	push	bp
	mov	bp,sp
	mov	ax,offset help_error_prefix
	push	ax
	call	help_print_string
	push	word ptr 4h[bp]
	call	help_print_string
	mov	ax,offset help_newline
	push	ax
	call	help_print_string
	mov	al,byte ptr 6h[bp]
	rcr	al,1
	jnc	help_error_return
	call	help_return
help_error_return:
	pop	bp
	ret	word ptr 4h

; -----------------------------------------------------------------------------
; Copy a byte count between two addresses; PL/M callee removes arguments.
; -----------------------------------------------------------------------------
help_move:
	push	bp
	mov	bp,sp
	mov	cl,byte ptr 8h[bp]
	mov	ch,0h
	mov	si,word ptr 6h[bp]
	mov	di,word ptr 4h[bp]
	push	ds
	pop	es
	cld
	repne	movsb
	pop	bp
	ret	word ptr 6h

; -----------------------------------------------------------------------------
; Compare two space-padded, twelve-character topic names.
; Return 0 for equal, 1 for less and 2 for greater.
; -----------------------------------------------------------------------------
help_compare:
	push	bp
	mov	bp,sp
	mov	byte ptr help_compare_result,0h
	mov	byte ptr help_compare_index,0h
compare_topic_character:
	mov	al,byte ptr help_compare_index
	cmp	al,0ch
	mov	al,0ffh
	jc	load_topic_character
	inc	ax
load_topic_character:
	mov	cl,byte ptr help_compare_index
	mov	ch,0h
	mov	si,cx	; 0EBEh: original 89CE, ASM86 8BF1 (same instruction/length)
	mov	bx,word ptr 6h[bp]
	mov	dl,byte ptr [bx+si]
	push	ax
	cmp	dl,20h
	mov	al,0ffh
	jnz	test_topic_compare_limit
	inc	ax
test_topic_compare_limit:
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	return_topic_comparison
	mov	bx,word ptr 4h[bp]
	cmp	dl,byte ptr [bx+si]
	jz	advance_topic_character
	cmp	dl,byte ptr [bx+si]
	jnc	topic_compares_greater
	mov	byte ptr help_compare_result,1h
	jmps	finish_topic_difference
topic_compares_greater:
	mov	byte ptr help_compare_result,2h
finish_topic_difference:
	mov	byte ptr help_compare_index,0bh
advance_topic_character:
	inc	byte ptr help_compare_index
	jmps	compare_topic_character
return_topic_comparison:
	mov	al,byte ptr help_compare_result
	pop	bp
	ret	word ptr 4h

; -----------------------------------------------------------------------------
; Move through 16-byte index entries in a 1 KiB cache. Crossing a 64-entry
; boundary reloads eight records; 8000h resets the index to its start.
; -----------------------------------------------------------------------------
help_step_index:
	pop	cx
	pop	word ptr help_index_step
	pop	word ptr help_index_pointer
	push	cx
	push	bp
	mov	bp,sp
	mov	byte ptr help_records_per_block,8h
	cmp	word ptr help_index_step,8000h
	jnz	test_index_direction
	mov	ax,0h
	mov	word ptr help_index_block,ax
	mov	byte ptr help_record_number,al
	mov	bx,word ptr help_index_pointer
	mov	word ptr [bx],ax
	call	help_load_index_block
	pop	bp
	ret
test_index_direction:
	cmp	word ptr help_index_step,8000h
	jna	test_forward_index_step
	neg	word ptr help_index_step
	mov	byte ptr help_step_count,1h
previous_index_entry:
	mov	al,byte ptr help_step_count
	mov	ah,0h
	cmp	ax,word ptr help_index_step
	ja	index_step_complete
	mov	bx,word ptr help_index_pointer
	mov	ax,word ptr [bx]
	dec	ax
	mov	word ptr [bx],ax
	cmp	ax,8000h
	jna	count_backward_step
	mov	ax,word ptr help_index_block
	mov	cl,byte ptr help_records_per_block
	mov	ch,0h
	mul	cx
	sub	ax,cx
	mov	byte ptr help_record_number,al
	call	help_load_index_block
	mov	bx,word ptr help_index_pointer
	add	word ptr [bx],40h
	dec	word ptr help_index_block
count_backward_step:
	inc	byte ptr help_step_count
	jnz	previous_index_entry
	pop	bp
	ret
test_forward_index_step:
	cmp	word ptr help_index_step,0h
	jna	index_step_complete
	mov	byte ptr help_step_count,1h
next_index_entry:
	mov	al,byte ptr help_step_count
	mov	ah,0h
	cmp	ax,word ptr help_index_step
	ja	index_step_complete
	mov	bx,word ptr help_index_pointer
	mov	ax,word ptr [bx]
	inc	ax
	mov	word ptr [bx],ax
	cmp	ax,3fh	; 0F9Ch: original 83F83F, ASM86 3D3F00 (same instruction/length)
	jna	count_forward_step
	mov	ax,word ptr help_index_block
	mov	cl,byte ptr help_records_per_block
	mov	ch,0h
	mul	cx
	add	ax,cx
	mov	byte ptr help_record_number,al
	call	help_load_index_block
	mov	bx,word ptr help_index_pointer
	sub	word ptr [bx],40h
	inc	word ptr help_index_block
count_forward_step:
	inc	byte ptr help_step_count
	jnz	next_index_entry
index_step_complete:
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Read eight random 128-byte records into the index cache, restoring the
; normal DMA afterward. A read error closes HELP.HLP and returns to the caller.
; -----------------------------------------------------------------------------
help_load_index_block:
	push	bp
	mov	bp,sp
	mov	byte ptr help_record_index,0h
load_index_record:
	mov	al,byte ptr help_records_per_block
	dec	al
	cmp	byte ptr help_record_index,al
	ja	restore_help_dma
	mov	al,byte ptr help_record_index
	mov	cl,80h
	mul	cl
	mov	cx,10h
	xor	dx,dx	; 0FE4h: original 31D2, ASM86 33D2 (same instruction/length)
	div	cx
	mul	cx
	mov	bx,ax	; 0FEAh: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	call	help_set_dma
	mov	al,byte ptr help_record_number
	mov	byte ptr help_random_record,al
	mov	al,0h
	mov	byte ptr help_random_record_middle,al
	mov	byte ptr help_random_record_high,al
	mov	cx,offset help_fcb
	push	cx
	call	help_read_random
	cmp	al,0h
	jz	advance_index_record
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	ah,0h
	mov	word ptr help_index_step,ax
	mov	al,0ffh
	push	ax
	mov	ax,offset help_read_error
	push	ax
	call	help_error
advance_index_record:
	inc	byte ptr help_record_number
	inc	byte ptr help_record_index
	jnz	load_index_record
restore_help_dma:
	mov	ax,offset help_input_buffer
	push	ax
	call	help_set_dma
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Advance a sequential buffer index, reading another record after byte 127.
; Set the end-of-data flag on a failed read.
; -----------------------------------------------------------------------------
help_next_byte:
	push	bp
	mov	bp,sp
	mov	al,byte ptr 4h[bp]
	inc	al
	mov	byte ptr 4h[bp],al
	cmp	al,7fh
	jna	return_help_byte_index
	mov	ax,offset help_fcb
	push	ax
	call	help_read_record
	cmp	al,0h
	jz	reset_help_byte_index
	mov	byte ptr help_end_of_data,0ffh
reset_help_byte_index:
	mov	byte ptr 4h[bp],0h
return_help_byte_index:
	mov	al,byte ptr 4h[bp]
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Count output lines and prompt at the configured page length unless paging
; is disabled. RETURN continues, Ctrl-C returns to the caller, other keys stop
; the current display. Return the stop flag in AL.
; -----------------------------------------------------------------------------
help_page_check:
	push	bp
	mov	bp,sp
	mov	byte ptr help_page_stop,0h
	mov	al,byte ptr help_no_page_mode
	not	al
	and	al,byte ptr help_page_mode
	rcr	al,1
	jnc	paging_disabled
	mov	bx,word ptr 4h[bp]
	mov	al,byte ptr [bx]
	inc	al
	mov	byte ptr [bx],al
	cmp	al,byte ptr help_page_length
	jna	output_page_linefeed
	mov	ax,offset help_continue_prompt
	push	ax
	call	help_print_string
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],0h
wait_page_response:
	mov	bx,word ptr 4h[bp]
	cmp	byte ptr [bx],0h
	jnz	erase_page_prompt
	mov	al,0fdh
	push	ax
	call	help_direct_console
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],al
	jmps	wait_page_response
erase_page_prompt:
	mov	ax,offset help_erase_prompt
	push	ax
	call	help_print_string
	mov	bx,word ptr 4h[bp]
	cmp	byte ptr [bx],3h
	jnz	test_page_return_key
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],al
	call	help_return
	jmps	return_page_stop_flag
test_page_return_key:
	mov	bx,word ptr 4h[bp]
	cmp	byte ptr [bx],0dh
	jz	reset_page_line_count
	mov	byte ptr help_page_stop,0ffh
reset_page_line_count:
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],0h
	jmps	return_page_stop_flag
paging_disabled:
	mov	bx,word ptr 4h[bp]
	mov	byte ptr [bx],0h
output_page_linefeed:
	mov	al,0ah
	push	ax
	call	help_write_console
return_page_stop_flag:
	mov	al,byte ptr help_page_stop
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Reset the cached directory traversal to its initial index block.
; -----------------------------------------------------------------------------
help_reset_index:
	push	bp
	mov	bp,sp
	mov	word ptr help_global_index,8000h
	mov	ax,offset help_index_position
	push	ax
	mov	ax,8000h
	push	ax
	call	help_step_index
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Normalize commas/tabs to spaces; parse topic and subtopic tokens plus HELP
; options. A leading period extends the current topic path.
; -----------------------------------------------------------------------------
help_parse:
	push	bp
	mov	bp,sp
	mov	byte ptr help_parse_index,0h
	cmp	byte ptr help_input_buffer,0h
	jnz	begin_separator_normalization
	jmp	initialize_help_options
begin_separator_normalization:
	mov	byte ptr help_parse_index,1h
normalize_next_separator:
	mov	al,byte ptr help_parse_index
	cmp	al,byte ptr help_input_buffer
	ja	begin_leading_space_scan
	mov	ah,0h
	mov	bx,ax	; 1126h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_input_buffer[bx],9h
	jz	replace_separator_with_space
	mov	bl,byte ptr help_parse_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],2ch
	jnz	advance_separator_scan
replace_separator_with_space:
	mov	byte ptr help_input_buffer[bx],20h
advance_separator_scan:
	inc	byte ptr help_parse_index
	jnz	normalize_next_separator
begin_leading_space_scan:
	mov	byte ptr help_parse_index,1h
test_leading_space_limit:
	mov	al,byte ptr help_parse_index
	cmp	al,byte ptr help_input_buffer
	mov	al,0ffh
	jc	test_leading_space_character
	inc	ax
test_leading_space_character:
	mov	bl,byte ptr help_parse_index
	mov	bh,0h
	push	ax
	cmp	byte ptr help_input_buffer[bx],20h
	mov	al,0ffh
	jz	combine_leading_space_tests
	inc	ax
combine_leading_space_tests:
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	test_relative_topic_prefix
	inc	byte ptr help_parse_index
	jmps	test_leading_space_limit
test_relative_topic_prefix:
	mov	bl,byte ptr help_parse_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],2eh
	jnz	reset_topic_path_level
	mov	al,byte ptr help_level
	mov	byte ptr help_parse_level,al
	mov	byte ptr help_input_buffer[bx],20h
	jmps	prepare_topic_slots
reset_topic_path_level:
	mov	byte ptr help_parse_level,0h
prepare_topic_slots:
	mov	al,byte ptr help_parse_level
	mov	byte ptr help_parse_index,al
clear_next_topic_slot:
	cmp	byte ptr help_parse_index,0ah
	ja	begin_help_token_scan
	mov	al,0fh
	push	ax
	mov	cx,offset help_blank_topic
	push	cx
	mov	cx,ax	; 11A9h: original 89C1, ASM86 8BC8 (same instruction/length)
	mov	al,byte ptr help_parse_index
	mul	cl
	mov	bx,ax	; 11B0h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_move
	inc	byte ptr help_parse_index
	jnz	clear_next_topic_slot
begin_help_token_scan:
	mov	al,byte ptr help_parse_level
	mov	byte ptr help_parse_index,al
	mov	byte ptr help_input_index,1h
	mov	byte ptr help_parse_done,0h
	mov	byte ptr help_option_seen,0h
test_help_input_end:
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],0h
	mov	al,0ffh
	jnz	test_help_parse_stop
	inc	ax
test_help_parse_stop:
	mov	cl,byte ptr help_parse_done
	not	cl
	and	al,cl
	rcr	al,1
	jc	test_help_token_space
	jmp	initialize_help_options
test_help_token_space:
	cmp	byte ptr help_input_buffer[bx],20h
	jnz	begin_help_token
	jmp	advance_help_input_index
begin_help_token:
	mov	byte ptr help_token_character_index,0h
read_help_token_character:
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	mov	al,byte ptr help_input_buffer[bx]
	push	ax
	cmp	al,20h
	mov	al,0ffh
	jnz	test_open_option_bracket
	inc	ax
test_open_option_bracket:
	pop	cx
	push	ax
	cmp	cl,5bh
	mov	al,0ffh
	jnz	test_close_option_bracket
	inc	ax
test_close_option_bracket:
	pop	dx
	and	al,dl
	push	ax
	cmp	cl,0h
	mov	al,0ffh
	jnz	test_help_token_width
	inc	ax
test_help_token_width:
	pop	dx
	and	al,dl
	push	ax
	cmp	byte ptr help_token_character_index,0ch
	mov	al,0ffh
	jc	test_help_token_capacity
	inc	ax
test_help_token_capacity:
	push	ax
	cmp	byte ptr help_parse_index,0bh
	mov	al,0ffh
	jc	combine_help_token_tests
	inc	ax
combine_help_token_tests:
	pop	dx
	and	al,dl
	pop	dx
	and	al,dl
	rcr	al,1
	jnc	advance_help_token_slot
	cmp	cl,60h
	jna	compute_help_token_address
	cmp	cl,7bh
	jnc	compute_help_token_address
	sub	cl,20h
	mov	al,byte ptr help_parse_index
	mov	dl,0fh
	mul	dl
	jmps	store_help_token_character
compute_help_token_address:
	mov	al,byte ptr help_parse_index
	mov	cl,0fh
	mul	cl
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	mov	cl,byte ptr help_input_buffer[bx]
store_help_token_character:
	mov	dl,byte ptr help_token_character_index
	mov	bx,ax	; 1279h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	dh,0h
	mov	si,dx	; 127Dh: original 89D6, ASM86 8BF2 (same instruction/length)
	mov	byte ptr help_topic_tokens[bx+si],cl
	inc	byte ptr help_input_index
	inc	byte ptr help_token_character_index
	jmp	read_help_token_character
advance_help_token_slot:
	mov	al,byte ptr help_parse_index
	inc	al
	mov	byte ptr help_parse_index,al
	cmp	al,0ah
	ja	stop_help_token_scan
	mov	al,byte ptr help_option_seen
	rcr	al,1
	jnc	test_help_option_bracket
stop_help_token_scan:
	mov	byte ptr help_parse_done,0ffh
	jmps	repeat_help_input_scan
test_help_option_bracket:
	mov	bl,byte ptr help_input_index
	mov	bh,0h
	cmp	byte ptr help_input_buffer[bx],5bh
	jnz	repeat_help_input_scan
	mov	al,byte ptr help_parse_index
	dec	al
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 12BEh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],20h
	jnz	store_help_option_token
	mov	al,byte ptr help_parse_index
	dec	al
	mov	byte ptr help_parse_index,al
store_help_option_token:
	mov	al,byte ptr help_parse_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 12D6h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	byte ptr help_topic_tokens[bx],5bh
	inc	byte ptr help_input_index
	inc	byte ptr help_parse_index
	mov	byte ptr help_option_seen,0ffh
	jmps	repeat_help_input_scan
advance_help_input_index:
	inc	byte ptr help_input_index
repeat_help_input_scan:
	jmp	test_help_input_end
initialize_help_options:
	mov	al,0h
	mov	byte ptr help_list_mode,al
	mov	byte ptr help_no_page_mode,al
	mov	byte ptr help_create_mode,al
	mov	byte ptr help_extract_mode,al
	cmp	byte ptr help_parse_index,al
	ja	begin_help_option_scan
	jmp	return_help_token_count
begin_help_option_scan:
	mov	byte ptr help_token_character_index,al
next_help_option_slot:
	mov	al,byte ptr help_token_character_index
	cmp	al,0ah
	jc	test_help_option_marker
	jmp	return_help_token_count
test_help_option_marker:
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 131Bh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],5bh
	jnz	advance_help_option_slot
	cmp	byte ptr help_topic_tokens+0fh[bx],43h
	jnz	test_help_list_option
	mov	byte ptr help_create_mode,0ffh
	jmps	remove_help_option_tokens
test_help_list_option:
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1339h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens+0fh[bx],45h
	jnz	test_help_no_page_option
	mov	byte ptr help_extract_mode,0ffh
remove_help_option_tokens:
	sub	byte ptr help_parse_index,2h
	jmps	finish_help_option_scan
test_help_no_page_option:
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1355h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens+0fh[bx],4eh
	jz	enable_help_no_page
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1365h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens+0fh[bx],4ch
	jnz	test_help_create_option
	mov	byte ptr help_list_mode,0ffh
enable_help_no_page:
	mov	byte ptr help_no_page_mode,0ffh
	jmps	remove_help_option_tokens
test_help_create_option:
	mov	al,byte ptr help_token_character_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1381h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens+0fh[bx],20h
	jnz	remove_help_option_tokens
	dec	byte ptr help_parse_index
finish_help_option_scan:
	mov	byte ptr help_token_character_index,0ah
advance_help_option_slot:
	inc	byte ptr help_token_character_index
	jmp	next_help_option_slot
return_help_token_count:
	mov	al,byte ptr help_parse_index
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Walk the help index and display the available topics or subtopics,
; respecting nesting level, pagination and the user's stop request.
; -----------------------------------------------------------------------------
help_display_index:
	push	bp
	mov	bp,sp
	mov	ax,0h
	mov	word ptr help_listing_position,ax
	mov	byte ptr help_listing_heading_shown,al
	mov	byte ptr help_listing_top_level,al
	mov	word ptr help_listing_stride,1h
	mov	al,byte ptr help_level
	inc	al
	mov	byte ptr help_listing_level,al
	cmp	al,0ah
	jnc	mark_top_level_listing
	cmp	byte ptr help_level,0h
	jnz	use_saved_index_position
	mov	word ptr help_listing_position,0h
	jmps	reset_displayed_topic_count
use_saved_index_position:
	mov	ax,word ptr help_saved_index
	mov	word ptr help_listing_position,ax
reset_displayed_topic_count:
	mov	word ptr help_displayed_topics,0h
	jmps	calculate_index_display_step
mark_top_level_listing:
	mov	byte ptr help_listing_top_level,0ffh
calculate_index_display_step:
	mov	ax,word ptr help_listing_position
	sub	ax,word ptr help_listing_cursor
	mov	word ptr help_listing_delta,ax
	mov	cx,offset help_listing_cursor
	push	cx
	push	ax
	call	help_step_index
	mov	word ptr help_listing_position,0h
test_top_level_listing:
	mov	al,byte ptr help_listing_top_level
	not	al
	rcr	al,1
	jc	load_index_entry_level
	jmp	finish_topic_listing
load_index_entry_level:
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 140Eh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_index_cache[bx],24h
	jnz	load_index_entry_name
	mov	byte ptr help_listing_top_level,0ffh
load_index_entry_name:
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1424h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	al,byte ptr help_index_cache+0fh[bx]
	cmp	al,byte ptr help_listing_level
	jz	test_subtopic_heading_printed
	jmp	load_next_index_level
test_subtopic_heading_printed:
	mov	al,byte ptr help_listing_heading_shown
	not	al
	rcr	al,1
	jc	print_topics_heading
	jmp	test_topic_column_boundary
print_topics_heading:
	mov	byte ptr help_listing_heading_shown,0ffh
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	cmp	byte ptr help_listing_level,1h
	jnz	test_index_scan_direction
	mov	al,byte ptr help_listing_top_level
	not	al
	rcr	al,1
	jnc	begin_index_display_page
	mov	ax,offset help_topics_heading
	push	ax
	call	help_print_string
	mov	ax,offset help_listing_cursor
	push	ax
	mov	ax,8000h
	push	ax
	call	help_step_index
	jmps	begin_index_display_page
test_index_scan_direction:
	cmp	byte ptr help_listing_level,2h
	jna	test_subtopic_heading_needed
	mov	ax,word ptr help_listing_cursor
	mov	word ptr help_listing_stride,ax
scan_previous_index_entry:
	mov	ax,offset help_listing_cursor
	push	ax
	mov	ax,0ffffh
	push	ax
	call	help_step_index
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	push	ax
	mov	ax,word ptr help_listing_cursor
	dec	ax
	mul	cx
	pop	bx
	mov	cl,byte ptr help_index_cache+0fh[bx]
	mov	bx,ax	; 149Eh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	cl,byte ptr help_index_cache+0fh[bx]
	jz	scan_previous_index_entry
	mov	ax,offset help_listing_cursor
	push	ax
	mov	ax,0ffffh
	push	ax
	call	help_step_index
	mov	ax,word ptr help_listing_cursor
	sub	word ptr help_listing_stride,ax
test_subtopic_heading_needed:
	cmp	byte ptr help_listing_level,2h
	ja	print_subtopics_heading
	mov	al,byte ptr help_listing_top_level
	not	al
	rcr	al,1
	jnc	begin_index_display_page
print_subtopics_heading:
	mov	ax,offset help_subtopics_heading
	push	ax
	call	help_print_string
begin_index_display_page:
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	mov	ax,offset help_heading_newline
	push	ax
	call	help_print_string
test_topic_column_boundary:
	mov	ax,word ptr help_displayed_topics
	mov	cx,6h
	xor	dx,dx	; 14E6h: original 31D2, ASM86 33D2 (same instruction/length)
	div	cx
	cmp	dx,0h
	jnz	prepare_topic_output_buffer
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	mov	al,0dh
	push	ax
	call	help_write_console
prepare_topic_output_buffer:
	mov	byte ptr help_listing_character,0h
clear_topic_output_byte:
	cmp	byte ptr help_listing_character,0dh
	ja	terminate_topic_output_buffer
	mov	bl,byte ptr help_listing_character
	mov	bh,0h
	mov	byte ptr help_listing_text[bx],20h
	inc	byte ptr help_listing_character
	jnz	clear_topic_output_byte
terminate_topic_output_buffer:
	mov	byte ptr help_listing_terminator,24h
	mov	al,0ch
	push	ax
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 152Ch: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	mov	ax,offset help_listing_text
	push	ax
	call	help_move
	mov	ax,offset help_listing_text
	push	ax
	call	help_print_string
	inc	word ptr help_displayed_topics
	jmps	advance_display_index
load_next_index_level:
	mov	ax,word ptr help_listing_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 154Fh: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	al,byte ptr help_index_cache+0fh[bx]
	cmp	al,byte ptr help_listing_level
	jnc	advance_display_index
	mov	byte ptr help_listing_top_level,0ffh
advance_display_index:
	mov	ax,offset help_listing_cursor
	push	ax
	push	word ptr help_listing_stride
	call	help_step_index
	mov	word ptr help_listing_stride,1h
	jmp	test_top_level_listing
finish_topic_listing:
	mov	al,byte ptr help_listing_heading_shown
	rcr	al,1
	jnc	restore_index_display_dma
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_listing_character,al
	mov	ax,304h
	push	ax
	call	help_print_string
restore_index_display_dma:
	mov	ax,offset help_input_buffer
	push	ax
	call	help_set_dma
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Search the index for the requested topic path; return FFh when not found
; and retain its text position for display.
; -----------------------------------------------------------------------------
help_search:
	push	bp
	mov	bp,sp
	mov	al,0h
	mov	byte ptr help_search_matched,al
	mov	byte ptr help_search_done,al
	mov	byte ptr help_search_failed,al
	mov	byte ptr help_search_passed_name,al
	mov	ah,0h
	mov	word ptr help_search_cursor,ax
	call	help_reset_index
	mov	byte ptr help_search_restart,0ffh
	cmp	byte ptr help_search_level,1h
	jnz	test_parent_search_restart
	mov	byte ptr help_last_token,0ah
find_last_topic_token:
	mov	al,byte ptr help_last_token
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 15C6h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],20h
	jnz	prepare_parent_topic_search
	dec	byte ptr help_last_token
	jmps	find_last_topic_token
prepare_parent_topic_search:
	mov	al,byte ptr help_last_token
	sub	al,2h
	mov	byte ptr help_parent_level,al
	mov	al,byte ptr help_last_token
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 15E4h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	mov	al,byte ptr help_parent_level
	mul	cl
	mov	bx,ax	; 15F0h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_compare
	mov	byte ptr help_search_restart,al
	mov	al,byte ptr help_parent_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 1604h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	al,byte ptr help_topic_tokens+0fh[bx]
	mov	byte ptr help_parent_token_saved,al
test_parent_search_restart:
	cmp	byte ptr help_search_restart,0h
	jz	select_parent_topic_level
	cmp	byte ptr help_search_level,0h
	jz	select_parent_topic_level
	jmp	topic_search_failed
select_parent_topic_level:
	cmp	byte ptr help_search_level,1h
	jnz	test_search_completion
	mov	al,byte ptr help_parent_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 162Ch: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	byte ptr help_topic_tokens+0fh[bx],20h
test_search_completion:
	mov	al,byte ptr help_search_done
	not	al
	mov	cl,byte ptr help_search_failed
	not	cl
	and	al,cl
	rcr	al,1
	jc	load_search_index_entry
	jmp	load_matched_topic_position
load_search_index_entry:
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 164Fh: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_index_cache[bx],24h
	jnz	test_search_child_level
	jmp	mark_search_not_found
test_search_child_level:
	mov	al,byte ptr help_level
	inc	al
	cmp	byte ptr help_index_cache+0fh[bx],al
	jz	compute_search_token_offset
	jmp	test_search_order_result
compute_search_token_offset:
	mov	al,byte ptr help_level
	mov	dl,0fh
	mul	dl
	mov	si,ax	; 1670h: original 89C6, ASM86 8BF0 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[si]
	push	ax
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	call	help_compare
	mov	byte ptr help_search_restart,al
	cmp	byte ptr help_search_restart,0h
	jz	compare_search_topic
	jmp	advance_search_index
compare_search_topic:
	mov	al,0ch
	push	ax
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1697h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache[bx]
	push	ax
	mov	al,byte ptr help_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 16A5h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_move
	mov	al,byte ptr help_level
	inc	al
	mov	byte ptr help_level,al
	mov	al,byte ptr help_search_passed_name
	not	al
	rcr	al,1
	jnc	test_search_depth_limit
	mov	al,byte ptr help_level
	mov	byte ptr help_compare_byte,al
	mov	byte ptr help_search_passed_name,0ffh
test_search_depth_limit:
	mov	al,byte ptr help_level
	cmp	al,8h
	ja	mark_search_match
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 16D6h: original 89C3, ASM86 8BD8 (same instruction/length)
	cmp	byte ptr help_topic_tokens[bx],20h
	jz	mark_search_match
	cmp	byte ptr help_topic_tokens[bx],5bh
	jnz	skip_search_subtree
mark_search_match:
	mov	byte ptr help_search_matched,0ffh
	mov	byte ptr help_search_done,0ffh
	jmps	repeat_topic_search
skip_search_subtree:
	mov	ax,offset help_search_cursor
	push	ax
	mov	ax,1h
	push	ax
	call	help_step_index
	mov	byte ptr help_search_matched,0h
	jmps	repeat_topic_search
test_search_order_result:
	mov	al,byte ptr help_search_passed_name
	rcr	al,1
	jnc	advance_search_index
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1713h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	cl,byte ptr help_compare_byte
	cmp	cl,byte ptr help_index_cache+0fh[bx]
	jc	advance_search_index
mark_search_not_found:
	mov	byte ptr help_search_failed,0ffh
	jmps	repeat_topic_search
advance_search_index:
	mov	ax,offset help_search_cursor
	push	ax
	mov	ax,1h
	push	ax
	call	help_step_index
repeat_topic_search:
	jmp	test_search_completion
load_matched_topic_position:
	mov	al,byte ptr help_search_matched
	rcr	al,1
	jnc	restore_parent_topic_token
	mov	ax,word ptr help_search_cursor
	inc	ax
	mov	word ptr help_saved_index,ax
	mov	al,1h
	push	ax
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 174Dh: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache+0ch[bx]
	push	ax
	mov	ax,offset help_random_record
	push	ax
	call	help_move
	mov	al,1h
	push	ax
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1766h: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_index_cache+0ch[bx]
	inc	ax
	push	ax
	mov	ax,offset help_random_record_middle
	push	ax
	call	help_move
	mov	byte ptr help_random_record_high,0h
	mov	ax,word ptr help_search_cursor
	mov	cx,10h
	mul	cx
	mov	bx,ax	; 1782h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	cl,byte ptr help_index_cache+0eh[bx]
	mov	byte ptr help_file_status,cl
	mov	al,byte ptr help_index_cache+0fh[bx]
	mov	byte ptr help_level,al
restore_parent_topic_token:
	cmp	byte ptr help_search_level,1h
	jnz	return_topic_search_result
	mov	al,byte ptr help_parent_level
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 17A1h: original 89C3, ASM86 8BD8 (same instruction/length)
	mov	cl,byte ptr help_parent_token_saved
	mov	byte ptr help_topic_tokens+0fh[bx],cl
	jmps	return_topic_search_result
topic_search_failed:
	mov	byte ptr help_search_failed,0ffh
return_topic_search_result:
	mov	al,byte ptr help_search_failed
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Print the requested topic path, separating its tokens for diagnostics.
; -----------------------------------------------------------------------------
help_display_tokens:
	push	bp
	mov	bp,sp
	mov	byte ptr help_token_display_index,0h
test_display_token_limit:
	mov	al,byte ptr help_token_display_index
	cmp	al,byte ptr 4h[bp]
	mov	al,0ffh
	jc	test_token_display_abort
	inc	ax
test_token_display_abort:
	mov	cl,byte ptr help_end_of_data
	not	cl
	and	al,cl
	rcr	al,1
	jnc	token_display_complete
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	test_display_token_limit
	mov	byte ptr help_token_indent,0h
indent_topic_token:
	mov	al,byte ptr help_token_indent
	cmp	al,byte ptr help_token_display_index
	ja	print_topic_token
	mov	ax,offset help_indent_string
	push	ax
	call	help_print_string
	inc	byte ptr help_token_indent
	jnz	indent_topic_token
print_topic_token:
	mov	al,byte ptr help_token_display_index
	mov	cl,0fh
	mul	cl
	mov	bx,ax	; 180Bh: original 89C3, ASM86 8BD8 (same instruction/length)
	lea	ax,word ptr help_topic_tokens[bx]
	push	ax
	call	help_print_string
	inc	byte ptr help_token_display_index
	jmps	test_display_token_limit
token_display_complete:
	pop	bp
	ret	word ptr 2h

; -----------------------------------------------------------------------------
; Read and display the selected HELP.HLP topic text, tracking lines and
; record boundaries until the topic ends or the user stops the display.
; -----------------------------------------------------------------------------
help_print_topic:
	push	bp
	mov	bp,sp
	mov	al,0dh
	push	ax
	call	help_write_console
	push	word ptr help_level
	call	help_display_tokens
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	read_first_topic_record
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
read_first_topic_record:
	mov	al,byte ptr help_end_of_data
	not	al
	rcr	al,1
	jnc	topic_read_failed
	mov	ax,offset help_fcb
	push	ax
	call	help_read_random
	cmp	al,0h
	jz	initialize_topic_text_scan
	mov	ax,offset help_fcb
	push	ax
	call	help_close_file
	mov	byte ptr help_file_status,al
	mov	al,0ffh
	push	ax
	mov	ax,offset help_topic_read_error
	push	ax
	call	help_error
topic_read_failed:
	mov	byte ptr help_end_of_data,0h
	pop	bp
	ret
initialize_topic_text_scan:
	mov	byte ptr help_topic_finished,0h
test_topic_text_end:
	mov	cl,byte ptr help_topic_finished
	not	cl
	mov	al,byte ptr help_end_of_data
	not	al
	and	al,cl
	push	ax
	mov	cx,offset help_fcb
	push	cx
	call	help_read_record
	cmp	al,0h
	mov	al,0ffh
	jz	test_topic_record_limit
	inc	ax
test_topic_record_limit:
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	topic_read_failed
	mov	al,byte ptr help_file_status
	dec	al
	mov	byte ptr help_text_index,al
advance_topic_text_byte:
	mov	al,byte ptr help_text_index
	inc	al
	mov	byte ptr help_text_index,al
	cmp	al,7fh
	mov	al,0ffh
	jna	test_topic_delimiter_state
	inc	ax
test_topic_delimiter_state:
	mov	cl,byte ptr help_topic_finished
	not	cl
	and	al,cl
	rcr	al,1
	jc	load_topic_text_character
	jmp	begin_next_topic_record
load_topic_text_character:
	mov	bl,byte ptr help_text_index
	mov	bh,0h
	mov	al,byte ptr help_input_buffer[bx]
	mov	byte ptr help_text_character,al
	cmp	al,1ah
	jnz	begin_topic_delimiter_scan
	mov	byte ptr help_end_of_data,0ffh
begin_topic_delimiter_scan:
	mov	byte ptr help_delimiter_count,0h
test_delimiter_scan_end:
	mov	al,byte ptr help_topic_finished
	not	al
	mov	cl,byte ptr help_end_of_data
	not	cl
	and	al,cl
	push	ax
	cmp	byte ptr help_delimiter_count,3h
	mov	al,0ffh
	jc	test_delimiter_character
	inc	ax
test_delimiter_character:
	mov	bl,byte ptr help_text_index
	mov	bh,0h
	push	ax
	cmp	byte ptr help_input_buffer[bx],2fh
	mov	al,0ffh
	jz	combine_delimiter_tests
	inc	ax
combine_delimiter_tests:
	pop	cx
	and	al,cl
	pop	cx
	and	al,cl
	rcr	al,1
	jnc	test_complete_topic_delimiter
	inc	byte ptr help_delimiter_count
	push	bx
	call	help_next_byte
	mov	byte ptr help_text_index,al
	mov	bl,byte ptr help_delimiter_count
	dec	bl
	mov	bh,0h
	push	bx
	mov	bl,byte ptr help_text_index
	mov	bh,0h
	mov	al,byte ptr help_input_buffer[bx]
	pop	bx
	mov	byte ptr help_delimiter_buffer[bx],al
	jmps	test_delimiter_scan_end
test_complete_topic_delimiter:
	cmp	byte ptr help_delimiter_count,3h
	jnz	terminate_delimiter_buffer
	mov	byte ptr help_topic_finished,0ffh
	jmps	test_topic_output_enabled
terminate_delimiter_buffer:
	mov	bl,byte ptr help_delimiter_count
	mov	bh,0h
	mov	byte ptr help_delimiter_buffer[bx],24h
test_topic_output_enabled:
	mov	al,byte ptr help_end_of_data
	not	al
	mov	cl,byte ptr help_topic_finished
	not	cl
	and	al,cl
	rcr	al,1
	jnc	continue_topic_text_scan
	cmp	byte ptr help_text_character,0ah
	jnz	output_pending_topic_character
	mov	al,byte ptr help_no_page_mode
	not	al
	rcr	al,1
	jnc	output_pending_topic_character
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_end_of_data,al
	jmps	output_partial_delimiter
output_pending_topic_character:
	push	word ptr help_text_character
	call	help_write_console
output_partial_delimiter:
	cmp	byte ptr help_delimiter_count,0h
	jna	reset_delimiter_count
	mov	ax,offset help_delimiter_buffer
	push	ax
	call	help_print_string
reset_delimiter_count:
	mov	byte ptr help_delimiter_count,0h
continue_topic_text_scan:
	jmp	advance_topic_text_byte
begin_next_topic_record:
	mov	byte ptr help_file_status,0h
	jmp	test_topic_text_end

; -----------------------------------------------------------------------------
; Print the topic prompt, read a line, then pass it to the topic parser.
; -----------------------------------------------------------------------------
help_prompt:
	push	bp
	mov	bp,sp
	mov	al,1h
	push	ax
	mov	ax,offset help_input_limit
	push	ax
	mov	ax,offset help_input_buffer
	dec	ax
	push	ax
	call	help_move
	mov	ax,offset help_line_count
	push	ax
	call	help_page_check
	mov	byte ptr help_prompt_tokens,al
	mov	ax,offset help_topic_prompt
	push	ax
	call	help_print_string
	mov	ax,offset help_input_buffer
	dec	ax
	push	ax
	call	help_read_line
	mov	bl,byte ptr help_input_buffer
	mov	bh,0h
	mov	byte ptr help_input_text[bx],0h
	mov	byte ptr help_line_count,0ffh
	call	help_parse
	mov	byte ptr help_prompt_tokens,al
	cmp	byte ptr help_prompt_tokens,0h
	jz	return_prompt_token_count
	mov	al,byte ptr help_list_mode
	not	al
	rcr	al,1
	jnc	return_prompt_token_count
	mov	ax,offset help_clear_screen
	push	ax
	call	help_print_string
return_prompt_token_count:
	mov	al,byte ptr help_prompt_tokens
	pop	bp
	ret

; -----------------------------------------------------------------------------
; Local BDOS-10-style editor: CR/LF accept, Escape/Ctrl-C cancel, backspace
; and DEL erase, Ctrl-E starts a new line, Ctrl-X/Ctrl-U clear, Ctrl-R retypes.
; Preserve the caller's ES and handle control-character/tab display widths.
; -----------------------------------------------------------------------------
help_line_editor:
	mov	word ptr help_editor_es,es
	mov	word ptr help_editor_buffer,dx
	mov	word ptr help_editor_sp,sp
initialize_line_edit:
	push	dx
	push	es
	mov	cl,9ah
	call	help_editor_bdos
	mov	ax,es
	mov	si,es:word ptr .68h
	mov	bl,es:byte ptr 20h[si]
	mov	byte ptr help_printer_number,bl
	pop	es
	pop	dx
	mov	al,byte ptr help_output_column
	mov	byte ptr help_prompt_column,al
	mov	bx,dx
	mov	cl,es:byte ptr [bx]
	inc	bx
	push	bx
	mov	ch,0h
preserve_line_edit_state:
	push	cx
	push	bx
read_line_edit_key:
	call	help_get_key
	pop	bx
	pop	cx
	cmp	al,0dh
	jnz	test_linefeed_or_backspace
accept_line_jump:
	jmp	accept_input_line
test_linefeed_or_backspace:
	cmp	al,0ah
	jz	accept_line_jump
	cmp	al,8h
	jnz	test_escape_key
	or	ch,ch
	jz	preserve_line_edit_state
	dec	ch
	mov	al,byte ptr help_output_column
	mov	byte ptr help_retype_width,al
	jmp	retype_input_line
test_escape_key:
	cmp	al,1bh
	jnz	test_delete_key
	jmp	cancel_input_line
test_delete_key:
	cmp	al,7fh
	jnz	test_new_line_key
	or	ch,ch
	jz	preserve_line_edit_state
	mov	al,es:byte ptr [bx]
	dec	ch
	dec	bx
	jmp	echo_input_character
test_new_line_key:
	cmp	al,5h
	jnz	test_clear_to_prompt_key
	push	cx
	push	bx
	call	help_crlf
	mov	byte ptr help_prompt_column,0h
continue_line_edit:
	jmps	read_line_edit_key
test_clear_to_prompt_key:
	cmp	al,18h
	jnz	test_kill_line_key
	pop	bx
erase_back_to_prompt:
	mov	al,byte ptr help_prompt_column
	cmp	al,byte ptr help_output_column
	jnc	restart_line_edit
	dec	byte ptr help_output_column
	call	help_erase_cell
	jmps	erase_back_to_prompt
test_kill_line_key:
	cmp	al,15h
	jnz	test_retype_line_key
	call	help_retype_prefix
	pop	bx
restart_line_edit:
	mov	sp,word ptr help_editor_sp
	mov	dx,word ptr help_editor_buffer
	jmp	initialize_line_edit
test_retype_line_key:
	cmp	al,12h
	jnz	test_abort_line_key
retype_input_line:
	push	cx
	call	help_retype_prefix
	pop	cx
	pop	bx
	push	bx
	push	cx
retype_next_character:
	or	ch,ch
	jz	finish_line_retype
	inc	bx
	mov	cl,es:byte ptr [bx]
	dec	ch
	push	cx
	push	bx
	call	help_echo_char
	pop	bx
	pop	cx
	jmp	retype_next_character
finish_line_retype:
	push	bx
	mov	al,byte ptr help_retype_width
	or	al,al
	jz	resume_after_retype
	sub	al,byte ptr help_output_column
	mov	byte ptr help_retype_width,al
erase_deleted_character_cells:
	call	help_erase_cell
	dec	byte ptr help_retype_width
	jnz	erase_deleted_character_cells
resume_after_retype:
	jmp	continue_line_edit
test_abort_line_key:
	cmp	al,3h
	jnz	test_input_buffer_capacity
	mov	ax,ds
	mov	es,ax
	jmp	cancel_input_line
test_input_buffer_capacity:
	cmp	ch,cl
	jnc	read_next_line_character
	inc	bx
	mov	es:byte ptr [bx],al
	inc	ch
echo_input_character:
	push	cx
	push	bx
	mov	cl,al
	call	help_echo_char
	pop	bx
	pop	cx
read_next_line_character:
	jmp	preserve_line_edit_state
accept_input_line:
	inc	bx
	mov	es:byte ptr [bx],0dh
	pop	bx
	mov	es:byte ptr [bx],ch
	mov	es,word ptr help_editor_es
	mov	cl,0dh
	jmp	help_output_char
cancel_input_line:
	mov	es,word ptr help_editor_es
	mov	bx,word ptr help_editor_buffer
	mov	byte ptr 1h[bx],0h
	mov	sp,word ptr help_editor_sp
	ret

; -----------------------------------------------------------------------------
; Check the saved key first, otherwise poll direct console status.
; -----------------------------------------------------------------------------
help_key_pending:
	mov	ax,word ptr help_pending_key
	or	ax,ax
	jnz	return_key_status
	push	cx
	mov	dl,0feh
	mov	cl,6h
	call	help_editor_bdos
	pop	cx
	or	al,al
return_key_status:
	ret

; -----------------------------------------------------------------------------
; Write CL through BDOS 6, preserving CX.
; -----------------------------------------------------------------------------
help_raw_output:
	push	cx
	mov	dl,cl
	mov	cl,6h
	call	help_editor_bdos
	pop	cx
	ret

; -----------------------------------------------------------------------------
; Consume a saved key or wait for input, preserving extended-key state.
; -----------------------------------------------------------------------------
help_get_key:
	mov	ax,word ptr help_pending_key
	or	ax,ax
	jz	read_fresh_help_key
	cmp	byte ptr help_extended_key,0ffh
	jz	return_saved_scan_code
	or	al,al
	jnz	clear_saved_key
	mov	byte ptr help_extended_key,0ffh
	ret
return_saved_scan_code:
	mov	al,ah
clear_saved_key:
	mov	byte ptr help_extended_key,0h
	mov	word ptr help_pending_key,0h
	ret
read_fresh_help_key:
	call	help_wait_key
	or	al,al
	jnz	return_help_key
	mov	byte ptr help_extended_key,0ffh
	mov	word ptr help_pending_key,ax
return_help_key:
	ret

; -----------------------------------------------------------------------------
; Recognize CR, LF, TAB and BS; otherwise compare AL with space.
; -----------------------------------------------------------------------------
help_classify_char:
	cmp	al,0dh
	jz	return_character_class
	cmp	al,0ah
	jz	return_character_class
	cmp	al,9h
	jz	return_character_class
	cmp	al,8h
	jz	return_character_class
	cmp	al,20h
return_character_class:
	ret

; -----------------------------------------------------------------------------
; Poll for Ctrl-C abort and Ctrl-S pause; Ctrl-Q resumes output.
; Save other pending input for the line editor.
; -----------------------------------------------------------------------------
help_flow_control:
	call	help_key_pending
	jz	flow_control_complete
	call	help_get_key
	cmp	al,3h
	jnz	test_output_pause
	mov	word ptr help_pending_key,0h
	jmp	cancel_input_line
test_output_pause:
	cmp	al,13h
	jnz	save_pending_input_key
wait_output_resume:
	call	help_get_key
	cmp	al,3h
	jnz	test_output_resume_key
	mov	word ptr help_pending_key,0h
	jmp	cancel_input_line
test_output_resume_key:
	cmp	al,11h
	jnz	wait_output_resume
	xor	ax,ax
	mov	word ptr help_pending_key,0h
flow_control_complete:
	ret
save_pending_input_key:
	mov	word ptr help_pending_key,ax
	mov	al,0ffh
	ret

; -----------------------------------------------------------------------------
; Output CL unless retyping silently, then update the tracked column.
; -----------------------------------------------------------------------------
help_output_char:
	test	byte ptr help_retype_width,0ffh
	jnz	update_output_column
	call	help_flow_control
	call	help_raw_output
update_output_column:
	mov	al,cl
	cmp	al,7fh
	jz	output_character_complete
	inc	byte ptr help_output_column
	cmp	al,20h
	jnc	output_character_complete
	dec	byte ptr help_output_column
	jz	output_character_complete
	cmp	al,8h
	jnz	test_output_linefeed
	dec	byte ptr help_output_column
output_character_complete:
	ret
test_output_linefeed:
	cmp	al,0ah
	jnz	output_column_complete
	mov	byte ptr help_output_column,0h
output_column_complete:
	ret

; -----------------------------------------------------------------------------
; Echo controls as caret notation and expand tabs to eight-column stops.
; -----------------------------------------------------------------------------
help_echo_char:
	mov	al,cl
	call	help_classify_char
	jnc	test_tab_expansion
	push	ax
	mov	cl,5eh
	call	help_output_char
	pop	cx
	or	cl,40h
; Shared entry: CL contains a display character. Expand TAB, otherwise output it.
test_tab_expansion:
	cmp	cl,9h
	jnz	help_output_char
output_tab_space:
	mov	cl,20h
	call	help_output_char
	mov	al,byte ptr help_output_column
	and	al,7h
	jnz	output_tab_space
expanded_character_complete:
	ret

; -----------------------------------------------------------------------------
; Erase one display cell with backspace and space.
; -----------------------------------------------------------------------------
help_erase_cell:
	call	help_backspace
	mov	cl,20h
	call	help_raw_output

; -----------------------------------------------------------------------------
; Emit backspace through direct console output.
; -----------------------------------------------------------------------------
help_backspace:
	mov	cl,8h
	jmp	help_raw_output

; -----------------------------------------------------------------------------
; Print the retype marker and CR/LF, then indent to the original prompt column.
; -----------------------------------------------------------------------------
help_retype_prefix:
	mov	cl,23h
	call	help_output_char
	call	help_crlf
restore_prompt_indentation:
	mov	al,byte ptr help_output_column
	cmp	al,byte ptr help_prompt_column
	jnc	expanded_character_complete
	mov	cl,20h
	call	help_output_char
	jmps	restore_prompt_indentation

; -----------------------------------------------------------------------------
; Print CR/LF through the tracked console-output routine.
; -----------------------------------------------------------------------------
help_crlf:
	mov	cl,0dh
	call	help_output_char
	mov	cl,0ah
	jmp	help_output_char

; -----------------------------------------------------------------------------
; Wait for a key through BDOS 6, DL=FDh, preserving CX.
; -----------------------------------------------------------------------------
help_wait_key:
	push	cx
	mov	cl,6h
	mov	dl,0fdh
	call	help_editor_bdos
	pop	cx
	ret

; -----------------------------------------------------------------------------
; Print a dollar-terminated string from the stack segment, expanding tabs.
; -----------------------------------------------------------------------------
help_print_stack_string:
	mov	si,cx
	lodsb
	cmp	al,24h
	jz	expanded_character_complete
	inc	cx
	push	cx
	mov	cl,al
	push	ds
	push	ss
	pop	ds
	call	test_tab_expansion
	pop	ds
	pop	cx
	jmps	help_print_stack_string

; -----------------------------------------------------------------------------
; BDOS entry used by the local line editor.
; -----------------------------------------------------------------------------
help_editor_bdos:
	int	0e0h
	ret
code_padding	db	0h,0h,0h
