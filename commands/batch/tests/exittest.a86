        title 'BATCH EXIT - native shell status observer'
; The interactive PCTMP launches BATCH normally, including its nested children.
; This observer then reads that same parent's BDOS 108 result word. It must
; not nest a second waiting CLI parent between BATCH and PCTMP: BATCH shares
; its ancestor PCTMP's DOS translator and console lifecycle.
;
; PD offsets are verified against assembled kernel symbols by the driver.
; The producer uses real BDOS 108/0; no kernel or termination path is mocked.
        cseg
start:
        mov si,81h
        xor bp,bp
parse_status:
        lodsb
        cmp al,' '
        je parse_status
        cmp al,0dh
        je inspect_parent
        or al,al
        jz inspect_parent
        sub al,'0'
        xor ah,ah
        mov bx,bp
        shl bp,1
        shl bx,1
        shl bx,1
        shl bx,1
        add bp,bx
        add bp,ax
        jmps parse_status
inspect_parent:
        mov cl,156
        int 0e0h
        mov bx,es:1eh[bx]
        mov ax,es:2ch[bx]
        cmp ax,bp
        jne failed
        cmp ax,es:2ch[bx]
        jne failed
        mov dx,offset passed_message
        jmps report
failed:
        mov dx,offset failed_message
report:
        mov cl,9
        int 0e0h
        xor cx,cx
        xor dx,dx
        int 0e0h
        dseg
        org 100h
passed_message db 'BATCH EXIT PASS',13,10,'$'
failed_message db 'BATCH EXIT FAIL',13,10,'$'
        rs 256
        end start
