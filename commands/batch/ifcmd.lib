;*******************************************************************************
; BATCH IF - native existence predicates and bytewise string comparison.
;
; IF [NOT] EXIST filespec command
; IF [NOT] DIREXIST directory command
; IF [NOT] left==right command (double quotes protect spaces/empty operands)
;
; Runs after expand.lib and before ordinary command dispatch. A true test
; removes its prefix and redispatches the remaining command without another
; expansion pass. False/error tests consume the line. Nested IF is iterative.
;
; Filesystem access is native BDOS throughout. FAT paths use directory OPEN
; (drive bit 7), never INT 21h. OPEN "." first makes CAT/HDS private by the
; kernel's copy-on-write rules. Later directory opens reuse that sole-owner
; HDS in place. Save/restore its eight mapping bytes, never its owner count.
; The original drive, DMA and error mode are restored before dispatch.
;*******************************************************************************
; Local 4.1 CAT/HDS and UDA fields, shared with the existing BATCH directory
; switching code. Eight mapping bytes exclude the reference count at +8.
CONDITION_CAT_OWNERS equ 20h
CONDITION_HDS_OWNERS equ 8
CONDITION_HDS_CLUSTER equ 6
CONDITION_U_ERROR_MODE equ 10h
        cseg

; Carry clear: ordinary command remains in clicb_cmd. Carry set: skip line.
batch_condition:
        push ds ! pop es
condition_again:
        mov si,offset clicb_cmd
        call lang_spaces
        mov di,offset condition_if_word
        call lang_word
        jc condition_start
        clc
        ret
condition_start:
        mov condition_negate,0
        mov condition_directory,0
        call condition_require_space
        jnc condition_not
        jmp condition_syntax
condition_not:
        mov condition_left,si
        mov di,offset condition_not_word
        call lang_word
        jnc condition_predicate
        cmp byte ptr [si],' '
        je condition_negated
        cmp byte ptr [si],TAB
        je condition_negated
; NOT==NOT compares a literal word; NOT followed by whitespace negates.
        mov si,condition_left
        jmps condition_predicate
condition_negated:
        mov condition_negate,1
        call condition_require_space
        jnc condition_predicate
        jmp condition_syntax
condition_predicate:
        mov condition_left,si
        mov di,offset condition_exist_word
        call lang_word
        jnc condition_try_directory
        cmp byte ptr [si],' '
        je condition_operand
        cmp byte ptr [si],TAB
        je condition_operand
        jmp condition_compare_start
condition_try_directory:
        mov di,offset condition_directory_word
        call lang_word
        jc condition_directory_matched
        jmp condition_compare_start
condition_directory_matched:
        cmp byte ptr [si],' '
        je condition_is_directory
        cmp byte ptr [si],TAB
        je condition_is_directory
        jmp condition_compare_start
condition_is_directory:
        mov condition_directory,1
condition_operand:
        call condition_require_space
        jnc condition_copy_operand
        jmp condition_syntax
condition_copy_operand:
        mov di,offset condition_spec
condition_operand_next:
        lodsb
        or al,al
        jnz condition_operand_character
        jmp condition_syntax
condition_operand_character:
        cmp al,' '
        je condition_operand_end
        cmp al,TAB
        je condition_operand_end
        cmp al,'"'
        jne condition_operand_store
        jmp condition_syntax
condition_operand_store:
        stosb
        jmps condition_operand_next
condition_operand_end:
        xor al,al
        stosb
        call lang_spaces
        cmp byte ptr [si],0
        jne condition_has_command
        jmp condition_syntax
condition_has_command:
        mov condition_command,si
        call condition_probe
        cmp condition_error,0
        je condition_decide
        cmp condition_error,2
        je condition_bad_filespec
        mov dx,offset condition_io_message
        jmps condition_report
condition_bad_filespec:
        mov dx,offset condition_spec_message
        jmps condition_report
condition_decide:
        mov al,condition_result
        xor al,condition_negate
        or al,al
        jnz condition_execute
        stc
        ret
condition_execute:
        mov ax,condition_command
        sub ax,offset clicb_cmd
        call expand_shift_empty
        mov si,condition_command
        mov di,offset clicb_cmd
condition_move_command:
        lodsb
        stosb
        or al,al
        jnz condition_move_command
        sub di,offset clicb_cmd
        mov ax,di
        mov read_blen,al
        call batch_prepare
        jmp condition_again
condition_syntax:
        mov dx,offset condition_syntax_message
condition_report:
        call print_string
        call crlf
        stc
        ret

; String operands are spans of the expanded command buffer, not new strings.
; Delimiters are recognized only outside quotes. Quotes remain in the spans
; for DOS compatibility; comparison is bytewise, case-sensitive and has no
; numeric interpretation. No filesystem or other OS service is called here.
condition_compare_start:
        mov si,condition_left
        xor cx,cx
        xor dl,dl
condition_compare_left:
        mov al,[si]
        or al,al
        jnz condition_left_character
        jmp condition_syntax
condition_left_character:
        cmp al,'"'
        jne condition_left_not_quote
        xor dl,1
        jmps condition_left_advance
condition_left_not_quote:
        or dl,dl
        jnz condition_left_advance
        cmp al,' '
        je condition_left_end
        cmp al,TAB
        je condition_left_end
        cmp al,'='
        jne condition_left_advance
        cmp byte ptr 1[si],'='
        je condition_left_end
condition_left_advance:
        inc si
        inc cx
        jmps condition_compare_left
condition_left_end:
        or cx,cx
        jnz condition_left_present
        jmp condition_syntax
condition_left_present:
        mov condition_left_length,cx
        call lang_spaces
        cmp word ptr [si],'=='
        je condition_operator
        jmp condition_syntax
condition_operator:
        add si,2
        call condition_rhs_spaces
        jnc condition_rhs_present
        jmp condition_syntax
condition_rhs_present:
        mov condition_right,si
        xor cx,cx
        xor dl,dl
condition_compare_right:
        mov al,[si]
        or al,al
        jnz condition_right_character
        jmp condition_syntax
condition_right_character:
        cmp al,'"'
        jne condition_right_not_quote
        xor dl,1
        jmps condition_right_advance
condition_right_not_quote:
        or dl,dl
        jnz condition_right_advance
        cmp al,' '
        je condition_right_end
        cmp al,TAB
        je condition_right_end
condition_right_advance:
        inc si
        inc cx
        jmps condition_compare_right
condition_right_end:
        or cx,cx
        jnz condition_right_present
        jmp condition_syntax
condition_right_present:
        mov condition_right_length,cx
        call lang_spaces
        cmp byte ptr [si],0
        jne condition_compare_command
        jmp condition_syntax
condition_compare_command:
        mov condition_command,si
        mov condition_result,0
        mov cx,condition_right_length
        cmp cx,condition_left_length
        jne condition_compare_unequal
        mov si,condition_left
        mov di,condition_right
        push ds ! pop es
        cld
        repe cmpsb
        jne condition_compare_unequal
        mov condition_result,1
condition_compare_unequal:
        jmp condition_decide

; Whitespace around == is allowed, but an empty substituted token is not
; padding. Keep the missing right operand distinct from the following command:
; IF VALUE == %MISSING% ECHO wrong must be a syntax error, not VALUE==ECHO.
; Quotes/suffixes make a real nonempty operand and are handled by the lexer.
condition_rhs_spaces:
        cmp byte ptr [si],' '
        je condition_rhs_blank
        cmp byte ptr [si],TAB
        je condition_rhs_blank
        cmp byte ptr [si],0
        je condition_rhs_missing
        clc
        ret
condition_rhs_blank:
        mov bx,si
        sub bx,offset clicb_cmd
        cmp expand_empty_positions[bx],0
        jne condition_rhs_missing
        inc si
        jmps condition_rhs_spaces
condition_rhs_missing:
        stc
        ret

; Require a real separator, rejecting IF=, NOT= and EXIST= spellings.
condition_require_space:
        cmp byte ptr [si],' '
        je condition_spaces
        cmp byte ptr [si],TAB
        je condition_spaces
        stc
        ret
condition_spaces:
        call lang_spaces
        clc
        ret

; Evaluate a copied operand. Globals keep cleanup independent of BDOS register
; clobbers; no descriptor from a user file is opened or retained.
condition_probe:
        mov condition_error,0
        mov condition_result,0
        mov condition_mapping,0
        mov condition_fat,0
        mov cl,52
        call ccpm
        mov condition_dma_offset,ax
        mov condition_dma_segment,es
        mov cl,25
        call ccpm
        mov condition_saved_drive,al
        inc al
        mov condition_drive,al
        mov cl,156
        call ccpm
        mov es,es:P_UDA[bx]
        mov al,es:CONDITION_U_ERROR_MODE
        mov condition_error_mode,al
        mov dx,0ffh
        mov cl,45
        call ccpm
        mov dx,ds
        mov cl,51
        call ccpm
        mov dx,offset condition_dma
        call setbuf
        push ds ! pop es
        mov si,offset condition_spec
        cmp byte ptr 1[si],':'
        jne condition_drive_ready
        lodsb
        call lang_upper
        sub al,'A'
        cmp al,15
        jbe condition_explicit_drive
        jmp condition_invalid
condition_explicit_drive:
        inc al
        mov condition_drive,al
        inc si
condition_drive_ready:
        mov condition_cursor,si
condition_resolve_drive:
; Unbound N:/O:/P: mean the current system drive. Probe that physical drive
; instead of turning an implicit floating-drive default into a fixed mapping.
        cmp condition_drive,14
        jb condition_select_drive
        mov cl,156
        call ccpm
        mov bx,es:CAT[bx]
        or bx,bx
        jz condition_unbound_drive
        xor ah,ah
        mov al,condition_drive
        dec ax
        shl ax,1
        add bx,ax
        cmp es:word ptr [bx],0
        jne condition_select_drive
condition_unbound_drive:
        mov al,es:.S_DSYSDISK
        inc al
        mov condition_drive,al
condition_select_drive:
        xor dh,dh
        mov dl,condition_drive
        dec dl
        mov cl,14
        call ccpm
        or al,al
        jz condition_media
        jmp condition_io_error
condition_media:
        call condition_clear_fcb
        mov condition_fcb,'?'
        mov di,offset condition_dma
        mov cx,128
        xor al,al
        rep stosb
        mov dx,offset condition_fcb
        mov cl,17
        call ccpm
        cmp ah,0
        je condition_media_result
        jmp condition_io_error
condition_media_result:
        cmp condition_dma,20h
        jne condition_cpm
        cmp byte ptr condition_dma+15,80h
        jne condition_cpm
        mov condition_fat,1
        call condition_private_mapping
        jnc condition_path
        jmp condition_io_error
condition_cpm:
condition_path:
        mov si,condition_cursor
        cmp byte ptr [si],'\'
        je condition_absolute
        cmp byte ptr [si],'/'
        jne condition_component
condition_absolute:
        cmp condition_fat,1
        je condition_root
        jmp condition_missing
condition_root:
        inc si
        mov condition_cursor,si
        call condition_clear_fcb
        or condition_fcb,80h
        mov dx,offset condition_fcb
        mov cl,16
        call ccpm
        or al,al
        jz condition_component
        jmp condition_io_error
condition_component:
        push ds ! pop es
        mov si,condition_cursor
        mov condition_component_start,si
        mov condition_next,0
condition_component_scan:
        lodsb
        or al,al
        jz condition_component_final
        cmp al,'\'
        je condition_component_slash
        cmp al,'/'
        jne condition_component_scan
condition_component_slash:
        mov condition_next,si
        mov byte ptr -1[si],0
condition_component_final:
        call condition_parse_component
        jnc condition_component_ok
        jmp condition_invalid
condition_component_ok:
        cmp condition_next,0
        je condition_search
        cmp condition_fat,1
        je condition_enter_path
        jmp condition_missing
condition_enter_path:
        call condition_no_wildcards
        jnc condition_enter
        jmp condition_invalid
condition_enter:
        cmp byte ptr condition_fcb+1,' '
        je condition_next_component
        call condition_open_directory
        jnc condition_next_component
        jmp condition_open_failed
condition_next_component:
        mov si,condition_next
        mov condition_cursor,si
        jmp condition_component
condition_search:
        cmp condition_directory,0
        je condition_search_media_ready
        cmp condition_fat,1
        je condition_search_media_ready
        jmp condition_missing
condition_search_media_ready:
        cmp byte ptr condition_fcb+1,' '
        jne condition_search_name
; An explicit root or trailing separator denotes a directory, never a file.
        cmp condition_fat,1
        je condition_empty_fat
        jmp condition_missing
condition_empty_fat:
        cmp condition_directory,1
        je condition_empty_directory
        jmp condition_missing
condition_empty_directory:
        jmp condition_found
condition_search_name:
        cmp byte ptr condition_fcb+1,'.'
        jne condition_search_first
        cmp condition_fat,1
        jne condition_missing
        cmp condition_directory,1
        jne condition_missing
        call condition_open_directory
        jnc condition_found
        jmp condition_open_failed
condition_search_first:
        cmp condition_directory,0
        je condition_files_only
        or condition_fcb,80h
condition_files_only:
        mov dx,offset condition_fcb
        mov cl,17
        call ccpm
condition_search_result:
        cmp al,0ffh
        jne condition_entry
        or ah,ah
        jz condition_missing
        jmp condition_io_error
condition_entry:
        xor ah,ah
        mov cl,5
        shl ax,cl
        mov bx,offset condition_dma
        add bx,ax
        cmp byte ptr [bx],16
        jae condition_search_next
        cmp condition_directory,0
        je condition_found
        mov al,16[bx]
        cmp al,17[bx]
        jne condition_search_next
        and al,0c0h
        cmp al,0c0h
        je condition_found
condition_search_next:
        cmp condition_directory,0
        je condition_next_search_ready
        or condition_fcb,80h
condition_next_search_ready:
        mov dx,offset condition_fcb
        mov cl,18
        call ccpm
        jmps condition_search_result
condition_open_failed:
        or ah,ah
        jnz condition_io_error
        jmps condition_missing
condition_found:
        mov condition_result,1
condition_missing:
        jmp condition_cleanup
condition_invalid:
        mov condition_error,2
        jmp condition_cleanup
condition_io_error:
        mov condition_error,1
condition_cleanup:
        call condition_restore_mapping
        xor dh,dh
        mov dl,condition_saved_drive
        mov cl,14
        call ccpm
        or al,al
        jz condition_restore_dma
        mov condition_error,1
condition_restore_dma:
        mov dx,condition_dma_segment
        mov cl,51
        call ccpm
        mov dx,condition_dma_offset
        call setbuf
        xor dh,dh
        mov dl,condition_error_mode
        mov cl,45
        call ccpm
        push ds ! pop es
        ret

condition_clear_fcb:
        push ds ! pop es
        mov di,offset condition_fcb
        mov cx,36
        xor al,al
        rep stosb
        mov al,condition_drive
        mov condition_fcb,al
        mov di,offset condition_fcb+1
        mov cx,11
        mov al,' '
        rep stosb
        ret

; Parse a single 8.3 component with native function 152, insisting that the
; entire component was consumed. Dot/dot-dot are special directory names.
condition_parse_component:
        call condition_clear_fcb
        mov si,condition_component_start
        cmp byte ptr [si],0
        je condition_parse_ok
        cmp byte ptr [si],'.'
        jne condition_parse_native
        cmp byte ptr 1[si],0
        je condition_dot
        cmp byte ptr 1[si],'.'
        jne condition_parse_native
        cmp byte ptr 2[si],0
        jne condition_parse_native
        mov byte ptr condition_fcb+2,'.'
condition_dot:
        mov byte ptr condition_fcb+1,'.'
        jmps condition_parse_ok
condition_parse_native:
        mov condition_parse_packet,si
        mov dx,offset condition_parse_packet
        mov cl,152
        call ccpm
        or cx,cx
        jnz condition_parse_bad
        or bx,bx
        jnz condition_parse_bad
        cmp condition_fcb,0
        jne condition_parse_bad
        cmp byte ptr condition_fcb+1,' '
        je condition_parse_bad
        mov al,condition_drive
        mov condition_fcb,al
condition_parse_ok:
        clc
        ret
condition_parse_bad:
        stc
        ret
condition_no_wildcards:
        mov si,offset condition_fcb+1
        mov cx,11
condition_wildcard_scan:
        lodsb
        cmp al,'?'
        je condition_parse_bad
        loop condition_wildcard_scan
        clc
        ret
condition_open_directory:
; FAT root has no on-disk ".." entry. Its logical parent is itself.
        cmp byte ptr condition_fcb+1,'.'
        jne condition_open_native
        cmp byte ptr condition_fcb+2,'.'
        jne condition_open_native
        cmp byte ptr condition_fcb+3,' '
        jne condition_open_native
        mov bx,condition_mapping
        or bx,bx
        jz condition_open_native
        push es
        mov es,sysdatseg
        cmp es:word ptr CONDITION_HDS_CLUSTER[bx],0
        pop es
        jne condition_open_native
        xor ax,ax
        clc
        ret
condition_open_native:
        or condition_fcb,80h
        mov dx,offset condition_fcb
        mov cl,15
        call ccpm
        or al,al
        jz condition_open_ok
        stc
        ret
condition_open_ok:
        clc
        ret

; Force native copy-on-write before touching a directory mapping. A unique
; CAT and HDS cannot be changed by a parent/child while this predicate runs.
; Subsequent native directory OPENs reuse this HDS (BLACK opn1ae/opn1b).
condition_private_mapping:
        call condition_clear_fcb
        mov byte ptr condition_fcb+1,'.'
        call condition_open_directory
        jc condition_private_done
        mov cl,156
        call ccpm
        mov bx,es:CAT[bx]
        or bx,bx
        jz condition_private_bad
        cmp es:word ptr CONDITION_CAT_OWNERS[bx],1
        jne condition_private_bad
        xor ah,ah
        mov al,condition_drive
        dec ax
        shl ax,1
        add bx,ax
        mov bx,es:[bx]
        or bx,bx
        jz condition_private_bad
        cmp es:word ptr CONDITION_HDS_OWNERS[bx],1
        jne condition_private_bad
        mov condition_mapping,bx
        mov si,bx
        mov di,offset condition_mapping_bytes
        mov cx,4
condition_save_mapping_word:
        mov ax,es:[si]
        mov [di],ax
        add si,2
        add di,2
        loop condition_save_mapping_word
        clc
condition_private_done:
        ret
condition_private_bad:
        stc
        ret

; Restore only the eight mapping bytes. Counts and CAT links are owned by
; BDOS. No new process can inherit this transient mapping: dispatch is later.
condition_restore_mapping:
        mov di,condition_mapping
        or di,di
        jz condition_mapping_done
        mov es,sysdatseg
        cmp es:word ptr CONDITION_HDS_OWNERS[di],1
        jne condition_mapping_bad
        mov si,offset condition_mapping_bytes
        mov cx,4
        pushf
        cli
        rep movsw
        popf
        jmps condition_mapping_done
condition_mapping_bad:
        mov condition_error,1
condition_mapping_done:
        ret

condition_if_word db 'IF',0
condition_not_word db 'NOT',0
condition_exist_word db 'EXIST',0
condition_directory_word db 'DIREXIST',0
condition_syntax_message db 'IF [NOT] EXIST filespec command, DIREXIST directory command, or left==right command.$'
condition_spec_message db 'Invalid IF filespec; command skipped.$'
condition_io_message db 'IF cannot inspect drive or directory; command skipped.$'
