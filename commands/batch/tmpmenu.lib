po2:
			    inc bx ! jmp po1

order:
			mov si,offset fcb
			mov di,parseret
			cmp di,0 ! jne ok
			jmp doneprs
ok:
			    inc di
loop:
			    call parsefilename
			    mov parseret,bx
			    cmp cx,0 ! jz loop1
				jmp doneprs
loop1:
			    cmp bx,0 ! je starto
				mov al,[bx]
				cmp al,',' ! je starto
				cmp al,' ' ! je starto
				cmp al,9 ! je starto
				jmp ordererr
starto:
			    mov dx,0
			    mov di,offset typ
again:
			    mov si,offset fcb ! inc si
			    mov cx,2
			    call cmpit ! jz found

				inc dx ! mov ax,dx
				shl ax,1 ! shl ax,1
				mov di,ax ! add di,offset typ

				cmp dx,4 ! jne again
