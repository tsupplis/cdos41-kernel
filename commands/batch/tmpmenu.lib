on:	mov dl,'O' ! call prchar
	mov dl,'N' ! call prchar
	ret
off: 	mov dl,'O' ! call prchar
	mov dl,'F' ! call prchar
	mov dl,'F' ! call prchar
	ret




EJECT

transient:
	push ds ! pop es		; point es to ds

	mov drive,TRUE			; initialize drive to "was specified"
	cmp byte ptr fcb,0 ! jnz specfd	; if drive byte zero then set drive to
	    mov drive,FALSE		; "not specified".

specfd:
	call getdisk			; in case transient specifies default
	inc al ! mov fcbdrv,al		; make al one relative

	mov typspec,FALSE
	call whattype        		; check validity of type field.
	or al,al ! jz trans1 		; if type = blanks, then search type
	    mov typspec,TRUE

trans1:
	cmp typspec,TRUE ! jz notq
	cmp drive,TRUE ! je notq	; if drive specified, then not a queue
					; else try queue open
	    mov cl,Q_OPEN		; function 135
	    mov dx,offset qfcb		; point dx to queue area
	    call ccpm			; int 224
	    inc al ! jz notq		; check error code not queue-try rest of the types.
		mov drive,TRUE		; don't bother figuring in drive. 
		jmp cpmcli		; queue open was succesful-go to P_CLI.

notq:

   	; dma for password protected files

	mov dx,offset password
	call setbuf

;	push es
;	mov es,sysdatseg
;	mov al,es:.S_DSYSDISK
;	pop es
;	inc al
;	mov sysdsk,al

	mov cl,6
	mov bx,offset search_struct
	mov byte ptr [bx],0FFh
	mov dx,bx
	callf ms_func_jmp_addr

	mov cl,F_ERRMODE		; set error return mode
	mov dl,0FFh			; return and display mode
	call ccpm

	mov byte ptr ms_p_cli_struct+8,0	; indicate default user load

	mov count,0
	mov gdopen,FALSE

	cmp typspec,TRUE ! jne srchloop
	    mov dx,offset fcb
	    call openit		; type now specified, try to open
	    jmp openck
					; found it - break out of here

srchloop:
		call settype
		mov dx,offset fcb
		call openit
srchlp1:
	    cmp gdopen,TRUE ! jz openck
	    inc count ! mov cl,count
	    cmp cl,cnt ! jb srchloop

openck:
	mov cl,F_ERRMODE ! xor dl,dl
	call ccpm

	cmp gdopen,TRUE ! jz openckgd 
	jmp open_err

openckgd:
	    mov bx,offset fcb		; last character in type field 
	    mov al,byte ptr 11[bx]
	    and al,7FH			; mask off attribute bits
	    cmp al,'D' ! jnz notcpm		; is this a .CMD file?
		mov drive,TRUE
		jmp cpmcli			; else jmp to P_CLI

notcpm:
	mov al,byte ptr 9[bx]
	and al,7FH			; mask off attribute bit
        cmp al,'B' ! jnz trans5       	; is fcb a .BAT
					; not sub so simply call bruce



IF BATCH

	mov si,offset fcb		; internal fcb
	mov di,offset default_fcb	; default fcb in base page
	mov cx,6 ! rep movsw		; if command is BATCH command
	mov si,offset clicb_cmd		; then put command and tail into
	mov di,offset dma+1		; this base page - then reinitialize
	mov cx,127 ! rep movsb	 	; submit and jump into the new file.
	call batchinit
	mov sp,offset stack_top
	jmp nextcommand

ENDIF




IF TMP

	jmp invoke_batch		; invoke BATCH processor

ENDIF


trans5:


IF BATCH
	    mov dl,batch_priority
	    mov cl,P_PRIORITY
	    call ccpm
ENDIF


	    mov dx,offset password
	    call setbuf
	
	    mov read_blen,0			; leading 0
	    mov dx,offset clicb		; dx -> 0command0
	    mov cmdsent,TRUE		; did send a command
	    mov ms_cmd_sent,TRUE		; did send a dos command
	    mov batchflag,FALSE		; did not send a BATCH command

	    mov bx,offset ms_p_cli_struct
	    mov [bx],offset fcb
	    mov 2[bx],ds ! mov 4[bx],dx ! mov 6[bx],ds

	    mov dx,offset ms_p_cli_struct
	    mov cl,1			; ms_p_cli function
	    callf ms_func_jmp_addr		; call function translator

	    cmp bx,0 ! je get_nextcommand
		call clierror
		jmps get_nextcommand

open_err:
	mov drive,TRUE			; don't worry about handling drive for cli
	mov cx,E_BAD_OPEN
	call clierror

get_nextcommand:

	jmp nextcommand			; do it again


EJECT

extbltin:

	    push es ! push ds

	    push ds ! pop es

	    std
	    mov si,offset clicb_cmd + 132
	    mov di,si
	    add di,ax

	    mov cx,132
	    rep movsb
	    dec si
	    add byte ptr [si],al
	    cld

	    push cs ! pop ds
	    mov di,offset clicb_cmd
	    mov si,bx
	    mov cx,11
	    rep movsb

	    pop ds ! pop es
	jmp delret


EJECT

openit:
	call openfile
	inc al ! jz openit9
	jmp openit2

openit9:
	    cmp drive,TRUE ! jnz openit8
	    jmp openit1

openit8:

	    mov al,sysdsk
;	    cmp al,0FFh ! jz openit1

	    push es
	    mov es,sysdatseg
	    mov bx,es:S_RLR
	    test es:P_SFLAG[bx],08h
	    pop es
	    jnz openit1

		mov fcb,al
		mov dx,offset fcb

		call openfile
		inc al ! jz openit3

		    test byte ptr fcb+10,80h ! jnz openit4

			mov dx,offset fcb
			call closefile
			call getuser
			push ax ! mov dl,0
			call setuser
			mov dx,offset fcb

			call openfile
			inc al ! jnz openit6

			    test byte ptr fcb+10,80h ! jz openit7

				mov byte ptr ms_p_cli_struct+8,0FFh
				mov gdopen,TRUE
				mov al,fcb
				mov fcbdrv,al
;				mov dx,offset fcb
;				call closefile
				jmps openit5

openit7:
				mov dx,offset fcb
				call closefile

openit6:
			    mov fcb,0

openit5:
			pop dx
			call setuser
			jmps openit1

openit4:
			mov gdopen,TRUE
			mov al,fcb
			mov fcbdrv,al
;			mov dx,offset fcb
;			call closefile
			jmps openit1

openit3:
		    mov fcb,0
		    jmps openit1

openit2:
	    mov gdopen,TRUE
;	    mov dx,offset fcb
;	    call closefile

openit1:
	ret


EJECT

;------------------------------------------------------------------------------
;                          SUPPORT ROUTINES
;------------------------------------------------------------------------------


;------------------------------------------------------------------------------
;  whattype determines what type is specified in the last 3 bytes of the file
;  name.   if the type is blanks then we will have to use the search order.
;

whattype:
        mov bx,offset fcb+9
        cmp byte ptr [bx],' ' ! jnz what0
	mov al,0 ! jmp what3

what0:
	mov cx,4
what1:
	    push cx
	    mov dx,cx
	    dec dx
	    shl dx,1 ! shl dx,1
	    mov di,offset typ
	    add di,dx

	    mov si,offset fcb+9

	    push es
	    mov dx,cs ! mov es,dx
	    mov cx,3
	    repz cmpsb
	    pop es
	    pop cx

	    jz what2
	loop what1

	mov cx,E_BAD_TYPE
	call clierror
	jmp nextcommand

what2:
	mov al,1
what3:
        ret


EJECT

;------------------------------------------------------------------------------
; settype is used to fill in new type so that the cli can attempt to open the
; next file in the search order. The type is specified by the value of count
;
settype:
	mov di,offset fcb+9
	mov si,offset cmdtyp
	xor dx,dx ! mov dl,count
	add dl,count ! add dl,count
	add si,dx
	mov cl,3 ! rep movsb
        ret


EJECT

rcln:
	push	ds
	pop	es


IF BATCH

	call	sublin			;get line from submit i/o buffer

ENDIF




IF TMP	

;*** Have ^C reset disk system if hit during command input	*GLP*
	push	ds
	mov	ds,sysdatseg
	mov	di,S_RLR		; get our PD offset
	or	P_SFLAG[di],PSF_RESET	; turn on ^C to mean reset
	pop	ds

	mov	batchflag,FALSE
	mov	read_maxcmd,128		;get line from the console
	mov     cl,C_READSTR            ;read a line into clicb_cmd
	mov     dx,offset read_buf	;point to beginning of buffer
	call	ccpm			;int 224

	push	ds
	mov	ds,sysdatseg
	mov	di,S_RLR		; get our PD offset
	and	P_SFLAG[di],not PSF_RESET	; turn on ^C to mean abort
	pop	ds


ENDIF


gotlin:
	xor bh,bh
	mov bl,read_blen
	add bx,offset clicb_cmd			;bx -> eol

	mov di,bx

	mov cx,offset clicb_cmd+132
	sub cx,bx

	xor al,al
	rep stosb				;zero out rest of read buffer


IF BATCH

	mov delimit,0				;set string delimiter to 0
	mov dx,offset clicb_cmd			;dx -> command line
	call print_ds_string			;print string

	mov delimit,'$'

	cmp long_line,TRUE ! jne notll

	    mov dx,offset llerr
	    call print_string
	    mov long_line,FALSE
notll:

	mov dl,CR
	call prchar

ENDIF


	ret


EJECT

IF BATCH

sublin:

	call getbuf				;refresh the submit buffer
						; for each command
						;handles those that change the
						;BATCH file on the fly
	xor bl,bl				;bl = eol flag = FALSE
	xor ah,ah				;ah = command length = 0
	mov si,submit				;si = buffer pointer = submit
	mov di,offset read_buf+1		;di = command pointer = rb+1

subagn:
	    call movchar			;get character from file.
	    cmp submit,FALSE ! jnz contsub	;is submit done?
		xor cx,cx			;program. else continue
		mov dx,cx
		call ccpm

contsub:
	    cmp dl,CR ! jnz ntcr		;is character a carriage ret?
		mov bl,TRUE			;yes - eol = TRUE
		call movchar			;    and check for line feed
		cmp dl,LF ! jz iscrlf		;    if next char line feed
		    dec ah			;    destination pointer
		    dec si			;    if not line feed then
		    dec di			;    back off by decrementing
		    jmp donsub			;    pointers

iscrlf:
		    dec di
		    dec ah
		    jmp donsub

ntcr:
		cmp dl,LF ! jnz donsub		;is character line feed
		    mov bl,TRUE			;yes - eol = TRUE

donsub:
	inc bl ! jnz subagn			;is eol TRUE?

	dec di					;yes - ignore eol character
	cmp submit,FALSE ! jz dontcg		;did we reach end of file?
	    mov submit,si			;else update submit pointer

dontcg:
	mov bx,offset read_buf			;bx->command buffer

	mov al,255				;al = 255 
	mov [bx],ax				;ah = buffer length

	mov bx,ax ! xchg bh,bl

	xor bh,bh				;mov bx,ah 
	add bx,offset clicb_cmd-1		;bx->eos in command line

	mov byte ptr [bx],0			;insert 0 in command line

	ret


EJECT

;------------------------------------------------------------------------------
; movchar gets a character from the submit buffer and puts it into the command
; line. Movechar automatically handles % symbols by substituting the parameter
; for the %n where n represents the number of the parm in the command line.
;

movchar:
	inc si ! inc di					;increment buffer pointer, command line pointer
	inc ah						;increment buffer counter
	cmp eof,TRUE ! jne movchar1
	    mov submit,FALSE				;end of submit file
	    mov dl,' '
	    jmps notpct

movchar1:
	    cmp si,offset subbuf+128 ! jb bufok		;if si is past end of buffer
							;then get a new buffer else
		add subsavelow,1			;increment saved rrn's
		adc subsavehigh,0			;
		push bx
		call getbuf				;continue on.
		pop bx

bufok:
	    mov dl,byte ptr [si]			;dl gets next character
	    cmp dl,1ah ! jnz notend			;is it eof?
		mov eof,TRUE				;yes - terminate submit
		mov dl,CR				;put a carriage return in dl

notend:
	    cmp dl,'%' ! jnz notpct			;is it a percent sign?
		inc si					;yes - point si to parm number
		cmp si,offset subbuf+128 ! jb bufok1
							;if si is past end of buffer
		    add subsavelow,1			;increment saved rrn's
		    adc subsavehigh,0			;
		    push bx
		    call getbuf				;continue on.
		    pop bx

bufok1:
		mov dl,byte ptr [si]			;is parm number another %
		cmp dl,'%' ! jz notpct			;yes - continue
		    push si ! push bx
		    call subparm			;corresponding parameter
		    pop bx ! pop si			;restore buffer pointer
		    dec di				;do not put blank in com line
		    dec ah				;decrement pointers
		    ret					;return

notpct:
	cmp ah,081h ! jae notpct1
	    mov byte ptr [di],dl				;move character into com line
	    jmps notpct2
notpct1:
	    mov long_line,TRUE
	    dec ah
	    dec di
notpct2:
	ret						;(character is blank if eof)


EJECT

;------------------------------------------------------------------------------
; getbuf supplies the BATCH processor with a new buffer of commands when 
; needed. Getbuf does random i/o and opens and closes the BATCH file each
; time it is invoked.
;

getbuf:
	push ax

	mov dx,offset subbuf		;set dma to subbuf
	call setbuf				;

	call getuser

	push ax
	mov dl,subuser
	call setuser

	push di
	call	switchhd		;points us to correct sub directory
	pop di

	mov dx,offset subfcb		;try to open subfcb
	call openfile			;if it is not found, somebody
	pop dx				;restore default user

;	push dx				;save default user
;	push ax				;save open return code
;	call setuser
;	pop ax				;restore open return code
;	pop dx				;balance stack in case of error

	inc al ! jnz fndsub		;may have changed disks on us.
	    call setuser		;restore user
	    call switchhd		;restore sub directory for BDOS
	    mov dx,offset subnotfound		;if so then output message
	    call print_ds_string			;
	    xor cx,cx				;and terminate
	    xor dx,dx
	    call ccpm

fndsub:
	push dx				;save default user number

;	mov dl,subuser			;get BATCH file user number
;	call setuser

	mov bx,offset subfcb+33		;bx->low random rec number 
	mov dx,subsavelow			;dx = saved low rrn
	mov [bx],dx				;set low rrn

	add bx,2				;bx->high random rec number
	mov dl,subsavehigh			;dl = saved high rrn
	mov byte ptr [bx],dl		;set high rrn

	mov dx,offset subfcb		;dx->subfcb
	mov cl,F_READRAND			;
	call ccpm				;read record from subfcb

	push ax				;save error code
	mov dx,offset subfcb		;dx->subfcb
	mov cl,F_CLOSE			;close file
	call ccpm				;int 224
	pop ax				;balance stack

	pop dx				;restore default user number


	push ax				;save error code from read
	call setuser

	push di
	call	switchhd		;restore default sub directory
	pop di

	mov dx,offset clicb_cmd		;reset dma buffer
	call setbuf				;
	pop ax				;retrieve error code
	dec al! js reedok		;if 0 then read was ok
	    mov submit,FALSE		;else terminate submit
	    mov byte ptr subbuf,LF	;move line feed into buffer
reedok:
	mov si,offset subbuf		;reset si to beginning of buffer
	pop ax
	ret


EJECT

;------------------------------------------------------------------------------
; subparm is called during BATCH processing when a % is encountered. it is 
; with the next character in dl. subparm then reduces that character to a 
; number and inserts the corresponding parameter in the buffer subprm into
; the command line.	
;

subparm:
	sub dl,30h			;dl now a number
	mov si,offset subparms		;si -> subparms

sub2:
	cmp dl,0 ! jz fondit		;if dl = 0 then  si is pointing
					;to proper parm, else inc si
	    mov al,byte ptr [si]	;until another space is found,

	    cmp al,' ' ! jz nxtprm	;dec di and try again
	    cmp al,0 ! jnz goagn
nxtprm:
		dec dl
goagn:
	    inc si
	    jmp sub2			;di not zero yet

fondit:
	mov dl,byte ptr [si]		;now move parm into command line
	cmp dl,' ' ! jz subdon		;is dl a blank?
	cmp dl,0 ! jz subdon		;is dl a zero?
	    mov byte ptr [di],dl	;else move character into line
	    inc ah			;inc si, inc di and do it again
	    inc si ! inc di
	    jmp fondit

subdon:
	mov dl,' '			;when done with parm insert a
	ret				;blank at the end


EJECT

;------------------------------------------------------------------------------
; clearsub is called when the TMP realizes it will be processing a BATCH file.
; its purpose is to clear out the parameter buffer and command buffer.
;

clearsub:
	mov submit,offset subbuf+128
	mov al,0
	mov di,offset subparms
	mov cx,128
	rep stosb
	mov byte ptr subfcb+32,0
	ret


EJECT

;------------------------------------------------------------------------------
; initsub moves the BATCH fcb into subfcb and initializes the random record #
;

initsub:
	mov subsavehigh,0			;ran rec = 0
	mov subsavelow,0			;ran rec = 0 

	mov si,offset default_fcb		;si -> default fcb in base page
	mov di,offset subfcb			;di -> subfcb
	mov cl,9				;move 9 bytes
	rep movsb

	mov bx,051h
	cmp byte ptr 2[bx],0 ! je initsub1

	    mov passflg,TRUE

	    mov al,' ' ! mov cl,8
	    mov di,offset batpass
	    rep stosb

	    mov si,[bx]
	    mov di,offset batpass
	    mov cl,2[bx]
	    rep movsb

initsub1:

	cmp byte ptr subfcb,0 ! jnz cont_initsub	;if default drive - change to
							; correct drive number
	    call getdisk
	    inc al ! mov subfcb,al

cont_initsub:
	mov eof,FALSE			;end of file set to FALSE
	call getuser
	mov subuser,al			;save user number of submit file
	mov submit,offset subbuf-1
	ret


EJECT

;------------------------------------------------------------------------------
; BATCH init takes the command line (as it is received from the TMP or another
; copy of the BATCH processor) stores away the file name, and processes the 
; parameter list - storing each parameter in a table
;
batchinit:
	call clearsub		; else initialize submit buffers
	call initsub			; move fcb into subfcb and init rrn
	call	savehd			; save off current location of x.BAT
	mov cl,' '
	mov si,offset subparms      ; si->parameter buffer area
	mov bx,offset dma+1		; bx->command line
mrprms:
	mov al,byte ptr 0[bx]		; move character into al
	cmp al,end$string ! jz nomore	; this code parses the remaining
					; command line for a BATCH file.

;	    call separator ! jnz notdli		; it takes the command tail, converts

	    push cx
	    xor cx,cx ! mov cl,3
	    mov di,offset delimiters
	    repne scasb ! pop cx
	    jnz notdli

	    cmp cl,' ' ! jz wassp			; delimeters to a single space between
					; arguments, and stores it into a
	    mov al,' '			; buffer called subparms
notdli:
	    mov byte ptr [si],al	;
	    inc si			; this buffer will be used when
wassp:
	    inc bx			; commands in the BATCH file  
	    mov cl,al			; use %0, %1  etc.
	jmp mrprms

nomore:
	mov byte ptr [si],' '
	inc si
	mov byte ptr [si],0
	ret


EJECT		

;------------------------------------------------------------------------------
; checksub is called after each dos program in a BATCH file. Its purpose is to
; check the return code and, if necessary, ask the user if he wants to abort
; the job.
;

chksub:
	mov cl,5
	mov dx,0FFFFH			;get ms_retcode
	callf ms_func_jmp_addr

	cmp ax,0fffeh ! jz ctl_c	; was it an abnormal abort
	    ret				; no  - return
ctl_c:
	mov cl,5
	xor dx,dx
	callf ms_func_jmp_addr		; reset ms_retcode

	push si
	push word ptr delimit
	mov delimit,'$'
	call crlf			; output carriage return
dummy:
	mov dx,offset subcont
	call print_ds_string		; output message

	mov cl,C_RAWIO			; read character
	mov dl,0fdh				; from console
        call ccpm				; (use raw mode)

	cmp al,20H ! jb not_printable
	    mov dl,al				; echo character to
	    push ax				;
	    call prchar				; screen
	    pop ax

not_printable:

	push ax
	call crlf
	pop ax

	cmp al,3				; check for control-C
	je trmsub

	cmp al,'y'				; if al = y or Y then abort.
	je trmsub				; if al = n or N then continue

	cmp al,'Y'
	je trmsub

	cmp al,'N'
	je dontstp

	cmp al,'n'
	jne dummy				; bad character so get another

dontstp:
	pop word ptr delimit
	pop si
	ret

trmsub:
	mov submit,FALSE			; terminate submit - 
	mov sp,offset stack_top		; balance stack
	jmp nextcommand			; jmp to top of loop

ENDIF




EJECT


;------------------------------------------------------------------------------
; setbuf sets the dma to the address in dx
;

setbuf:
	mov cl,F_DMAOFF
      	push dx
	call ccpm			;dma offset

	mov cl,F_DMASEG
	mov dx,ds
	call ccpm			;dma segment

	pop dx

	ret

EJECT

;------------------------------------------------------------------------------
; closefile closes the file pointer to by dx 
;

closefile:

	push bx

	mov cl,F_CLOSE
	call ccpm

	pop bx

	ret


EJECT

;------------------------------------------------------------------------------
; openfile opens the file pointed to by dx in read-only mode
;

openfile:			; open FCB in DX
	push bx

	mov bx,dx
	or byte ptr 6[bx],80h

	cmp passflg,TRUE ! jne open1

	    mov cl,52			; Get rhe current DMA address
	    call ccpm

	    mov si,offset batpass	; Then move in the password
	    mov di,ax
	    mov cl,8
	    rep movsb

open1:

        mov cl,F_OPEN
        call ccpm

	pop bx

        ret


EJECT

IF BATCH

set_parents_pd:				;set byte in my pd and my parents pd 
	push bx				;according to offset in dx and value 
	push es				;in al.
	mov ax,bx			;
	mov es,sysdatseg		;es:bx points to address of 
	mov bx,68h			;ready list root.
	mov cx,es:word ptr [bx]		;es:cx points to my pd.
	mov bx,cx			;es:bx points to my pd 
	add bx,dx			;add offset into pd to bx.
	mov es:byte ptr [bx],al		;put byte in al into my pd.
	mov bx,cx			;es:bx points to my pd
	add bx,1eh			;offset of parent field
	mov cx,es:word ptr [bx]		;cx points to parents pd
	mov bx,cx			;
	add bx,dx			;es:bx points to proper field in 
	mov es:byte ptr [bx],al		;parents pd   -   insert value.
	pop es				;restore es
	pop bx				;restore bx
	ret

ENDIF



EJECT

print_string:	


IF BATCH

		mov si,0ffffh
		call print_ds_string
		mov si,0
		ret

ENDIF




IF TMP

		push ds
		mov ax,cs ! mov ds,ax
		call print_ds_string 
		pop ds ! ret

ENDIF




EJECT


IF BATCH

check_control:
		push dx
		mov cl,C_RAWIO ! mov dl,0FFH	;check for character typed
		call ccpm			;check for ^S, ^Q & ^C
		or al,al ! jz check_control_ret
		  cmp al,3 ! jne not_ctlc
got_ctlc:
		    call ctl_c
		    jmps check_control_ret
not_ctlc:
		  cmp al,13H ! jne check_control_ret	;is is ^S
not_ctlq:
		    mov cl,C_RAWIO ! mov dl,0FDH	;wait for ^Q char
		    call ccpm
		    cmp al,3 ! je got_ctlc
		    cmp al,11H ! jne not_ctlq	;try again
check_control_ret:
		pop dx
		ret

ENDIF


EJECT

prchar:


IF BATCH

		call check_control
		mov cl,C_WRITE ! call ccpm		;output the character
		call check_control
		ret

ENDIF




IF TMP

		mov cl,C_WRITE ! jmp ccpm

ENDIF




EJECT

p_dec:
		div cx
		push dx
		cmp p_dec_flg,TRUE ! je p_dec1
		or ax,ax ! jz p_dec_ret
p_dec1:
		mov p_dec_flg,TRUE		;printed a number
		mov dl,al			;so don't suppress blanks
		add dl,'0'
		call prchar
p_dec_ret:
		pop ax ! xor dx,dx
		ret


EJECT

print_dec:
		mov p_dec_flg,FALSE		;suppress leading zeros
		xor dx,dx
		mov cx,10000
		call p_dec
		mov cx,1000
		call p_dec
		mov cx,100
		call p_dec
		mov cx,10
		call p_dec
		mov dl,al
		add dl,'0'
		call prchar
		ret


EJECT

print_ds_string:


IF TMP

	mov 	cl,C_WRITEBUF 
	jmp	ccpm

ENDIF




IF BATCH

	mov	bx,dx	
more:	cmp	si,0ffffh
	jnz	notcs
	mov	dl,cs:byte ptr [bx]
	jmps	notds
notcs:	mov	dl,byte ptr [bx]
notds:	mov	ax,colcnt
	cmp	dl,delimit
	jz	dollar
	cmp	dl,13			;carriage return? if so reset col count
	jnz	notcr			;no - go on
	mov	ax,0			;reset column counter
notcr:	cmp	ax,8			;8 columns? if so reset col counter 
	jb	not8			;no - go on
	mov	ax,0			;
not8:	cmp	dl,9
	jnz	notab
;	call	outtab
	mov 	dl,20
notab:	push	bx
	push	ax
	call	prchar
	pop	ax
	pop	bx
	inc	bx
	jmps	more
dollar:	mov	colcnt,ax
	ret

outtab: cmp	al,0
	jz	tabout
	dec	al
	push	ax
	push	bx
	mov	cl,C_RAWIO
	mov	dl,' '
	call	ccpm
	pop	bx
	pop	ax
	jmps	outtab
tabout:	ret

ENDIF



clierr1:
clierr2:		

invoke_batch:	mov command,'C'		;This is the place where by stuffing in
		mov read_maxcmd,'H'	;the drive spec, the last 3 chars in
		mov read_blen,' '	;"BATCH " may have been lost previously.
		cmp byte ptr drive,FALSE ! jnz dont_insert_drive	;FALSE - no drive specified
		    push ds ! pop es
		    mov cx,132
		    mov di,offset clicb_cmd+132
		    mov si,di
		    dec si ! dec si
		    std			;move everything down 2 bytes in buffer
		    rep movsb
		    cld
		    mov al,fcbdrv		;get drive number
		    add al,'A'-1
		    mov byte ptr read_blen+1,al
		    mov byte ptr read_blen+2,':'
dont_insert_drive:
		lea dx,batch_cmd	;a drive. must blank it out if not
		mov batchflag,TRUE	;using it this time.
		jmps startearly		;don't issue prompt when done with .bat

cpmcli:
		mov dx,0ffffh 
		call drive_free

		mov dx,offset password ! call setbuf

IF BATCH

		mov dl,batch_priority
		mov cl,P_PRIORITY
		call ccpm

ENDIF


	   	mov command,0
		lea dx,command		;start with dx pointing two bytes early
		cmp drive,FALSE		;if I had to force in the drive 
		jz startearly		;then leave dx here
		inc dx ! inc dx		;else add 2 to dx.
		mov read_blen,0		;and zero out first byte
startearly:	mov cmdsent,TRUE	;command was sent
		mov cl,P_CLI		;
	    	call ccpm		;invoke P_CLI
		cmp bx,0 ! je noerr	;
		cmp batchflag,TRUE
;		jnz clierror
		jz blah
		call clierror
		jmp nextcommand
blah:
		mov batchflag,FALSE
		mov cx,E_NO_BATCH
;		jmp clierror
		call clierror
		jmp nextcommand

noerr:		mov drive,TRUE		;reinitialize drive flag
        	jmp nextcommand		;do it again


EJECT

;========
clierror:
;========
; Cli call unsuccesful, analyze and display err msg
;	input: CX = ERROR CODE

	mov si,(offset clierrtab)-4
nexterr:
	add si,4
	cmp cs:word ptr [si],0ffffh ! je unknownerr
	cmp cx,cs:[si] ! jne nexterr
unknownerr:
	mov dx,cs:2[si]
	; jmps showerr


showerr:	; Print Error String
;-------	; input: DX = address of Error
		;             string in CSEG
		;	 if DX=0 then NULL COMMAND

	cmp dx,0 ! jne perr
	    mov cmdsent,FALSE ! ret

perr:
	push dx ! call crlf

	mov dx,offset errstr ! call print_string

	pop dx ! call print_string ! call crlf

	mov dx,offset cmdstr ! call print_string

	mov dx,offset savebuf ! call print_ds_string ! call crlf

;	jmp nextcommand	
	ret


EJECT
;
;	REGISTER PARAMETERS
;
;	ENTRY	di: pointer to string
;
;	EXIT	di: points to nonblank char
;

deblank:
	    inc di
	cmp byte ptr [di],' ' ! jz deblank
	cmp byte ptr [di],TAB ! jz deblank
	cmp byte ptr [di],'=' ! jz deblank
	ret


EJECT

moveit:
	mov ax,cs ! push ds   ! push es  
	mov ds,ax ! mov es,ax 
	rep movsw 
	pop es ! pop ds 
	ret


EJECT

cmpit:
	push es
	mov ax,cs ! mov es,ax
	repz cmpsw
	pop es
	ret


EJECT
;
;		returns ax = address of next delimiter in command or zero
;

parsefilename:

	mov cx,F_PARSE
	mov bx,offset pcb
	mov [bx],di ! mov 2[bx],si
	mov dx,bx
	call ccpm

	push cx ! push es

	push ds ! pop es	; make es = ds
	mov cx,4
	mov si,offset fcb+16 ! mov di,offset password
	rep movsw

	pop es ! pop cx
	ret


EJECT

a_to_b:		;dl = 1st char, dh = 2nd char.
		;ch = highest order character (for minmem only)
		push cx ! push dx
		cmp dh,' ' ! jne atob2char
		    mov dh,dl ! mov dl,ch
		    mov ch,'0'
		cmp dh,' ' ! jne atob2char
		    mov dh,dl ! mov dl,ch	
atob2char:	cmp dh,'0' ! jb atoberr
		cmp dh,'9' ! ja atoberr
		cmp dl,'0' ! jb atoberr
		cmp dl,'9' ! ja atoberr
		cmp ch,'0' ! jb atoberr
		cmp ch,'9' ! ja atoberr

		    sub dh,'0' ! sub dl,'0'
		    sub ch,'0'	
		    mov ax,0 ! mov al,dl
		    push dx ! mov cl,10
		    mul cl 
		    mov si,ax
		    mov cl,100 ! mov al,ch
		    mul cl
		    add ax,si		
		    pop dx
		    mov dl,dh ! mov dh,0
		    add ax,dx
		    mov bx,ax ! jmps atobdon
atoberr:	mov bx,0ffffh 
atobdon:	    pop dx ! pop cx ! ret
prnum:		; dl = num (0-15)
		cmp dl,10 ! jb prnum_one
		    push dx
		    mov dl,'1' ! call prchar
		    pop dx ! sub dl,10
prnum_one:	add dl,'0'
		jmp prchar

EJECT

getuser:
	mov dl,0ffh
setuser:
	mov cl,DIR_USERNUM ! jmp ccpm

getrawchar:
	mov dl,0fdh ! mov cl,C_RAWIO ! jmps ccpm

setconsolenum:
	mov cl,C_SETNUM   ! jmps ccpm

setdisk:
	mov cl,DRV_SET    ! jmps ccpm

getdisk:
	mov cl,DRV_GET    ! jmps ccpm

setlist:
	mov cl,L_SETNUM   ! jmps ccpm

getlist:
	mov cl,L_GETNUM   ! jmps ccpm

attach:
	mov cl,C_ATTACHC  ! jmps ccpm

detach:
	mov cl,C_DETACHC  ! jmps ccpm

drive_free:
	mov cl,DRV_FREE   !;jmps ccpm

;====
ccpm:	; INTERFACE ROUTINE FOR SYSTEM ENTRY POINTS
