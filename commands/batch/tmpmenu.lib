

title 'Terminal Message Processor & PC-MODE - CCP/M-86 3.2'

;*****************************************************
;*
;*	Terminal Message Processor
;*
;*
;*	The TMP determines the user interface to CCP/M.
;*	Much of the interface is available though
;*	system calls.  This TMP takes advantage of
;*	as much as possible for simplicity.  The TMP
;*	could, for instance,  be easily modified to
;*	force logins and have non-standard defaults.
;*
;*	With a little more work, the TMP could do all
;*	command parsing and File Loading instead of
;*	using the CLI COMMAND FUNCTION.  
;*	Suggestions are given in the CCP/M-86 SYSTEM'S GUIDE.
;*
;*****************************************************
;*
;*	Generation Procedure
;*
;*	Generating RSP:
;*	  TMP flag TRUE; BATCH flag FALSE; CMD flag FALSE
;*	  RASM86 tmppc $lo
;*	  RASM86 ms $lo
;*	  LINK86 tmppc.rsp = tmppc,ms[data[max[0],origin[0]]]
;*
;*	Generating DEBUG SYSTEM:
;*	  TMP flag TRUE; BATCH flag FALSE; CMD flag TRUE
;*	  RASM86 tmppc $lo
;*	  RASM86 ms $lo
;*	  LINK86 tmppc = tmppc,ms[data[max[0]]
;*	  
;*	Generating BATCH.CMD:
;*	  TMP flag FALSE; BATCH flag TRUE; CMD flag TRUE
;*	  RASM86 tmppc $lo
;*	  LINK86 BATCH = tmppc[data[max[0]]
;*
;*****************************************************

;
;	Defines the compile time equ's for the Runmenu interface
;	Defines external code references satisified in Runmenu
;

ESC		equ	01bh	; Ascii Escape character



IF TMP

RUNMENU 	equ	TRUE	; True for generating Runmenu interfaced tmp
CCP		equ	TRUE	; True for generating VCCP interfaced tmp

ENDIF



IF BATCH

RUNMENU 	equ	FALSE	; False for generated non-Runmenu interfaced tmp
CCP		equ	FALSE	; False for generating non-VCCP interfaced tmp

ENDIF



IF RUNMENU

	EXTRN	M_GETCMD:near
	EXTRN	M_INIT:near
ENDIF



IF NOT BATCH

	EXTRN	ms_init:near
	EXTRN	ms_func:near

ENDIF

;	Some common equates

CR		equ	13		; carriage return
LF		equ	10		; linefeed
TAB		equ	9		; tab char
BLANK		equ	32		; blank character
dma		equ	.80h		; default dma buffer (batch)
default_fcb	equ	.5ch		; default fcb for batch

;	CCP/M-86 system functions used by the TMP

OSINT		equ	224		; interrupt number for CCP/M
					; system calls

C_READ		equ	1
C_WRITE		equ	2		; console functions
C_RAWIO		equ	6
C_WRITEBUF	equ	9
C_READSTR	equ	10
C_DELIMIT	equ	110
C_ATTACHC	equ	146
C_DETACHC	equ	147
C_SETNUM	equ	148

L_SETNUM	equ	160		; list device functions
L_GETNUM	equ	164

F_OPEN		equ	15		; file functions
F_CLOSE		equ	16
F_SFIRST	equ	17
F_SNEXT		equ	18
F_READ		equ	20
F_DMAOFF	equ	26
F_SIZE		equ	35
F_ERRMODE	equ	45
F_DMASEG	equ	51
F_TIMEDATE	equ	102
F_PARSE		equ	152
F_READRAND	equ	33

DRV_SET		equ	14		; drive functions
DRV_GET		equ	25
DRV_FREE	equ	39
DRV_SPACE	equ	46

DIR_USERNUM	equ	32		; directory functions

P_PRIORITY	equ	145
P_CLI		equ	150		; process control functions
P_PDADR 	equ	156		; get process descriptor address
P_ABORT		equ	157

Q_OPEN		equ	135

S_BDOSVER	equ	12

;	Some Process descriptor locations

P_PRIOR		equ	05h	;process descriptor priority
P_FLAG		equ	06h	;process descriptor flags
P_NAME		equ	08h	;process descriptor name
P_PARENT	equ	1Eh	;PD's parent
P_UDA		equ	10h	;PD's UDA segment
P_SFLAG		equ	word ptr 26h	;2nd set of flags

U_INITCS	equ	.50H
UDA_CS		equ	.50h	; offset in UDA of user's code segment

;	Process descriptor flags

PS_RUN		equ	00	; on ready list root
PF_SYS		equ	001h	; system process
PF_KEEP		equ	002h	; do not terminate

;	Process descriptor 2nd flags

PSF_CTLC	equ	0010h	; on if ^C has been entered in non-rawio
PSF_RESET	equ	0020h	; ^C means reset disk system

;	Media types

CPMMEDIA	equ	0
DOSMEDIA	equ	not CPMMEDIA


;	Some locations in the system data segment

S_CCPMSEG  equ	word ptr 40H	;begin CCPM segment
S_SYSDISK  equ  byte ptr 4Bh	;system disk
S_NCNS	   equ	byte ptr 47H    ;sys. consoles
S_RLR	   equ	word ptr .68h	;system ready list root
S_VERSION  equ	word ptr 78h	;ofst ver. str in SUP
S_DSYSDISK equ	byte ptr 9dh	;default system disk


;	Some RSP format equates

RSP_TOP	     equ  0
RSP_MD	     equ  008h
RSP_PD	     equ  010h
RSP_UDA	     equ  040h
RSP_BOTTOM   equ  140h


;	Error codes returned by the CLI

E_NO_MEMORY	   equ	3   ; cant find memory
E_NO_PD		   equ	12  ; no free pd's
E_Q_FULL	   equ	15  ; full queue
E_ILLCON	   equ	19  ; illegal console #
E_NO_PROC	   equ	20  ; no process descriptor match
E_NO_CONS_MATCH	   equ	21  ; no console match
E_ILLDISK	   equ	23  ; illegal disk #
E_BADFNAME	   equ	24  ; illegal filename
E_BADFTYPE	   equ	25  ; illegal filetype
E_BAD_LOAD	   equ	28  ; bad ret. from BDOS load
E_BAD_READ	   equ	29  ; bad ret. from BDOS read
E_BAD_OPEN	   equ  30  ; bad ret. from BDOS open
E_NULLCMD	   equ	31  ; null command sent
E_NOT_OWNER	   equ	32  ; no owner of resource
E_CANT_ATTACH	   equ  36  ; can not attach to process
E_ILL_LST	   equ	37  ; illegal list device
E_ILL_PASS	   equ	38  ; illegal password
E_ABORT            equ  40  ; aborted in CLI
E_BAD_TYPE   	   equ	60  ; bad file type
E_NO_BATCH	   equ  61  ; error opening BATCH processor
E_NOT_ENOUGH_MEM   equ  62  ; not enough memory to load program

EJECT

;*****************************************************
;*
;*	TMP Shared Code and Constant Area
;*
;*****************************************************

	cseg
codebeg:
	jmp start


IF NOT BATCH

	jmp ms_func

ENDIF


IF CCP

	dw	ccp_data		    ; Pointer to the ccp interface data

ENDIF


	db	'COPYRIGHT(C)1983,84,'
	db	'DIGITAL RESEARCH(05/23/84)'
	db	'XXXX-0000-654321'


IF BATCH

patch_code:
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop
	nop ! nop ! nop ! nop ! nop ! nop ! nop ! nop

ENDIF


if BATCH


	CSEG

switchhd:

	push	es
	mov	es,sysdatseg
	mov	bx,es:S_RLR
	add	bx,CAT
	mov	si,es:[bx]		; SI offset of batchs CAT
	cmp	hdmode,NOCAT
	je	switchcathds
	call	gethds
	cmp	hdmode,NOHDS
	je	switchcathds

			; hdmode is 2     ES:SI pt to 10 byte HDS
	mov	bx,8
	push di
	mov	di,offset savedhds
switchhd1:
	mov	ax,es:[si+bx]		; will xchg saved hds with current
	xchg	[di+bx],ax		; hds backwards
	mov	es:[si+bx],ax
	dec	bx
	dec	bx
	jnl	switchhd1
	pop di

	pop	es
	ret 

switchcathds:
			; SI contains the offset of the CAT or HDS
			; ES:BX pts CAT or HDS

	xchg	cathds,si
	mov	es:[bx],si
	pop	es
	ret


savehd:

	mov	cathds,0		; value if no CAT or HDS exists
	mov	hdmode,NOCAT		; default (used to save code)
	push	es
	mov	es,sysdatseg
	mov	bx,es:S_RLR
	mov	si,es:CAT[bx]		; SI offset of batchs CAT
	cmp	si,0
	je	snocat			; save the fact we have no CAT

	call	gethds			; enter -> SI offset of CAT
	cmp	si,0
	je	snohds			; save the fact we have no HDS

		; ES:SI pts to 10 byte HDS

	mov	hdmode,HAVEHDS
	mov	ax,ds
	push	es
	pop	ds
	mov	es,ax
	mov	cx,5
	mov	di,offset savedhds
	rep	movsw
	mov	ds,ax
snocat:
			; 1) hdmode set  2) ES on stack  3) HD saved
	pop	es

	ret

snohds:
	mov	hdmode,NOHDS
	jmps	snocat

gethds:
	mov	al,subfcb
	dec	al
	xor	ah,ah
	shl	ax,1
	add	si,ax
	mov	bx,si
	mov	si,es:[si]
	ret

endif


start:


IF CMD or BATCH

	mov	ax,ds			;set up stack in my ds 
	pushf
	pop 	bx
	cli				;no interrupts!
	mov	ss,ax			;ss -> ds
	mov	sp,offset stack_top	;sp -> top of stack
	push 	bx
	popf				;interrupts back on
 

IF BATCH

	mov	cl,S_BDOSVER		;get version number
	call	ccpm
	and	bh,not 2		;strip network bit
	cmp	bh,14h! jz okvers	;CCP/M?
	  mov	dx,offset wrongvers
	  mov	si,0
	  call	print_ds_string
	  xor	cx,cx
	  mov	dx,cx
	  call	ccpm
okvers:

ENDIF


	;
	; set priority better than parent
	;

	push	es
	mov	cl,P_PDADR
	call	ccpm
	mov	sysdatseg,es
	mov 	bx,es:P_PARENT[bx]	;get our parent's PD address
	xor	dh,dh
	cmp	bx,0! jne psetpar	;see if parent exists
	  mov 	dl,197! jmps setp	;  no parent - set to better than TMP
psetpar:
	mov	dl,es:P_PRIOR[bx]	;get parents priority
	dec	dl			;set to one better
	cmp	dl,64! jae setp
	  mov	dl,64			;don't compete with the system
setp:


IF BATCH

	mov	batch_priority,dl

ENDIF


	mov	cl,P_PRIORITY		;set priority
	call	ccpm
	pop	es


IF NOT BATCH

	call	ms_init			;initialize bruce only if CMD

ENDIF


	mov	ms_func_seg,cs



IF BATCH

	call batchinit		;initialize BATCH buffers and fcb
	push es
	mov es,sysdatseg
	mov di,es:S_RLR
scan_again:
	push di
	add di,8		;point to name field
	mov si,offset PCTmp
	mov cx,5
	repe cmpsb
	pop di
	or cx,cx
	jz found_pd
	  mov di,es:.P_PARENT[di]
	  or di,di
	  jnz scan_again
	  jmps pd_not_found

found_pd:
	mov es,es:.P_UDA[di]
	mov ax,es:U_INITCS
	mov ms_func_seg,ax
	pop es	
	jmp  nextcommand

pd_not_found:
	pop es
	mov dx,offset no_pcmode
	mov si,0
	call print_ds_string
	xor cx,cx
	mov dx,cx
	call ccpm

ENDIF


	jmp nextcommand

ENDIF




;===
go:	; PROGRAM MAIN - INITIALIZATION
;===

	mov ms_func_seg,cs	

;	Set default console # = TMP#

	mov dl,defconsole ! call setconsolenum


;	Set default disk = system drive

	push ds
	mov ds,sysdatseg
	mov dl,.S_DSYSDISK
	pop ds				;get default system drive from

	call setdisk			;system data segment


IF TMP

	xor dl,dl			;all TMPs come up user 0
	call setuser
  
	call attach			;print version

	push ds

	mov ds,sysdatseg

	mov dx,.S_VERSION
	mov ds,.S_CCPMSEG

	call print_ds_string
	pop ds

ENDIF




IF NOT BATCH

	call ms_init			;initialize function translator

ENDIF




IF TMP

	call detach

ENDIF




IF BATCH

	call batchinit

ENDIF




IF TMP

;
;		Startup code
;		Depending on console number, we try to open the startup
;		file.  If not sucessful, bag it.  If we find it, close
;		the file and point the TMP command buffer to the file
;		name and set the command ready flag.  Startup files are
;		now bat files so they work as a command as well as a batch.
;
	xor bx,bx		; clear hi bits
	mov bl,defconsole	; our console number
	shl bx,1

	mov si,offset fcb	; fcb to open the file
	mov di,startup_tab[bx]	; source file name for our console
	call parsefilename	; parse the name into our fcb

	mov dx,offset fcb	; now try to open the file
	mov cl,F_OPEN		;
	call ccpm		;

	test al,0ffh		; see if we got it open
	jnz nostartup		; jmp if not
	    mov dx,offset fcb		; close the file
	    mov cl,F_CLOSE
	    call ccpm

	    xor bx,bx			; clear hi bits
	    mov bl,defconsole		; get our console number again
	    shl bx,1			; adjust for table
	    mov ax,startup_tab[bx]	; get address of file name again

	    mov CUR_PTR,ax		; store as current command
	    push ds			; and store the segment
	    pop CUR_SEG			; address into command pointer
	    mov cmd_ready,TRUE		; and set command ready flag

ENDIF




IF	0				; delete this code (in case we blow it)

	push ds ! pop es
	mov si,offset pd_ascii_num
	mov di,offset startupnum
	mov cx,3
	rep movsb

	mov dx,offset fcb
	mov cl,F_OPEN			;try to open the startup file
	call ccpm			;on default drive which is
	cmp al,0ffh			;the system drive
	je nostartup
	    mov dx,offset clicb_cmd	;use the CLI buffer for this
	    mov cl,F_DMAOFF		;one time one sector read
	    call ccpm
	    mov dx,offset fcb
	    mov cl,F_READ
	    call ccpm
	    push ax
	    mov dx,offset fcb
	    mov cl,F_CLOSE
	    call ccpm
	    pop ax
	    test al,al
	    jnz nostartup
		mov ax,ds
		mov es,ax
		mov al,CR
		mov cx,128
		mov di,offset clicb_cmd
		repne scasb
		jne nostartup		;didn't find a carriage return
		    inc di			;include CR LF in line
		    mov byte ptr [di],'$'
		    sub di,offset clicb_cmd
		    mov ax,di
		    sub ax, 2
		    mov read_blen, al
		    mov dx,offset supmsg
		    call print_string
		    mov dx,offset clicb_cmd
		    call print_ds_string
		    jmps startup

ENDIF


nostartup:
		; THIS IS WHERE A LOGIN ROUTINE MIGHT
		; BE IMPLEMENTED.  THE DATA FILE THAT
		; CONTAINS THE USER NAME AND PASSWORD
		; MIGHT ALSO CONTAIN AN INITIAL DEFAULT
		; DISK AND USER NUMBER FOR THAT USER.


EJECT

;===========
nextcommand:	; LOOP FOREVER
;===========

		; free drive
	    mov dx,0ffffh ! call drive_free

		; attach console
	    call attach
	    
	    mov cl,0			;execute code to clean up translator
	    callf ms_func_jmp_addr
	    cmp ms_cmd_sent,TRUE	;if this command was sent to the int 21
	    jnz not_ms			;translator, and terminated abnormally,
	        mov ms_cmd_sent,FALSE


IF BATCH

		cmp submit,0 
		jz not_ms		;if abnormal abort and within bat file,
		    call chksub		;ask user if he wants to abort whole job

ENDIF


not_ms:					;print CR,LF if we just sent command



IF RUNMENU

;
;		Get the next command from user or menu system
;
	call getuser		    ; copied from TMP
	mov diskuserb+1,bl	    ; save default user number
	call getdisk		    ; get default drive
	mov diskuserb,bl	    ; save default drive


	call M_GETCMD		    ; get a command from DMENU


	jmp delret		    ; join code in progress

ENDIF




IF TMP

;	    cmp batchflag,TRUE ! jne notbatch
;	        mov cmdsent,FALSE  ! jmp noprompt

ENDIF




IF NOT RUNMENU

notbatch:   cmp cmdsent,FALSE   ! je noclearline
		mov cmdsent,FALSE
		call crlf
noclearline:

					; set up and print user prompt
					; get current default user # and disk
					; this call should be made on every
					; loop in case the last command
					; has changed the default.
					; (unless we just returned from the
					; BATCH processor.)
	    mov dl,CR ! call prchar
	    call getuser


IF TMP

	    mov diskuserb+1,bl		;save default user number

ENDIF




IF BATCH

	    mov dx,13h			;address of user in pd
	    call set_parents_pd		;set pd in TMP

ENDIF


	    test bl,bl ! jz nozero	;don't print user 0 prompt
	    mov dl,bl ! call prnum
nozero:
	    call getdisk


IF TMP

	    mov diskuserb,bl		;save default drive

ENDIF




IF BATCH

	    mov dx,12h			;address of drive in pd
	    call set_parents_pd		;set pd in TMP	

ENDIF


	    mov dl,'A' ! add dl,bl
	    call prchar	
	    mov dx,offset prompt
	    call print_string


EJECT

					; Read Command from Console or Bat file.
noprompt:
	    call rcln
startup:
		; echo newline
	    mov dl,LF ! call prchar
;
;		Code added for RUNMENU
;

ENDIF




IF RUNMENU

startup:

ENDIF


;
;		End code added for RUNMENU
;


EJECT

delret:
	    mov bx,offset clicb
	    xor cx,cx
	    mov cl,read_blen
strp:
	    mov si,bx ! add si,cx
	    cmp byte ptr [si],' ' ! jne strpdne
		dec cx ! mov read_blen,cl
		mov byte ptr [si],0
		jmp strp

strpdne:
	    
		; make sure not a null command
	    lea bx,clicb_cmd
	    cmp read_blen,0 ! jne delret1
	    jmp gonextcmd
delret1:
		mov di,bx
		dec di
		call deblank
		mov bx,di
		cmp byte ptr [bx],0	;if command is blanks only then skip
		je gonextcmd		;over it.
noblanks:	
	    lea ax,clicb_cmd ! cmp ax,bx ! je chksemi
			; remove leading blanks
		push ds ! pop es ! xor ch,ch ! mov cl,read_blen
		mov di,ax ! mov si,bx ! cld ! rep movsb
		mov bx,ax
chksemi:		; see if line starts with semicolon or period
	    cmp byte ptr [bx],';' ! je gonextcmd
	    cmp byte ptr [bx],'.' ! je gonextcmd	
;
;		Code for CCP/VCCP command interface
;		    If CCP is active and command is ESC only
;		    then we substitute the command: VCCP for the escape
;


IF CCP

		cmp byte ptr read_blen+2,0 ; is command 1 byte long?
		jne not_ccp		; jump if not
		cmp byte ptr [bx],ESC	; is first (and only) char an escape?
		jne not_ccp		; jump if not
		test CCP_ACT,0ffh	; see if ccp is active
		jz not_ccp		; jump if not
		mov cx,VCCP_LEN 	; it's true, make the substitution
		mov si,offset VCCP_CMD	; set source
		mov di,offset read_buf	; and destination
		push ds ! pop es	; make es = ds
		rep movsb		; and move them bytes
not_ccp:

ENDIF


			; see if disk change
			; if 'X:' change def disk to X
		    cmp byte ptr read_blen+3,0 ! jne clicall
		    cmp byte ptr 1[bx],':'
		    jne clicall

				; change default disk
			mov dl,[bx]	;get disk name
			and dl,5fh	;Upper Case
			sub dl,'A'	;disk number

				; check bounds
			cmp dl,0 ! jb baddrive
			cmp dl,15 ! ja baddrive

				; select default disk
			    call setdisk
			    cmp al,0 ! je gonextcmd

baddrive:   mov dx,offset errstr ! call print_string
	    mov dx,offset fdrverr ! call print_string ! call crlf

gonextcmd:  jmp nextcommand


EJECT

;=======
clicall:	; SEND CLI COMMAND
;=======
			; put null at end of input
		    mov bx,offset clicb_cmd
		    mov al,read_blen ! mov ah,0
		    add bx,ax ! mov byte ptr [bx],0

			; copy command string for error
			; reporting later and to check
			; for built in commands...
		    mov cx,64
		    mov si,offset clicb_cmd
		    mov di,offset savebuf
		    push ds ! pop es
		    rep movsw

			; parse front to see if
			; built in command
		    mov si,offset fcb
		    mov di,offset savebuf
		    call parsefilename
		    jcxz goodparse
			sub bx,bx ! mov bl,read_blen
			add bx,offset savebuf
			mov byte ptr [bx],'$'
		        call clierror
			jmp nextcommand

;			jmp clierror


goodparse:

		    mov parseret,bx
		    cmp bx,0 ! jne haveatail
			mov bl,read_blen
			add bx,offset savebuf
haveatail:
		    mov byte ptr [bx],'$' ! inc bx
try_typ:
		    cmp fcb+9,' ' ! je try_drv
			jmp transient
try_drv:
		    cmp fcb,0 ! je try_builtin
			jmp transient
			; is it USER command?

parser:		    mov si,offset fcb ! inc si
		    push cs ! pop es
		    mov cx,9 ! repz cmpsb
		    ret


EJECT
try_builtin:


IF RUNMENU OR BATCH

;
;		Search for RUNMENU command
;
	mov di,offset rmenutext     ;
	call parser		    ; is it RUNMENU?
	jnz rmenu_not_active2	    ; no

start_menu:
	call M_INIT		    ; activate RUNMENU
	jmp nextcommand 	    ; and get another command

rmenutext     db  'RUNMENU  '

ENDIF




IF BATCH

;
;		Batch version of menu initialization.
;		We find the TMP, there is a pointer in bytes 6 & 7 of code seg
;		to a reserved area in the TMP data area.  Byte 1 of
;		this area is a flag called CMD_READY which causes
;		the TMP to assume that there is a command ready for processing
;		in the buffer pointed to by bytes 2 through 5 in the same area.
;		We move the command to that buffer and set the pointers so
;		the TMP will process the command instead of us.
;
M_INIT:
	mov cl,P_PDADR		    ;
	call ccpm		    ; get our process descriptor
m_init_05:
	mov di,es:P_PARENT[bx]	    ; get our parent's PD addr
	mov ax,es:P_NAME[di]	    ; get our parent's Name
	cmp ax,'CP'		    ; see if PCTmp
	je m_init_10		    ; ok so far

m_init_07:
	mov bx,di		    ; not the tmp, go back a level
	jmp m_init_05		    ;

m_init_10:
	mov ax,es:P_NAME+2[di]	    ; check next 2 bytes
	cmp ax,'mT'		    ;
	jne m_init_07		    ; jmp if not the tmp

	mov ax,es:P_UDA[di]	    ; get the tmp's UDA
	mov es,ax		    ; to a segment address
	mov bx,es:UDA_CS	    ; get code segment of TMP
	mov es,bx		    ; to segment register
	mov bx,es:.6		    ; offset to CCP_DATA in TMP data area
	sub ax,4		    ; subtract 4 paragraphs from UDA to get
				    ; start of TMP data area
	mov es,ax		    ; get TMP data area into segment reg
	mov es:byte ptr .1[bx],TRUE ; set command ready flag
	mov cx,130		    ; 130 byte buffer in TMP data area
	mov si,offset clicb_cmd     ; source (the command)
	mov di,es:.6[bx]	    ; option buffer address in TMP data area
	mov es:.2[bx],di	    ; store offset
	mov es:.4[bx],es	    ; store the segment
	rep movsb		    ; move them bytes
	ret			    ; return to caller

ENDIF




