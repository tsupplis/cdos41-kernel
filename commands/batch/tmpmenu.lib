			    cmp bx,FALSE ! jne ordererr
m1:
				mov si,dx
				shl si,1 ! shl si,1
				add si,offset typ

				xor ax,ax ! mov al,tcnt
				add al,tcnt ! add al,tcnt
				mov di,ax ! add di,offset ttype

				push es ! mov ax,ds
				mov es,ax
				push ds ! mov ax,cs
				mov ds,ax
				mov cx,3 ! repz movsb
				pop ds ! pop es

				inc tcnt
				jmp order

doneprs:
			cmp tcnt,0 ! jz prorder
			    push es ! mov ax,ds
			    mov es,ax
			    mov si,offset tcnt
			    mov di,offset cnt
			    mov cx,7 ! repz movsw
			    pop es

			    mov tget,00h
			    mov cl,6 ! mov dx,offset tget
			    callf ms_func_jmp_addr	;set new structure

			    jmps prorder
ordererr:
