			    mov ax,ds ! mov es,ax
			    xor ax,ax ! mov bx,FALSE
while:
			    cmp bx,FALSE ! jne movetyp
			    cmp al,tcnt ! je movetyp
				mov si,offset fcb ! inc si
				mov di,ax ! add di,ax
				add di,ax ! add di,offset ttype
				mov cx,3
				repz cmpsb ! jne retval
				    mov bx,TRUE
retval:
				inc al ! jmps while
movetyp:
