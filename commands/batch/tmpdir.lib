delimit		db	'$'

batchflag	db	0

drive		db	0
disk		db	0			;subflag in emulator data area
fcbdrv		db	0

typspec		db	FALSE
gdopen		db	FALSE

next_sub        dw      0
knownptr        dw      0
end$string      db      0

