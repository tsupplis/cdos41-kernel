 	dw	-1			;DOS disk flag
	rb	27
DPB9:           	
 	dw	-1			;DOS disk flag
	rb	27
                                            
DPB10:           	
 	dw	-1			;DOS disk flag
	rb	27
                                            
DPB11:           	
 	dw	-1			;DOS disk flag
	rb	27
                           
DPB12:           	
 	dw	-1			;DOS disk flag
	rb	27

