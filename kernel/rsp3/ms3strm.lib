; MS3 - DOS redirection byte-stream adapter.
; Shares the MS1 record buffer and restores the caller's DMA on exit.

; DI points to a local DOS byte-record FCB. Return AH=0 on success,
; AH=1 at EOF, AH=5 for an error; AL is the byte. Saved DOS register
; frames are untouched, so console functions can call this directly.
stream_read_byte:
	mov stream_operation,0
	jmps stream_byte_entry
stream_write_byte:
	mov stream_operation,1
	mov stream_byte,cl
stream_byte_entry:
	push bx ! push cx ! push dx ! push si ! push di ! push es
	mov stream_fcb,di
	mov ax,last_dmaadr ! mov stream_dma,ax
	mov ax,last_dmabase ! mov stream_dma+2,ax
	cmp stream_operation,0 ! jne stream_find_fcb
	mov ax,es:MS_RAN_REC+2[di]
	cmp ax,es:MS_FILE_SIZE+2[di] ! jb stream_find_fcb
	jbe $+5
	jmp stream_byte_eof
	mov ax,es:MS_RAN_REC[di]
	cmp ax,es:MS_FILE_SIZE[di] ! jb $+5
	jmp stream_byte_eof
stream_find_fcb:
	push ds ! pop es
	call find_fcb_pub
	jnc $+5
	jmp stream_byte_error
	mov cpm_fcb,si
	mov di,stream_fcb
	mov ax,MS_RAN_REC[di]
	mov dx,MS_RAN_REC+2[di]
	mov bx,ax
	and bx,7fh
	mov stream_index,bx
	mov cx,7
stream_record_shift:
	shr dx,1 ! rcr ax,1
	loop stream_record_shift
	mov CPM_RAN_REC[si],ax
	mov CPM_RAN_REC+2[si],dl
	call activate_buffer
	cmp stream_operation,0 ! jne stream_write_buffer
	or al,al ! jz $+5
	jmp stream_byte_error
	mov bx,stream_index
	mov al,byte ptr buffer[bx]
	mov stream_byte,al
	jmps stream_advance
stream_write_buffer:
	or al,al ! jz stream_buffer_ready
	cmp al,1 ! je stream_new_record
	cmp al,4 ! je $+5
	jmp stream_byte_error
stream_new_record:
	lea di,buffer
	push ds ! pop es
	mov cx,128
	xor ax,ax
	cld
	rep stosb
	mov buffer_activeb,TRUE
	mov dl,0ffh
	call get_set_user
	mov buffer_user_no,al
stream_buffer_ready:
	mov bx,stream_index
	mov al,stream_byte
	mov byte ptr buffer[bx],al
	mov buffer_writtenb,TRUE
	mov si,cpm_fcb
	mov cpm_written[si],TRUE
	cmp first_write,TRUE ! jne stream_advance
	call flush_buffer
	or al,al ! jz $+5
	jmp stream_byte_error
	mov first_write,FALSE
stream_advance:
	mov di,stream_fcb
	add word ptr MS_RAN_REC[di],1
	adc word ptr MS_RAN_REC+2[di],0
	cmp stream_operation,0 ! je stream_byte_success
	mov dx,MS_RAN_REC+2[di]
	mov ax,MS_RAN_REC[di]
	cmp dx,MS_FILE_SIZE+2[di] ! jb stream_byte_success
	ja stream_extend_size
	cmp ax,MS_FILE_SIZE[di] ! jbe stream_byte_success
stream_extend_size:
	mov MS_FILE_SIZE[di],ax
	mov MS_FILE_SIZE+2[di],dx
stream_byte_success:
	mov al,stream_byte
	xor ah,ah
	jmps stream_byte_restore
stream_byte_eof:
	mov ax,011ah
	jmps stream_byte_restore
stream_byte_error:
	mov ax,051ah
stream_byte_restore:
	push ax
	les dx,dword ptr stream_dma
	call set_dma_ptr
	pop ax
	pop es ! pop di ! pop si ! pop dx ! pop cx ! pop bx
	ret


