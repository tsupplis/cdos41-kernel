; MS3 - enhanced DOS video dispatch, register results and mode table.
; Enhanced graphics packets preserve the DOS colour/page registers.
; The native owner query decides whether the legacy text/CGA path applies.
eg_dos_dispatch:
	cmp	ah,1
	jb	eg_dos_fallback
	cmp	ah,10h
	ja	eg_dos_fallback
	cmp	ah,4
	je	eg_dos_fallback
	cmp	ah,5
	je	eg_dos_fallback
	cmp	ah,0Fh
	je	eg_dos_fallback
	push	ax ! push bx ! push cx ! push dx ! push si
	mov	al,30
	mov	ch,4
	call	backdoor
	cmp	al,20h
	jb	eg_dos_not_enhanced
	cmp	al,50h
	jae	eg_dos_packet_mode
	; Preserve the legacy CGA palette ABI (BH is a selector, not a page).
	pop	si ! pop dx ! pop cx ! pop bx ! pop ax
	cmp	ah,0Bh
	je	eg_dos_fallback
	jmp	eg_dos_packet_ready
eg_dos_packet_mode:
	cmp	al,0C0h
	ja	eg_dos_not_enhanced
	pop	si ! pop dx ! pop cx ! pop bx ! pop ax
eg_dos_packet_ready:
	push	bx
	mov	bx,ax
	or	bh,80h
	mov	bl,1Fh
	mov	si,bx
	pop	bx
	clc
	ret
eg_dos_not_enhanced:
	pop	si ! pop dx ! pop cx ! pop bx ! pop ax
eg_dos_fallback:
	stc
	ret

; Copy only documented result registers into the private INT10 frame.
; Packet flag 80h distinguishes the extended ABI from historical selectors.
eg_dos_result:
	cmp	ax,0FFFFh
	je	eg_dos_result_done
	cmp	si,0D1Fh
	je	eg_dos_pixel_result
	cmp	si,8D1Fh
	je	eg_dos_pixel_result
	cmp	si,881Fh
	jne	eg_dos_cursor_result
	mov	MS_AX,ax
	ret
eg_dos_pixel_result:
	mov	byte ptr MS_AX,al
	ret
eg_dos_cursor_result:
	cmp	si,831Fh
	je	eg_dos_cursor_copy
	cmp	si,901Fh
	jne	eg_dos_result_done
	mov	ax,vid_struct
	cmp	al,7
	je	eg_dos_palette_copy
	cmp	al,15h
	jne	eg_dos_result_done
eg_dos_palette_copy:
	mov	ax,vid_struct_bx
	mov	MS_BX,ax
eg_dos_cursor_copy:
	mov	ax,vid_struct_cx
	mov	MS_CX,ax
	mov	ax,vid_struct_dx
	mov	MS_DX,ax
eg_dos_result_done:
	ret

eg_dos_modes db 10h,0Dh,0Eh,11h,12h,13h,0Fh,7Fh
