	jnz opn0
opn0a:					;    {
	cmp info_fcb+1,02eh		;      if (info_fcb+1 == 0x2e &&
	jne opn0
	cmp info_fcb+2,020h		;          info_fcb+2 == 0x20)
	jne opn0			;      {
opn0b:
	mov ax,offset info_fcb+2	;        dirp = AX = &info_fcb+1;
	mov dirp,ax		
	mov byte ptr info_fcb+datts+2,010h  ;    dirp->datts = 0x10;
	mov word ptr info_fcb+block1+2,0    ;    dirp->block1 = 0;
	jmps opn1			;      }
					;    }
					;  }
opn0:					;  else else else
					;  {
	call reset_checksum_fcb		;    reset_checksum_fcb();
	jmp lret_eq_ff			;    return(0xff);
					;  }
opn1:					;}
	test hdirfx,0ffh		;if (hdirfx)
	jnz $+5
	jmp opn1d			;{
	xor bx,bx			;  if ((BX = infop->extent) > 3)
	mov bl,info_fcb+extent		;    return(0xff);
	cmp bl,4
	jnb opn0
	mov di,ax			;  DI = AX;
	test byte ptr datts[di],010h	;  if (!(datts[DI] & 0x10)) 
	jz opn0				;    return(0xff);
	or bl,bl			;  if (BX)
	jz opn1aa
	add bl,12			;    BX += 12;
	jmps opn1ac
opn1aa:					;  else
					;  {
	cmp hdsaddr,0			;    if (hdsaddr)
	je opn1abc			; was opn1ab	*G*3.3*85*06*
	mov bl,hdsdir			;      BX = hdsdir;
	jmps opn1ac			;    else

;start			*G*3.3*85*06*
opn1abc:
	mov	bl,fcbdsk		; Get the orginal drive (1 rel)
	sub	bl,1			; Make (0 rel) and Is it default drive?
					; Dec does not set Carry
	jnc	opn1abd			; NO
	mov	di,rlr
	mov	bl,p_dsk[di]		; Get defualt drive number(0 rel)
	jmps	opn1aca
opn1abd:
	and	bl,00011111b		; Get rid of non drive bits(over kill)
	cmp	bl,DRIVEN		; Is it a floating drive(FD)?
	jb	opn1ab			; NO
	cmp	bl,DRIVEP		; Is it a FD?
	jbe	opn1ac			; YES
;end			*G*3.3*85*06*

opn1ab:
	mov bl,seldsk			;      BX = seldsk;
opn1ac:					;  }
			; BX has disk number (0 rel)
	mov di,rlr			;  DI = rlr;
			; BX has disk number (0 rel)
			; DI ready list root
opn1aca:
	mov si,02eh[di]			;  SI = DI->cataddr;
	or si,si
	mov dx,si
	jz opn1ac0			;  if (!(DX = SI) || *(SI+32) != 1)
	cmp word ptr 32[si],1
	je opn1ae			;  {
	dec word ptr 32[si]		;    if (SI) *(SI+32)--;
opn1ac0:
	pushf
	cli				;    turn off interrupts
	mov si,pul			;    if (!SI = pul)
	or si,si			;    {
	jnz opn1ad			;      restore interrupts
					;      AH = 11;
	popf286 b286		; Make Iret do the pop flags
	jmps opn1ba			;      goto set_aret;
					;    }
opn1ad:
	mov ax,0[si]			;    AX = SI->p_link;
	mov pul,ax			;    pul = AX;
	popf286 b286		; Make Iret do the pop flags
	mov 02eh[di],si			;    DI->cataddr = SI;
	or dx,dx			;    if (DX)
	jz opn1ad0			;    {
	mov bp,si			;      BP = SI;
	mov di,si			;      DI = SI;
	mov si,dx			;      SI = DX;
	mov cx,18			;      movsw(DI,SI,18);	*3.2*
	rep movsw
	mov si,bp			;      SI = BP;
	jmps opn1ad1			;    }
opn1ad0:				;    else
	xor ax,ax			;    {
	mov di,si			;      zero(DI=SI,32);
	mov cx,18			;    }			*3.2*
	rep stosw
opn1ad1:
	mov word ptr 32[si],1		;    *(SI+32) = 1;
opn1ae:					;  }
	mov di,dirp			;  DI = dirp;
	add bx,bx
	add si,bx			;  SI += 2*BX;
	mov bx,[si]			;  if (!(BX = *SI) ||
	or bx,bx
	jz opn1a
	dec word ptr prcnt[bx]
	jz opn1b                      	;      --BX->prcnt)
opn1a:					;  {
	push si
	call get_item			;    if (!(BX = get_item())
	pop si
	jnz opn1b			;    {
opn1ba:
	mov ah,11			;      AH = 11;
	jmp set_aret			;      goto set_aret;
opn1b:					;    }
	mov [si],bx			;    *SI = BX;
opn1c:					;  }
	mov al,curdsk			;  BX->hdrv = curdsk;
	mov hdrv[bx],al
	mov si,drvlbla			;  BX->mseq = *(drvlbla + 2);
	mov al,2[si]
	mov mseq[bx],al
	mov dx,block1[di]		;  DX = DI->block1;
	cmp dx,chdblk			;  if (DX == chdblk && /* name=="." */
	jnz opn1c1			;  
	mov si,hdsaddr			;     (SI = hdsaddr))
	or si,si			;
	jz opn1c1			;  {
	mov ax,PBLK[si]			;    AX = SI->pblk;
	mov cx,pdcnt[si]		;    CX = SI->pdcnt;
	jmps opn1c2			;  }
opn1c1:					;  else
					;  {
	mov ax,chdblk			;    AX = chdblk;
	mov cx,dcnt			;    CX = dcnt;
opn1c2:					;  }
	mov PBLK[bx],ax			;  BX->pblk = AX;
	mov pdcnt[bx],cx		;  BX->pdcnt = CX;
	mov HBLK[bx],dx			;  BX->hblk = DX;
	mov word ptr prcnt[bx],1	;  BX->prcnt = 1;
	ret				;  return;
opn1d:					;}
	mov bx,ax			;if (dirp->datts & 0x10)
	test byte ptr datts[bx],10h	;{
	jz $+5				;  reset_checksum_fcb();
	jmp opn0			;  return(0xff);
					;}
	cmp attributes,080h		;if (attributes == 0x80 &&
	jne opn1e
	test byte ptr datts[bx],01h	;    dirp->datts & 0x01)
	jz opn1e
	mov attributes,020h		;  attributes = 0x20;
opn1e:
	mov al,info_fcb+extent		;extcnt = infop->extent & 0x1f;
	and al,01fh
	xor ah,ah
	mov extcnt,ax
	call extsize	
	cmp ax,0ffffh			;if ((size = extsize()) == 0xffff)

;start		*G*3.2*4*
	jnz $+3
	inc ax				; set record count to zero
;end		*G*3.2*4*

	push ax
	call set_sdcnt			;set_sdcnt();
	mov ch,5			;if (search_olist(5) && check_fcb1())
	call search_olist		;{
	jnz opn2

	mov bx,offset opn1f
	push bx
	mov check_fcb_ret,TRUE
	call check_fcb1
	pop bx	
	pop ax
	cmp info_fcb+cr,0ffh		;  if (infop->cr == 0xff)
	jne opn4			;    infop->cr = infop->csize & 0x7f;
	mov al,info_fcb+csize
	and al,07fh
	mov info_fcb+cr,al
	jmp opn4
opn1f:
	call setenddir			; restore dcnt & dirp!!!
