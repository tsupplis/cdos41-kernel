set_sdcnt:
	mov si,dcnt			;sdcnt = dcnt;
	mov sdcnt,si			;pack_sdcnt();
	jmp pack_sdcnt			;return;

get_omode:				;VOID get_omode(mask)
;	entry:	CL = (0x80 0r 0xc0) open mode mask

;					; AL = atts
	push cx
	call get_atts			;atts = get_atts;
	pop cx
	and al,cl			;atts &= mask;
	cmp al,0c0h			;if (atts == 0xc0) atts = 0x40;
	jne gom1
	  mov al,040h
gom1:
	mov high_ext,al			;high_ext = atts;
	shr al,1			;atts >>= 1;
	jnz gom2			;if (atts == 0) atts = 0x80;
	  mov al,080h
gom2:
	mov attributes,al		;attributes = atts;
	ret

closef:
	test hdirfx,0ffh		;if (hdirfx && (BX = hdsaddr))
	jz cls0a			;{
	mov bx,hdsaddr			;  BX->hblk = 0; /*This comment does
					; not match the code*/
	or bx,bx			;  return;
	jz cls0a0			;}
	xor	bl,bl
	mov	info_fcb+extent,bl
	jmp	opn0b
cls0a0:
	ret
cls0a:
	test byte ptr chksiz+1,80h	;if (chksiz & 0x8000) 
	jnz cls0b			;  rd_dir_flag = 0f0h;
	mov rd_dir_flag,0f0h
cls0b:
	call setenddir			;dcnt = 0xffff;
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2)))
	or ax,ax			;  return(0xff);
	jnz cls1
	jmp lret_eq_ff	
cls1:
	test info_fcb+module,080h	;if (!(infop->module & 0x80))
	jnz cls2			;  update_fat();
	call update_fat
cls2:
	call set_sdcnt			;sdcnt = dcnt;
	test info_fcb+module,040h	;if (infop->module & 0x40)
	jz cls3				;{
	call closedir			;  closedir();
	call flush			;  flush();
cls3:					;}
	and info_fcb+module,03fh	;infop->module &= 0x3f;
	or info_fcb+module,080h		;infop->module |= 0x80;
	jmp close021

makef:
	mov cl,080h	
	call get_omode			;get_omode(0x80);
	call setenddir			;dcnt = 0xffff;
	mov cx,2			;
	call getdir			;if (dirp = getdir(0,2))
	or ax,ax			;  exterr(0x08ff);
	jz mak1
