	pop bx
	or ax,ax
	pop ax
	jnz alloc3
	mov ax,bx
	ret
alloc3:
	inc bx				;    BX++;
alloc4:					;  }
	cmp ax,2			;  if (AX > 2)
	jbe alloc6			;  {
	push ax
	push bx
	call getblk			;    if (!getblk(AX) return(AX);
	pop bx
	or ax,ax
	pop ax
	jnz alloc5
	ret	
alloc5:
	dec ax				;    AX--;
alloc6:					;  }
	cmp ax,2			;} while (AX > 2 ||
	ja alloc2
	cmp bx,nclstrs			;   	  BX < dpbptr->nclstrs);
	jb alloc2
	xor ax,ax			;return(0);
	ret

rw_rtn:
;	entry: AX = # of physical records
	       
	mov cl,bdrwflg			;CL = reading
	and cl,1
	or ax,ax			;if (AX)
	jz rw2				;{
	or cl,cl			;  if (!reading)
	jnz rw1
	push ax
	call discard_data		;    discard_data();
	pop ax
	xor cl,cl
rw1:
	jmp directio			;  directio(CL,AX);
rw2:					;}
	mov ch,preread			;else
	jmp dblockio			;  dblockio(CH,CL);

getphy:					;AX = blk
					;BX = blkoffset
	             			;byteoff = (blk -= 2) * dpbptr->clsize;
	dec ax
	dec ax
	mul clsize
	add ax,bx			;byteoff += blkoffset;
	adc dx,0
	mov cl,7			;byteoff >>= 7;
	call lshiftr
	mov bx,dirmax			;dsize = (dpbptr->pc.drm + 4) >> 2;
	add bx,4
	mov cl,2
	shr bx,cl
	test bl,phymsk			;if (dsize & phymsk)
	jz gph1				;{
	mov cl,phymsk
	xor ch,ch
	not cx		
	and bx,cx			;  dsize &= ~phymsk;
	not cx
	add bx,cx			;  dsize += phymsk + 1;
	inc bx
gph1:					;}
	add ax,bx			
	adc dx,0			;byteoff += dsize;
	mov arecord,al			;arecord[0] = AL;
	mov arecord+1,ah		;arecord[1] = AH;
	mov arecord+2,dl		;arecord[2] = DL;
	ret

zeroblk:				;AX = blk

	xor bx,bx
	call getphy			;getphy(blk,0);
	call init_wzf			;AX = init_wzf();
	          			;(AX == phymsk + 1)
	mov bx,clsize
	mov cl,7
	add cl,physhf			;BX = clsize >> (physhf + 7);
	shr bx,cl
	mov preread,0			;preread = FALSE;
zero1:					;while(BX--)
	push ax				;{
	push bx
	call discard_data		;  discard_data();
	call seek			;  seek();
	xor cl,cl
	call wrbuff			;  wrbuff();
	pop bx
	pop ax
	add word ptr arecord,ax		;  arecord += AX;
	adc arecord+2,0
	dec bx
	jnz zero1			;}
	ret

testfile:
	xor al,al			;if (!dont_close) return(0);
	xchg dont_close,al		;dont_close = 0;
	or al,al
	jz tstf3
	test high_ext,080h		;if (!(high_ext & 0x80)) return(0);
	jz tstf3
	cmp mult_cnt,1			;if (mult_cnt > 1 && 
	jbe tstf0			;    mult_cnt != mult_num) return(0);
	mov al,mult_num
	cmp al,mult_cnt
	jne tstf3
tstf0:
	mov al,info_fcb+lowdcnt		;dcnt = fcbp->lowdcnt +
	mov ah,info_fcb+pcfcb1		;       ((fcbp->pcfcb1 & 0x1f) << 8) -
	and ah,01fh			;       1;
	dec ax
	mov dcnt,ax
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2))) reterr(11);
	or ax,ax
	jnz tstf1
	pop bx				;discard return address
	mov lret,11			;return from bdosrw with error(11)
	ret
tstf1:
	mov comp_fcb_cks,0ffh		;comp_fcb_cks = 0xff;
	mov bx,ax
	mov ax,dblock1[bx]		;infop->block1 = dirp->dblock1;
	mov word ptr info_fcb+block1,ax
	mov dx,dsize+2[bx]
	cmp word ptr info_fcb+csize+2,dx ;if (infop->csize < dirp->dsize)
	ja tstf3
	jb tstf2
	mov ax,dsize[bx]
	cmp word ptr info_fcb+csize,ax
	jae tstf3
tstf2:					;{
	mov word ptr info_fcb+csize,ax	;  infop->csize = dirp->dsize;
	mov word ptr info_fcb+csize+2,dx
	mov update_rc,TRUE		;  update_rc = TRUE;
	mov al,1			;  return(1);
	ret				;}
tstf3:					;else return(0);
	xor ax,ax
	ret

extendf:
	cmp mult_cnt,1			;if (mult_cnt > 1) return;
	ja exf1
	test high_ext,080h		;if (!(high_ext & 0x80)) return;
	jz exf1
	jmps closedir			;closedir();
exf1:	
	ret

closedir:
	mov bx,dirp
	test word ptr dblock1[bx],0ffffh
	jnz cld1			;if (!dirp->dblock1)
	mov ax,word ptr info_fcb+block1
	mov dblock1[bx],ax		;  dirp->dblock1 = infop->block1;
cld1:
	mov ax,word ptr info_fcb+csize	;if (infop->csize > dirp->dsize)
	mov dx,word ptr info_fcb+csize+2
	cmp dx,dsize+2[bx]
	ja cld2
	jb cld3
	cmp ax,dsize[bx]
	jbe cld3
cld2:
	mov dsize[bx],ax		;  dirp->dsize = infop->csize;
	mov dsize+2[bx],dx		
cld3:
	or byte ptr datts[bx],020h	;dirp->datts |= 0x20;
	and info_fcb+fname+10,07fh	;infop->fname[10] &= 0x7f;

	call set_sdcnt			;set_sdcnt();
	mov ch,5			;if ((BX = search_olist(5)) &&
	call search_olist		;  !(*(BX+2) & 0x10))
	jnz cld4
	test byte ptr 2[bx],10h
	jnz cld4			;{
	call cnvcpd			;  cnvcpd();
	call setpcd			;  setpcd();
cld4:					;}
	jmp wrdir			;wrdir();
	
pc_chkrec:
	mov	cl,3			; *3.2*G*7*
	call bdosrw			;bdosrw();
	; AX,DX = byteoff
	adc ax,080h			;byteoff += 0x80;
	adc dx,0
	mov dont_close,0ffh		;dont_close = 0xff;
pchk0:
	cmp word ptr info_fcb+csize+2,dx ;if (infop->csize < byteoff)
	ja pchk2
	jb pchk1
	cmp word ptr info_fcb+csize,ax
	jae pchk2
pchk1:
	mov ax,offset pchk2		;{
	push ax
	call testfile			;  if (testfile()) goto pchk0;
	pop bx
	or ax,ax
	jnz pchk0
	mov lret,1			;  return(1);
pchk2:					;}
	mov lock_shell,FALSE		;else return(0);

;	testfile returns directly to pchk2 if error 11 encountered.

	ret

chk_pcfcb:

	mov al,info_fcb+lowdcnt		;dcnt = fcbp->lowdcnt +
	mov ah,info_fcb+pcfcb1		;       ((fcbp->pcfcb1 & 0x1f) << 8) -
	and ah,01fh			;       1;
	push ax
	dec ax
	mov dcnt,ax
	mov rd_dir_flag,0fh		;rd_dir_flag = 0fh;
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2)))
	or ax,ax			;  goto check_fcb3
	pop ax
	jnz chk_pc1
chk_pc0:
	jmp check_fcb3

chk_pc1:
	cmp ax,dcnt
	jne chk_pc0
	call set_sdcnt			;set_sdcnt();
	mov ch,5			;if (!search_olist(5)) goto check_fcb3
	call search_olist
	jnz chk_pc0
	ret

	END
