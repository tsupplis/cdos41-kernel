

pnamsiz	equ	8

include pd.def

TRUE	equ	0ffffh
FALSE	equ	0

include	popf286.mac

FAT12		equ	00fffh		; 12 bit fat	*3.2*19*
FAT16		equ	0ffffh		; 16 bit fat	*3.2*19*

DRIVEN		equ	0dh		; (0 rel)
DRIVEP		equ	0fh		; (0 rel)


fxi40	equ	1bh
dskmap	equ	16

PUL		equ	ds:word ptr .05ch
RLR		equ	ds:word ptr .068h
THRDRT		equ	ds:word ptr .072h
TOD		equ	ds:byte ptr .07Eh
THRD_SPB	equ	0aah

include	modfunc.def

; struct pcfcb

drive	equ	0		;drive
fname	equ	1		;file name & type
extent	equ	12		;extent (0 - 31)
chksum	equ	13		;checksum
module	equ	14		;module (0 - 63)
				; 0x80 - file extended flag
				; 0x40 - file write flag
rcdcnt	equ	15		;record count (0 - 128)
pcfcb1	equ	16		;PCDOS fcb flag byte
				; 0x1f - high byte of file's dcnt
				; 0x20 - hidden
				; 0x40 - sub-directory
				; 0x80 - always one
pcfcb2 	equ	17		;same as pcfcb1
lowdcnt	equ	18		;low byte of file's dcnt
cbflag	equ	19		;current block flag
cblock	equ	20		;current block (2 bytes)
cblkidx equ	22		;current block index (2 bytes)
time	equ	22		;time (hhhhhmmmmmmsssss)
date	equ	24		;date (yyyyyyymmmmddddd)
block1	equ	26		;first block in file
csize	equ	28		;current file size
cr	equ	32		;current record
rr0	equ	33		;random record field (byte 0)
rr1	equ	34		;random record field (byte 1)
rr2	equ	35		;random record field (byte 2)


; struct dirfcb

dname	equ	0		;file name & type
datts	equ	11		;PCDOS attributes
				; 0x01 - read/only
				; 0x02 - hidden
				; 0x04 - system
				; 0x08 - volume label
				; 0x10 - sub-directory
				; 0x20 - archive
				; 0x40 - not used
				; 0x80 - not used 
datts2	equ	12		;CP/M attributes
				; 0x80 - f1' modify default open rules
				; 0x40 - f2' partial close default
				; 0x20 - f3' ignore close checksum errors
				; 0x10 - f4' disable checksums
drsrv	equ	13		;reserved area
dtime	equ	22		;time (hhhhhmmmmmmsssss)
ddate	equ	24		;date (yyyyyyymmmmddddd)
dblock1	equ	26		;first block in file
dsize	equ	28		;current file size

;struct pctod

pcyr	equ	0		;year since 1980
pcmon	equ	1		;month (1 - 12)
pcday	equ	2		;day (1 - 31)
pchr	equ	3		;hour (0 - 23)
pcmin	equ	4		;minute (0 - 59)
pcsec	equ	5		;seconds/2 (0 - 29)

;struct cpmtod

cpmdays	equ	0		;days since jan 1, 1978
cpmhr	equ	2		;BCD hours (0 - 23)
cpmmin	equ	3		;BCD minutes (0 - 59)
cpmsec	equ	4		;BCD seconds (0 - 59)

;struct hds

hdrv	equ	0		;drive (A - M)
mseq	equ	1		;media sequence #
PBLK	equ	word ptr 2	;parent block
pdcnt	equ	4		;parent dcnt
HBLK	equ	word ptr 6	;1st block of directory
prcnt	equ	8		;creating PD address

cat	equ	02eh

	DSEG

	EXTRN	arecord:BYTE
	EXTRN 	attributes:BYTE
	EXTRN	bdrwflg:BYTE
	EXTRN	blk:WORD
	EXTRN	blkcnt:WORD
	EXTRN	blkidx:WORD
	EXTRN	blkoffset:WORD
	EXTRN	byteoff:WORD
	EXTRN	chdblk:WORD
	EXTRN	check_fcb_ret:BYTE
	EXTRN	chksiz:WORD
	EXTRN  	cdrmaxa:WORD
	EXTRN	clsize:WORD
	EXTRN	common_dma:BYTE
	EXTRN	comp_fcb_cks:BYTE
	EXTRN	cpm_tod:BYTE
	EXTRN	curdsk:BYTE
	EXTRN	cur_dma:WORD
	EXTRN	cur_dma_seg:WORD
	EXTRN	dir_bcba:WORD
	EXTRN	dir_cnt:BYTE
	EXTRN	dirmax:WORD
	EXTRN	dcnt:WORD
	EXTRN	dirp:WORD
	EXTRN	dma_ofst:WORD
	EXTRN	dma_seg:WORD
	EXTRN	dont_close:BYTE
	EXTRN	dosfat:WORD
	EXTRN	drvlbla:WORD
	EXTRN	extcnt:WORD
	EXTRN	fcbdsk:BYTE
	EXTRN	fx_intrn:BYTE
	EXTRN	hash_seg:WORD
	EXTRN	hdirfx:BYTE
	EXTRN	hdsaddr:WORD
	EXTRN	hdsdir:BYTE
	EXTRN	high_ext:BYTE
	EXTRN	info:WORD
	EXTRN	info_fcb:BYTE	
	EXTRN   lock_shell:BYTE
	EXTRN	lprvblk:WORD
	EXTRN	lret:BYTE
	EXTRN	make_flag:BYTE
	EXTRN	mon_days:WORD
	EXTRN 	mult_cnt:BYTE
	EXTRN	mult_num:BYTE
	EXTRN 	nclstrs:WORD
	EXTRN	parlg:BYTE
	EXTRN 	pc_cr:BYTE
	EXTRN	pc_ext:BYTE
	EXTRN	pc_module:BYTE
	EXTRN	pc_tod:BYTE
	EXTRN	phymsk:BYTE
	EXTRN	physhf:BYTE
	EXTRN	preread:BYTE
	EXTRN	prvblk:WORD
	EXTRN	rd_dir_flag:BYTE
	EXTRN	sdcnt:WORD
	EXTRN	searchl:BYTE
	EXTRN	seldsk:BYTE
	EXTRN	update_rc:BYTE
	EXTRN	usrcode:BYTE


eject

	CSEG

	EXTRN	check_fcb1:NEAR
	EXTRN	check_fcb3:NEAR
	EXTRN	checkwrite:NEAR
	EXTRN	chk_olist:NEAR
	EXTRN	chk_wild:NEAR
	EXTRN	chk_wild0:NEAR
	EXTRN	ckrofile:NEAR
	EXTRN	close021:NEAR
	EXTRN	conv_rr:NEAR
	EXTRN	copy_user_no:NEAR
	EXTRN	get_item:NEAR
	EXTRN	dblockio:NEAR
	EXTRN	directio:NEAR
	EXTRN	discard_data:NEAR
	EXTRN	flush:NEAR
	EXTRN	flushx:NEAR
	EXTRN	get_atts:NEAR
	EXTRN	init_wzf:NEAR
	EXTRN	lret_eq_ff:NEAR
	EXTRN	mpmif:NEAR
	EXTRN	openx1a:NEAR
	EXTRN	pack_sdcnt:NEAR
	EXTRN	patch:NEAR
	EXTRN	pc_make_test:NEAR
	EXTRN	rd_pcdir:NEAR
	EXTRN	rdbuff:NEAR
	EXTRN	reset_checksum_fcb:NEAR
	EXTRN	roferror:NEAR
	EXTRN	search_olist:NEAR
	EXTRN	seek:NEAR
	EXTRN	setcdr:NEAR
	EXTRN	setenddir:NEAR
	EXTRN	set_aret:NEAR
	EXTRN	set_lret1:NEAR
	EXTRN	test_lock:NEAR
	EXTRN	tst_olist:NEAR
	EXTRN	update_fat:NEAR
	EXTRN	wrbuff:NEAR
	EXTRN	wrdir:NEAR
	
	PUBLIC bdosrw
	PUBLIC chk_pcfcb
	PUBLIC closef
	PUBLIC compfs
	PUBLIC deletef
	PUBLIC extsize
	PUBLIC getnblk
	PUBLIC getphy
	PUBLIC getspace
	PUBLIC makef
	PUBLIC openf
	PUBLIC opn0a
	PUBLIC pc_chkrec
	PUBLIC pcsearch
	PUBLIC renamef
	PUBLIC setattsf
	PUBLIC setstamp
	PUBLIC truncatef
	PUBLIC xfcb

pcsearch:
;	entry:	Z flag (on stack) = 1 for search, 0 for searchn
;		CL = searchl
;
					;if (first)
	popf286 b286		; Make Iret do the pop flags
	pushf
	jnz pcs1			;{
	call setenddir			;  dcnt = 0xffff;
	mov extcnt,0			;  extcnt = 0;
pcs1:					;}
	cmp cl,0			;if (srchl)
	jz pcs2				;{
	mov bx,offset info_fcb+extent	;  if (infop->extent == '?')    
	cmp byte ptr [bx],'?'		;    srchl = 2;
	mov cl,2			;  else
	je pcs2				;  {
	mov cl,3			;    srchl = 3;
	mov al,[bx]			;    extcnt = infop->extent & 0x1f;
	xor ah,ah			;  }
	mov extcnt,ax			;}
pcs2:					;
	cmp cl,3			;if (srchl < 3 && extcnt) dcnt--;
	jae pcs3
	test extcnt,0ffffh		
	jz pcs3				
	dec dcnt
pcs3:
	; CL = getdir searchl parameter (0,1,2,3) 
	; getdir sets dirp and returns dirp in AX

	mov searchl,cl
pcs4:
	mov cl,searchl			;do
	xor ch,ch			; CH = info_fcb offset, CL = searchl
	call getdir			;{ 
	or ax,ax			;  if (!dirp = getdir(offset,searchl)))
	jnz pcs5			;     return(0xff);
	    				;}
	popf286 b286		; Make Iret do the pop flags

	jmp lret_eq_ff
pcs5:

;start			*3.2*
;
;     We will only return directory entries if the high bit of the drive
;  field in the fcb is on.  (NOTE the calling program must turn it on before
;  each search first AND search next.)
;
	cmp	searchl,2		;if (searchl >=2 &&
	jb	pcs5a
	mov	bx,ax
	test	byte ptr datts[bx],010h	;    DIRP->DATTS=010h
	jz	pcs5a
	test	hdirfx,0ffh		;    !hdirfx)
	jz	pcs4			;	goto pcs4;
pcs5a:
;end			*3.2*

	cmp searchl,3			;while(srchl == 3 && 
	jne pcs6			;      extsize() == 0xffff);
	call extsize
	cmp ax,0ffffh
	jz pcs4	
pcs6:
	popf286 b286		; Make Iret do the pop flags
	push es
	mov es,dma_seg
	mov di,dma_ofst

	jnz pcs6a			;if (first && !srchl)
	cmp searchl,0			;
	jne pcs6a			;{
	mov al,20h			;  p = dmaptr;
	stosb				;  *p++ = 0x20;
	test byte ptr datts[bx],08h	;  if (dirp->datts & 0x08)
	jz pcs60			;  {
	lea si,dname[bx]		;    for (i = 0; i < 11; i++)
	mov cx,11			;      *p++ = dirp->dname[i];
	rep movsb			;  }
	jmps pcs61			;  else
pcs60:					;  {
	mov cx,11			;    for (i = 0; i < 11; i++)
	rep stosb			;      *p++ = 0x20;
pcs61:					;  }
	mov al,21h
	stosb				;  *p++ = 0x21;
	xor al,al
	mov cx,2			;  zero(p,2);
	rep stosb
	mov al,80h
	stosb				;  *p++ = 0x80;
	stosb				;  *p++ = 0x80;
	stosb				;  *p++ = 0x80;
	xor ax,ax
	mov cx,39			;  zero(p,78);
	rep stosw			;  *p++ = 0x21;
	mov al,21h
	stosb
	xor al,al			;  zero(p,31);
	mov cx,31
	rep stosb
	test byte ptr datts[bx],08h	;  if (!(dirp->datts & 0x08))
	jnz pcs9			;    dcnt = 0xffff;
	call setenddir
	jmps pcs9			;}
pcs6a:					;else
	mov bx,dirp			;if (dirp->dname[0] == 0 ||
	cmp byte ptr dname[bx],0	;    dirp->dname[0] == 0xe5)
	je pcs6b
	cmp byte ptr dname[bx],0e5h	;{
	jne pcs8			;  zero(dmaptr,128);
pcs6b:
	mov al,0e5h    			;  *dmaptr = 0xe5;
	stosb    			;}
	xor ax,ax
	mov cx,127
	rep stosb
	jmps pcs9
pcs8:					;else
	call extsize			;{
	xor bx,bx			;  i = extsize();
	push bx				;  copydir(dmaptr,i,FALSE);
	push ax				;  zero(dmaptr+32,64);
	push di				;  setsfcb();
	call copydir			;  extcnt++;
	pop di				;  if (extsize() == 0xffff) extcnt = 0;
	pop bx				;}
	pop ax
	add di,32
	mov cx,32
	rep stosw 
	call setsfcb			;es:di -> sfcb
	inc extcnt
	call extsize
	cmp ax,0ffffh
	jne pcs9
	mov extcnt,0
pcs9:
	pop es
	ret				;return(0);

fcb_extsize:
	xor ah,ah			;extcnt = pc_module << 5 + pc_ext;
	mov al,pc_module
	mov cl,5
	shl ax,cl
	or al,pc_ext
	mov extcnt,ax
	mov ax,word ptr info_fcb+csize
	mov dx,word ptr info_fcb+csize+2 ;AX,DX = infop->csize
	jmps extsize1

extsize:
	mov bx,dirp
	mov ax,dsize[bx]		;AX,DX = dirp->dsize;
	mov dx,dsize+2[bx]
extsize1:
	mov bx,ax			;BX = (WORD)size;
	mov cl,14
	call lshiftr			;AX = size >> 14; (ext)
	and bx,03fffh			;if (!(BX &= 0x3fff))
	or bx,bx
	jnz exs1			;{
	or ax,ax			;  if (AX)
	jz exs1				;  {
	dec ax				;     AX--;
	mov bx,16384			;     BX = 16384;
					;  }
exs1:					;}
	cmp ax,extcnt			;if (AX < extcnt) return(0xffff);
	jae exs2
	mov ax,0ffffh
	ret
exs2:					;else
	ja exs3				;if (AX == extcnt) return(size);
	mov ax,bx
	ret
exs3:					;else
	mov ax,16384			;    return(16384);
	ret				

copydir:				;copydir(fcbp,size,fcbsw)
					;    struct pcfcb *fcbp;
					;    UWORD size;
					;    BOOLEAN fcbsw;
					;{
	
	push bp
	mov bp,sp

	mov di,4[bp]			; DI = fcbp

	test word ptr 8[bp],0ffffh	;if (!fcbsw) fcbp->drive = user;
	jnz cpd1
	mov al,usrcode
	mov es:[di],al
cpd1:
	xor bx,bx			; BX = i, SI = dirp, DI = fcbp
	mov si,dirp			; AL = atts
cpd2:
	cmp bl,11			;for (i = 0; i < 11; i++)
	jae cpd8			;{
	xor al,al			;   atts = 0;
	cmp bl,4			;   if (i < 4)
	ja cpd3				;     att = (dirp->datts2 << i) & 0x80;
	mov al,datts2[si]
	mov cl,bl
	shl al,cl
	and al,080h
	jmps cpd7
cpd3:					;   else
	cmp bl,8			;   if (i == 8 &&
	jne cpd4			;     dirp->datts & 0x01) att = 0x80;
	test byte ptr datts[si],01h
	jz cpd7
	jmps cpd6
cpd4:					;   else
	cmp bl,9			;   if (i == 9 &&
	jne cpd5			;     dirp->datts & 0x04) att = 0x80;
	test byte ptr datts[si],04h
	jz cpd7
	jmps cpd6
cpd5:					;   else
	cmp bl,10			;   if (i == 10 &&
	jne cpd7			;    !(dirp->datts & 0x20)) att = 0x80;
	test byte ptr datts[si],20h
	jnz cpd7
cpd6:
	mov al,080h
cpd7:
	mov dl,dname[si+bx]		;   fcbp->fname[i] = (dirp->dname[i]
	and dl,07fh			;          & 0x7f) | att;
	or dl,al
	mov es:fname[di+bx],dl
	inc bx
	jmps cpd2
cpd8:					;}
	mov ax,extcnt
	and ax,1fh			;fcbp->extent = extcnt & 0x1f;
	mov es:extent[di],al
	
	mov ax,6[bp]			;bc = size & 0x7f;
	mov dl,al			;rc = size >> 7;
	and dl,7fh			;if (bc) rc++;
	shl ax,1
	mov al,dl			; AL = bc, AH = rc
	or al,al
	jz cpd9
	inc ah
cpd9:
	test word ptr 8[bp],0ffffh	;if (!fcbsw) fcbp->chksum = bc;
	jnz cpd10
	mov es:chksum[di],al
cpd10:	
	mov bx,extcnt			;fcbp->module = extcnt >> 5;
	mov cl,5
	shr bx,cl
	mov es:module[di],bl
	mov es:rcdcnt[di],ah		;fcbp->rcdcnt = rc;
	mov al,80h			;i = 0x80;
	test byte ptr datts[si],10h	;if (dirp->datts & 0x10) i |= 0x40;
	jz cpd10a
	or al,40h
cpd10a:
	test byte ptr datts[si],02h	;if (dirp->datts & 0x02) i |= 0x20;
	jz cpd10b
	or al,20h
cpd10b:
	mov bx,dcnt			;i |= dcnt >> 8;
	or al,bh
	mov es:pcfcb1[di],al		;fcbp->pcfcb1 = i;
	mov es:pcfcb2[di],al		;fcbp->pcfcb2 = fcbp->pcfcb1;
	mov es:lowdcnt[di],bl		;fcbp->lowdcnt = dcnt & 0xff;
	xor ax,ax
	mov es:cbflag[di],al		;zero(&fcbp->cbflag,3);
	mov es:cblock[di],ax
	lea di,time[di]			;move(&dirp->dtime,&fcbp->time,10);
	lea si,dtime[si]
	mov cx,5
	rep movsw
	mov sp,bp
	pop bp
	ret

setsfcb:				
;	entry ES:DI = dmaptr + 96

	mov al,021h			;*dmap++ = 0x21;
	stosb

	mov bx,dirp			;if (!(dirp->ddate | dirp->dtime))
	mov ax,ddate[bx]		;{
	mov bx,dtime[bx]		;  zero(dmap,31);
	or ax,bx			;  return;
	jnz sfcb1			;}
	mov cx,31
	rep stosb
	ret
sfcb1:
	call getpcd			;getpcd();
	call cnvpcd			;cnvpcd();

					;ES,DI = dmap
	xor ax,ax			;zero(dmap,4);
	mov cx,2			;dmap += 4;
	rep stosw
	mov cx,2			;move(&cpm_tod,dmap,4);
	mov si,offset cpm_tod		;dmap += 4;
	rep movsw
	mov cx,21			;zero(dmap,21);
	rep stosb
	ret

getpcd:

	mov bx,dirp			;pc_tod.pcday = (i = dirp->ddate)
	mov ax,ddate[bx]		;			& 0x1f;
	mov dl,al			;AX = i
	and dl,1fh
	mov pc_tod+pcday,dl
	mov cl,5			;i >>= 5;
	shr ax,cl
	mov dl,al			;pc_tod.pcmon = i & 0x0f;
	and dl,0fh
	mov pc_tod+pcmon,dl
	mov cl,4			;i >>= 4;
	shr ax,cl
	mov pc_tod+pcyr,al		;pc_tod.pcyr = i;

                    			;pc_tod.pcsec = (i = dirp->dtime)
	mov ax,dtime[bx]		;			& 0x1f;
	mov dl,al			;AX = i
	and dl,1fh
	mov pc_tod+pcsec,dl
	mov cl,5			;i >>= 5;
	shr ax,cl
	mov dl,al			;pc_tod.pcmon = i & 0x3f;
	and dl,3fh
	mov pc_tod+pcmin,dl
	mov cl,6			;i >>= 6;
	shr ax,cl
	mov pc_tod+pchr,al		;pc_tod.pchr = i;
	
	ret

setpcd:
	mov bx,dirp			;dirp->ddate =
	mov al,pc_tod+pcyr		;  (((pc_tod.pcyr << 4) +
	mov cl,4			;  pc_tod.pcmon) << 5) +
	shl ax,cl			;  pc_tod.pcday; 
	add al,pc_tod+pcmon
	mov cl,5
	shl ax,cl
	add al,pc_tod+pcday
	mov ddate[bx],ax

	mov al,pc_tod+pchr		;dirp->dtime =
	mov cl,6			;  (((pc_tod.pchr << 6) +
	shl ax,cl			;  pc_tod.pcmin) << 5) +
	add al,pc_tod+pcmin		;  pc_tod.pcsec;
	mov cl,5
	shl ax,cl
	add al,pc_tod+pcsec
	mov dtime[bx],ax

	ret

cnvpcd:
	
	xor bx,bx			;cpm_tod.cpmdays =
	mov bl,pc_tod+pcmon
	dec bx
	add bx,bx
	mov ax,mon_days[bx]		;  mon_days[pc_tod.pcmon-1] +
	push ax
	xor ah,ah
	mov al,pc_tod+pcyr		;  365 * (pc_tod.pcyr + 2) +
	inc ax
	inc ax
	mov bx,365			
	mul bx
	pop bx
	add ax,bx
	xor bx,bx
	mov bl,pc_tod+pcday		;  pc_tod.pcday +
	add ax,bx
	push ax
	mov bl,pc_tod+pcmon		;  leapdays(pc_tod.pcyr + 4,
	xor bh,bh			;                 pc_tod.pcmon) + 1;
	mov al,pc_tod+pcyr
	add al,4
	xor ah,ah			; AX = leapdays param 1
	call leapdays			; BX = leapdays param 2
	pop bx
	add ax,bx
	mov word ptr cpm_tod+cpmdays,ax

	mov al,pc_tod+pchr		;cpm_tod.cpmhr = bcd(pc_tod.pchr);
	call bcd			; AL = bcd(AL)
	mov cpm_tod+cpmhr,al	

	mov al,pc_tod+pcmin		;cpm_tod.cpmmin = bcd(pc_tod.pcmin);
	call bcd			; AL = bcd(AL)
	mov cpm_tod+cpmmin,al

	ret

cnvcpd:
	mov si,offset tod		;move(&tod,&cpm_tod,5);
	mov di,offset cpm_tod
	mov cx,5
	rep movsb
cnvcpdx:

					; CX = year, BX = days, DX = yl

	mov cx,78			;year = 78;
	mov bx,word ptr cpm_tod+cpmdays	;days = cpm_tod.cpmdays - 1;
	dec bx

cnvc1:					;FOREVER
					;{
	mov dx,365			;  yl = 365;
	test cl,3			;  if (!(yl & 3)) yl = 366;
	jnz cnvc2
	inc dx
cnvc2:
	cmp bx,dx			;  if (days <= yl) break;

;	jbe cnvc3
	jb cnvc3

	sub bx,dx			;  days -= yl;
	inc cx				;  year++;
	jmps cnvc1			;}
cnvc3:
					; DX = leapbias, SI = month
	xor dx,dx
	test cl,3			;if (!(year & 3) && days > 59)
	jnz cnvc4			;  leapbias = 1;
	cmp bx,59			;else
	jbe cnvc4			;  leapbias = 0;
	mov dx,1
cnvc4:
	mov si,24			;month = 12;
cnvc5:	
	dec si				;while(--month)
	dec si
	or si,si			;{
	jz cnvc6			;  if ((mon_days[month] + leapbias)
	mov ax,mon_days[si]		;         < days) break;
	add ax,dx			;}
	cmp ax,bx

;	jae cnvc5
	ja cnvc5

cnvc6:
	sub cx,80			;pc_tod.pcyr = year - 80;
	mov pc_tod+pcyr,cl
	mov ax,si
	shr al,1
	inc al
	mov pc_tod+pcmon,al		;pc_tod.pcmon = month + 1;
	mov ax,mon_days[si]
	sub bx,ax
	sub bx,dx
	inc bl
	mov pc_tod+pcday,bl		;pc_tod.pcday = days -
	mov al,cpm_tod+cpmhr		;               mon_days[month] -
	call bin			;		leapbias;
	mov pc_tod+pchr,al		;pc_tod.pchr = bin(cpm_tod.cpmhr);
	mov al,cpm_tod+cpmmin
	call bin
	mov pc_tod+pcmin,al		;pc_tod.pcmin = bin(cpm_tod.cpmmin);
	mov al,cpm_tod+cpmsec
	call bin
	shr al,1			;pc_tod.pcsec = bin(cpm_tod.cpmsec)
	mov pc_tod+pcsec,al		;		  >> 1;
	ret

leapdays:				;UWORD leapdays(year,month)
;	entry AX = year, BX = month

	mov dx,ax			;rv = year >> 2;
	shr ax,1
	shr ax,1
	test dx,3			;if (!(year & 3) && 
	jnz lpdy1			;    (mon_days[month-1] < 59)) rv--;
	dec bx
	add bx,bx
	mov bx,mon_days[bx]
	cmp bx,59
	jae lpdy1
	dec ax
lpdy1:
	ret				;return(rv);

bcd:
;	entry: AL = binval		; AL = bcd(AL);

	xor ah,ah			;i = 0;
bcd1:					;while (binval >= 10)
	cmp al,10			;{
	jb bcd2
	sub al,10			;   binval -= 10;
	add ah,16			;   i += 16;
	jmps bcd1
bcd2:					;}
	add al,ah
	ret				;return(i + binval);

bin:
;	entry: AL = bcdval		; AL = bin(AL);

	xor ah,ah			;i = 0;
bin1:					;while (bcdval >= 16)
	cmp al,16			;{
	jb bin2
	sub al,16			;   bcdval -= 16;
	add ah,10			;   i += 10;
	jmps bin1
bin2:					;}
	add al,ah
	ret				;return(i + bcdval);

getdir:
;	entry: CH = info_fcb offset
;	entry: CL = search length (0,1,2,3)
;	returns: AX,dirp = offset of directory entry, or zero if
;		 no match or end of directory

					;struct dirfcb *getdir(offset,srchl);

					;FOREVER
					;{
	push cx				;  if (!(dirp = rd_pcdir()))
					;    return(NULL);
	call rd_pcdir			;
	pop cx				;
	mov dirp,ax
	mov bx,ax
	or ax,ax
	jz gtd4b
gtd1:
	cmp cl,0			;  if (srchl == 0) return(dirp);
	jne gtd3
gtd2:
	mov ax,bx
	ret				;  else
gtd3:
	cmp cl,1			;  if (srchl == 1)
	jne gtd4			;  {
	mov al,byte ptr dname[bx]	;    if (!dirp->dname[0] ||
	or al,al! jz gtd2		;        dirp->dname[0] == 0xe5)
	cmp al,0e5h			;      return(dirp);
	jz gtd2				;  }
	jmps gtd6			;  else
gtd4:					;  {
	test hdsaddr,0ffffh		     
	jnz gtd5
	mov ax,dcnt
	mov si,cdrmaxa			;    if (dcnt >= dphptr->cdrmax)
	cmp ax,[si]			;      return(NULL);
	jb gtd5
gtd4a:
	xor ax,ax
	mov dirp,ax
gtd4b:
	ret
gtd5:
	mov al,byte ptr dname[bx]	;    if (!dirp->dname[0]) return(NULL);
	or al,al
	jz gtd4a
	cmp al,0E5h			;    if (dirp->dname[0] == 0xe5) 
	jz gtd6 			;      continue;
	test byte ptr datts[bx],08h	;    if (dirp->datts & 0x08)
	jnz gtd6			;      continue;
	call match			;    if (match(offset)) return(dirp);
	or al,al
	jz gtd6
	mov ax,dirp
	ret
gtd6:					;  }
	jmp getdir			;}

match:					;BOOLEAN match()
;	entry: BX = dirp
;	       CH = info_fcb offset
;	exit: TRUE if name match

	mov al,ch
	push cx
	xor ah,ah
	mov si,offset info_fcb+1	;p(SI) = (UBYTE *)infop+1+offset
	add si,ax
					;q(BX) = dirp;
	mov cx,11			;i = 11;
mat1:					;do
					;{
	mov al,[si]			;  if ((*p ^ *q) & 0x7f &&
	xor al,[bx]			
	test al,7fh			
	jz mat2				
	mov al,[si]			;      (*p ^ '?') & 0x7f)
	xor al,'?'			  
	test al,7fh			
	jz mat2				
	xor al,al			;     return(FALSE);
	pop cx
	ret
mat2:
	inc si				;  p++;
	inc bx				;  q++;
	loop mat1			;} while(--i);
	or al,1
	pop cx
	ret				;return(TRUE);

lshiftl:
;	Entry:	DX,AX = long value to shift left
;		CL = shift count

	xor ch,ch
lshiftl_1:
	shl ax,1
	rcl dx,1
	loop lshiftl_1
	ret

lshiftr:
;	Entry:	DX,AX = long value to shift right
;		CL = shift count

	xor ch,ch
lshiftr_1:
	shr dx,1
	rcr ax,1
	loop lshiftr_1
	ret

mul_32:
;	Entry:	BX,AX = long multiplicand
;		CX = word multiplier
;	Exit:	BX,AX = long result
;		CX = preserved
;		DX = used

	mul cx
	push dx
	xchg ax,bx
	mul cx
	pop dx
	add ax,dx
	xchg ax,bx
	ret

div_32:
;	Entry:	BX,AX = long dividend
;		CX = word divisor
;	Exit:	DX,AX = long result
;		CX = remainder

	jcxz div0			;divide by 0
	cmp cx,1 ! jne not_div1		;divide by 1
	  mov dx,bx
	  xor cx,cx
	  ret
not_div1:
	xor dx,dx			;extend AX to long value
	xchg ax,bx			;low in BX, high in DX,AX
	push ax				;save ax
	div cx				;divide high part
	mov di,ax			;save result
	mul cx				;AX = even divisor part
	pop dx				;old high in DX
	sub dx,ax			;eliminate even part
	mov ax,bx			;AX = old low part
	div cx				;low part in AX
	mov cx,dx			;CX = remainder
	mov dx,di			;high result in DX
	ret

div0:
	mov ax,-1
	mov dx,ax
	ret

openf:
	mov cl,0c0h
	call get_omode			;get_omode(0xc0);

	call setenddir			;dcnt = 0xffff;
	mov cx,2			;
	call getdir			;if (!(dirp = getdir(0,2))
	or ax,ax			;{
	jnz opn1
	test hdirfx,0ffh		;  if (hdirfx & 0xff)
	jz opn0				;  {
	mov bx,hdsaddr			;    if (!(hdsaddr & 0xffff) ||
	or bx,bx
	jz opn0a
