	cmp bl,11			;for (i = 0; i < 11, i++)
	jae mak4			;{
	mov al,info_fcb+fname[bx]	;  SI->dname[i] = infop->fname[i] &
	and al,07fh			;        	  0x7f;
	mov dname[si+bx],al		;}
	inc bl
	jmps mak3
mak4:
	xor ax,ax
	mov di,dirp			;zero(dirp->datts2,20);
