	call setpcd			;setpcd();
	mov si,dirp			;SI = dirp;

	test hdirfx,0ffh		;if (hdirfx)
	jnz $+5
	jmp mak4e			;{
	mov byte ptr datts[si],010h	;  SI->datts = 0x10;
	xor ax,ax
