	call getphy			;  getphy(AX,BX);
	call init_wzf			;  init_wzf();
	mov si,cur_dma			;  SI = cur_dma;
	mov byte ptr dname[si],02eh	;  SI->dname[0] = 0x2e;
	xor bx,bx
mak4a:
	cmp bl,10			;  for (BX = 0; BX < 10; BX++)
	jae mak4b			;    SI->dname[BX+1] = 0x20;
	mov byte ptr dname+1[si+bx],020h
	inc bl
	jmps mak4a
mak4b:
	mov byte ptr datts[si],010h	;  SI->datts = 0x10;
	mov ax,blk			;  AX = blk;
	mov block1[si],ax		;  SI->block1 = AX;
	mov dirp,si			;  dirp = SI;
	call setpcd			;  setpcd();

	mov si,cur_dma			;  SI = cur_dma
	add si,32			;  SI++;
	mov byte ptr dname[si],02eh	;  SI->dname[0] = 0x2e;
	mov byte ptr dname+1[si],02eh	;  SI->dname[1] = 0x2e;
	xor bx,bx
mak4c:
	cmp bl,9			;  for (BX = 0; BX < 9; BX++)
	jae mak4d			;    SI->dname[BX+2] = 0x20;
	mov byte ptr dname+2[si+bx],020h
	inc bl
	jmps mak4c
mak4d:
	mov byte ptr datts[si],010h	;  SI->datts = 0x10;
;start		*3.2*G*8*
;	mov ax,chdblk			;  AX = chdblk
	xor	ax,ax
	mov	di,hdsaddr
	test	di,di			; if no hdsaddr are parent is DR ROOT
	jz	mak4d1
	mov	ax,HBLK[di]
mak4d1:
;end		*3.2*G*8*
	mov block1[si],ax		;  SI->block1 = AX:
	mov dirp,si			;  SI = dirp;
	call setpcd			;  setpcd();
	call seek			;  seek();
	xor cx,cx
	call wrbuff			;  wrbuff(0);
	ret				;  return;
					;}
mak4e:
	mov byte ptr datts[si],020h	;dirp->datts = 0x20;

	call set_sdcnt			;set_sdcnt();
	mov al,attributes		;AL = attributes
	call pc_make_test		;pc_make_test(AL);

;start			*G*3.3*85*09*

		; Do we need to update the High Water Mark(HWM)?

	test	hdsaddr,0ffffh		; Do we have a HDS?
	jz	mak4f			; NO (ie we are at the root)
	mov	bx,hdsaddr		; Get HDS
	cmp	HBLK[bx],0		; Is our blk # zero? (0 implies root)
	jne	mak4g			; NO (ie  we are in a subdirectory)
mak4f:
		; We only update the High Water Mark(HWM) if we are at the
		; root as we have no HWM for subdirectories.

	call setcdr			; Update HWM(cdrmaxa) if needed
;end			*G*3.3*85*09*

mak4g:
	call wrdir			;wrdir();

	mov extcnt,0			;extcnt = 0;
	mov bx,0ffffh		
	push bx				;copydir(infop,0,TRUE);
	inc bx
	push bx
	mov bx,offset info_fcb
	push bx
	call copydir
	add sp,6
	call reset_checksum_fcb		;reset_checksum_fcb();
	or info_fcb+module,080h		;infop->module |= 0x80;
	mov al,make_flag
	mov attributes,al
	jmp openx1a

deletef:

	call get_atts			;get_atts();
					;AH = found, AL = i
	xor ax,ax			;found = FALSE;
del1:					;for (i = 0; i < 2; i++);
	cmp al,2			;{
	jb far1
	    jmp del6
far1:
	push ax
	call setenddir			;  dcnt = 0xffff;
del2:
	mov cx,2			;  while (dirp = getdir(0,2))
	call getdir			;  {
	or ax,ax
	pop ax
	jne far2
	    jmp del5
far2:
	test attributes,80h		;     if (attributes & 80h) return(0);
	jz $+3
	ret
	mov ah,TRUE			;     found = TRUE;
	or al,al			;     if (!i)
	jnz del3			;     {
	push ax
	call tst_olist			;       tst_olist();
	mov bx,dirp			;       if (dirp->datts & 0x03)
	test byte ptr datts[bx],003h	;	   exterr(0x03ff);
	jz $+5
del25:
	jmp roferror
	mov bx,offset info_fcb		;       if (!wild()) i = 1;
	call chk_wild
	pop ax
	jz del3				; YES fcb is wild
	inc al
	jmps del30
del3:
;	mov bx,dirp
;	test byte ptr datts[bx],010h
;	jnz del32

del30:					;     }
	cmp al,1			;     if (i)
	jne del4			;     {
	push ax	
	mov bx,dirp			;       if (dirp->datts & 0x10)
	test byte ptr datts[bx],010h	;	{
	jz del34			;          do

	push	bx
	mov	bx,offset info_fcb
	call	chk_wild
	pop	bx
	jz	del2			; Is a wild delete, so skip DIRS
	test	hdirfx,0ffh		; Is this a hdir delete?
	jz	del32			; NO	report could not find

					;          {
	mov ax,dblock1[bx]		;            AX = dirp->dblock1;
	mov cx,2			;	     CX = 2;
del31:
	mov	bx,ax
	push	ax
	call tstempty			;            if (!tstempty(AX,CX))
	pop	ax
	jz del32			;              return(0xff);
	call getnblk			;            AX = getnblk(AX);
	xor cx,cx			;            CX = 0;
	cmp ax,nclstrs			;	   } while (AX < dpb->nclstrs);
	jb del31
	jmps del33

del32:
		; Return file not found
	pop ax
	jmp lret_eq_ff
del33:
	call chkpds			;   	   if (chkpds()) return(0xff);
	jnz del32
	dec dcnt			;	   dcnt--;
	mov cx,2
	mov	chdblk,0		; *3.2*G*13*
	call getdir			;	   if (!(dirp = getdir(0,2)))
	or ax,ax			;            return(0xff);
	jz del32
	jmps del35			;        }
del34:
	call chk_olist			;	 else chk_olist();
del35:
	mov bx,dirp
	mov byte ptr[bx],0e5h		;        dirp->dname[0] = 0xe5;
	mov ax,dblock1[bx]
	push bx
	call delfat			;	 delfat(dirp->dblock1);
	pop bx
	mov word ptr dblock1[bx],0	;	 dirp->dblock1 = 0;
	call wrdir			;        wrdir();
	mov bx,offset info_fcb
	call chk_wild			;        if (!wild()) break break;
	pop ax
	jnz del6			;     }
del4:						
	push ax
	jmp del2			;   }

del5:	or ah,ah			;   if (!found) return(0xff);
	jnz $+5
	jmp lret_eq_ff
	inc al
	jmp del1			;}
del6:
	jmp update_fat


;start			*G*3.3*85*10*

;
;	If ANY process is currently pointing to the subdirectory that we
;    wish to delete we will return an error.
;

chkpds:
	mov	bx,THRD_SPB		; Lock up THREAD link
	mov	cx,f_sync
	call	mpmif
	mov	bx,dirp
	mov	cx,block1[bx]		; block number of directory to delete

	mov	si,thrdrt		; Link list of all Processes
	jmps	chkloop2

chkloop1:
		; SI -> link list of PD's
		; CX    BLK number of directory to delete

	mov	si,02[si]

chkloop2:
;
;	Check out next process.
;
	cmp	si,0			; Are there anymore processes to check?
	je	dirfree			; NO
	mov	di,word ptr cat[si]	; grap CAT offset
	cmp	di,0			; Is there a CAT?
	je	chkloop1		; NO (All logical drives are at roots)
	mov	al,curdsk		; get the drive the subdir is in(0 rel)

tryfloats:
;
;	Any logical drive can be a floating drive, so check all logical drives
;    to see if ANY point to the subdirectory we wish to delete.
;
		; DI -> CAT array
		; AL    (0 rel) drive that rmdir will take place in
		; SI -> PD
		; CX    BLK number of directory to delete

	mov	dx,0fffeh		; Set up of proper index into CAT array
nxtfloat:
	inc	dx
	inc	dx
	cmp	dx,32			; Have we checked all logical Drives?
	je	chkloop1		; YES
	mov	bx,di
	add	bx,dx
	mov	bx,[bx]			; bx -> hds of logical drives
	cmp	bx,0			; Does this drive have a HDS?
	je	nxtfloat		; NO (ie We are not in a subdirectory)
	cmp	cx,HBLK[bx]		; do block numbers match?
	jne	nxtfloat		; NO
	cmp	al,HDRV[bx]		; do physical drives match?
	jne	nxtfloat		; NO

		; Someone is pointing at the directory, so no deleting it
dirinuse:
	inc	cx			; block number can not be 0ffffh so
					; this clears the zero flag

dirfree:
	pushf
	mov	bx,THRD_SPB		; lets free up the thread sync
	mov	cx,f_unsync
	call	mpmif
	popf286 b286		; Make Iret do the pop flags

	ret

;end			*G*3.3*85*10*


;start			*3.2*

tstempty:

;	ENTRY
;		CX	->	first fcb to check if empty(0 rel)
;		AX	->	block number of directory
;
;
;	EXIT
;		zf	->	off if all empty else on
;

	mov	blkcnt,cx		; tmp location only
	xor	bx,bx
	call	getphy			; calulate ARECORD from block number

; dup in pcbdos under zeroblk:
	mov	di,DIR_BCBA
	sub	di,12

fill00:
	mov	di,12[di]
	cmp	word ptr 12[di],0
	jnz	fill00

	mov	byte ptr [di],0ffh
	mov	di,10[di]
	mov	cur_dma,di
	mov	cur_dma_seg,ds		; now have buffer for a physical record
	xor	al,al
	rep	stos	al
; end dup

	mov	al,PHYMSK
	xor	ah,ah
	inc	ax			; # log records in a phy rcord
	mov	blkidx,ax		; tmp location only
	shl	ax,1
	shl	ax,1			; # of directories per phy. record
	mov	blkoffset,ax		; tmp location only

	mov bx,clsize
	mov cl,7
	add cl,physhf			;BX = clsize >> (physhf + 7);
	shr bx,cl

lzero1:					;while(BX--)
	push bx
	call 	seek			;  seek();
	call	rdbuff

		; Now lets see if all the fcbs in this block are empty
	pop	bx			; number of phy records yet to read

	mov	cx,blkcnt		; start fcb
	mov	dx,blkoffset		; # fcb in phy. rec
	sub	dx,cx
	mov	si,cur_dma
tstloop1:
	cmp	cx,0
	je	tst1a
		add	si,32
		dec	cx
		jmps	tstloop1
tst1a:
	mov	blkcnt,cx
tstnext1:
	dec	dx
	jl	bempty			; OK to exit as zero flag is off
	mov	al,[si]
	cmp	al,0
	je	tst1		
	cmp	al,0e5h
	jne	fndone

tst1:			; test next fcb
	add	si,32
	jmps	tstnext1
	
fndone:
	xor	ax,ax			; set zero flag
	ret
	
bempty:
		; This record is all empty

	mov	ax,blkidx		; # log rec in a phy rec
	add word ptr arecord,ax		;  arecord += AX;
	adc arecord+2,0

	dec bx
	jnz 	lzero1			;}
	inc	bx			; turn off zero flag
	ret

;end			*3.2*

renamef:
	call copy_user_no		;(UBYTE *)infop += 16;
	mov dl,1
	call chk_wild0			;if (wild()) exterr(0x09ff);	
	mov ah,9
	jz ren0
	call setenddir			;dcnt = 0xffff;
	mov cx,01002h			
	call getdir			;if (getdir(16,2)) exterr(0x08ff);
	or ax,ax
	jz ren1
	mov ah,8
ren0:
	add info,dskmap
	mov parlg,0
	jmp set_aret
ren1:
	call setenddir			;dcnt = 0xffff;
	mov cx,2
	call getdir			;if (getdir(0,2)) return(0xff);
	or ax,ax
	jnz ren2
	jmp lret_eq_ff
ren2:
	mov bx,ax
	test byte ptr datts[bx],11h	;if (dirp->datts & 0x01) 
	jz ren3				;  exterr(0x03ff);
	jmp roferror
ren3:
	call chk_olist			;chk_olist();
	xor bx,bx
	mov si,dirp
ren4:
	cmp bl,11			;for (i = 0; i < 11, i++)
	jae ren5			;{
	mov al,info_fcb+fname+16[bx]	;  dirp->dname[i] = infop->fname[i] &
	and al,07fh			;        	    0x7f;
	mov dname[si+bx],al		;}
	inc bl
	jmps ren4
ren5:
	jmp wrdir			;wrdir();
	
setattsf:

	call setenddir			;dcnt = 0xffff;
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2)))
	or ax,ax			;  return(0xff);
	jnz set1
	jmp lret_eq_ff
set1:
	call get_atts			;if ((get_atts() & 0x40) &&
	test al,40h
	jz set2	
	mov cl,info_fcb+cr		;    (CL = infop->cr & 0x7f) &&
	and cl,07fh
	or cl,cl
	jz set2
	mov bx,dirp
	mov ax,word ptr dsize[bx]	;    dirp->dsize)
	mov dx,word ptr dsize+2[bx]
	or ax,dx				
	jz set2				;{
	test al,07fh			;  if (dirp->dsize & 0x7f)
	jz set1a
	and al,7fh			;    dirp->dsize &= ~(LONG)0x7f;
	jmps set1b
set1a:					;  else
	sub ax,080h			;    dirp->dsize -= 0x80;
	sbb dx,0
set1b:
	xor ch,ch			;  dirp->dsize += CL;
	add ax,cx
	adc dx,0
	mov word ptr dsize[bx],ax
	mov word ptr dsize+2[bx],dx
set2:					;}
	call chk_olist			;chk_olist();
	xor bx,bx
	mov si,dirp
set3:					;for (i = 0; i < 11; i++)
	cmp bl,11			;{
	jae set10
	mov ah,info_fcb+fname[bx]	;  set = infop->fname[i] & 0x80;
	and ah,080h			
	cmp bl,4			;  if (i < 4)
	jae set4			;  {
	lea di,datts2[si]		;    p = &dirp->datts2;
	mov al,080h			;    mask = 0x80 >> i;
	mov cl,bl			;  }
	shr al,cl
	jmps set7
set4:					;  else
	cmp bl,8			;  if (i <  8) continue;
	jb set9				;  else
	lea di,datts[si]		;  {
	cmp bl,8			;     p = &dirp->datts;
	jne set5			;     if (i == 8) mask = 0x01;
	mov al,01h			;     else
	jmps set7
set5:					;     if (i == 9) mask = 0x04;
	cmp bl,9			;     else
	jne set6			;     {
	mov al,04h
	jmps set7
set6:						
	mov al,020h			;       mask = 0x20;
	xor ah,80h			;       set = !set;
set7:					;     }
	test ah,80h			;  }
	jz set8				;  if (set)
	or byte ptr [di],al		;    *p |= mask;
	jmps set9			;  else
set8:					
	not al				;    *p &= ~mask;
	and byte ptr [di],al
set9:
	inc bl
	jmps set3			;}
set10:
	jmp wrdir			;wrdir();

truncatef:
	
	call get_atts			;get_atts();
	test info_fcb+rr2,0fch		;if (infop->rr2 & 0xfc) return(0xff);
	jz tru2
tru1:
	jmp lret_eq_ff
tru2:
	call setenddir			;dcnt = 0xffff;
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2)))
	or ax,ax			;  return(0xff);
	jz tru1
	call chk_olist			;chk_olist();
	mov si,dirp
	test byte ptr datts[si],011h	;if (dirp->datts & 0x11)
	jz $+5				;  exterr(0x03ff);
	jmp roferror
	mov ax,word ptr info_fcb+rr0	;size = infop->rr2;
	mov dl,info_fcb+rr2		;size = size << 8 + infop->rr1;
	xor dh,dh			;size = size << 8 + infop->rr0;
	mov cl,7			;size <<= 7;
	call lshiftl
	add ax,0080h			;size += 0x80;
	adc dx,0
	cmp dx,dsize+2[si]		;if (size >= dirp->dsize)
	ja tru1				;  return(0xff);
	jb tru3
	cmp ax,dsize[si]
	jae tru1
tru3:
	mov dsize[si],ax		;dirp->dsize = size;
	mov dsize+2[si],dx
	or byte ptr datts[si],020h	;dirp->datts |= 0x20
	sub ax,1
	sbb dx,0
	         			; AX = nblks
	mov cx,clsize			;nblks = divide(--size,dpbptr->clsize,
	div cx     			;		&dontcare);
	mov bx,dblock1[si]		; BX = bl1
	or bx,bx			;if (!(bl1 = dirp->dblock1) ||
	jnz tru5			;    bl1 >= dpbptr->nclstrs)
tru4:
	jmp lret_eq_ff			;    return(0xff);
tru5:
	cmp bx,nclstrs			;while (nblks--)
	jae tru4			;{
	or ax,ax
	jz tru6
	dec ax
	push ax
	mov ax,bx			;  bl1 = getnblk(bl1);
	call getnblk			; AX = bl1
	mov bx,ax
	pop ax
	jmps tru5			;  if (bl1 >= dpbptr->nclstrs)
tru6:					;    return(0xff);
					;}
	mov ax,bx			;if ((bl2 = getnblk(bl1)) < 
	push bx				;     dpbptr->nclstrs)
	call getnblk			;{
	pop bx
	cmp ax,nclstrs
	jae tru7
	push bx				; AX = bl2
	call delfat			;  delfat(bl2);
	pop ax
;	mov bx,0fffh			;			*3.2*19*
	mov bx,dosfat			; 12 or 16 bit fat	*3.2*19*
	call fixfat			;  fixfat(bl1,dosfat);
	call update_fat			;  update_fat();
tru7:					;}
	call cnvcpd			;cnvcpd();
	call setpcd			;setpcd();
	jmp wrdir			;wrdir();
	
xfcb:
	call setenddir			;dcnt = 0xffff;
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2))
	or ax,ax			;  return(0xff);
	jnz xfcb1
	jmp lret_eq_ff
xfcb1:
	mov di,offset info_fcb+extent	;p = &infop->extent
	mov cx,4			;zero(p,8);
	xor ax,ax
	rep stosw
	call getpcd			;getpcd();
	call cnvpcd			;cnvpcd();
	mov si,offset cpm_tod		;move(&cpm_tod,p+8,4);
	mov di,offset info_fcb+20
	mov cx,2
	rep movsw
	ret

setstamp:
	call setenddir			;dcnt = 0xffff;
	mov cx,2
	call getdir			;if (!(dirp = getdir(0,2))
	or ax,ax			;  return(0xff);
	jnz stmp1
	jmp lret_eq_ff
stmp1:
	mov si,offset common_dma+4	;move(&cpm_tod,&common_dma+4,4);
	mov di,offset cpm_tod
	movsw
	movsw
	xor al,al
	stosb
	call cnvcpdx			;cnvcpdx();
	call setpcd			;setpcd();
	
	call set_sdcnt			;set_sdcnt();
	mov ch,5			;if (BX = search_olist(5))
	call search_olist		;  *(BX+2) |= 0x10;
	jnz stmp2
	or byte ptr 2[bx],10h
stmp2:
	jmp wrdir			;wrdir();

compfs:
	mov dx,0ffffh			;size |= 0ffff0000h;
	push ax
	push dx

	call setenddir			;dcnt = 0xffff;
cmp1:
	mov cx,2
	call getdir			;while(dirp = getdir(0,2))
	or ax,ax			;{
	jz cmp4
	mov si,ax			; DX,AX = size
	pop dx
	pop ax
	cmp dx,0ffffh			;   if ((size & 0xffff0000) ==
	je cmp2				;	             0xffff0000 ||
	cmp dx,dsize+2[si]		;        size < dsize)
	jb cmp2
	ja cmp3
	cmp ax,dsize[si]
	jae cmp3
cmp2:
	mov ax,dsize[si]		;      size = dirp->dsize;
	mov dx,dsize+2[si]
cmp3:
	push ax
	push dx
	jmps cmp1
cmp4:					;}
	pop dx
	pop ax
	cmp dx,0ffffh			;if ((size & 0xffff0000) ==
	jne cmp5			;			0xffff0000)
	jmp lret_eq_ff			;     return(0xff);
cmp5:
	mov di,offset info_fcb+rr0
	;jmp cnvsize			;cnvsize(&infop->rr0,size);

cnvsize:
;       entry DX,AX = size 
;	entry ES:DI = random record field pointer

					; ES:DI = rrptr

	test al,07fh			;if (size & 0x7f) size += 0x80;
	jz cnv1
	and al,80h
	add ax,0080h
	adc dx,0
cnv1:					;*rrptr++ = (size >>= 7) & 0xff;
	mov cx,7
	call lshiftr
	mov es:[di],al
	mov es:1[di],ah			;*rrptr++ = (size >>= 8) & 0xff;
	mov es:2[di],dl			;*rrptr++ = size >>= 8; 
	ret

getnblk:				;UWORD getnblk(blk);
;	entry: AX = blk
;	exit: AX = next FAT block index

	push ax
	call getblk			;i = getblk(blk);
	pop bx
	or ax,ax			;if (!i) fixfat(blk,i = dosfat);
	jnz gnb1
;	mov ax,0fffh			;			*3.2*19*
	mov ax,dosfat			; 12 or 16 bit fat	*3.2*19*
	push ax
	xchg ax,bx			;AX = blk, BX = i
	call fixfat
	pop ax
gnb1:
	ret

getblk:					;UWORD getblk(blk);
;	entry: AX = blk
;	exit: AX = FAT[blk]

	mov di,ax			;DI = AX * 1.5
;start		*3.2*19*
	cmp	dosfat,FAT16
	je	get16
;end		*3.2*19*
	shr di,1
	add di,ax
	mov es,hash_seg			;DX = FAT[DI]
	mov dx,es:[di]
	test ax,1			;if (AX & 1)
	jz gtb1 
	mov cl,4			;  DX >>= 4;
	shr dx,cl
	jmps gtb2
;start		*3.2*19*
get16:
	shl	di,1
	mov	es,hash_seg
	mov	dx,es:[di]
