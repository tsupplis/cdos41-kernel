   db	0FCh,66h,66h,7Ch,66h,66h,0FCh,0,3Ch,66h,0C0h,0C0h,0C0h,66h,3Ch,0
   db	0F8h,6Ch,66h,66h,66h,6Ch,0F8h,0,0FEh,62h,68h,78h,68h,62h,0FEh,0
   db	0FEh,62h,68h,78h,68h,60h,0F0h,0,3Ch,66h,0C0h,0C0h,0CEh,66h,3Eh,0
   db	0CCh,0CCh,0CCh,0FCh,0CCh,0CCh,0CCh,0,78h,30h,30h,30h,30h,30h,78h,0
   db	1Eh,0Ch,0Ch,0Ch,0CCh,0CCh,78h,0,0E6h,66h,6Ch,78h,6Ch,66h,0E6h,0
   db	0F0h,60h,60h,60h,62h,66h,0FEh,0,0C6h,0EEh,0FEh,0FEh,0D6h,0C6h,0C6h,0
   db	0C6h,0E6h,0F6h,0DEh,0CEh,0C6h,0C6h,0,38h,6Ch,0C6h,0C6h,0C6h,6Ch,38h,0
   db	0FCh,66h,66h,7Ch,60h,60h,0F0h,0,78h,0CCh,0CCh,0CCh,0DCh,78h,1Ch,0
