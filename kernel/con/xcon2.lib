   db	0E0h,60h,6Ch,76h,66h,66h,0E6h,0,30h,0,70h,30h,30h,30h,78h,0
   db	0Ch,0,0Ch,0Ch,0Ch,0CCh,0CCh,78h,0E0h,60h,66h,6Ch,78h,6Ch,0E6h,0
   db	70h,30h,30h,30h,30h,30h,78h,0,0,0,0CCh,0FEh,0FEh,0D6h,0C6h,0
   db	0,0,0F8h,0CCh,0CCh,0CCh,0CCh,0,0,0,78h,0CCh,0CCh,0CCh,78h,0
   db	0,0,0DCh,66h,66h,7Ch,60h,0F0h,0,0,76h,0CCh,0CCh,7Ch,0Ch,1Eh
   db	0,0,0DCh,76h,66h,60h,0F0h,0,0,0,7Ch,0C0h,78h,0Ch,0F8h,0
   db	10h,30h,7Ch,30h,30h,34h,18h,0,0,0,0CCh,0CCh,0CCh,0CCh,76h,0
