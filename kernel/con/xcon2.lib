   db	0,0,0FCh,98h,30h,64h,0FCh,0,1Ch,30h,30h,0E0h,30h,30h,1Ch,0
   db	18h,18h,18h,0,18h,18h,18h,0,0E0h,30h,30h,1Ch,30h,30h,0E0h,0
   db	76h,0DCh,0,0,0,0,0,0,0,10h,38h,6Ch,0C6h,0C6h,0FEh,0


;	dynamic row update list for fast window scrolling

vc_list		rw	(2*num_vir_cons-1) * crt_rows_p * 2 + 4

;	console control blocks have moved to xchar.lib
eject

;********************************************************
;*							*
;*		PC MODE VIDEO SUPPORT			*
;*							*
;********************************************************

;	This was previously a seperate module name PCVIDEO.LIB

;	code and data required for PC_MODE video support in XIOS
;	written by M.P. Vano 22-November-1983
;	altered by D.D. Ballard 8-December-1983

;	PARAMETER BLOCK DEFINITION

;	VID (VIDeo command block) passes registers to some subfunctions.
;	The registers pass different parameters to different subfunctions.
;	These definitions are also used to index the parameters when
;	they are put on the stack.

VID_ax		equ	word ptr 0	;ax register
VID_al		equ	byte ptr 0
VID_ah		equ	byte ptr 1
VID_bx		equ	word ptr 2	;bx register
VID_bl		equ	byte ptr 2
VID_bh		equ	byte ptr 3
VID_cx		equ	word ptr 4	;cx register
VID_cl		equ	byte ptr 4
VID_ch		equ	byte ptr 5
VID_dx		equ	word ptr 6	;dx register
VID_dl		equ	byte ptr 6
VID_dh		equ	byte ptr 7
VID_vcons	equ	byte ptr 8	;virtual console number


reorg_mv2_code	equ	offset $
		cseg
		org	reorg_mv2_code

;	New XIOS function 31 used to support ROS video emulation
pc_video:
	cmp	al,14			;this was bl at xios entry
	jg	pc_video_err		;out of range function
	cbw
	xchg	ax,bx			;bx = function number
	shl	bl,1
	jmp	pc_video_fn[bx]
;
pc_video_fn:					;subfunction branch table
	dw	offset pc_video_err		;0
	dw	offset pc_video_cursortype	;1 set cursor type
	dw	offset pc_video_setcursor	;2 set cursor position
	dw	offset pc_video_getcursor	;3 get cursor position
	dw	offset pc_video_err		;4
	dw	offset pc_video_err		;5
	dw	offset pc_video_scroll_up	;6 scroll window up
	dw	offset pc_video_scroll_down	;7 scroll window down
	dw	offset pc_video_read		;8 get attr/char at cursor
	dw	offset pc_video_write_attr	;9 set attr/char at cursor
	dw	offset pc_video_write_char	;10 set char (curr.attr) @ cur
	dw	offset pc_video_set_color	;11 pallette / border control
	dw	offset pc_video_write_dot	;12 graphics pix write
	dw	offset pc_video_read_dot	;13 graphics pix read
	dw	offset pc_video_write_tty	;14 write char stream as a tty

pc_video_err:				;null routine for unimplemented fns
	ret


;	***  Sub-function 1  ***
;	set cursor type   start line=CH, end line=CL
pc_video_cursortype:
	call	pc_video_setup		; point to vs_
	 jz	pc_vid_1		;* ZF reset if serial console
	 jmp	pc_vid_ser_exit		;* leave
pc_vid_1:				;*
	mov	vs_cur_type,cx		; save the new cursor
	call	show_cursor		;   and display it
	jmp	pc_video_exit


;	***  Sub-function 2  ***
;	set/update cursor to row=CH, col=CL
pc_video_setcursor:
	call	pc_video_setup
	 jz	pc_vid_2		;* ZF reset if serial console
	 jmp	pc_vid_ser_exit		;* leave
pc_vid_2:				;*
	cmp	ch,vs_crt_rows
	jb	pc_v_row_ok		; if row is too big
	  mov	ch,vs_crt_rows		;   then clip it
	  dec	ch

pc_v_row_ok:
	cmp	cl,vs_width
	jb	pc_v_col_ok		; if column is too big
	  mov	cl,vs_width		;   then clip it
	  dec	cl

pc_v_col_ok:
	mov	dx,cx
	call	put_cursor		; (updates vs_cursor as well)
	jmp	pc_video_exit


;	***  Sub-function 3  ***
;	return AH=row, AL=column
pc_video_getcursor:
	call	pc_video_setup
	 jz	pc_vid_3		;* ZF reset if serial console
	 jmp	pc_vid_ser_exit		;* leave
pc_vid_3:				;*
	mov	ax,vs_cursor
	jmp	pc_video_exit


;	***  Sub-function 6  ***
;	scroll ROS screen window as per Scroll Command Block CX:DX--> 
pc_video_scroll_up:
	call	pc_video_params		; push registers on stack
	 jz	pc_vid_6		;* ZF reset if serial console
	 jmp	pc_vid_ser_p_exit	;* leave
pc_vid_6:				;*
	test	vs_screen_mode,0F0h	; if we're in graphics mode
	jz	pc_v_scroll_up		;   then skip
	jmp	pc_gr_scroll_up		; do a graphics scroll

pc_v_scroll_up:
	mov	dx,VID_cx[bp]		; top left corner to start
	call	point_cursor		; di -> top left corner
	call	pc_video_count		; move, erase and column counts
	jc	pc_v_scroll_exit	; quit on illegal box

	mov	al,vs_width		; next row down
	cbw  !	shl ax,1
	jmps	pc_v_move_erase		; shared routine from here


;	***  Sub-function 7  ***
;	scroll ROS screen window as per Scroll Command Block CX:DX--> 
pc_video_scroll_down:
	call	pc_video_params		; push registers on stack
	 jz	pc_vid_7		;* ZF reset if serial console
	 jmp	pc_vid_ser_p_exit		;* leave
pc_vid_7:				;*
	test	vs_screen_mode,0F0h	; if not in graphics mode
	jz	pc_v_scroll_down	;   then skip
	jmp	pc_gr_scroll_down	; do a graphics scroll

pc_v_scroll_down:
	mov	dh,VID_dh[bp]		; bottom row
	mov	dl,VID_cl[bp]		; left column
	call	point_cursor		; di -> bottom left corner
	call	pc_video_count		; move, erase and column counts
	jc	pc_v_scroll_exit	; quit on illegal box

	mov	al,vs_width		; next row down
	cbw ! shl ax,1 ! neg ax
;	jmps	pc_v_move_erase		; shared routine from here

;	shared code for scroll up and down
;	entry:	ax = + or - chars per crt row
pc_v_move_erase:
	push	ax			; save row increment
	imul	VID_dx[bp]		; ax = move offset
	mov	si,di
	add	si,ax			; si -> move source
	pop	dx			; dx = row increment

	cmp	VID_cx[bp],0		; if no moves to do
	jz	pc_v_erase_loop		;   then just erase

pc_v_move_loop:
	mov	cx,VID_ax[bp]		; get column count
	push si ! push di		; save line pointers
	call	z_movsw			; move one screen line
	pop di ! pop si
	add	si,dx			; next source line
	add	di,dx			;   and next destination
	dec	VID_cx[bp]		; move countdown
	jnz	pc_v_move_loop

pc_v_erase_loop:
	mov	cx,VID_ax[bp]		; get column count
	mov	al,' '			; erase to a blank
	mov	ah,VID_bh[bp]		; pick up the attribute
	push dx ! push di
	call	erase_pc		; erase one line
	pop di ! pop dx
	add	di,dx			; next line to erase
	dec	VID_dx[bp]		; erase countdown
	jnz	pc_v_erase_loop

pc_v_scroll_exit:
	jmp	pc_video_p_exit


;	calculate move, erase and column counts
;	exit:	VID_dx[bp] = erase count
;		VID_cx[bp] = move count
;		VID_ax[bp] = column count
;		      -	or -
;		cf set on illegal box

pc_video_count:
	mov	al,VID_dh[bp]		; bottom row
	sub	al,VID_ch[bp]		; minus top row
	jc	pc_count_exit		; if negative, forget it

	cbw  !  inc ax			; ax = # of rows in box
	mov	dx,ax			; dx = default erase count
	sub	cx,cx			; default move count = 0
	sub	al,VID_al[bp]		; subtract lines to scroll
	jbe	pc_count_erase		; if too much, just erase
	cmp	VID_al[bp],0		; if al = 0, just erase
	jz	pc_count_erase

	mov	cx,ax			; cx = move count
	sub	dx,ax			; dx = erase count
pc_count_erase:
	mov	al,VID_dl[bp]		; right column
	sub	al,VID_cl[bp]		; minus left column
	jc	pc_count_exit		; if negative, forget it

	cbw  !	inc ax			; ax = column count
	mov	VID_dx[bp],dx		; save the move count
	mov	VID_cx[bp],cx		;   the erase count and
	mov	VID_ax[bp],ax		;   column count in the stack
	clc				; all is well
pc_count_exit:
	ret

;	Graphics mode scrolling
pc_gr_scroll_up:
	mov	dx,VID_cx[bp]		; get the top left corner
	call	pc_gr_set_index		; set up di, si for move
	add	si,ax			; source below destination
	sub	ax,ax			; no post-move correction
	jmps	pc_gr_scroll		; the rest is shared code

pc_gr_scroll_down:
	mov	dl,VID_cl[bp]		; get the left edge
	mov	dh,VID_dh[bp]		;   but the bottom row
	call	pc_gr_set_index		; set up di, si for move
	sub	si,ax			; source above destination
	mov	ax,-640			; post-move correct up row
	jmps	pc_gr_scroll		; the rest is shared code

pc_gr_set_index:
	call	graph_point		; di -> graphics screen
	mov	si,di			; si will be offset either
	mov	al,160			;   up or down as many rows
	mul	VID_al[bp]		;   as we have to scroll
	shl	ax,1			; ax = 320 * row count
	ret

;	Graphics scrolling function
;	shared by scroll up and scroll down
;	entry:	si,di -> graphics screen
;		ax = post move address correction
pc_gr_scroll:
	push	es
	push	ds

	xchg	ax,VID_dx[bp]		; get bottom right, and
					;   save address correction
	sub	ax,VID_cx[bp]		; subtract top left
	add	ax,0101h		; ah = rows, al = cols
	mov	VID_bh[bp],ah		; save for scroll count
	mov	VID_bl[bp],ah		;   and for blank count

	cbw
	cmp	vs_screen_mode,40h	; 1 * col count for hi-res
	jz	pc_gr_scroll_lines
	shl	ax,1			; 2 * col count for med-res
pc_gr_scroll_lines:
	mov	VID_cx[bp],ax		; save for movsw and stosw
	mov	ax,color_seg
	mov	es,ax			; reach into the crt ram
	mov	ds,ax

	mov	al,VID_al[bp]		; get scroll count
	test	al,al			; if count = 0
	jz	pc_gr_blank_loop	;   then just blank

	sub	VID_bh[bp],al		; reduce scroll count
	mov	VID_bl[bp],al		; and set the blank count

pc_gr_scroll_loop:
	mov	cx,4			; 4 even/odd pairs per row
pc_gr_scroll_row:
	push	cx
	mov	dx,2000h		; even to odd
	call	pc_gr_move_one		; scroll one line
	mov	dx,80 - 2000h		; odd to next even
	call	pc_gr_move_one
	pop	cx
	loop	pc_gr_scroll_row

	add	di,VID_dx[bp]		; correct pointers when
	add	si,VID_dx[bp]		;   scrolling down
	dec	VID_bh[bp]		; scroll count down
	jnz	pc_gr_scroll_loop

pc_gr_blank_loop:
	sub	ax,ax			; ax = 0 for blanking
	mov	cx,4			; 4 even/odd pairs per row
pc_gr_blank_row:
	push	cx
	mov	dx,2000h		; even to odd
	call	pc_gr_store_one		; blank even scan line
	mov	dx,80 - 2000h		; odd to next even
	call	pc_gr_store_one		; blank odd scan line
	pop	cx
	loop	pc_gr_blank_row

	add	di,VID_dx[bp]		; correct for down scroll
	dec	VID_bl[bp]		; blank count down
	jnz	pc_gr_blank_loop

	pop	ds
	pop	es
	jmp	pc_video_p_exit		; clear stack and leave

;	scroll one horizontal scan line
pc_gr_move_one:
	mov	cx,VID_cx[bp]
	sub	dx,cx			; correct next line inc
	rep	movsb			; move one scan line
	add	si,dx			; next source line
	add	di,dx			; next dest line
	ret

;	blank one horizontal scan line
pc_gr_store_one:
	mov	cx,VID_cx[bp]
	sub	dx,cx			; correct next line inc
	rep	stosb			; blank one scan line
	add	di,dx			; next dest line
	ret


;	***  Sub-function 8  ***
;	read a character at current cursor position
pc_video_read:
	call	pc_video_setup		; bx -> vs_
	 jz	pc_vid_8		;* ZF reset if serial console
	 jmp	pc_vid_ser_exit		;* leave
pc_vid_8:				;*
	mov	dx,vs_cursor
	test	vs_screen_mode,0F0h	; if we're in a graphics mode
	jnz	pc_gr_read		;   then skip

	call	point_cursor		; di -> cursor dest
	test	vs_mode,match_bit	; if matched then
	jnz	pc_v_read_image		;   get it from the image

	mov	si,di			; for lodsw
	call	get_crt_c		; with sync'ing for color
	jmp	pc_video_exit
pc_v_read_image:
	push	es
	mov	es,vs_vc_seg
	mov	ax,es:[di]		; no hurry here
	pop	es
	jmp	pc_video_exit

;	Read one character off the graphics screen
;	This works in the somewhat awkward (but IBM compatible!) manner
;	of reading the font and scanning the font tables for a match.
pc_gr_read:
	push es	! push ds		; save both segments
	pop es	! push es		; local extra segment
	call	graph_point		; dx set, returns di
	mov	si,di
	mov	ax,color_seg
	mov	ds,ax			; ds:si -> graphics ram
	mov	di,offset temp_font	; local storage
	mov	cx,4			; even/odd row pairs
	cmp	cs:vs_screen_mode,40h	; if not in hi-res mode
	jnz	pc_gr_read_med		;   then skip

pc_gr_read_hi:
	movsb				; store font directly
	add	si,2000h-1
	movsb				; odd rows too
	add	si,(80 - 2000h - 1)
	loop	pc_gr_read_hi
	jmps	pc_gr_search

pc_gr_read_med:
	call	one_row_in		; read even font row
	add	si,2000h - 2		; to odd row
	call	one_row_in		; read odd font row
	add	si,(80 - 2000h - 2)	; to next even row
	loop	pc_gr_read_med

pc_gr_search:
	pop ds	! push ds		; restore local ds
	mov	si,offset font		; ds:si -> low font table
	call	search_font		; look for a match
	jz	pc_gr_read_done		; zf set on a match

	mov	si,00h
	mov	ds,si			; reach for the base page
	lds	si,dword ptr .7Ch	; ds:si -> hi font table
	call	search_font		; look for a match
	jnz	pc_gr_read_done		; al = 0 if no match

	add	al,80h			; correct offset
pc_gr_read_done:
	pop ds	! pop es		; restore both segments
	jmp	pc_video_exit		; and return with al

;	Read one row of font from the med-res graphics ram
;	entry:	ds:si -> graphics ram
;		es:di -> temp font storage
one_row_in:
	push	cx
	lodsw				; grab the graphics ram
	xchg	al,ah			; correct the order
	mov	dx,ax			; save a copy
	shr	ax,1
	or	dx,ax			; or the color bits
	mov	cx,8			; font bits per word
one_row_in_loop:
	shl	dx,1
	shl	dx,1			; font bit to carry
	rcl	al,1			; save it in al
	loop	one_row_in_loop
	stosb				; save in temp font
	pop	cx
	ret

;	Search one font table for a match
;	entry:	ds:si -> font table
;	exit:	if match, zf set & al = ascii value
;		if not, zf clear & al = 0
search_font:
	mov	al,0			; initial ascii
	mov	dx,si			; for reinitialization
search_font_loop:
	mov	si,dx			; character beginning
	mov	di,offset temp_font
	mov	cx,8			; bytes per font
	add	dx,cx			; for next time
	repz	cmpsb			; compare the two
	jz	search_font_done	; skip if matched
	inc	al			; next ascii value
	jns	search_font_loop	; up to 80h

	mov	al,0			; al = 0 for failure
search_font_done:
	ret

temp_font	rb	8		; font compare storage


;	***  Sub-function 9  ***
;	write a char/attr at current cursor position
pc_video_write_attr:
	call	pc_video_params		; push registers on stack
	 jz	pc_vid_9		;* ZF reset if serial console
	 jmp	pc_vid_ser_p_exit	;* leave
pc_vid_9:				;*
	test	vs_screen_mode,0F0h	; if we're in a graphics mode
	jnz	pc_gr_write_attr	;   then skip

	pop	ax			; recover character
	pop	dx			; recover attribute
	mov	ah,dl			;   and save it
	jmps	pc_v_write		; shared with write_char

;	Graphics mode char out routines

pc_gr_write_char:			; if no color specified
	mov	VID_bl[bp],03h		;   use white for color
pc_gr_write_attr:
	jmp	pc_gr_write		; jump to shared code


;	***  Sub-function 10  ***
;	write a char at current cursor using current attribute
pc_video_write_char:
	call	pc_video_params		; push registers on stack
	 jz	pc_vid_10		;* ZF reset if serial console
	 jmp	pc_vid_ser_p_exit	;* leave
pc_vid_10:				;*
	test	vs_screen_mode,0F0h	; if we're in a graphics mode
	jnz	pc_gr_write_char	;   then skip

	pop	ax			; recover character
	pop	dx			; throw away the attrib
	mov	ah,vs_attrib		; use current attribute
;	jmps	pc_v_write		; shared with write_attr

;	Shared code for alpha character writes
;	write cx attr/chars at current cursor
pc_v_write:
	pop	cx			; recover repeat count
	pop	dx			; throw away dx
	push	ax			; save attr/char
	mov	dx,vs_cursor
	call	point_cursor		; di -> cursor dest
	pop	ax			; restor attr/char
	test	vs_mode,match_bit	; if full screen top
	jz	pc_v_write_full		;   then skip

;	this is a little redundant but it's much better than
;	the old way of updating the screen every character!

pc_v_write_image:
	push	es
	push	cx
	mov	cx,ax			; save char in cx
	call	point_cursor
	mov	es,vs_vc_seg		; go to the vc image
	mov	es:[di],cx		; store char, attrib

;	now update screen if character belongs

	mov	es,vc_map_seg		; for ownership check
	add	ax,vs_correct
	xchg	ax,si			; save for map check
	call	in_window		; is char in window?
	mov	ax,cx			; ax = character + attrib
	jc	pc_v_image_bump		; skip if not

	mov	di,si
	shl	di,1			; back to screen coords
	call	put_if_ours		; print it if we own it
pc_v_image_bump:
	inc	dl			; advance cursor
	cmp	dl,vs_width		; if not wrapping around
	jb	pc_v_image_next		;   then do next char

	mov	dl,0
	inc	dh			; next row
pc_v_image_next:
	pop	cx
	pop	es
	loop	pc_v_write_image
	jmp	pc_video_exit

pc_v_write_full:
	call	put_crt_s		; go right to physical
	jmp	pc_video_exit


;	Shared code for graphic character writes
pc_gr_write:
	push	es			; we'll use these
	push	ds
	call	font_point		; ds:si -> char font
	mov	ax,color_seg		; always in color ram
	mov	es,ax
	mov	dx,cs:vs_cursor		; find where we point

;	set jump vectors for a move
	mov	VID_ax[bp],offset pc_gr_mov_al
	mov	VID_dx[bp],offset pc_gr_mov_ax
	test	VID_bl[bp],80h		; if color msb not set
	jz	pc_gr_again		;   then go to it

;	set jump vectors for an exclusive or
	mov	VID_ax[bp],offset pc_gr_xor_al
	mov	VID_dx[bp],offset pc_gr_xor_ax
	mov	VID_bx[bp],03h		; store a white for xor

pc_gr_again:
	push	dx			; save for repeats
	push	si
	call	graph_point		; point to graphics screen
	mov	cx,4			; 4 evens, 4 odds
	mov	dx,VID_bx[bp]		; grab the color value
	and	dx,03h			; mask off color bits
pc_gr_out:
	call	one_row			; first the even row
	add	di,2000h
	call	one_row			; then the odd row
	add	di,(80 - 2000h)
	loop	pc_gr_out

	pop	si			; restore font pointer
	pop	dx			;   and previous cursor
	inc	dl			; next column
	dec	VID_cx[bp]		; count down repeat
	jnz	pc_gr_again		; and loop till done

	pop	ds
	pop	es
	jmp	pc_video_p_exit

;	point to a character in the graphics screen
;	entry:	dx = cursor row,column
;	exit:	di -> character start
graph_point:
	mov	ah,dh			; ah = row number
	mov	al,0
	shr	ax,1
	shr	ax,1			; ax = row * 64
	add	ah,dh			; ax = row * 320
	mov	dh,0			; dx = column
	add	ax,dx			; ax = 320 * row + col
	cmp	cs:vs_screen_mode,40h	; if hi-res
	jz	graph_point_done	;   then skip
	add	ax,dx			; 2 bytes per in med-res
graph_point_done:
	xchg	di,ax			; tuck it away
	ret

;	point to low or hi font
;	exit:	ds:si -> font
font_point:
	mov	al,VID_al[bp]		; grab the character
	cmp	al,80h			; if above 7Fh
	jae	font_point_hi		;   then skip

	mov	si,offset font		; if below, then local
	jmps	font_shared
font_point_hi:
	and	al,7Fh			; zap the msb
	mov	si,00h			; base page
	mov	ds,si
	lds	si,dword ptr .7Ch
font_shared:
	mov	ah,8			; bytes per char
	mul	ah			; ax = index
	add	si,ax			; ds:si -> char font
	ret

;	calc font mask for one horiz line
one_row:
	cmp	cs:vs_screen_mode,40h	; if not hi-res
	jnz	one_row_med		;   then skip

	push	dx			; save the color
	rcr	dl,1			; color bit to carry
	sbb	dl,dl			;   and copied across
	lodsb
	and	al,dl			; font or zeros
	pop	dx
	jmp	VID_ax[bp]		; mov or xor to finish

one_row_med:
	push	cx
	push	dx
	lodsb				; grab a font byte
	mov	dh,al
	mov	cx,8
one_row_loop:
	shl	ax,1
	shl	dh,1
	rcl	ax,1			; expand into ax
	loop	one_row_loop

	mul	dx			; ax = color * font
	xchg	al,ah			; lead with lsb
	pop	dx			; restore color
	pop	cx			; and outer count
	jmp	VID_dx[bp]		; mov or xor to finish

pc_gr_mov_al:
	mov	es:[di],al		; store hi-res font
	ret
pc_gr_mov_ax:
	mov	es:[di],ax		; store med-res font
	ret
pc_gr_xor_al:
	xor	es:[di],al		; xor with hi-res font
	ret
pc_gr_xor_ax:
	xor	es:[di],ax		; xor with med-res font
	ret


;	***  Sub-function 11  ***
;	set the palette / border color
pc_video_set_color:
	call	pc_video_params		; get the parameters
	 jz	pc_vid_11		;* ZF reset if serial console
	 jmp	pc_vid_ser_p_exit	;* leave
pc_vid_11:				;*
	mov	al,palette_reg		; current value
	mov	dx,VID_bx[bp]		; this gets used
	test	dh,dh			; if not color=0
	jnz	pc_video_set_pal	;   the set to 1

	and	al,0E0h			; 5 lsb's off
	and	dl,01Fh			; 3 msb's off
	or	al,dl			; mash 'em
	jmps	pc_video_set_out	; shared code
pc_video_set_pal:
	and	al,0DFh			; turn off palette select
	mov	cl,5			; shift count
	shl	dl,cl			; move up to palette bit
	and	dl,20h			; just in case
	or	al,dl			; set it
pc_video_set_out:
	mov	dx,color_port + 5	; palette port
	out	dx,al
	mov	al,palette_reg		; for next time
	jmp	pc_video_p_exit


;	***  Sub-function 12  ***
;	write one dot to a graphics screen
pc_video_write_dot:
	push	es
	call	pc_video_params		; get the parameters
	 jz	pc_vid_12		;* ZF reset if serial console
	 pop	es			;*
	 jmp	pc_vid_ser_p_exit	;* leave
pc_vid_12:				;*
	call	pc_video_dot_pos	; get the dot position
	shr	al,cl			; shift output bits
	and	al,ah			; mask off
	mov	cl,es:[si]		; get current byte
	test	VID_al[bp],80h		; check xor flag
	jnz	pc_video_dot_xor	; skip if on

	not	ah
	and	cl,ah			; strip unwanted bits
	or	al,cl			; or with the new ones
	jmps	pc_video_dot_out	; put it
pc_video_dot_xor:
	xor	al,cl
pc_video_dot_out:
	mov	es:[si],al		; store it
	pop	es			; restore segment
	jmp	pc_video_p_exit		; and bug out


;	***  Sub-function 13  ***
;	read one dot from a graphics screen
pc_video_read_dot:
	push	es
	call	pc_video_params		; get the parameters
	 jz	pc_vid_13		;* ZF reset if serial console
	 pop	es			;*
	 jmp	pc_vid_ser_p_exit	;* leave
pc_vid_13:				;*
	call	pc_video_dot_pos	; get the dot position
	mov	al,es:[si]		; get the graphics byte
	and	al,ah			; mask off unwanted bits
	shl	al,cl			; shift to the top
	mov	cl,dh			; bits per pix
	rol	al,cl			; rotate to bottom
	pop	es			; restore segment
	jmp	pc_video_p_exit		; and bug out

;	calculate the address of a given pix cell
;	entry:	VID_dx = row value (0-199)
;		VID_cx = col value (0-639)
;	exit:	si = offset into crt memory
;		al = write pix shifted left
;		ah = pix bit mask
;		cl = count to right justify ah
;		dh = number of result bits
;		es = crt segment
pc_video_dot_pos:
	mov	ax,color_seg
	mov	es,ax			; for crt mem references
	mov	ax,40			; bytes per row
	mov	dx,VID_dx[bp]		; get row value
	and	dl,0FEh			; zap the lsb
	mul	dx			; ax -> first row byte
	test	VID_dx[bp],1		; if row is even
	jz	pc_video_dot_even	;   then skip
	add	ax,2000h		; else jump up 2000h
pc_video_dot_even:
	xchg	ax,si			; si hold the pointer
	mov	dx,2C0h			; set medium res params
	mov	cx,302h
	cmp	vs_screen_mode,40h	; check which mode we're in
	jnz	pc_video_dot_res	; skip if not hi res
	mov	dx,180h			; set hi res params
	mov	cx,703h
pc_video_dot_res:
	mov	ax,VID_cx[bp]		; get column number
	and	ch,al			; ch = pix address in byte
	shr	ax,cl			; byte address in row
	add	si,ax			; si -> byte containing pix
	mov	cl,0
	mov	al,VID_al[bp]		; get write byte
	mov	ah,dh			; copy count
pc_video_dot_shift:
	ror	al,1			; left justify it
	add	cl,ch			; slow multiply
	dec	ah
	jnz	pc_video_dot_shift	; cl = bit count

	mov	ah,dl			; get bit mask
	shr	ah,cl			; move to correct position
	ret				; return params


;	***  Sub-function 14  ***
;	write as a tty the char in CL to console # in DL
pc_video_write_tty:
	call	pc_video_setup
	 jz	pc_vid_14		;* ZF reset if serial console
	 jmp	pc_vid_ser_exit		;* leave
pc_vid_14:				;*
	mov	dx,vs_cursor

	cmp	cl,8			;backspace?
	jne	pc_not_bs
	  call	vc_out_bs
	  jmps	pc_video_exit

pc_not_bs:
	cmp	cl,0dh			;cr?
	jne	pc_not_cr
	  call	vc_out_cr
	  jmps	pc_video_exit

pc_not_cr:
	cmp	cl,0ah			;lf?
	jne	pc_not_lf
	  call	vc_out_lf
	  jmps	pc_video_exit

pc_not_lf:
	cmp	cl,7			;bell?
	jne	pc_not_bell
	  call	vc_out_bel
	  jmps	pc_video_exit

pc_not_bell:
	call	vc_out
	jmps	pc_video_exit

;	leave the pc_video function, restoring the stack

pc_video_p_exit:
	add	sp,8			; clear the stack
;	jmps	pc_video_exit		; and fall through

pc_video_exit:
	mov	vs_mx,0			; release crt routines
	ret
pc_vid_ser_p_exit:			;* clear the stack
	add	sp,8			;*
;	jmps	pc_vid_ser_exit		;*

pc_vid_ser_exit:			;*
	ret				;*

;	as pc_video setup1 but for cases where there is a VID involved
;	exit:	ax - dx returned on the stack (ax comes off first)
;*	Return w/ ZF set if PC console, reset if serial console

pc_video_params:
	pop	di			; stash the return addr
	mov	ax,es			; save es in ax
	mov	es,cx			; set up segment and
	mov	bx,dx			;   offset of parmam block
	push	es:VID_dx[bx]		; push the dx param
	push	es:VID_cx[bx]		; push the cx param
	push	es:VID_bx[bx]		; push the bx param
	push	es:VID_ax[bx]		; push the ax param
	mov	bp,sp			; for stack var references
	push	di			; return return addr to stack

	mov	dl,es:VID_vcons[bx]	; get the console number
	mov	es,ax			; restore es
;	jmp	pc_video_setup		; set up bx -> vs_

;	sets up environment as if already in vc routines for simple parameters
pc_video_setup:
	cmp	dl,num_vir_cons		;* check for PC screen
	 jb	pc_v_s_ok		;* 
	mov	ax,0ffffh		;* indicate error
	jmps	pc_v_back		;*
pc_v_s_ok:
	push	cx			; save char for tty mode
	call	point_vs
	call	get_mx
	pop	cx
	xor	ax,ax			;*
pc_v_back:				;*
	or	ax,ax			;* set ZF appropriately
	ret
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀