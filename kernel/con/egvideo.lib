; Preserve the combined XIOS code/data origin across library boundaries.
eg_reorg equ offset $
	cseg
	org eg_reorg

;------------------------------------------------------------------------------
; Enhanced graphics adapter bridge (local copy in each independent project).
;
; Native function 30 assigns 50h=10h, 60h=0Dh, 70h=0Eh,
; 80h=11h, 90h=12h, A0h=13h, B0h=0Fh (VGA emulation). A single foreground console owns graphics.
; Function 31 accepts the usual packet AX,BX,CX,DX,console (nine bytes).
; Set bit 7 of its BIOS selector to use a packet also for cursor/cell/TTY
; operations. Plain selectors retain the historical native argument ABI.
; Firmware runs through video_bios with IRQs masked and a private stack.
; CF=0: handled, AX=result; CF=1: ordinary text/CGA path, inputs unchanged.
;------------------------------------------------------------------------------
eg_try_video:
	push	bx ! push cx ! push dx ! push si
	push	di ! push bp ! push es ! push ax
	call	eg_dispatch
	jc	$+5
	jmp	eg_handled
	pop	ax
	pop	es ! pop bp ! pop di ! pop si
	pop	dx ! pop cx ! pop bx
	stc
	ret
eg_handled:
	add	sp,2
	pop	es ! pop bp ! pop di ! pop si
	pop	dx ! pop cx ! pop bx
	clc
	ret

eg_dispatch:
	push	ax
	and	al,7Fh
	cmp	al,1
	jb	eg_selector_bad
	cmp	al,16
	ja	eg_selector_bad
	cmp	al,4
	je	eg_selector_bad
	cmp	al,5
	je	eg_selector_bad
	cmp	al,15
	je	eg_selector_bad
	pop	ax
	jmp	eg_selector_ok
eg_selector_bad:
	pop	ax
	test	al,80h
	jz	$+5
	jmp	eg_reject
	stc
	ret
eg_selector_ok:
	xor	ah,ah
	mov	si,ax			; BIOS selector, optionally packet flag
	test	al,80h
	jz	$+5
	jmp	eg_packet
	cmp	al,16
	jne	$+5
	jmp	eg_packet
	cmp	al,6
	jae	$+5
	jmp	eg_simple
	cmp	al,8
	jne	$+5
	jmp	eg_simple
	cmp	al,14
	jne	$+5
	jmp	eg_simple
	cmp	al,13
	jbe	$+5
	jmp	eg_fallback
eg_packet:
	mov	es,cx
	mov	di,dx
	mov	dl,es:byte ptr 8[di]
	eg_simple:
	cmp	dl,num_vir_cons
	jb	$+5
	jmp	eg_reject
	call	point_vs
	cmp	vs_screen_mode,50h
	jae	eg_enhanced_owner
	; CGA packet services use the same ROM guard, even on a real CGA.
	test	si,80h
	jz	$+5
	jmp	eg_cga_owner
	jmp	eg_fallback
eg_cga_owner:
	cmp	vs_screen_mode,20h
	jb	$+5
	jmp	eg_cga_upper
	jmp	eg_reject
eg_cga_upper:
	cmp	vs_screen_mode,40h
	jbe	$+5
	jmp	eg_reject
	jmp	eg_owner_check
eg_enhanced_owner:
	cmp	vs_screen_mode,0C0h
	jbe	$+5
	jmp	eg_reject
	cmp	bios_graphics,0
	jne	$+5
	jmp	eg_reject
eg_owner_check:
	mov	al,vs_number
	cmp	al,top_screen
	je	$+5
	jmp	eg_reject
	mov	al,vs_bit
	test	graphic_bits,al
	jnz	$+5
	jmp	eg_reject
	call	get_mx
	push	cx
	call	eg_owned
	pop	cx
	mov	vs_mx,0
	clc
	ret

eg_fallback:
	test	si,80h
	jz	$+5
	jmp	eg_reject
	stc
	ret
eg_reject:
	mov	ax,0FFFFh
	clc
	ret

; Work only after locking the graphics owner. Dimensions also bound BIOS
; character rectangles. Mode 13h uses 8x8 cells; VGA 480 uses 8x16;
; mode 10h uses 8x14. Reject nonzero pages and malformed rectangles.
eg_owned:
	push	di
	mov	al,vs_screen_mode
	xor	ah,ah
	shr	ax,1			; native mode / 16 * eight-byte descriptor
	mov	di,ax
	mov	cx,cs:eg_modes-16+4[di]
	mov	bp,cs:eg_modes-16+6[di]
	pop	di
; eg_dimensions:
	cmp	vs_screen_mode,0C0h
	jne	hgc_services_ready
	mov	ax,si
	and	ax,7Fh
	cmp	ax,11
	je	$+5
	jmp	hgc_check_palette
	jmp	eg_owned_bad
hgc_check_palette:
	cmp	ax,16
	jne	hgc_services_ready
	jmp	eg_owned_bad
hgc_services_ready:
	test	si,80h
	jz	$+5
	jmp	eg_owned_packet
	cmp	si,16
	jne	$+5
	jmp	eg_owned_packet
	cmp	si,6
	jae	$+5
	jmp	eg_owned_simple
	cmp	si,8
	jne	$+5
	jmp	eg_owned_simple
	cmp	si,14
	jne	$+5
	jmp	eg_owned_simple
eg_owned_packet:
	and	si,7Fh
	cmp	si,16
	jne	$+5
	jmp	eg_palette
	cmp	si,12
	jne	$+5
	jmp	eg_pixel
	cmp	si,13
	jne	$+5
	jmp	eg_pixel
	; Derive character bounds from pixel dimensions and ROM font height.
	shr	cx,1 ! shr cx,1 ! shr cx,1
	mov	ax,43
	cmp	bp,348
	je	eg_cell_bounds
	mov	ax,25
	cmp	bp,480
	je	$+5
	jmp	eg_cell_bounds
	mov	ax,30
eg_cell_bounds:
	cmp	si,6
	jne	$+5
	jmp	eg_rectangle
	cmp	si,7
	jne	$+5
	jmp	eg_rectangle
	cmp	es:byte ptr 3[di],0
	je	$+5
	jmp	eg_owned_bad
	cmp	si,2
	je	$+5
	jmp	eg_packet_call
	cmp	es:byte ptr 6[di],cl
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 7[di],al
	jb	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call

eg_rectangle:
	cmp	es:byte ptr 4[di],cl
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 6[di],cl
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 5[di],al
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 7[di],al
	jb	$+5
	jmp	eg_owned_bad
	mov	ax,es:word ptr 4[di]
	cmp	al,es:byte ptr 6[di]
	jbe	$+5
	jmp	eg_owned_bad
	cmp	ah,es:byte ptr 7[di]
	jbe	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call

eg_pixel:
	cmp	es:byte ptr 3[di],0
	je	$+5
	jmp	eg_owned_bad
	cmp	es:word ptr 4[di],cx
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:word ptr 6[di],bp
	jb	$+5
	jmp	eg_owned_bad
	cmp	vs_screen_mode,0C0h
	jne	$+5
	jmp	hgc_pixel
	cmp	vs_screen_mode,0A0h
	jne	$+5
	jmp	eg_chain4_pixel
	jmp	eg_packet_call

eg_palette:
	cmp	vs_screen_mode,50h
	jae	$+5
	jmp	eg_owned_bad
	mov	al,es:byte ptr [di]
	cmp	al,0
	jne	$+5
	jmp	eg_atc_write
	cmp	al,7
	jne	$+5
	jmp	eg_atc_read
	cmp	enhanced_vga,0
	jne	$+5
	jmp	eg_owned_bad
	cmp	es:word ptr 2[di],256
	jb	$+5
	jmp	eg_owned_bad
	cmp	al,15h
	jne	$+5
	jmp	eg_packet_call
	cmp	al,10h
	je	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 5[di],64
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 4[di],64
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 7[di],64
	jb	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call
eg_atc_write:
	cmp	vs_screen_mode,0A0h
	jne	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 3[di],64
	jb	$+5
	jmp	eg_owned_bad
eg_atc_read:
	cmp	vs_screen_mode,0A0h
	jne	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr [di],7
	jne	eg_atc_index
	cmp	enhanced_vga,0
	jne	$+5
	jmp	eg_owned_bad
eg_atc_index:
	cmp	es:byte ptr 2[di],16
	jb	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call

eg_owned_bad:
	mov	ax,0FFFFh
	ret

; Preserve the screen pointer across ROM calls. Results are captured by
; the existing guarded helper before it restores caller registers.
eg_packet_call:
	push	bx
	mov	ax,si
	mov	ah,al
	mov	al,es:byte ptr [di]
	mov	bx,es:word ptr 2[di]
	mov	cx,es:word ptr 4[di]
	mov	dx,es:word ptr 6[di]
	call	eg_graphics_bios
	pop	bx
	cmp	hgc_present,0
	je	hgc_result_kind
	cmp	video_result_ax,0FFFFh
	jne	hgc_result_kind
	jmp	eg_read_result
hgc_result_kind:
	cmp	si,3
	jne	$+5
	jmp	eg_packet_results
	cmp	si,16
	je	$+5
	jmp	eg_pixel_result
eg_packet_results:
	mov	ax,video_result_bx
	mov	es:word ptr 2[di],ax
	mov	ax,video_result_cx
	mov	es:word ptr 4[di],ax
	mov	ax,video_result_dx
	mov	es:word ptr 6[di],ax
eg_pixel_result:
	cmp	si,8
	jne	$+5
	jmp	eg_read_result
	cmp	si,13
	jne	$+5
	jmp	eg_read_result
	xor	ax,ax
	ret
eg_read_result:
	mov	ax,video_result_ax
	ret

; Historical native simple ABI: CX holds cursor argument or TTY byte;
; DL is console. Native TTY uses white (15); full packets preserve BL.
eg_owned_simple:
	push	bp
	mov	bp,sp
	mov	cx,ss:word ptr 4[bp] ; saved before the dimension calculation
	pop	bp
	push	bx
	xor	bx,bx
	mov	ax,si
	mov	ah,al
	cmp	si,2
	je	$+5
	jmp	eg_simple_tty
	mov	dx,cx
eg_simple_tty:
	cmp	si,14
	je	$+5
	jmp	eg_simple_call
	mov	al,cl
	mov	bl,15
eg_simple_call:
	call	eg_graphics_bios
	pop	bx
	cmp	si,3
	je	$+5
	jmp	eg_simple_read
	mov	ax,video_result_dx
	ret
eg_simple_read:
	jmp	eg_read_result

; VGA mode 13h uses a linear chain-4 byte, with no XOR interpretation.
; Establish ordinary write mode temporarily, restoring GC/SEQ registers and
; their index selectors afterwards. All eight colour bits are retained.
eg_chain4_pixel:
	push	bx ! push es ! push si
	mov	ax,es:word ptr 6[di]
	mov	bx,320
	mul	bx
	add	ax,es:word ptr 4[di]
	mov	cl,es:byte ptr [di]
	mov	di,ax
	mov	ax,0A000h
	mov	es,ax
	mov	dx,3C4h
	in	al,dx
	xor	ah,ah
	push	ax			; original sequencer index
	mov	al,2
	out	dx,al
	inc	dx
	in	al,dx
	push	ax			; original map mask
	mov	al,0Fh
	out	dx,al
	mov	dx,3CEh
	in	al,dx
	push	ax			; original graphics-controller index
	mov	si,offset eg_chain4_regs
	mov	bh,4
eg_chain4_save:
	lodsb
	out	dx,al
	inc	dx
	in	al,dx
	push	ax
	mov	al,cs:byte ptr [si]
	inc	si
	out	dx,al
	dec	dx
	dec	bh
	jnz	eg_chain4_save
	; Saved SI is the original operation selector (12=write, 13=read).
	push	bp
	mov	bp,sp
	cmp	ss:word ptr 16[bp],13
	pop	bp
	je	eg_chain4_read
	mov	es:byte ptr [di],cl
	xor	cx,cx
	jmp	eg_chain4_restore
eg_chain4_read:
	xor	cx,cx
	mov	cl,es:byte ptr [di]
eg_chain4_restore:
	mov	si,offset eg_chain4_regs+6
	mov	bh,4
eg_chain4_restore_loop:
	mov	al,cs:byte ptr [si]
	out	dx,al
	inc	dx
	pop	ax
	out	dx,al
	dec	dx
	sub	si,2
	dec	bh
	jnz	eg_chain4_restore_loop
	pop	ax			; graphics-controller index
	out	dx,al
	mov	dx,3C5h
	pop	ax			; sequencer map mask
	out	dx,al
	dec	dx
	pop	ax			; sequencer index
	out	dx,al
	mov	ax,cx
	pop	si ! pop es ! pop bx
	ret
; Graphics enable-set/reset, rotate, write/read mode, bit mask. Chain-4
; mode remains BIOS configured; GC mode 40h retains its 256-colour shift.
eg_chain4_regs db 1,0,3,0,5,40h,8,0FFh

; Native CGA programs hardware directly. Keep the ROM's BIOS data area
; in agreement so its pixel writer distinguishes mode 6 from modes 4/5.
; AL=BIOS mode, AH=columns. Also reset the single exposed page offset.
eg_legacy_bda:
	push	ax ! push bx ! push es
	mov	bx,40h
	mov	es,bx
	mov	es:byte ptr .49h,al
	mov	es:byte ptr .4Ah,ah
	mov	es:byte ptr .4Bh,0
	mov	es:word ptr .4Eh,0
	mov	es:byte ptr .62h,0
	mov	bx,800h
	cmp	al,2
	jb	eg_bda_page_size
	mov	bx,1000h
	cmp	al,4
	jb	eg_bda_page_size
	mov	bx,4000h
eg_bda_page_size:
	mov	es:word ptr .4Ch,bx
	pop	es ! pop bx ! pop ax
	ret

; One capability-gated entry for enhanced native modes 50h..B0h.
; CH retains the requested native mode through foreground ownership.
eg_set_graphics:
	mov	al,ch
	xor	ah,ah
	shr	ax,1
	mov	si,ax
	push	bx			; capability query returns BX; preserve console
	call	xios_v1_graph_caps
	test	bl,cs:byte ptr eg_modes-16+1[si]
	pop	bx
	jnz	$+5
	jmp	screen_not_sup
	mov	al,cs:byte ptr eg_modes-16[si]
	push	ax
	call	general_graph
	pop	ax
	jmp	enhanced_graph_init

; Eight-byte descriptors, indexed directly by native mode >> 1.
; BIOS mode, required capability bit, columns, reserved, pixel width/height.
; CGA keeps its hardware-specific mode setter; its dimensions live here too.
eg_modes:
	db	04h,0,40,0 ! dw 320,200	; 20h
	db	05h,0,40,0 ! dw 320,200	; 30h
	db	06h,0,80,0 ! dw 640,200	; 40h
	db	10h,1,80,0 ! dw 640,350	; 50h
	db	0Dh,2,40,0 ! dw 320,200	; 60h
	db	0Eh,2,80,0 ! dw 640,200	; 70h
	db	11h,4,80,0 ! dw 640,480	; 80h
	db	12h,4,80,0 ! dw 640,480	; 90h
	db	13h,4,40,0 ! dw 320,200	; A0h
	db	0Fh,8,80,0 ! dw 640,350	; B0h
	db	7Fh,10h,90,0 ! dw 720,348	; C0h: project Hercules extension

enhanced_vga db 0
video_result_ax dw 0
video_result_bx dw 0
video_result_cx dw 0
video_result_dx dw 0

; Function 30 CH=4: truthful mode/column query for DOS and new callers.
; CH=1 retains the historical CDOS graphics-as-text compatibility result.
eg_screen_query:
	mov	al,vs_screen_mode
	mov	ah,80
	cmp	al,20h
	jb	eg_query_text
	cmp	al,0C0h
	ja	eg_query_done
	push	si ! push ax
	xor	ah,ah
	shr	ax,1
	mov	si,ax
	pop	ax
	mov	ah,cs:byte ptr eg_modes-16+2[si]
	pop	si
	ret
eg_query_text:
	cmp	al,2
	je	eg_query_40
	cmp	al,3
	jne	eg_query_done
eg_query_40:
	mov	ah,40
eg_query_done:
	ret

; IBM VGA firmware selects its monochrome path from the equipment bits.
; Keep those consistent with mode 0Fh, then restore the startup selection
; for colour graphics/text. Other equipment bits remain untouched.
eg_set_mode:
	cmp	enhanced_vga,0
	jne	$+5
	jmp	video_bios
	push	ax ! push es ! push di
	mov	di,40h
	mov	es,di
	mov	di,10h
	mov	ah,eg_equipment
	cmp	al,0Fh
	jne	$+4
	mov	ah,30h
	and	es:byte ptr [di],0CFh
	or	es:byte ptr [di],ah
	pop	di ! pop es ! pop ax
	jmp	video_bios

enhanced_mono db 0
eg_equipment db 0

; Hercules page-zero backend. Native C0h maps to project DOS mode 7Fh.
; Register values and interleaving follow the GB101 owner's manual.
hgc_detect:
 push ax ! push bx ! push cx ! push dx ! push es
 mov ax,40h
 mov es,ax
 cmp es:word ptr .63h,mono_port
 jne hgc_detect_done
 mov ah,12h
 mov bx,0FF10h
 int 10h
 cmp bh,1
 jbe hgc_detect_done         ; EGA/VGA monochrome is not Hercules
 mov dx,3BAh
 in al,dx
 and al,80h
 mov ah,al
 mov cx,0FFFFh
hgc_probe:
 in al,dx
 and al,80h
 cmp al,ah
 jne hgc_found
 loop hgc_probe
 jmps hgc_detect_done
hgc_found:
 mov hgc_present,1
 mov enhanced_text,7
hgc_detect_done:
 pop es ! pop dx ! pop cx ! pop bx ! pop ax
 ret

hgc_graphics:
 cmp hgc_present,0
 jne $+5
 jmp screen_not_sup
 call general_graph
 mov bios_graphics,1
 mov hgc_cursor,0
 mov hgc_shape,0607h
 push bx ! push es
 mov dx,3BFh
 mov al,1                  ; page zero only: leave B800h available
 out dx,al
 mov si,offset hgc_graph_regs
 mov ax,0002h
 mov cx,4000h
 call hgc_set
 mov ax,5A7Fh
 mov cx,8000h
 call hgc_bda
 pop es ! pop bx
 xor ax,ax
 ret

hgc_text:
 push ax ! push bx ! push cx ! push dx ! push si ! push di ! push es
 mov si,offset hgc_text_regs
 mov ax,0720h
 mov cx,2000
 call hgc_set
 mov dx,3BFh
 xor al,al
 out dx,al
 mov ax,5007h
 mov cx,1000h
 call hgc_bda
 pop es ! pop di ! pop si ! pop dx ! pop cx ! pop bx ! pop ax
 ret

; AL=mode control without display enable, AH=clear attribute, CX=words.
hgc_set:
 push ax ! push cx
 mov dx,3B8h
 out dx,al
 mov dx,3B4h
 xor ah,ah
 mov cx,16
hgc_register:
 mov al,ah
 out dx,al
 inc dx
 lodsb
 out dx,al
 dec dx
 inc ah
 loop hgc_register
 mov ax,0B000h
 mov es,ax
 xor di,di
 pop cx ! pop ax
 push ax
 mov al,32
 test ah,ah
 jnz $+4
 xor al,al
 cld
 rep stosw
 pop ax
 or al,8
 mov dx,3B8h
 out dx,al
 ret

; Bounds/page/ownership have already been checked by eg_pixel.
hgc_pixel:
 push bx
 mov bp,si
 mov ax,es:word ptr 6[di]
 mov dx,ax
 and dx,3
 mov cl,13
 shl dx,cl
 push dx
 shr ax,1 ! shr ax,1
 mov bx,90
 mul bx
 pop dx
 add ax,dx
 mov cx,es:word ptr 4[di]
 mov bl,es:byte ptr [di]
 mov di,cx
 shr di,1 ! shr di,1 ! shr di,1
 add di,ax
 mov ax,0B000h
 mov es,ax
 and cl,7
 mov ah,80h
 shr ah,cl
 mov al,es:byte ptr [di]
 cmp bp,13
 je hgc_read
 test bl,80h
 jnz hgc_xor
 test bl,1
 jnz hgc_set_bit
 not ah
 and al,ah
 jmps hgc_store
hgc_set_bit:
 or al,ah
 jmps hgc_store
hgc_xor:
 test bl,1
 jz hgc_store
 xor al,ah
hgc_store:
 mov es:byte ptr [di],al
 xor ax,ax
 pop bx
 ret
hgc_read:
 and al,ah
 mov ax,0
 jz $+3
 inc ax
 pop bx
 ret

hgc_present db 0
hgc_graph_regs db 35h,2Dh,2Eh,07h,5Bh,02h,57h,57h,02h,03h,0,0,0,0,0,0
hgc_text_regs db 61h,50h,52h,0Fh,19h,06h,19h,19h,02h,0Dh,0Bh,0Ch,0,0,0,0

; Native graphics text: 90 x 43 cells of eight scan lines. The final four
; raster lines are outside the text grid. Use the PC ROM 8x8 font and the
; optional INT 1Fh extension for characters 128..255; no shadow text image.
eg_graphics_bios:
 cmp hgc_present,0
 jne hgc_bios
 jmp video_bios
hgc_bios:
 push ax ! push bx ! push cx ! push dx ! push si ! push di ! push bp ! push ds ! push es
 mov hgc_args,ax
 mov hgc_args+2,bx
 mov video_result_bx,bx
 mov hgc_args+4,cx
 mov hgc_args+6,dx
 mov al,ah
 xor ah,ah
 shl ax,1
 mov bx,ax
 call hgc_functions[bx]
 mov cs:video_result_ax,ax
 pop es ! pop ds ! pop bp ! pop di ! pop si ! pop dx ! pop cx ! pop bx ! pop ax
 ret
hgc_functions dw hgc_error,hgc_cursor_shape,hgc_cursor_set,hgc_cursor_get
 dw hgc_error,hgc_error,hgc_scroll,hgc_scroll,hgc_char_read
 dw hgc_write,hgc_write,hgc_error,hgc_error,hgc_error,hgc_tty,hgc_error,hgc_error
hgc_error:
 mov ax,0FFFFh
 ret
hgc_cursor_shape:
 mov ax,hgc_args+4
 mov hgc_shape,ax
 xor ax,ax
 ret
hgc_cursor_set:
 mov ax,hgc_args+6
 cmp al,90
 jae hgc_error
 cmp ah,43
 jae hgc_error
 mov hgc_cursor,ax
 xor ax,ax
 ret
hgc_cursor_get:
 mov ax,hgc_shape
 mov video_result_cx,ax
 mov ax,hgc_cursor
 mov video_result_dx,ax
 xor ax,ax
 ret

; AL=character -> DS:SI font. CF set if the extension font is absent.
hgc_font:
 xor ah,ah
 mov si,ax
 mov ax,0F000h
 mov ds,ax
 cmp si,128
 jb hgc_rom_font
 sub si,128
 xor ax,ax
 mov ds,ax
 mov ax,word ptr .7Ch
 mov dx,word ptr .7Eh
 or ax,dx
 jz hgc_font_missing
 mov ax,word ptr .7Ch
 mov ds,dx
 jmps hgc_font_offset
hgc_rom_font:
 mov ax,0FA6Eh
hgc_font_offset:
 shl si,1 ! shl si,1 ! shl si,1
 add si,ax
 clc
 ret
hgc_font_missing:
 stc
 ret

; DX=row,column -> ES:DI first scan byte. Preserve DX.
hgc_cell:
 push dx
 mov al,dh
 xor ah,ah
 mov di,180
 mul di
 pop dx
 mov di,ax
 mov al,dl
 xor ah,ah
 add di,ax
 mov ax,0B000h
 mov es,ax
 ret
hgc_next_scan:
 add di,2000h
 test di,8000h
 jz hgc_scan_done
 sub di,8000h
 add di,90
hgc_scan_done:
 ret

; AL=character, BL=colour/XOR, DX=cell; preserve caller registers, return CF.
hgc_draw:
 push ax ! push bx ! push cx ! push dx ! push si ! push di ! push ds ! push es
 push ax
 call hgc_cell
 pop ax
 call hgc_font
 jc hgc_draw_done
 mov cx,8
hgc_draw_row:
 lodsb
 test bl,1
 jnz hgc_draw_colour
 xor al,al
hgc_draw_colour:
 test bl,80h
 jz hgc_draw_replace
 xor al,es:byte ptr [di]
hgc_draw_replace:
 mov es:byte ptr [di],al
 call hgc_next_scan
 loop hgc_draw_row
 clc
hgc_draw_done:
 pop es ! pop ds ! pop di ! pop si ! pop dx ! pop cx ! pop bx ! pop ax
 ret

hgc_write:
 mov dx,hgc_cursor
 mov cx,hgc_args+4
 jcxz hgc_write_done
 mov bx,hgc_args+2
hgc_write_loop:
 mov al,byte ptr hgc_args
 call hgc_draw
 jnc $+5
 jmp hgc_error
 inc dl
 cmp dl,90
 jb hgc_write_next
 xor dl,dl
 inc dh
 cmp dh,43
 jae hgc_write_done
hgc_write_next:
 loop hgc_write_loop
hgc_write_done:
 xor ax,ax
 ret

; Match glyph bytes against the framebuffer, so direct pixel writes are seen.
hgc_char_read:
 xor bx,bx
hgc_match_char:
 push ds
 mov dx,hgc_cursor
 call hgc_cell
 mov al,bl
 call hgc_font
 jc hgc_match_absent
 mov cx,8
hgc_match_row:
 lodsb
 cmp al,es:byte ptr [di]
 jne hgc_match_next
 call hgc_next_scan
 loop hgc_match_row
 pop ds
 mov al,bl
 xor ah,ah
 ret
hgc_match_next:
 pop ds
 inc bl
 jnz hgc_match_char
 xor ax,ax
 ret
hgc_match_absent:
 pop ds
 xor ax,ax
 ret

hgc_tty:
 mov dx,hgc_cursor
 mov al,byte ptr hgc_args
 cmp al,7
 je hgc_write_done
 cmp al,8
 je hgc_backspace
 cmp al,13
 je hgc_carriage
 cmp al,10
 je hgc_linefeed
 mov bx,hgc_args+2
 call hgc_draw
 jnc $+5
 jmp hgc_error
 inc dl
 cmp dl,90
 jb hgc_tty_save
hgc_carriage:
 xor dl,dl
 cmp byte ptr hgc_args,13
 je hgc_tty_save
hgc_linefeed:
 inc dh
 cmp dh,43
 jb hgc_tty_save
 mov dh,42
 push dx
 push hgc_args ! push hgc_args+2 ! push hgc_args+4 ! push hgc_args+6
 mov hgc_args,0601h
 mov hgc_args+2,0
 mov hgc_args+4,0
 mov hgc_args+6,2A59h
 call hgc_scroll
 pop hgc_args+6 ! pop hgc_args+4 ! pop hgc_args+2 ! pop hgc_args
 pop dx
 jmps hgc_tty_save
hgc_backspace:
 test dl,dl
 jz hgc_tty_save
 dec dl
hgc_tty_save:
 mov hgc_cursor,dx
 xor ax,ax
 ret

; AX=scan line, DL=byte-column -> DI=Hercules address. Preserve DX.
hgc_scan_address:
 push dx
 mov di,ax
 and di,3
 mov cl,13
 shl di,cl
 shr ax,1 ! shr ax,1
 mov cx,90
 mul cx
 add di,ax
 pop dx
 mov al,dl
 xor ah,ah
 add di,ax
 ret

; Rectangle bounds are checked by eg_rectangle. Copy raster rows in the
; appropriate direction; line counts at least the rectangle height clear it.
hgc_scroll:
 mov ax,hgc_args+4
 mov al,ah
 xor ah,ah
 shl ax,1 ! shl ax,1 ! shl ax,1
 mov hgc_top,ax
 mov ax,hgc_args+6
 mov al,ah
 xor ah,ah
 inc ax
 shl ax,1 ! shl ax,1 ! shl ax,1
 dec ax
 mov hgc_bottom,ax
 mov al,byte ptr hgc_args
 xor ah,ah
 shl ax,1 ! shl ax,1 ! shl ax,1
 mov hgc_shift,ax
 mov bp,hgc_top
 cmp byte ptr hgc_args+1,6
 je hgc_scroll_row
 mov bp,hgc_bottom
hgc_scroll_row:
 mov dx,hgc_args+4
 mov ax,bp
 call hgc_scan_address
 push di
 mov ax,bp
 cmp byte ptr hgc_args+1,6
 jne hgc_scroll_down
 add ax,hgc_shift
 jmps hgc_scroll_source
hgc_scroll_down:
 sub ax,hgc_shift
hgc_scroll_source:
 cmp hgc_shift,0
 je hgc_scroll_fill
 cmp ax,hgc_top
 jb hgc_scroll_fill
 cmp ax,hgc_bottom
 ja hgc_scroll_fill
 call hgc_scan_address
 mov si,di
 pop di
 mov cl,byte ptr hgc_args+6
 sub cl,byte ptr hgc_args+4
 inc cl
 xor ch,ch
 push ds
 mov ax,0B000h
 mov ds,ax
 mov es,ax
 cld
 rep movsb
 pop ds
 jmps hgc_scroll_advance
hgc_scroll_fill:
 pop di
 mov cl,byte ptr hgc_args+6
 sub cl,byte ptr hgc_args+4
 inc cl
 xor ch,ch
 mov ax,0B000h
 mov es,ax
 xor al,al
 test byte ptr hgc_args+3,1
 jz hgc_scroll_clear
 dec al
hgc_scroll_clear:
 cld
 rep stosb
hgc_scroll_advance:
 cmp byte ptr hgc_args+1,6
 jne hgc_scroll_reverse
 inc bp
 cmp bp,hgc_bottom
 ja $+5
 jmp hgc_scroll_row
 xor ax,ax
 ret
hgc_scroll_reverse:
 cmp bp,hgc_top
 je $+6
 dec bp
 jmp hgc_scroll_row
 xor ax,ax
 ret

hgc_cursor dw 0
hgc_shape dw 0607h
hgc_args dw 0,0,0,0
hgc_top dw 0
hgc_bottom dw 0
hgc_shift dw 0

; Keep DOS mode queries and the BIOS data area consistent. The firmware
; itself does not implement 7Fh; all its graphics services are mediated.
hgc_bda:
 push es
 mov dx,40h
 mov es,dx
 mov es:byte ptr .49h,al
 mov es:byte ptr .4Ah,ah
 mov es:byte ptr .4Bh,0
 mov es:word ptr .4Ch,cx
 mov es:word ptr .4Eh,0
 mov es:byte ptr .62h,0
 pop es
 ret
